<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<CustomTasksFolder>$(MSBuildThisFileDirectory)..\tasks\netstandard2.0</CustomTasksFolder>
		<CustomTasksAssembly>$(CustomTasksFolder)\Telerik.Maui.Theming.dll</CustomTasksAssembly>
	</PropertyGroup>

	<UsingTask TaskName="Telerik.Maui.Theming.TelerikThemingTask" AssemblyFile="$(CustomTasksAssembly)" TaskFactory="TaskHostFactory"/>
</Project>