<UserControl x:Class="SamaHesab.WPF.Views.Sales.RecurringInvoiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft"
             Background="{StaticResource ErpAppBg}">
    <!-- F5 = بازخوانی (کیبوردمحور، هم‌راستا با بقیهٔ صفحات) -->
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource ErpTextMuted}"/>
            <Setter Property="Margin" Value="2,6,0,2"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- ═══ تولبار ═══ -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IcRefresh}" Style="{StaticResource ErpToolSvg}" Width="18" Height="18" Stroke="{StaticResource ErpBlue700}"/>
                    <TextBlock Text="فاکتورهای تکرارشونده" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource ErpBtnPrimary}" Height="30" Padding="14,0" Margin="0,0,6,0"
                            Content="تولید فاکتورهای سررسیدشده" Command="{Binding GenerateDueCommand}"/>
                    <Button Style="{StaticResource ErpBtnGhost}" Height="30" Padding="12,0" Content="بازخوانی" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>

            <!-- ═══ فهرستِ الگوها ═══ -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="0">
                <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          ItemsSource="{Binding Items}" RowHeight="28" GridLinesVisibility="All" FontFamily="{StaticResource VazirFont}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نام الگو" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="مشتری" Binding="{Binding CustomerName}" Width="160"/>
                        <DataGridTextColumn Header="تناوب" Binding="{Binding Frequency}" Width="80"/>
                        <DataGridTextColumn Header="سررسیدِ بعدی" Binding="{Binding NextDate}" Width="110"/>
                        <DataGridTextColumn Header="آخرین تولید" Binding="{Binding LastGenerated}" Width="110"/>
                        <DataGridCheckBoxColumn Header="فعال" Binding="{Binding IsActive}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ═══ تعریفِ الگوی جدید ═══ -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="تعریفِ الگوی جدید" FontWeight="Bold" FontSize="13" Foreground="{StaticResource ErpBlue700}" Margin="0,0,0,6"/>
                        <TextBlock Text="نامِ الگو" Style="{StaticResource Cap}"/>
                        <TextBox Style="{StaticResource ErpInput}" Height="30" Text="{Binding NewName}"/>
                        <TextBlock Text="مشتری" Style="{StaticResource Cap}"/>
                        <ComboBox Height="30" ItemsSource="{Binding Customers}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding NewCustomerId}" IsEditable="True"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="انبار" Style="{StaticResource Cap}"/>
                                <ComboBox Height="30" ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding NewWarehouseId}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="تناوب" Style="{StaticResource Cap}"/>
                                <ComboBox Height="30" ItemsSource="{Binding Frequencies}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding NewFrequency}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="سررسیدِ بعدی" Style="{StaticResource Cap}"/>
                        <TextBox Style="{StaticResource ErpInput}" Height="30" Text="{Binding NewNextDate}" FlowDirection="LeftToRight" TextAlignment="Center"/>

                        <Rectangle Height="1" Fill="{StaticResource ErpBorder}" Margin="0,10"/>
                        <TextBlock Text="افزودنِ کالا" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox Height="30" ItemsSource="{Binding Products}" DisplayMemberPath="Name" SelectedItem="{Binding LineProduct}" IsEditable="True"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="تعداد" Style="{StaticResource Cap}"/>
                                <TextBox Style="{StaticResource ErpInput}" Height="28" Text="{Binding LineQty}" FlowDirection="LeftToRight" TextAlignment="Center"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="فی" Style="{StaticResource Cap}"/>
                                <TextBox Style="{StaticResource ErpInput}" Height="28" Text="{Binding LinePrice}" FlowDirection="LeftToRight" TextAlignment="Left"/></StackPanel>
                            <Button Grid.Column="4" VerticalAlignment="Bottom" Style="{StaticResource ErpBtnPrimary}" Height="28" Padding="12,0" Content="افزودن" Command="{Binding AddLineCommand}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding NewLines}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0F1F3" BorderThickness="0,0,0,1" Padding="2,4">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Left" Content="✕" Width="22" Height="22" Background="White" BorderBrush="#E6BCBC" Foreground="#B91C1C" Cursor="Hand"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding UnitPrice, Converter={StaticResource Num}}" DockPanel.Dock="Left" Width="80" FlowDirection="LeftToRight" TextAlignment="Left" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Quantity}" DockPanel.Dock="Left" Width="36" TextAlignment="Center" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource ErpBtnPrimary}" Height="36" Margin="0,10,0,0" Content="💾 ذخیرهٔ الگو" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
