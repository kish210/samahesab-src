<UserControl x:Class="SamaHesab.WPF.Views.Inventory.StockCountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft"
             Background="{StaticResource ErpAppBg}">
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="*"/>       <!-- grid -->
            <RowDefinition Height="Auto"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ═══ نوار شروع (gbox) ═══ -->
        <Border Grid.Row="0" Style="{StaticResource ErpGbox}" Padding="12,9" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="انبارگردانی سندی" FontSize="17" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="انبار" Style="{StaticResource ErpFieldLabel}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox Width="180" Height="32" ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedWarehouseId}" IsEnabled="{Binding IsStarted, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                    <TextBlock Text="تاریخ" Style="{StaticResource ErpFieldLabel}" Margin="12,0,6,0" VerticalAlignment="Center"/>
                    <TextBox Style="{StaticResource ErpInput}" Text="{Binding Date}" Width="100"/>
                    <Button Style="{StaticResource ErpBtnPrimary}" Content="شروع شمارش" Padding="16,0" Margin="12,0,0,0" FontWeight="Bold"
                            Command="{Binding StartCommand}"
                            Visibility="{Binding IsStarted, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                    <Border Background="{StaticResource ErpBlue50}" CornerRadius="6" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsStarted, Converter={StaticResource BoolVis}}">
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource ErpBlue700}" FontWeight="SemiBold">
                            <Run Text="سند #"/><Run Text="{Binding SessionId, Mode=OneWay}"/><Run Text="  ·  مغایرت: "/><Run Text="{Binding VarianceCount, Mode=OneWay}"/><Run Text=" قلم"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ گرید شمارش (dgrid) ═══ -->
        <Border Grid.Row="1" Style="{StaticResource ErpGbox}">
            <DataGrid Style="{StaticResource ErpDataGrid}" ItemsSource="{Binding Lines}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کالا" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="موجودی سیستم" Binding="{Binding SystemQty, Converter={StaticResource Num}}" Width="140" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="6,0"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="شمارش" Binding="{Binding CountedQty, UpdateSourceTrigger=PropertyChanged}" Width="130">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="6,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="مغایرت" Binding="{Binding Variance, Converter={StaticResource Num}}" Width="120" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/>
                                <Setter Property="Margin" Value="6,0"/><Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Variance}" Value="0"><Setter Property="Foreground" Value="{StaticResource ErpTextMuted}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══ پایین ═══ -->
        <Border Grid.Row="2" Style="{StaticResource ErpGbox}" Padding="12,9" Margin="0,10,0,0"
                Visibility="{Binding IsStarted, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <TextBlock Text="{Binding ResultText}" Foreground="{StaticResource ErpSuccess700}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource ErpBtnSecondary}" Content="ثبت شمارش‌ها" Padding="18,0" Command="{Binding SaveCountsCommand}"/>
                    <Button Style="{StaticResource ErpBtnSuccess}" Content="قطعی‌سازی و تعدیل موجودی" Padding="18,0" Margin="8,0,0,0" FontWeight="Bold" Command="{Binding PostCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
