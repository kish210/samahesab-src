<UserControl x:Class="SamaHesab.WPF.Views.Inventory.StockTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- هدر فرم + جریان انبار -->
            <RowDefinition Height="Auto"/>   <!-- ردیف ورود -->
            <RowDefinition Height="*"/>      <!-- گرید اقلام -->
            <RowDefinition Height="Auto"/>   <!-- نوار جمع + ثبت -->
        </Grid.RowDefinitions>

        <!-- ═══ هدر فرم + جریان انبار ═══ -->
        <Border Grid.Row="0" Style="{StaticResource ErpGbox}">
            <StackPanel Margin="12,10">
                <TextBlock Text="انتقال بین انبار" Style="{StaticResource ErpGboxTitle}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="تاریخ" Style="{StaticResource ErpFieldLabel}"/>
                        <TextBox Text="{Binding TransferDate}" Style="{StaticResource ErpInput}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="شرح" Style="{StaticResource ErpFieldLabel}"/>
                        <TextBox Text="{Binding Description}" Style="{StaticResource ErpInput}"/>
                    </StackPanel>
                </Grid>

                <!-- جریان انبار مبدأ ← مقصد -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="انبار مبدأ" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                            <ComboBox ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding FromWarehouseId}" Margin="0,4,0,0" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1" Text="◄" FontSize="22" VerticalAlignment="Center" Margin="14,0"
                               Foreground="{DynamicResource PrimaryAccent}"/>
                    <Border Grid.Column="2" Background="{DynamicResource CardBackground}" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="انبار مقصد" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                            <ComboBox ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding ToWarehouseId}" Margin="0,4,0,0" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══ ردیف ورود (entry strip) ═══ -->
        <Border Grid.Row="1" Style="{StaticResource ErpEntryStrip}" Margin="0,8,0,0">
            <Grid Margin="8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="کالا (جستجو)" Style="{StaticResource ErpFieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Products}" DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedProduct}"
                              IsEditable="True"
                              Height="32"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="تعداد انتقال" Style="{StaticResource ErpFieldLabel}"/>
                    <TextBox Text="{Binding Quantity}" Height="32"/>
                </StackPanel>
                <Button Grid.Column="2" Content="افزودن ⏎" Style="{StaticResource ErpBtnPrimary}"
                        VerticalAlignment="Bottom" Height="32" Command="{Binding AddLineCommand}"/>
            </Grid>
        </Border>

        <!-- ═══ گرید اقلام ═══ -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Lines}" Style="{StaticResource ErpDataGrid}"
                  AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0"
                  HeadersVisibility="Column" GridLinesVisibility="All" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="44"/>
                <DataGridTextColumn Header="نام کالا" Binding="{Binding Display}" Width="*"/>
                <DataGridTextColumn Header="موجودی مبدأ" Binding="{Binding SourceStock, Converter={StaticResource Num}}" Width="110"/>
                <DataGridTextColumn Header="تعداد انتقال" Binding="{Binding Qty, Converter={StaticResource Num}}" Width="120"/>
                <DataGridTextColumn Header="مانده پس از انتقال" Binding="{Binding RemainingAfter, Converter={StaticResource Num}}" Width="130">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsShortage}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="حذف" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✕" FontSize="13" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="{DynamicResource DangerColor}"
                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══ نوار جمع + ثبت ═══ -->
        <Border Grid.Row="3" Style="{StaticResource ErpSumBarOk}" Margin="0,8,0,0">
            <DockPanel Margin="12,8">
                <Button DockPanel.Dock="Left" Content="✓ ثبت انتقال" Style="{StaticResource ErpBtnPrimary}"
                        Height="34" Command="{Binding TransferCommand}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="اقلام:" Foreground="{DynamicResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LineCount}" FontWeight="Bold" Margin="4,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock Text="تعداد کل:" Foreground="{DynamicResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalQty, Converter={StaticResource Num}}" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
