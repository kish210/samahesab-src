<UserControl x:Class="SamaHesab.WPF.Views.HRM.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource FormSectionCard}" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <Border Width="40" Height="40" CornerRadius="8" Background="#DCE2EE">
                        <materialDesign:PackIcon Kind="CalendarCheckOutline" Width="22" Height="22"
                                                 Foreground="{DynamicResource PrimaryAccent}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="حضور و غیاب" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedDate, StringFormat=تاریخ: {0}}" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                </StackPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Command="{Binding LoadRecordsCommand}">
                    <StackPanel><materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="بروزرسانی" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- summary cards -->
        <UniformGrid Grid.Row="1" Columns="3">
            <Border Style="{StaticResource FormSectionCard}">
                <StackPanel><TextBlock Text="حاضر" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                    <TextBlock Text="{Binding PresentCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}"/></StackPanel>
            </Border>
            <Border Style="{StaticResource FormSectionCard}">
                <StackPanel><TextBlock Text="غایب" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                    <TextBlock Text="{Binding AbsentCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource DangerColor}"/></StackPanel>
            </Border>
            <Border Style="{StaticResource FormSectionCard}">
                <StackPanel><TextBlock Text="مرخصی" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                    <TextBlock Text="{Binding LeaveCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource WarningColor}"/></StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource FormSectionCard}" Padding="0">
            <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Records}"
                                
                                 FontFamily="{StaticResource VazirFont}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کارمند" Binding="{Binding EmployeeName}" Width="*"/>
                    <DataGridTextColumn Header="ورود" Binding="{Binding CheckIn}" Width="100"/>
                    <DataGridTextColumn Header="خروج" Binding="{Binding CheckOut}" Width="100"/>
                    <DataGridTextColumn Header="ساعت کارکرد" Binding="{Binding WorkHours, StringFormat={}{0:0.##}}" Width="120"/>
                    <DataGridTextColumn Header="اضافه‌کاری" Binding="{Binding OvertimeHours, StringFormat={}{0:0.##}}" Width="110"/>
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
