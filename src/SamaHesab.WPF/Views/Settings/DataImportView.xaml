<UserControl x:Class="SamaHesab.WPF.Views.Settings.DataImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft"
             Background="{StaticResource ErpAppBg}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <StackPanel Grid.Row="0" Margin="2,0,2,8">
            <TextBlock Text="ورودِ داده از اکسل" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}"/>
            <TextBlock Text="مهاجرتِ مشتری/تأمین‌کننده از سیستمِ قبلی. سطرِ اولِ فایل باید سرستون باشد."
                       FontSize="12" Foreground="{StaticResource ErpTextMuted}" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- نوار انتخاب -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="نرم‌افزارِ مبدأ:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="170" Height="30" ItemsSource="{Binding SourceApps}" SelectedItem="{Binding SelectedSourceApp}"/>
                    <TextBlock Text="نوعِ داده:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox Width="150" Height="30" ItemsSource="{Binding EntityTypes}" SelectedItem="{Binding SelectedEntityType}"/>
                    <Button Style="{StaticResource ErpBtnGhost}" Height="30" Padding="12,0" Margin="10,0,0,0" Content="📥 دانلودِ نمونهٔ اکسل" Command="{Binding DownloadTemplateCommand}"/>
                    <Button Style="{StaticResource ErpBtnPrimary}" Height="30" Padding="14,0" Margin="6,0,0,0" Content="📂 انتخابِ فایلِ اکسل…" Click="Browse_Click"/>
                    <TextBlock Text="{Binding FilePath}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource ErpTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                </StackPanel>
                <!-- راهنمای مهاجرتِ نرم‌افزارِ مبدأ -->
                <Border Background="{StaticResource ErpBlue50}" CornerRadius="5" Padding="8,6" Margin="0,8,0,0">
                    <TextBlock Text="{Binding SourceHint}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource ErpBlue700}"/>
                </Border>
                <TextBlock Text="{Binding ColumnHelp}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource ErpTextMuted}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- پیش‌نمایش -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="0,0,0,6">
                    <Run Text="پیش‌نمایش — تعداد سطر: "/><Run Text="{Binding RowCount}" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}"/>
                </TextBlock>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             FontFamily="Consolas" FontSize="11.5" FlowDirection="LeftToRight" TextWrapping="NoWrap"/>
                </ScrollViewer>
                <Border Grid.Row="2" CornerRadius="4" Padding="8,6" Margin="0,8,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#E8F5E9"/><!-- موفق: سبزِ کم‌رنگ -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                    <Setter Property="Background" Value="#FDECEA"/><!-- خطا/هشدار: قرمزِ کم‌رنگ -->
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- دکمه -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
            <Button Style="{StaticResource ErpBtnPrimary}" Height="36" Padding="22,0" FontWeight="Bold"
                    Content="⬇ ورودِ داده" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}"/>
        </StackPanel>
    </Grid>
</UserControl>
