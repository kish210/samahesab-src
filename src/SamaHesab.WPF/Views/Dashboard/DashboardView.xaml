<UserControl x:Class="SamaHesab.WPF.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <!-- جعبه‌ی بخش (gbox) -->
        <Style x:Key="GBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="GHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Margin" Value="12,9"/>
        </Style>

        <!-- کارت KPI فشرده -->
        <Style x:Key="MiniKpi" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="12,9"/>
        </Style>

        <!-- تایل راه‌انداز فشرده -->
        <Style x:Key="LBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Command" Value="{Binding NavigateToCommand}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource SurfaceBackground}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="9" Padding="12">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource PrimaryAccentLight}" Margin="0,0,10,0">
                                    <TextBlock Text="{TemplateBinding Tag}" FontSize="17" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <ContentPresenter/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryAccent}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryAccentLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- تولبار: میز کار + سلام + اکشن -->
            <RowDefinition Height="Auto"/>   <!-- mini-kpi -->
            <RowDefinition Height="*"/>      <!-- ws: main + side -->
        </Grid.RowDefinitions>

        <!-- ═══ تولبار ═══ -->
        <DockPanel Grid.Row="0" Margin="4,0,4,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="میز کار" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Greeting}" FontSize="13" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TodayDateText}" FontSize="12" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="🔄 بازخوانی" Command="{Binding RefreshCommand}"
                        Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="14,7" Margin="4,0" Cursor="Hand"/>
                <Button Content="＋ سند جدید (F2)" Command="{Binding NavigateToCommand}" CommandParameter="VoucherEdit"
                        Background="{DynamicResource PrimaryAccent}" Foreground="White"
                        BorderThickness="0" Padding="16,7" Margin="4,0" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>

        <!-- ═══ mini-kpi (نوار فشرده) ═══ -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="4">
            <Border Style="{StaticResource MiniKpi}" Cursor="Hand" ToolTip="باز کردنِ فاکتورِ فروش">
                <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToCommand}" CommandParameter="SalesInvoice"/></Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="فروش امروز" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                    <TextBlock Text="{Binding TodaySales, Converter={StaticResource Num}, ConverterParameter=ریال}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MiniKpi}" Cursor="Hand" ToolTip="باز کردنِ دریافتنی/پرداختنی">
                <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToCommand}" CommandParameter="Receivables"/></Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="دریافتنی کل" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                    <TextBlock Text="{Binding Receivable, Converter={StaticResource Num}}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource DangerColor}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MiniKpi}" Cursor="Hand" ToolTip="باز کردنِ تابلوی چک">
                <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToCommand}" CommandParameter="ChequeBoard"/></Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="چک سررسید" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                    <TextBlock Text="{Binding ChequesDueCount, Converter={StaticResource Num}, ConverterParameter=فقره}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MiniKpi}" Cursor="Hand" ToolTip="باز کردنِ فهرستِ کالا">
                <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToCommand}" CommandParameter="Products"/></Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="کالای کم‌موجود" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                    <TextBlock Text="{Binding LowStockCount, Converter={StaticResource Num}, ConverterParameter=قلم}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource DangerColor}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ═══ ws: ستون اصلی (راست) + ستون کنار (چپ ۳۲۰) ═══ -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- ستون اصلی -->
            <Grid Grid.Column="0" Margin="0,0,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- دسترسی سریع -->
                <Border Grid.Row="0" Style="{StaticResource GBox}">
                    <StackPanel Margin="4,2,4,8">
                        <TextBlock Text="دسترسی سریع — عملیات روزانه" Style="{StaticResource GHead}"/>
                        <UniformGrid Columns="4">
                            <Button Style="{StaticResource LBtn}" CommandParameter="VoucherEdit" Tag="📄">
                                <StackPanel><TextBlock Text="ثبت سند" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Ctrl+1" FontSize="10.5" Foreground="{DynamicResource MutedText}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource LBtn}" CommandParameter="SalesInvoice" Tag="🛒">
                                <StackPanel><TextBlock Text="فاکتور فروش" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Ctrl+2" FontSize="10.5" Foreground="{DynamicResource MutedText}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource LBtn}" CommandParameter="PurchaseInvoice" Tag="🚚">
                                <StackPanel><TextBlock Text="فاکتور خرید" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Ctrl+3" FontSize="10.5" Foreground="{DynamicResource MutedText}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource LBtn}" CommandParameter="POS" Tag="🖥">
                                <StackPanel><TextBlock Text="صندوق فروش" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="F12" FontSize="10.5" Foreground="{DynamicResource MutedText}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource LBtn}" CommandParameter="StockTransfer" Tag="↹">
                                <StackPanel><TextBlock Text="انتقال انبار" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Ctrl+4" FontSize="10.5" Foreground="{DynamicResource MutedText}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource LBtn}" CommandParameter="ChequeBoard" Tag="🧾">
                                <StackPanel><TextBlock Text="تابلوی چک" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Ctrl+5" FontSize="10.5" Foreground="{DynamicResource MutedText}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource LBtn}" CommandParameter="Customers" Tag="👤">
                                <StackPanel><TextBlock Text="کارت مشتری" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Ctrl+6" FontSize="10.5" Foreground="{DynamicResource MutedText}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource LBtn}" CommandParameter="Reports" Tag="📊">
                                <StackPanel><TextBlock Text="گزارش‌ها" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Ctrl+R" FontSize="10.5" Foreground="{DynamicResource MutedText}"/></StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- اسناد اخیر من -->
                <Border Grid.Row="1" Style="{StaticResource GBox}" Margin="0,8,0,0">
                    <DockPanel Margin="2">
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Right" Text="اسناد اخیر من" Style="{StaticResource GHead}"/>
                            <Button DockPanel.Dock="Left" Content="همه اسناد ↗" Margin="12,9" FontSize="11.5"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Vouchers"
                                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryAccent}" Cursor="Hand"/>
                        </DockPanel>
                      <Grid>
                        <DataGrid ItemsSource="{Binding RecentInvoices}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="All" RowHeight="30" FontSize="12.5"
                                  Background="Transparent" BorderThickness="0" CanUserAddRows="False"
                                  Foreground="{DynamicResource PrimaryText}" Margin="6,0,6,6">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="شماره" Binding="{Binding Number}" Width="80"/>
                                <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="110"/>
                                <DataGridTextColumn Header="شرح/مشتری" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, Converter={StaticResource Num}}" Width="130"/>
                                <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- حالتِ خالیِ بامعنا -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding RecentInvoices.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="📄" FontSize="22" HorizontalAlignment="Center" Opacity="0.5"/>
                            <TextBlock Text="هنوز سند/فاکتوری ثبت نشده است." FontSize="12" Foreground="{DynamicResource MutedText}" Margin="0,4,0,0"/>
                            <Button Content="＋ ثبت سند جدید (F2)" Command="{Binding NavigateToCommand}" CommandParameter="VoucherEdit"
                                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryAccent}" Cursor="Hand"
                                    FontSize="11.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                      </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ستون کنار -->
            <Grid Grid.Column="1" Margin="5,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- کارهای امروز -->
                <Border Grid.Row="0" Style="{StaticResource GBox}">
                    <DockPanel Margin="2,2,2,8">
                        <TextBlock DockPanel.Dock="Top" Text="کارهای امروز" Style="{StaticResource GHead}"/>
                        <TextBlock DockPanel.Dock="Bottom" Text="✓ کارِ معوقی نیست — همه‌چیز مرتب است." FontSize="12"
                                   Foreground="{DynamicResource SuccessColor}" Margin="12,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Alerts.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Alerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="12,6">
                                        <Button DockPanel.Dock="Left" Content="برو ↗" FontSize="11"
                                                Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding ActionPage}"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource PrimaryAccent}" Cursor="Hand" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Icon}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- سررسید چک‌های نزدیک -->
                <Border Grid.Row="1" Style="{StaticResource GBox}" Margin="0,8,0,0">
                    <DockPanel Margin="2,2,2,6">
                        <TextBlock DockPanel.Dock="Top" Text="سررسید چک‌های نزدیک" Style="{StaticResource GHead}"/>
                        <TextBlock DockPanel.Dock="Bottom" Text="چکی در سررسیدِ نزدیک نیست." FontSize="12"
                                   Foreground="{DynamicResource MutedText}" Margin="12,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding ChequesDue.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ChequesDue}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="12,7">
                                            <StackPanel DockPanel.Dock="Left" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Amount, Converter={StaticResource Num}}" FontSize="12"
                                                           FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" TextAlignment="Left"/>
                                                <TextBlock Text="{Binding DueDate}" FontSize="11" Foreground="{DynamicResource WarningColor}" TextAlignment="Left"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding BankName}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource PrimaryText}"/>
                                                <TextBlock Text="{Binding ChequeNumber}" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
