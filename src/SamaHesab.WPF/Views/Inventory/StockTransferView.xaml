<UserControl x:Class="SamaHesab.WPF.Views.Inventory.StockTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ErpToolbar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="SwapHorizontal" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/>
                <TextBlock Text="انتقال بین انبارها" Style="{StaticResource ErpSectionTitle}" Margin="8,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}" VerticalAlignment="Top" Margin="3" Padding="16">
            <StackPanel MaxWidth="560" HorizontalAlignment="Right">
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="از انبار (مبدأ)" Style="{StaticResource FieldCaption}"/>
                        <ComboBox Style="{StaticResource BaseComboBox}" ItemsSource="{Binding Warehouses}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding FromWarehouseId}"/>
                    </StackPanel>
                    <materialDesign:PackIcon Grid.Column="1" Kind="ArrowLeftBold" Width="22" Height="22"
                                             VerticalAlignment="Bottom" Margin="0,0,0,8" HorizontalAlignment="Center"
                                             Foreground="{DynamicResource PrimaryAccent}"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="به انبار (مقصد)" Style="{StaticResource FieldCaption}"/>
                        <ComboBox Style="{StaticResource BaseComboBox}" ItemsSource="{Binding Warehouses}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ToWarehouseId}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,4">
                    <TextBlock Text="کالا" Style="{StaticResource FieldCaption}"/>
                    <telerik:RadComboBox ItemsSource="{Binding Products}" DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedProduct}" TextSearchMode="Contains"
                              IsEditable="True" IsFilteringEnabled="True" CanAutocompleteSelectItems="True"
                              OpenDropDownOnFocus="True" EmptyText="جستجوی کالا..." Height="34"/>
                </StackPanel>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="مقدار" Style="{StaticResource FieldCaption}"/>
                        <telerik:RadMaskedNumericInput Value="{Binding Quantity}" Mask="n2" Height="34"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="تاریخ" Style="{StaticResource FieldCaption}"/>
                        <TextBox Text="{Binding TransferDate}" Height="34"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,4">
                    <TextBlock Text="توضیحات" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding Description}"/>
                </StackPanel>

                <Button Style="{StaticResource PrimaryButton}" Height="40" Margin="0,12,0,0" Command="{Binding TransferCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="SwapHorizontalBold" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="ثبت انتقال" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
