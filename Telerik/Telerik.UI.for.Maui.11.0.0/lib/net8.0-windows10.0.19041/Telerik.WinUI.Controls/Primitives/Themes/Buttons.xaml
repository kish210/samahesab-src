                            <Setter Target="PART_Button.Foreground" Value="{ThemeResource TelerikButton_ForegroundDisabled}"/>
                            <Setter Target="PART_DropDownButton.Foreground" Value="{ThemeResource TelerikButton_ForegroundDisabled}"/>
                            <Setter Target="PART_Button.Background" Value="{ThemeResource TelerikButton_BackgroundDisabled}"/>
