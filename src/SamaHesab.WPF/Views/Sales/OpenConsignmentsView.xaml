<UserControl x:Class="SamaHesab.WPF.Views.Sales.OpenConsignmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <conv:IntEqualsVisibilityConverter x:Key="IntEqVis"/>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource FormSectionCard}" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="کنسینمنت‌هایِ بازِ تسویه‌نشده" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="🔄 بازخوانی (F5)" Style="{StaticResource SecondaryButton}" Height="32" Margin="16,0,0,0"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}" Padding="0" Margin="0,8,0,0">
            <Grid>
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                          Background="Transparent" RowBackground="Transparent" BorderThickness="0" FontSize="12.5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="شمارهٔ فاکتور" Binding="{Binding Number}" Width="Auto"/>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="110"/>
                        <DataGridTextColumn Header="کنسینی (مشتری)" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="مبلغِ کل" Binding="{Binding GrandTotal, Converter={StaticResource Num}}" Width="Auto"/>
                        <DataGridTextColumn Header="مانده" Binding="{Binding RemainAmount, Converter={StaticResource Num}}" Width="Auto"/>
                        <DataGridTemplateColumn Header="عملیات" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="تسویه" Style="{StaticResource PrimaryButton}" Height="26" Padding="10,0"
                                            Command="{Binding DataContext.SettleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="هیچ کنسینمنتِ بازی برایِ تسویه نیست."
                           Visibility="{Binding Rows.Count, Converter={StaticResource IntEqVis}, ConverterParameter=0}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" FontSize="13"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
