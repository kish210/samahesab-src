<UserControl x:Class="SamaHesab.WPF.Views.Treasury.ReceivablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="ActBtn" TargetType="Button">
            <Setter Property="Margin" Value="2,0"/><Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- دریافتنی‌ها (بدهکاران) -->
        <Border Grid.Column="0" Margin="0,0,4,0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="2,0,2,8">
                    <DockPanel>
                        <TextBlock Text="دریافتنی‌ها (بدهکاران)" FontSize="16" FontWeight="Bold" Foreground="#2E7D52"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding TotalReceivable, StringFormat='جمع: {0:#,##0}'}" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock Text="Enter: وصولِ کامل · Ctrl+Enter: مبلغ · F5: بروزرسانی" FontSize="11" Foreground="{DynamicResource MutedText}" Margin="0,2,0,0"/>
                </StackPanel>
                <DataGrid Grid.Row="1" x:Name="RecvGrid" ItemsSource="{Binding Receivables}" AutoGenerateColumns="False"
                          SelectedItem="{Binding SelectedReceivable, Mode=TwoWay}" SelectionMode="Single" SelectionUnit="FullRow"
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          RowHeight="29" FontSize="12.5" CanUserDeleteRows="False" PreviewKeyDown="Grid_PreviewKeyDown"
                          Background="Transparent" RowBackground="Transparent" BorderThickness="0" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="مشتری" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="مانده" Binding="{Binding Balance, StringFormat='{}{0:#,##0}'}" Width="Auto"/>
                        <DataGridTemplateColumn Header="عملیات" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="وصول کامل" Style="{StaticResource ActBtn}" Background="#2E7D52"
                                                Command="{Binding DataContext.ReceiveFullCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="مبلغ…" Style="{StaticResource ActBtn}" Background="#4B5F97"
                                                Command="{Binding DataContext.ReceiveCustomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- پرداختنی‌ها (بستانکاران) -->
        <Border Grid.Column="1" Margin="4,0,0,0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="2,0,2,8">
                    <DockPanel>
                        <TextBlock Text="پرداختنی‌ها (بستانکاران)" FontSize="16" FontWeight="Bold" Foreground="#C2403A"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding TotalPayable, StringFormat='جمع: {0:#,##0}'}" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock Text="Enter: پرداختِ کامل · Ctrl+Enter: مبلغ · F5: بروزرسانی" FontSize="11" Foreground="{DynamicResource MutedText}" Margin="0,2,0,0"/>
                </StackPanel>
                <DataGrid Grid.Row="1" x:Name="PayGrid" ItemsSource="{Binding Payables}" AutoGenerateColumns="False"
                          SelectedItem="{Binding SelectedPayable, Mode=TwoWay}" SelectionMode="Single" SelectionUnit="FullRow"
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          RowHeight="29" FontSize="12.5" CanUserDeleteRows="False" PreviewKeyDown="Grid_PreviewKeyDown"
                          Background="Transparent" RowBackground="Transparent" BorderThickness="0" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تأمین‌کننده" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="مانده" Binding="{Binding Balance, StringFormat='{}{0:#,##0}'}" Width="Auto"/>
                        <DataGridTemplateColumn Header="عملیات" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="پرداخت کامل" Style="{StaticResource ActBtn}" Background="#C2403A"
                                                Command="{Binding DataContext.PayFullCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="مبلغ…" Style="{StaticResource ActBtn}" Background="#4B5F97"
                                                Command="{Binding DataContext.PayCustomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
