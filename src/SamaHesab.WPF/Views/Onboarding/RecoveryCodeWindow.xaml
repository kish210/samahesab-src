<Window x:Class="SamaHesab.WPF.Views.Onboarding.RecoveryCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="کدِ بازیابیِ رمزِ عبور"
        Height="460" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        Background="#161C2A">

    <Border CornerRadius="16" Background="#161C2A" BorderBrush="#1E3A5F" BorderThickness="1" Padding="28">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="🔑 کدِ بازیابیِ رمزِ عبور" FontSize="18" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="اگر روزی رمزِ عبورتان را فراموش کنید، فقط با همین کد می‌توانید رمزِ جدید تعیین کنید — این برنامه آفلاین است و ایمیل/پیامکِ بازیابی ندارد. این کد فقط همین یک‌بار نشان داده می‌شود؛ آن را جایی امن (کاغذ، مدیرِ رمز) نگه دارید."
                       Foreground="#94A3B8" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>

            <Border Background="#1B2843" BorderBrush="#283A60" BorderThickness="1" CornerRadius="10"
                    Padding="16" Margin="0,20,0,0">
                <TextBlock x:Name="CodeText" Text="XXXX-XXXX-XXXX-XXXX" FontSize="20" FontWeight="Bold"
                           Foreground="#7DD3FC" HorizontalAlignment="Center" FlowDirection="LeftToRight"
                           FontFamily="Consolas"/>
            </Border>

            <Button x:Name="BtnCopy" Content="📋  کپی در کلیپ‌بورد" Height="38" FontSize="13" Margin="0,12,0,0"
                    Background="Transparent" Foreground="#BAC5DD" BorderBrush="#283A60" BorderThickness="1"
                    Cursor="Hand" Click="BtnCopy_Click"/>

            <CheckBox x:Name="ChkSaved" Content="این کد را در جایی امن ذخیره کردم" Foreground="#DCE2EE"
                      FontSize="13" Margin="4,22,0,0" Checked="ChkSaved_Changed" Unchecked="ChkSaved_Changed"/>

            <Button x:Name="BtnContinue" Content="ادامه" Height="46" FontSize="14" FontWeight="SemiBold"
                    Margin="0,16,0,0" Foreground="White" Cursor="Hand" IsEnabled="False" Click="BtnContinue_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="#324A7A">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4B5F97"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
