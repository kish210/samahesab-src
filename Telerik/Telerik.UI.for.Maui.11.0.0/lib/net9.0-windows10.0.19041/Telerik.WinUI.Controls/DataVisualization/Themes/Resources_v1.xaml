                        <Grid>
                            <local:StackedBarItemsControl
                                BarHeightPercent="{TemplateBinding BarHeightPercent}"
                                BarBrushes="{TemplateBinding BarBrushes}"
                                BarBorderBrushes="{TemplateBinding BarBorderBrushes}"
