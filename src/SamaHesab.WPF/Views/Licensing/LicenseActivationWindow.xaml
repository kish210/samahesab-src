<Window x:Class="SamaHesab.WPF.Views.Licensing.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فعال‌سازیِ سما حساب"
        Height="520" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource VazirFont}"
        Background="{DynamicResource AppBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="فعال‌سازیِ نرم‌افزار" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}"/>
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryText}"/>
        </StackPanel>

        <!-- شناسهٔ دستگاه -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="۱) شناسهٔ این دستگاه را برای فروشنده بفرستید:" FontSize="12.5" FontWeight="SemiBold"/>
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Left" Content="📋 کپی" Height="30" Padding="12,0" Command="{Binding CopyFingerprintCommand}"/>
                    <TextBox Text="{Binding Fingerprint, Mode=OneWay}" IsReadOnly="True" Height="30"
                             VerticalContentAlignment="Center" FontFamily="Consolas" FlowDirection="LeftToRight" Margin="0,0,8,0"/>
                </DockPanel>
                <TextBlock Text="(به‌همراهِ نام و شناسهٔ ملیِ شرکت ارسال کنید تا فایلِ لایسنس برایتان صادر شود.)"
                           FontSize="11" Foreground="{DynamicResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- بارگذاری فایل -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="12">
            <StackPanel>
                <TextBlock Text="۲) یکی از دو راهِ فعال‌سازی را انتخاب کنید:" FontSize="12.5" FontWeight="SemiBold"/>

                <!-- آنلاین: فعال‌سازی از طریقِ سایتِ پشتیبانی -->
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Left" Content="🌐 فعال‌سازی از طریقِ سایت" Height="34" Padding="16,0"
                            Command="{Binding ActivateOnlineCommand}"/>
                    <TextBlock Text="(نیازمندِ اینترنت و آدرسِ سرورِ پشتیبانی در تنظیمات؛ کلید و انقضا خودکار دریافت می‌شود.)"
                               FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </DockPanel>

                <!-- آفلاین: بارگذاریِ فایلِ امضاشده -->
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Left" Content="📂 فعال‌سازیِ آفلاین (فایلِ .lic)…" Height="34" Padding="16,0"
                            Click="LoadLicense_Click"/>
                    <TextBlock Text="(فایلِ لایسنسِ دریافتی از پشتیبانی را بارگذاری کنید — بدونِ نیاز به اینترنت.)"
                               FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- وضعیتِ فعال -->
        <Border Grid.Row="3" VerticalAlignment="Top" Margin="0,12,0,0" CornerRadius="8" Padding="12"
                Background="#E8F5E9" Visibility="{Binding IsActivated, Converter={StaticResource BoolVis}}">
            <TextBlock Text="✔ این نرم‌افزار فعال است." FontWeight="Bold" Foreground="#2E7D52"/>
        </Border>

        <!-- دکمه -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="ادامه / ورود به برنامه" Height="38" Padding="22,0" FontWeight="Bold"
                    Background="#2E7D52" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Command="{Binding ContinueCommand}" IsEnabled="{Binding CanContinue}"/>
        </StackPanel>
    </Grid>
</Window>
