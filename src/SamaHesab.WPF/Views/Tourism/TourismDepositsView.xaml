<UserControl x:Class="SamaHesab.WPF.Views.Tourism.TourismDepositsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ودیعهٔ تأمین‌کنندگان (گردشگری)" FontSize="18" FontWeight="Bold" Margin="2,0,0,8"/>

        <!-- فرمِ شارژِ ودیعه -->
        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}" Padding="10">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="تأمین‌کننده" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    <ComboBox Width="200" Height="32" ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedSupplierId}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="مبلغِ شارژ (ریال)" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBox Width="150" Height="32" Text="{Binding Amount}" FlowDirection="LeftToRight"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="روشِ پرداخت" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    <ComboBox Width="100" Height="32" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="سالِ مالی" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    <ComboBox Width="140" Height="32" ItemsSource="{Binding FiscalYears}" DisplayMemberPath="Title"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedFiscalYearId}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="تاریخ" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBox Width="110" Height="32" Text="{Binding Date}" FlowDirection="LeftToRight"/>
                </StackPanel>
                <Button Content="💰 ثبتِ شارژ" Style="{StaticResource PrimaryButton}" Height="32" VerticalAlignment="Bottom"
                        Command="{Binding TopUpCommand}"/>
            </WrapPanel>
        </Border>

        <!-- جدولِ مانده -->
        <Border Grid.Row="2" Style="{StaticResource FormSectionCard}" Padding="0" Margin="0,8,0,0">
            <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      ItemsSource="{Binding Balances}" RowHeight="{DynamicResource ErpDensRowHeight}" FontFamily="{StaticResource VazirFont}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="تأمین‌کننده" Binding="{Binding SupplierName}" Width="*"/>
                    <DataGridTextColumn Header="جمعِ شارژ" Binding="{Binding ToppedUp, Converter={StaticResource Num}}" Width="140" ElementStyle="{StaticResource NumCell}"/>
                    <DataGridTextColumn Header="برداشت" Binding="{Binding Drawn, Converter={StaticResource Num}}" Width="140" ElementStyle="{StaticResource NumCell}"/>
                    <DataGridTextColumn Header="مانده" Binding="{Binding Remaining, Converter={StaticResource Num}}" Width="150" ElementStyle="{StaticResource NumCell}"/>
                    <DataGridTemplateColumn Header="وضعیت" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="⚠ کم" Foreground="{DynamicResource DangerColor}" FontWeight="Bold"
                                           Visibility="{Binding IsLow, Converter={StaticResource BoolVis}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- نوارِ پایین -->
        <DockPanel Grid.Row="3" Margin="2,8,2,0">
            <CheckBox DockPanel.Dock="Right" Content="فقط ودیعهٔ کم" IsChecked="{Binding OnlyLow}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="جمعِ ماندهٔ ودیعه: " Foreground="{DynamicResource SecondaryText}"/>
                <TextBlock Text="{Binding TotalRemaining, Converter={StaticResource Num}}" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" FlowDirection="LeftToRight"/>
                <TextBlock Text=" ریال" Foreground="{DynamicResource SecondaryText}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
