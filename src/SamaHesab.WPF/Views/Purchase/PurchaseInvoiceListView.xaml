<UserControl x:Class="SamaHesab.WPF.Views.Purchase.PurchaseInvoiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NewInvoiceCommand}"/>
    </UserControl.InputBindings>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource FormSectionCard}" Padding="5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <Border Width="28" Height="28" CornerRadius="6" Background="#DCE2EE">
                        <Path Data="{StaticResource IcLines}" Style="{StaticResource ErpToolSvg}" Width="17" Height="17"
                              Stroke="{DynamicResource PrimaryAccent}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="لیست فاکتورهای خرید" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding NewInvoiceCommand}">
                        <StackPanel><Path Data="{StaticResource IcPlusBox}" Style="{StaticResource ErpToolSvg}" Width="22" Height="22" HorizontalAlignment="Center" Stroke="{DynamicResource PrimaryAccent}"/><TextBlock Text="خرید جدید" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding SearchCommand}">
                        <StackPanel><Path Data="{StaticResource IcRefresh}" Style="{StaticResource ErpToolSvg}" Width="22" Height="22" HorizontalAlignment="Center" Stroke="{DynamicResource SecondaryText}"/><TextBlock Text="بازخوانی" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding PrintCommand}">
                        <StackPanel><Path Data="{StaticResource IcPrinter}" Style="{StaticResource ErpToolSvg}" Width="22" Height="22" HorizontalAlignment="Center" Stroke="{DynamicResource SecondaryText}"/><TextBlock Text="چاپ" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ExportExcelCommand}">
                        <StackPanel><Path Data="{StaticResource IcExcel}" Style="{StaticResource ErpToolSvg}" Width="22" Height="22" HorizontalAlignment="Center" Stroke="{DynamicResource SuccessColor}"/><TextBlock Text="خروجی اکسل" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- UX-CORE-AUDIT — نوارِ فیلترِ بازهٔ تاریخ: قبلاً VM (FromDate/ToDate) بدونِ هیچ UIِ متناظر بود. -->
        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}" Padding="8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="4,0" Width="120">
                    <TextBlock Text="از تاریخ" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Margin="4,0" Width="120">
                    <TextBlock Text="تا تاریخ" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding SearchCommand}" Margin="8,14,0,0" VerticalAlignment="Top">
                    <StackPanel><Path Data="{StaticResource IcSearch}" Style="{StaticResource ErpToolSvg}" Width="20" Height="20" HorizontalAlignment="Center" Stroke="{DynamicResource PrimaryAccent}"/><TextBlock Text="اعمالِ فیلتر" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FormSectionCard}" Padding="0">
            <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Invoices}"
                                 SelectedItem="{Binding SelectedInvoice}"
                                 FontFamily="{StaticResource VazirFont}">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenInvoiceCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="👁 مشاهدهٔ فاکتور"
                                  Command="{Binding PlacementTarget.DataContext.OpenInvoiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="شماره" Binding="{Binding Number}" Width="110"/>
                    <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="110"/>
                    <DataGridTextColumn Header="تأمین‌کننده" Binding="{Binding SupplierName}" Width="*"/>
                    <DataGridTextColumn Header="مبلغ کل" Binding="{Binding Total, StringFormat={}{0:#,##0}}" Width="140"/>
                    <DataGridTextColumn Header="پرداختی" Binding="{Binding Paid, StringFormat={}{0:#,##0}}" Width="130"/>
                    <DataGridTextColumn Header="مانده" Binding="{Binding Remain, StringFormat={}{0:#,##0}}" Width="130"/>
                    <DataGridTemplateColumn Header="وضعیت" Width="100" CellTemplate="{StaticResource ErpStatusChipTemplate}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource FormSectionCard}" Padding="12,8">
            <TextBlock FontSize="12" HorizontalAlignment="Right">
                <Run Text="تعداد فاکتور:"/><Run Text="{Binding TotalCount}" FontWeight="Bold"/>
                <Run Text="   |   جمع مبلغ:"/><Run Text="{Binding TotalAmount, StringFormat={}{0:#,##0}}" FontWeight="Bold"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
