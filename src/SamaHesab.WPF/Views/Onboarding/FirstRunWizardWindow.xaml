<Window x:Class="SamaHesab.WPF.Views.Onboarding.FirstRunWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
        Title="راه‌اندازیِ اولیه — سما حساب"
        Height="660" Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource VazirFont}"
        Background="{DynamicResource AppBackground}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:IntEqualsVisibilityConverter x:Key="StepVis"/>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
            <Setter Property="Margin" Value="2,8,0,3"/>
        </Style>
        <Style x:Key="Sec" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryAccent}"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- سربرگ + نوارِ مرحله -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="به سما حساب خوش آمدید 👋" FontSize="19" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryAccent}"/>
            <TextBlock Text="{Binding StepTitle}" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryText}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- بدنه: ۵ مرحله، فقط مرحلهٔ جاری دیده می‌شود -->
        <Grid Grid.Row="1">

            <!-- گام ۱: اطلاعاتِ شرکت و صنف -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=0}">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="اطلاعاتِ شرکت" Style="{StaticResource Sec}"/>
                    <TextBlock Text="نامِ شرکت *" Style="{StaticResource Cap}"/>
                    <TextBox Height="32" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="تلفن" Style="{StaticResource Cap}"/>
                            <TextBox Height="32" Text="{Binding CompanyPhone}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="شناسهٔ ملی" Style="{StaticResource Cap}"/>
                            <TextBox Height="32" Text="{Binding CompanyNationalId}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="صنف / شغلِ کسب‌وکار" Style="{StaticResource Cap}"/>
                    <ComboBox Height="32" IsEditable="True" ItemsSource="{Binding BusinessTypes}" Text="{Binding BusinessType}"/>
                    <TextBlock Text="(برای پیش‌پُرِ کالاهای نمونهٔ متناسب در گامِ دادهٔ پایه استفاده می‌شود)"
                               FontSize="10.5" Foreground="{DynamicResource MutedText}" Margin="2,2,0,0"/>
                    <TextBlock Text="کدِ اقتصادی" Style="{StaticResource Cap}"/>
                    <TextBox Height="32" Text="{Binding CompanyEconomicCode}"/>
                    <TextBlock Text="نشانی" Style="{StaticResource Cap}"/>
                    <TextBox Height="46" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding CompanyAddress}"/>
                    <TextBlock Text="لوگو" Style="{StaticResource Cap}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="انتخابِ لوگو…" Height="30" Padding="12,0" Click="Logo_Click"/>
                        <TextBox Height="30" IsReadOnly="True" Text="{Binding LogoPath}" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- گام ۲: ماژول‌ها -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=1}">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="ماژول‌های موردِ استفاده" Style="{StaticResource Sec}"/>
                    <TextBlock Text="فقط ماژول‌هایی را که استفاده می‌کنید روشن کنید؛ بقیه از منو پنهان می‌مانند. بعداً از «تنظیمات → مدیریت ماژول‌ها» قابلِ تغییر است." Style="{StaticResource Cap}"/>
                    <ItemsControl ItemsSource="{Binding Modules}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" FontSize="13"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- گام ۳: سالِ مالی -->
            <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=2}">
                <TextBlock Text="سالِ مالی" Style="{StaticResource Sec}"/>
                <TextBlock Text="عنوان" Style="{StaticResource Cap}"/>
                <TextBox Height="32" Text="{Binding FiscalTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="از تاریخ (۱۴۰۵/۰۱/۰۱)" Style="{StaticResource Cap}"/>
                        <TextBox Height="32" Text="{Binding FiscalStart}" FlowDirection="LeftToRight" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="تا تاریخ (۱۴۰۵/۱۲/۲۹)" Style="{StaticResource Cap}"/>
                        <TextBox Height="32" Text="{Binding FiscalEnd}" FlowDirection="LeftToRight" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- گام ۴: دادهٔ پایه + دموی متناسب -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=3}">
                <StackPanel Margin="0,0,8,0">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="دادهٔ پایه" Style="{StaticResource Sec}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Left" Content="✨ پیش‌پُر بر اساسِ صنف" Height="30" Padding="12,0" Cursor="Hand"
                                Command="{Binding ApplyBusinessPresetCommand}"
                                ToolTip="کالاهای نمونهٔ متناسب با صنفِ انتخاب‌شده را پر می‌کند"/>
                    </DockPanel>

                    <TextBlock Text="انبارها" Style="{StaticResource Cap}"/>
                    <DataGrid ItemsSource="{Binding Warehouses}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" MaxHeight="110" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نامِ انبار" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTemplateColumn Width="38">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Button Content="✕" Padding="4,0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                            Command="{Binding DataContext.RemoveWarehouseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="+ افزودنِ انبار" Command="{Binding AddWarehouseCommand}" HorizontalAlignment="Right" Margin="0,3,0,0" Padding="12,3" Cursor="Hand"/>

                    <TextBlock Text="کالاها و خدمات" Style="{StaticResource Cap}"/>
                    <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" MaxHeight="150" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کد" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="نام" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridCheckBoxColumn Header="خدمت؟" Binding="{Binding IsService, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            <DataGridTextColumn Header="فروش" Binding="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                            <DataGridTextColumn Header="خرید" Binding="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                            <DataGridTemplateColumn Width="38">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Button Content="✕" Padding="4,0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                            Command="{Binding DataContext.RemoveProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="+ افزودنِ کالا/خدمت" Command="{Binding AddProductCommand}" HorizontalAlignment="Right" Margin="0,3,0,0" Padding="12,3" Cursor="Hand"/>

                    <TextBlock Text="مشتری‌ها" Style="{StaticResource Cap}"/>
                    <DataGrid ItemsSource="{Binding Customers}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" MaxHeight="120" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridCheckBoxColumn Header="حقوقی؟" Binding="{Binding IsCompany, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            <DataGridTemplateColumn Width="38">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Button Content="✕" Padding="4,0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                            Command="{Binding DataContext.RemoveCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="+ افزودنِ مشتری" Command="{Binding AddCustomerCommand}" HorizontalAlignment="Right" Margin="0,3,0,0" Padding="12,3" Cursor="Hand"/>

                    <CheckBox IsChecked="{Binding LoadDemoData}" Margin="0,10,0,0"
                              Content="افزون بر این‌ها، داده‌های دموِ بیشتر هم وارد شود (فاکتور/سندِ نمونه)"/>
                </StackPanel>
            </ScrollViewer>

            <!-- گام ۵: رمزِ مدیر + اتمام -->
            <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=4}">
                <TextBlock Text="رمزِ عبورِ مدیر (admin)" Style="{StaticResource Sec}"/>
                <TextBlock Text="⚠ رمزِ پیش‌فرض admin123 است. برای امنیت، رمزِ تازه‌ای بگذارید (اختیاری)."
                           FontSize="11" Foreground="{DynamicResource WarningColor}" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="رمزِ جدید" Style="{StaticResource Cap}"/>
                        <PasswordBox x:Name="PwdNew" Height="32" PasswordChanged="PwdNew_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="تکرارِ رمز" Style="{StaticResource Cap}"/>
                        <PasswordBox x:Name="PwdConfirm" Height="32" PasswordChanged="PwdConfirm_Changed"/>
                    </StackPanel>
                </Grid>
                <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="خلاصهٔ راه‌اندازی" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding CompanyName, StringFormat='شرکت: {0}'}" Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding BusinessType, StringFormat='صنف: {0}'}" Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding FiscalTitle, StringFormat='سالِ مالی: {0}'}" Margin="0,1,0,0"/>
                        <TextBlock Text="با «اتمام و ورود»، تنظیماتِ شرکت، سالِ مالی، ماژول‌ها و دادهٔ پایه ثبت و واردِ برنامه می‌شوید."
                                   FontSize="11" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ناوبریِ مرحله -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="بعداً" Height="38" Padding="16,0" Cursor="Hand"
                    Command="{Binding SkipCommand}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="◀ قبلی" Height="38" Padding="16,0" Margin="0,0,8,0" Cursor="Hand"
                        Command="{Binding BackCommand}"
                        Visibility="{Binding IsFirstStep, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                <Button Content="بعدی ◀" Height="38" Padding="24,0" FontWeight="Bold" Cursor="Hand"
                        Background="{DynamicResource PrimaryAccent}" Foreground="White" BorderThickness="0"
                        Command="{Binding NextCommand}"
                        Visibility="{Binding IsLastStep, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                <Button Content="✔ اتمام و ورود" Height="38" Padding="20,0" FontWeight="Bold" Cursor="Hand"
                        Background="#2E7D52" Foreground="White" BorderThickness="0"
                        Command="{Binding FinishCommand}"
                        Visibility="{Binding IsLastStep, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
