<UserControl x:Class="SamaHesab.WPF.Views.HRM.EmployeeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ErpToolbar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ErpToolButton}" Command="{Binding AddNewCommand}">
                    <StackPanel><materialDesign:PackIcon Kind="AccountPlusOutline" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="کارمند جدید" TextAlignment="Center"/></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}" Margin="3" Padding="0">
            <telerik:RadGridView ItemsSource="{Binding Employees}" AutoGenerateColumns="False" RowIndicatorVisibility="Collapsed" RowHeight="28"
                                 ShowSearchPanel="True" IsReadOnly="True"
                                 ShowGroupPanel="True" ShowColumnFooters="True">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="کد" DataMemberBinding="{Binding Code}" Width="80"/>
                    <telerik:GridViewDataColumn Header="نام" DataMemberBinding="{Binding FirstName}" Width="*"/>
                    <telerik:GridViewDataColumn Header="نام خانوادگی" DataMemberBinding="{Binding LastName}" Width="*"/>
                    <telerik:GridViewDataColumn Header="کد ملی" DataMemberBinding="{Binding NationalCode}" Width="120"/>
                    <telerik:GridViewDataColumn Header="موبایل" DataMemberBinding="{Binding Mobile}" Width="120"/>
                    <telerik:GridViewDataColumn Header="نوع قرارداد" DataMemberBinding="{Binding ContractType}" Width="100"/>
                    <telerik:GridViewDataColumn Header="تاریخ استخدام" DataMemberBinding="{Binding HireDate}" Width="110"/>
                    <telerik:GridViewDataColumn Header="حقوق پایه" DataMemberBinding="{Binding BaseSalary}" DataFormatString="{}{0:#,##0}" Width="140">
                        <telerik:GridViewDataColumn.AggregateFunctions>
                            <telerik:SumFunction ResultFormatString="{}{0:#,##0}"/>
                        </telerik:GridViewDataColumn.AggregateFunctions>
                    </telerik:GridViewDataColumn>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ErpToolbar}" BorderThickness="0,1,0,0">
            <TextBlock FontSize="12" HorizontalAlignment="Right" Text="فهرست کارکنان فعال" Margin="4,2" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
