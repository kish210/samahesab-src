<UserControl x:Class="SamaHesab.WPF.Views.Support.FeatureRequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource VazirFont}" FlowDirection="RightToLeft"
             Background="{StaticResource ErpAppBg}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,8">
            <TextBlock Text="درخواستِ قابلیت" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}"/>
            <TextBlock Text="قابلیتی که می‌خواهید به سما حساب اضافه شود را پیشنهاد دهید."
                       FontSize="12" Foreground="{StaticResource ErpTextMuted}" Margin="0,3,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="عنوان *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="6,4"/>

                    <TextBlock Text="اولویت" FontWeight="SemiBold" Margin="0,10,0,3"/>
                    <ComboBox Width="200" HorizontalAlignment="Right" Height="32" ItemsSource="{Binding Priorities}"
                              SelectedItem="{Binding SelectedPriority}" DisplayMemberPath="Label"/>

                    <TextBlock Text="شرحِ قابلیت *" FontWeight="SemiBold" Margin="0,10,0,3"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="90"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6,4"/>

                    <TextBlock Text="فایدهٔ تجاری (این قابلیت چه مشکلی را حل می‌کند؟)" FontWeight="SemiBold" Margin="0,10,0,3"/>
                    <TextBox Text="{Binding BusinessBenefit, UpdateSourceTrigger=PropertyChanged}" Height="70"
                             TextWrapping="Wrap" AcceptsReturn="True" Padding="6,4"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="4" Padding="10,7" VerticalAlignment="Center"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#E8F5E9"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResultIsError}" Value="True"><Setter Property="Background" Value="#FDECEA"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" FontSize="12"/>
            </Border>
            <Button Grid.Column="1" Style="{StaticResource ErpBtnPrimary}" Height="36" Padding="22,0" Margin="8,0,0,0"
                    Content="📤 ثبتِ درخواست" Command="{Binding SubmitCommand}"/>
        </Grid>
    </Grid>
</UserControl>
