<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:telerik="using:Telerik.UI.Xaml.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/Primitives/Themes/ThemeColorsDark.xaml"/>
        <ResourceDictionary>
            <telerik:UserThemeResources x:Key="ResourceLoaderInitializer"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="{CustomResource DarkResourcesPath}"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>

    <!-- Axis -->
    <SolidColorBrush x:Key="TelerikChart_AxisBorderBrush" Color="{ThemeResource ControlStrongStrokeColorDefault}" />
    <SolidColorBrush x:Key="TelerikChart_AxisLabelsForeground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikChart_AxisTitleForeground" Color="{ThemeResource TextFillColorPrimary}"/>

    <!-- Grid -->
    <SolidColorBrush x:Key="TelerikChart_GridLineBorderBrush" Color="{ThemeResource ControlStrongStrokeColorDefault}" />
    <SolidColorBrush x:Key="TelerikChart_StripeBackground" Color="{ThemeResource SolidBackgroundFillColorBase}" />

    <!-- Annotations -->
    <SolidColorBrush x:Key="TelerikChart_GridLineAnnotationBorderBrush" Color="{ThemeResource ControlStrongStrokeColorDefault}" />
    <SolidColorBrush x:Key="TelerikChart_PlotBandAnnotationBackground" Color="{ThemeResource SubtleFillColorSecondary}" />
    <SolidColorBrush x:Key="TelerikChart_MarkedZoneAnnotationBackground" Color="{ThemeResource SubtleFillColorSecondary}" />

    <!-- TrackBall -->
    <SolidColorBrush x:Key="TelerikChart_TrackBallInfoForeground" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TelerikChart_TrackBallInfoBackground" Color="{ThemeResource SolidBackgroundFillColorTertiary}" />
    <SolidColorBrush x:Key="TelerikChart_TrackBallInfoBorderBrush" Color="{ThemeResource ControlStrongStrokeColorDefault}" />
    <SolidColorBrush x:Key="TelerikChart_TrackBallLineBorderBrush" Color="{ThemeResource ControlStrongStrokeColorDefault}" />

    <SolidColorBrush x:Key="TelerikChart_ToolTipForeground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikChart_ToolTipBackground" Color="{ThemeResource SolidBackgroundFillColorTertiary}"/>

    <SolidColorBrush x:Key="TelerikChart_PolarChartGridStripeBrush" Color="{ThemeResource ControlAltFillColorTertiary}"/>
</ResourceDictionary>

