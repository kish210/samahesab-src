<UserControl x:Class="SamaHesab.WPF.Views.Contracting.ServiceContractListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- تعریفِ قراردادِ جدید — UX-CORE-AUDIT: بدونِ ScrollViewer بخشِ «افزودنِ آیتمِ این‌دوره» در ارتفاعِ معمولیِ صفحه دیده نمی‌شد. -->
        <ScrollViewer Grid.Column="0" Margin="0,0,10,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="قراردادهایِ خدماتی" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="برایِ خدماتِ تکرارشونده (اینترنت/پشتیبانی/...) — نه کالا." FontSize="11"
                       Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <Border Style="{StaticResource FormSectionCard}" Padding="10">
                <StackPanel>
                    <TextBlock Text="تعریفِ قراردادِ جدید" FontWeight="Bold" Margin="0,0,0,8"/>

                    <TextBlock Text="عنوانِ قرارداد" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Text="مشتری" Style="{StaticResource FieldCaption}"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" ItemsSource="{Binding Customers}"
                              DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding NewCustomerId}"
                              Margin="0,0,0,8"/>

                    <TextBlock Text="انبار" Style="{StaticResource FieldCaption}"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" ItemsSource="{Binding Warehouses}"
                              DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding NewWarehouseId}"
                              Margin="0,0,0,8"/>

                    <TextBlock Text="خدمت (کالایِ نوعِ خدمت)" Style="{StaticResource FieldCaption}"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" ItemsSource="{Binding Products}"
                              DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding NewServiceProductId}"
                              Margin="0,0,0,8" ToolTip="بهتر است کالایی از نوعِ «خدمت» انتخاب شود (بدونِ کسرِ موجودیِ انبار)."/>

                    <TextBlock Text="مبلغِ هر دوره (ریال)" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding NewMonthlyAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Text="تناوب" Style="{StaticResource FieldCaption}"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" ItemsSource="{Binding Frequencies}"
                              DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding NewFrequency}"
                              Margin="0,0,0,8"/>

                    <TextBlock Text="سررسیدِ اولین فاکتور" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding NewNextDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <Button Content="💾 ذخیرهٔ قرارداد" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FormSectionCard}" Padding="10" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="افزودنِ آیتمِ این‌دوره" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="اگر در همین ماه کالایی هم به این مشتری فروخته‌اید، اینجا اضافه کنید تا در فاکتورِ قراردادیِ همین دوره بیاید."
                               FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="قراردادِ انتخاب‌شده" Style="{StaticResource FieldCaption}"/>
                    <TextBlock Text="{Binding SelectedContract.Title}" FontWeight="Bold" Margin="0,0,0,8"/>

                    <TextBlock Text="کالا" Style="{StaticResource FieldCaption}"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" ItemsSource="{Binding Products}"
                              DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ExtraProductId}"
                              Margin="0,0,0,8"/>

                    <TextBlock Text="تعداد" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding ExtraQty, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Text="مبلغِ واحد" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding ExtraPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <Button Content="➕ افزودنِ آیتم" Command="{Binding AddExtraItemCommand}" Style="{StaticResource SuccessButton}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- فهرستِ قراردادها -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource FormSectionCard}" Padding="8" Margin="0,0,0,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="فهرستِ قراردادها" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Left" Content="↻ بازخوانی" Command="{Binding RefreshCommand}"
                            Style="{StaticResource BaseButton}" Margin="6,0,0,0"/>
                    <Button DockPanel.Dock="Left" Content="🔄 تولیدِ پیش‌فاکتورهایِ سررسیدشده"
                            Command="{Binding GenerateDueCommand}" Style="{StaticResource PrimaryButton}"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource FormSectionCard}" Padding="0">
                <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedContract}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="عنوانِ قرارداد" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="مشتری" Binding="{Binding CustomerName}" Width="160"/>
                        <DataGridTextColumn Header="مبلغِ هر دوره" Binding="{Binding MonthlyAmount, StringFormat={}{0:#,##0}}" Width="120"/>
                        <DataGridTextColumn Header="تناوب" Binding="{Binding Frequency}" Width="90"/>
                        <DataGridTextColumn Header="سررسیدِ بعدی" Binding="{Binding NextInvoiceDate}" Width="110"/>
                        <DataGridTextColumn Header="آخرین تولید" Binding="{Binding LastGenerated}" Width="110"/>
                        <DataGridTextColumn Header="آیتمِ اضافیِ در انتظار" Binding="{Binding PendingExtraItems}" Width="130"/>
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding IsActive}" Width="80"/>
                        <DataGridTemplateColumn Header="" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="فسخ" Padding="6,2"
                                            Command="{Binding DataContext.TerminateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
