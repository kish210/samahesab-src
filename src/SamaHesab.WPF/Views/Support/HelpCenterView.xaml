<UserControl x:Class="SamaHesab.WPF.Views.Support.HelpCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft"
             Background="{StaticResource ErpAppBg}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <TextBlock Text="مرکزِ پشتیبانی" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}"/>
            <TextBlock Text="گزارشِ باگ، درخواستِ قابلیت، تیکتِ پشتیبانی، دانشنامه و عیب‌یابی — مستقیم به تیمِ سما حساب."
                       FontSize="12.5" Foreground="{StaticResource ErpTextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="250" Height="118" Margin="0,0,10,10" Cursor="Hand"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Card" Background="White" BorderBrush="{StaticResource ErpBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8"
                                                        Background="{StaticResource ErpAppBg}">
                                                    <TextBlock Text="🛟" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border x:Name="Soon" DockPanel.Dock="Right" VerticalAlignment="Top"
                                                        Background="#FFF3E0" CornerRadius="10" Padding="8,2"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="به‌زودی" FontSize="10.5" Foreground="#E65100"/>
                                                </Border>
                                                <TextBlock/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource ErpBlue700}" Margin="0,10,0,0"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="{StaticResource ErpTextMuted}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Available}" Value="False">
                                            <Setter TargetName="Soon" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Card" Property="Opacity" Value="0.72"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource ErpBlue700}"/>
                                            <Setter TargetName="Card" Property="BorderThickness" Value="1.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
