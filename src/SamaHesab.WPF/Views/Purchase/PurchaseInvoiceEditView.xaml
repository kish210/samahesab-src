<UserControl x:Class="SamaHesab.WPF.Views.Purchase.PurchaseInvoiceEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{StaticResource ErpAppBg}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:GreaterThanZeroVisibilityConverter x:Key="GtzVis"/>
        <conv:GreaterThanZeroConverter x:Key="GtzBool"/>
        <conv:NullToVisibilityConverter x:Key="NullVis"/>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ErpBlue700}"/><Setter Property="Margin" Value="2,0,0,2"/>
        </Style>
        <Style x:Key="ActBtn" TargetType="Button" BasedOn="{StaticResource ErpBtnGhost}">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,0,5,0"/><Setter Property="FontSize" Value="11.5"/>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NewInvoiceCommand}"/>
        <KeyBinding Key="F7" Command="{Binding AddEmptyRowCommand}"/>
        <KeyBinding Key="F8" Command="{Binding PrintCommand}"/>
        <KeyBinding Key="F9" Command="{Binding PostInvoiceCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- هدر کلاسیک -->
            <RowDefinition Height="*"/>      <!-- گرید اقلام -->
            <RowDefinition Height="Auto"/>   <!-- ردیف دکمه‌ها + جمع‌ها -->
        </Grid.RowDefinitions>

        <!-- ═══ هدرِ کلاسیک ═══ -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="9,7" Margin="0,0,0,6">
            <StackPanel>
                <DockPanel Margin="0,0,0,7">
                    <TextBlock Text="فاکتور خرید" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource ErpBtnGhost}" Height="30" Padding="10,0" Command="{Binding NewInvoiceCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcFilePlus}" Style="{StaticResource ErpToolSvg}" Stroke="{StaticResource ErpBlue600}"/>
                                <TextBlock Text="جدید" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource ErpBlue700}" FontWeight="SemiBold"/>
                                <TextBlock Text="F2" FontSize="9.5" Foreground="{StaticResource ErpTextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ErpBtnGhost}" Height="30" Padding="10,0" Margin="4,0,0,0" Command="{Binding PrintPreviewCommand}">
                            <TextBlock Text="👁 پیش‌نمایش" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource ErpBtnGhost}" Height="30" Padding="10,0" Margin="4,0,0,0" Command="{Binding PrintCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcPrinter}" Style="{StaticResource ErpToolSvg}"/>
                                <TextBlock Text="چاپ" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="F8" FontSize="9.5" Foreground="{StaticResource ErpTextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Menu Background="Transparent" VerticalAlignment="Center" Margin="2,0,0,0"
                              Visibility="{Binding PrintTemplates.Count, Converter={StaticResource GtzVis}}">
                            <MenuItem Header="چاپ ▼" ItemsSource="{Binding PrintTemplates}" FontSize="11.5">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding Name}"/>
                                        <Setter Property="Command" Value="{Binding DataContext.PrintWithTemplateCommand, RelativeSource={RelativeSource AncestorType=Menu}}"/>
                                        <Setter Property="CommandParameter" Value="{Binding}"/>
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                        </Menu>
                    </StackPanel>
                </DockPanel>

                <!-- متادیتا: شماره/تاریخ/سررسید/انبار -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="شماره" Style="{StaticResource Cap}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource ErpInput}" Height="30" Text="{Binding InvoiceNumber}" IsReadOnly="{Binding AutoNumber}" FlowDirection="LeftToRight" TextAlignment="Center"/>
                            <CheckBox Grid.Column="1" Content="خودکار" IsChecked="{Binding AutoNumber}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="تاریخ" Style="{StaticResource Cap}"/>
                        <TextBox Style="{StaticResource ErpInput}" Height="30" Text="{Binding InvoiceDate}" FlowDirection="LeftToRight" TextAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="تاریخ سررسید" Style="{StaticResource Cap}"/>
                        <TextBox Style="{StaticResource ErpInput}" Height="30" Text="{Binding DueDate}" FlowDirection="LeftToRight" TextAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="انبار" Style="{StaticResource Cap}"/>
                        <ComboBox Height="30" ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedWarehouseId}"/>
                    </StackPanel>
                </Grid>

                <!-- تأمین‌کننده + نوع -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Cap}"><Run Text="تأمین‌کننده"/><Run Text=" *" Foreground="{StaticResource ErpDanger500}"/></TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="SupplierCombo" ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedSupplierId}" IsEditable="True" Height="30"/>
                            <!-- UX-CRM-SUPPLIER-1 — پیش‌تر برخلافِ فرمِ فروش، هیچ راهِ افزودنِ سریعِ تأمین‌کننده نبود. -->
                            <Button Grid.Column="1" Width="30" Height="30" Margin="4,0,0,0" Style="{StaticResource ErpBtnPrimary}" Padding="0" ToolTip="تأمین‌کنندهٔ جدید" Click="AddSupplier_Click" Content="＋"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="نوع" Style="{StaticResource Cap}"/>
                        <ComboBox Height="30" ItemsSource="{Binding InvoiceTypes}" SelectedItem="{Binding InvoiceType}"/>
                    </StackPanel>
                </Grid>

                <!-- نوار ماندهٔ تأمین‌کننده -->
                <DockPanel Margin="0,6,0,0" Visibility="{Binding HasSupplierInfo, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ماندهٔ تأمین‌کننده:" Foreground="{StaticResource ErpTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SupplierBalance, Converter={StaticResource Num}}" FontWeight="Bold" FontSize="11" FlowDirection="LeftToRight" Foreground="{StaticResource ErpDanger500}" Margin="4,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ═══ گریدِ اقلام (تمام‌عرض، قابلِ ویرایش) ═══ -->
        <Border Grid.Row="1" Style="{StaticResource ErpGbox}" Padding="0">
            <DataGrid x:Name="ItemsGrid" Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                      ItemsSource="{Binding InvoiceItems}" SelectedItem="{Binding SelectedItem}"
                      RowHeight="{DynamicResource ErpDensRowHeight}" GridLinesVisibility="All" FontFamily="{StaticResource VazirFont}" BorderThickness="0">
                <!-- CC-5 — منوی راست‌کلیکِ ردیف (تکرار/حذف). -->
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📄 تکرارِ ردیف"
                                  Command="{Binding PlacementTarget.DataContext.DuplicateRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="🗑 حذفِ ردیف"
                                  Command="{Binding PlacementTarget.DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="36" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="کالا" Width="2.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.AllProducts, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          DisplayMemberPath="Name" SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                          Text="{Binding ProductName, Mode=OneWay}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="شرح" Binding="{Binding Description}" Width="2*"/>
                    <DataGridTextColumn Header="واحد" Binding="{Binding Unit}" Width="70">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="مقدار" Binding="{Binding Quantity}" Width="78">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="قیمت خرید" Binding="{Binding UnitPrice}" Width="115">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="تخفیف ٪" Binding="{Binding DiscountPct}" Width="64">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="مالیات ٪" Binding="{Binding TaxPct}" Width="64">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="موجودی" Binding="{Binding StockOnHand, StringFormat={}{0:#,##0}}" Width="66" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="مبلغ کل" Binding="{Binding NetAmount, StringFormat={}{0:#,##0}}" Width="130" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="38">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Width="26" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                    <Path Data="{StaticResource IcTrash}" Style="{StaticResource ErpToolSvg}" Width="15" Height="15" Stroke="{StaticResource ErpDanger500}"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══ ردیفِ دکمه‌ها + جمع‌ها ═══ -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="9,7" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <WrapPanel>
                        <Button Style="{StaticResource ActBtn}" Command="{Binding AddEmptyRowCommand}" Content="＋ افزودن ردیف  F7"/>
                        <Button Style="{StaticResource ActBtn}" Click="FocusBarcode_Click" Content="▮▮ بارکد"/>
                    </WrapPanel>

                    <!-- UX-PURCHASE-1 — خریدهای اخیر از این تأمین‌کننده: چیپِ افزودنِ سریع -->
                    <StackPanel Margin="0,5,0,0" Visibility="{Binding RecentProducts.Count, Converter={StaticResource GtzVis}}">
                        <TextBlock Text="🔁 خریدهای اخیر از این تأمین‌کننده (کلیک=افزودن):" FontSize="10.5" Foreground="{StaticResource ErpTextMuted}" Margin="2,0,0,3"/>
                        <ItemsControl ItemsSource="{Binding RecentProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ErpBtnGhost}" Height="26" Margin="0,0,5,5" Padding="9,0" FontSize="11"
                                            Content="{Binding Name}" ToolTip="{Binding Price, StringFormat='افزودن — فی {0:N0}'}"
                                            Command="{Binding DataContext.AddRecentProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/><ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="بارکد / کد / نامِ کالا  (⏎)" Style="{StaticResource Cap}"/>
                            <TextBox x:Name="BarcodeBox" Style="{StaticResource ErpInput}" Height="30"
                                     Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchProductCommand}"/></TextBox.InputBindings>
                            </TextBox>
                            <!-- U-PUR-1: وقتی جست‌وجو دقیقاً یک نتیجه نداشت (حالتِ رایج)، نتایج در
                                 SearchResults می‌ریخت ولی هیچ UIای برایِ نمایش/انتخابشان نبود — یعنی
                                 جست‌وجو با هر عبارتِ غیرِمنحصربه‌فرد کاملاً بی‌اثر بود. حالا نتایج زیرِ
                                 فیلد نمایش داده می‌شوند؛ کلیک روی هرکدام همان کالا را اضافه می‌کند. -->
                            <Popup PlacementTarget="{Binding ElementName=BarcodeBox}" Placement="Bottom" StaysOpen="False"
                                   IsOpen="{Binding SearchResults.Count, Converter={StaticResource GtzBool}, Mode=OneWay}"
                                   AllowsTransparency="True" Width="320">
                                <Border Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="8" Margin="0,3,0,0">
                                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22" Color="#334155"/></Border.Effect>
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                                            Command="{Binding PlacementTarget.DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                            CommandParameter="{Binding}">
                                                        <DockPanel Margin="10,7">
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Code}" FontSize="10.5" Foreground="{StaticResource ErpTextMuted}" FlowDirection="LeftToRight"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5"/>
                                                        </DockPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <!-- UX-PURCHASE-1 — هینتِ تاریخچهٔ قیمتِ خرید (آخرین خرید، کلی + از این تأمین‌کننده) -->
                            <TextBlock Text="{Binding EntryPriceHint}" FontSize="10.5" Foreground="{StaticResource ErpBlue700}"
                                       TextTrimming="CharacterEllipsis" Margin="2,2,0,0"
                                       Visibility="{Binding EntryPriceHint, Converter={StaticResource NullVis}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="توضیحاتِ فاکتور" Style="{StaticResource Cap}"/>
                            <TextBox Style="{StaticResource ErpInput}" Height="30" Width="260" Text="{Binding Description}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="حمل و نقل" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource ErpInput}" Width="110" Height="28" Margin="5,0,0,0" FlowDirection="LeftToRight" Text="{Binding Shipping}"/>
                        <TextBlock Text="روش پرداخت" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <ComboBox Width="120" Height="28" Margin="5,0,0,0" ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding PaymentType}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <DockPanel Margin="0,1"><TextBlock Text="تعداد" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5"/><TextBlock DockPanel.Dock="Left" Text="{Binding TotalQuantity, Converter={StaticResource Num}}" FlowDirection="LeftToRight" FontWeight="SemiBold" FontSize="11.5"/></DockPanel>
                    <DockPanel Margin="0,1"><TextBlock Text="جمع اقلام" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5"/><TextBlock DockPanel.Dock="Left" Text="{Binding SubTotal, Converter={StaticResource Num}}" FlowDirection="LeftToRight" FontWeight="SemiBold" FontSize="11.5"/></DockPanel>
                    <DockPanel Margin="0,1"><TextBlock Text="تخفیف" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5"/><TextBlock DockPanel.Dock="Left" Text="{Binding TotalDiscount, Converter={StaticResource Num}}" FlowDirection="LeftToRight" Foreground="{StaticResource ErpDanger500}" FontSize="11.5"/></DockPanel>
                    <DockPanel Margin="0,1"><TextBlock Text="مالیات" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5"/><TextBlock DockPanel.Dock="Left" Text="{Binding TotalTax, Converter={StaticResource Num}}" FlowDirection="LeftToRight" FontSize="11.5"/></DockPanel>

                    <Border Background="{StaticResource ErpBlue700}" Padding="11,7" Margin="0,5,0,0">
                        <DockPanel>
                            <TextBlock Text="قابل پرداخت" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding GrandTotal, Converter={StaticResource Num}}" Foreground="White" FontSize="19" FontWeight="Bold" FlowDirection="LeftToRight"/>
                        </DockPanel>
                    </Border>

                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="پرداختی" Foreground="{StaticResource ErpTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{StaticResource ErpInput}" Height="26" Margin="5,0,8,0" FlowDirection="LeftToRight" Text="{Binding PaidAmount}"/>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center">
                            <Run Text="مانده: " Foreground="{StaticResource ErpTextMuted}" FontSize="11"/><Run Text="{Binding RemainAmount, Converter={StaticResource Num}, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource ErpDanger500}"/>
                        </TextBlock>
                    </Grid>

                    <Button Style="{StaticResource ErpBtnSuccess}" Height="42" Margin="0,7,0,0" FontSize="14" FontWeight="Bold"
                            Command="{Binding PostInvoiceCommand}" Content="{Binding PostButtonText}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
