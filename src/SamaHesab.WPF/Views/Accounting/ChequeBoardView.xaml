<UserControl x:Class="SamaHesab.WPF.Views.Accounting.ChequeBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="تابلوی چک‌های در جریان" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Text="{Binding TotalAmount, StringFormat='جمع: {0:#,##0} ریال'}" FontWeight="SemiBold"/>
                <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#C2403A"
                           Text="{Binding OverdueCount, StringFormat='سررسید گذشته: {0}'}"/>
            </DockPanel>
        </Border>

        <!-- نوارِ عملیاتِ همیشه‌دیدنی (روی ردیفِ انتخابی) + راهنمای میان‌بر -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="✓ وصول (Enter)" Padding="14,6" Margin="0,0,6,0" Cursor="Hand" Foreground="White"
                        BorderThickness="0" Background="#2E7D52" Command="{Binding ClearSelectedCommand}"/>
                <Button Content="↩ برگشت (Del)" Padding="14,6" Margin="0,0,6,0" Cursor="Hand" Foreground="White"
                        BorderThickness="0" Background="#C2403A" Command="{Binding ReturnSelectedCommand}"/>
                <Button Content="↻ بروزرسانی (F5)" Padding="12,6" Cursor="Hand" Command="{Binding RefreshCommand}"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource MutedText}"
                       Text="میان‌بر: Enter وصول · Del برگشت · F5 بروزرسانی"/>
        </DockPanel>

        <DataGrid Grid.Row="2" x:Name="Grid" ItemsSource="{Binding Cheques}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectedItem="{Binding Selected, Mode=TwoWay}" SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False"
                  RowHeight="30" FontSize="12.5" PreviewKeyDown="Grid_PreviewKeyDown"
                  PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                  Background="Transparent" RowBackground="Transparent">
            <!-- CC-5/خزانه — منوی راست‌کلیک: وصول/برگشت روی ردیفِ انتخاب‌شده -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="✅ وصولِ چک" Command="{Binding ClearSelectedCommand}"/>
                    <MenuItem Header="↩ برگشتِ چک" Command="{Binding ReturnSelectedCommand}"/>
                    <Separator/>
                    <MenuItem Header="🔄 بازخوانی (F5)" Command="{Binding RefreshCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StateCode}" Value="2"><Setter Property="Background" Value="#3F1D1D"/></DataTrigger>
                        <DataTrigger Binding="{Binding StateCode}" Value="1"><Setter Property="Background" Value="#3A2E12"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="شماره چک" Binding="{Binding ChequeNumber}" Width="Auto"/>
                <DataGridTextColumn Header="بانک" Binding="{Binding BankName}" Width="*"/>
                <DataGridTextColumn Header="نوع" Binding="{Binding Type}" Width="Auto"/>
                <DataGridTextColumn Header="سررسید" Binding="{Binding DueDate}" Width="Auto"/>
                <DataGridTextColumn Header="وضعیت" Binding="{Binding StateFa}" Width="Auto"/>
                <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, StringFormat='{}{0:#,##0}'}" Width="Auto"/>
                <DataGridTemplateColumn Header="عملیات" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="وصول" Margin="2,0" Padding="10,3" Cursor="Hand" Foreground="White"
                                        BorderThickness="0" Background="#2E7D52"
                                        Command="{Binding DataContext.ClearChequeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="برگشت" Margin="2,0" Padding="10,3" Cursor="Hand" Foreground="White"
                                        BorderThickness="0" Background="#C2403A"
                                        Command="{Binding DataContext.ReturnChequeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
