<UserControl x:Class="SamaHesab.WPF.Views.Settings.ModuleSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft"
             Background="{StaticResource ErpAppBg}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <!-- ردیف ماژول -->
        <DataTemplate x:Key="ModuleTpl">
            <Border Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,7">
                <DockPanel>
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource ErpBlue50}" DockPanel.Dock="Right">
                        <materialDesign:PackIcon Kind="{Binding Icon}" Width="20" Height="20" Foreground="{StaticResource ErpBlue700}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource ErpTextStrong}"/>
                        <TextBlock Text="{Binding Key}" FontSize="10.5" Foreground="{StaticResource ErpTextMuted}" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <!-- وضعیت هسته یا کلید -->
                    <Border DockPanel.Dock="Left" Background="{StaticResource ErpGray150}" CornerRadius="4" Padding="9,3" VerticalAlignment="Center"
                            Visibility="{Binding Core, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="🔒 هسته" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ErpTextMuted}"/>
                    </Border>
                    <ToggleButton DockPanel.Dock="Left" VerticalAlignment="Center" IsChecked="{Binding IsOn}"
                            Visibility="{Binding Core, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="مدیریت ماژول‌ها" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}"/>
            <TextBlock Text="سماع‌حساب یک بستر ERP ماژولار است. هستهٔ حسابداری همیشه فعال است؛ ماژول‌های اختیاری را روشن/خاموش کنید. با خاموش‌کردن یک ماژول، منوها و صفحات آن پنهان می‌شوند و سیستم مثل یک ERP حسابداری حرفه‌ای رفتار می‌کند."
                       Foreground="{StaticResource ErpTextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- هسته -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="ماژول‌های هسته (همیشه فعال)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource ErpTextStrong}" Margin="2,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding CoreModules}" ItemTemplate="{StaticResource ModuleTpl}"/>
                </StackPanel>

                <!-- اختیاری -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ماژول‌های اختیاری (قابل فعال‌سازی)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource ErpTextStrong}" Margin="2,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding OptionalModules}" ItemTemplate="{StaticResource ModuleTpl}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
