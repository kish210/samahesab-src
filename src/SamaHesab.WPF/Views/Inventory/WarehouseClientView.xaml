<UserControl x:Class="SamaHesab.WPF.Views.Inventory.WarehouseClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- نوار بالا -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="انبارداری" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center"/>
                <TextBlock Text="نوع سند:" Margin="24,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}"/>
                <ComboBox Width="150" Height="34" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Operations}" SelectedItem="{Binding Operation}"/>
                <TextBlock Text="انبار:" Margin="16,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}"/>
                <ComboBox Width="180" Height="34" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedWarehouse}"/>
                <!-- انبار مقصد (فقط در حالت انتقال) -->
                <TextBlock Text="به انبار:" Margin="16,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}"
                           Visibility="{Binding IsTransfer, Converter={StaticResource BoolVis}}"/>
                <ComboBox Width="180" Height="34" VerticalContentAlignment="Center"
                          Visibility="{Binding IsTransfer, Converter={StaticResource BoolVis}}"
                          ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" SelectedItem="{Binding DestWarehouse}"/>
                <TextBlock Text="{Binding StatusText}" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedText}" FontSize="13"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- سبد سند -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="10" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Operation}" FontSize="15" FontWeight="Bold" Margin="2,0,2,8"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Cart}" AutoGenerateColumns="False"
                              HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              Background="Transparent" RowBackground="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="تعداد" Binding="{Binding Qty}" Width="70"/>
                            <DataGridTextColumn Header="بهای واحد" Binding="{Binding UnitCost}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="2,8,2,0">
                        <DockPanel Margin="0,3">
                            <TextBlock Text="جمع تعداد" FontSize="14"/>
                            <TextBlock Text="{Binding TotalQty}" DockPanel.Dock="Left" FontWeight="SemiBold"/>
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="ارزش کل (رسید)" FontSize="14"/>
                            <TextBlock Text="{Binding TotalValue, Converter={StaticResource Num}}" DockPanel.Dock="Left"
                                       FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}"/>
                        </DockPanel>
                        <Button Content="✔  ثبت سند" Height="50" FontSize="16" FontWeight="Bold" Margin="0,8,0,0"
                                Background="#16A34A" Foreground="White" BorderThickness="0" Cursor="Hand"
                                Command="{Binding SubmitCommand}"/>
                        <Button Content="پاک کردن سبد" Height="40" Margin="0,8,0,0" Cursor="Hand"
                                Command="{Binding ClearCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- جست‌وجو + موجودی فعلی -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Height="42" FontSize="15" VerticalContentAlignment="Center" Padding="8,0"
                         Text="{Binding QuickSearch, UpdateSourceTrigger=PropertyChanged}"
                         Tag="جست‌وجوی کالا یا بارکد…"/>

                <ScrollViewer Grid.Row="1" MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="170" Height="64" Margin="4" Cursor="Hand"
                                        Background="#EFF4FF" BorderBrush="{DynamicResource PrimaryAccent}" BorderThickness="1"
                                        Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" FontSize="13"/>
                                        <TextBlock Text="{Binding Code}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource MutedText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="2,0,2,6">
                            <TextBlock Text="موجودی فعلی انبار" FontWeight="Bold" FontSize="14"/>
                            <Button Content="⟳" DockPanel.Dock="Left" Width="34" Height="28" Cursor="Hand"
                                    Command="{Binding RefreshStockCommand}"/>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Stock}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowBackground="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="90"/>
                                <DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="موجودی" Binding="{Binding Quantity}" Width="90"/>
                                <DataGridTextColumn Header="بهای میانگین" Binding="{Binding AverageCost, Converter={StaticResource Num}}" Width="120"/>
                                <DataGridTextColumn Header="ارزش" Binding="{Binding Value, Converter={StaticResource Num}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
