<UserControl x:Class="SamaHesab.WPF.Views.Purchase.PurchaseInvoiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource FormSectionCard}" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <Border Width="40" Height="40" CornerRadius="8" Background="#DCE2EE">
                        <materialDesign:PackIcon Kind="FormatListBulletedSquare" Width="22" Height="22"
                                                 Foreground="{DynamicResource PrimaryAccent}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="لیست فاکتورهای خرید" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding NewInvoiceCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="CartPlus" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="خرید جدید" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding SearchCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="بازخوانی" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding PrintCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="PrinterOutline" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="چاپ" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}" Padding="0">
            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Invoices}"
                                
                                
                                 FontFamily="{StaticResource VazirFont}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="شماره" Binding="{Binding Number}" Width="110"/>
                    <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="110"/>
                    <DataGridTextColumn Header="تأمین‌کننده" Binding="{Binding SupplierName}" Width="*"/>
                    <DataGridTextColumn Header="مبلغ کل" Binding="{Binding Total, StringFormat={}{0:#,##0}}" Width="140"/>
                    <DataGridTextColumn Header="پرداختی" Binding="{Binding Paid, StringFormat={}{0:#,##0}}" Width="130"/>
                    <DataGridTextColumn Header="مانده" Binding="{Binding Remain, StringFormat={}{0:#,##0}}" Width="130"/>
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FormSectionCard}" Padding="12,8">
            <TextBlock FontSize="12" HorizontalAlignment="Right">
                <Run Text="تعداد فاکتور:"/><Run Text="{Binding TotalCount}" FontWeight="Bold"/>
                <Run Text="   |   جمع مبلغ:"/><Run Text="{Binding TotalAmount, StringFormat={}{0:#,##0}}" FontWeight="Bold"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
