    <Style x:Key="HorizontalDataAxisStyle" TargetType="local:RadHorizontalDataAxis">
        <Setter Property="Foreground" Value="{ThemeResource TelerikDataBar_Foreground}"/>
        <Setter Property="Stroke" Value="{ThemeResource TelerikDataBar_AxisStroke}"/>
