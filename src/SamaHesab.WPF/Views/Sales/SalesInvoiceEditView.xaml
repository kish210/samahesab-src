<UserControl x:Class="SamaHesab.WPF.Views.Sales.SalesInvoiceEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{StaticResource ErpAppBg}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:GreaterThanZeroVisibilityConverter x:Key="GtzVis"/>
        <conv:NullToVisibilityConverter x:Key="NullVis"/>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ErpBlue700}"/><Setter Property="Margin" Value="2,0,0,2"/>
        </Style>
        <!-- دکمه‌ی پرداخت کناری -->
        <Style x:Key="PayBtn" TargetType="Button" BasedOn="{StaticResource ErpBtnSecondary}">
            <Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="12.5"/>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NewInvoiceCommand}"/>
        <KeyBinding Key="F8" Command="{Binding PrintCommand}"/>
        <KeyBinding Key="F9" Command="{Binding PostInvoiceCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- هدر فشرده -->
            <RowDefinition Height="*"/>      <!-- بدنه: ورود+گرید | پنل تسویه -->
        </Grid.RowDefinitions>

        <!-- ═══ هدر فشرده (مشتری + اعتبار + متادیتا) ═══ -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="7,5" Margin="0,0,0,5">
            <StackPanel>
                <DockPanel>
                    <!-- اکشن‌ها -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource ErpBtnGhost}" Height="28" Padding="9,0" Command="{Binding NewInvoiceCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcFilePlus}" Style="{StaticResource ErpToolSvg}" Stroke="{StaticResource ErpBlue600}"/>
                            <TextBlock Text="جدید" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource ErpBlue700}" FontWeight="SemiBold"/>
                            <TextBlock Text="F2" FontSize="9.5" Foreground="{StaticResource ErpTextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ErpBtnGhost}" Height="28" Padding="9,0" Margin="2,0,0,0" Command="{Binding SaveDraftCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcSave}" Style="{StaticResource ErpToolSvg}"/>
                            <TextBlock Text="پیش‌نویس" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ErpBtnGhost}" Height="28" Padding="9,0" Margin="2,0,6,0" Command="{Binding PrintCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcPrinter}" Style="{StaticResource ErpToolSvg}"/>
                            <TextBlock Text="چاپ" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="F8" FontSize="9.5" Foreground="{StaticResource ErpTextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Rectangle DockPanel.Dock="Right" Width="1" Fill="{StaticResource ErpBorder}" Margin="2,3"/>

                    <!-- متادیتا (چپ) -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="انبار" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Width="120" Height="28" ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedWarehouseId}"/>
                        <TextBlock Text="تاریخ" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,4,0"/>
                        <TextBox Style="{StaticResource ErpInput}" Height="28" Text="{Binding InvoiceDate}" Width="92" FlowDirection="LeftToRight" TextAlignment="Center"/>
                        <TextBlock Text="شماره" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,4,0"/>
                        <TextBox Style="{StaticResource ErpInput}" Height="28" Text="{Binding InvoiceNumber}" Width="92" IsReadOnly="True" FlowDirection="LeftToRight" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- مشتری (پررنگ) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                        <TextBlock Text="مشتری" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="CustomerCombo" ItemsSource="{Binding Customers}" Width="280" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedCustomerId}" IsEditable="True"
                                  Height="28" ToolTip="F6"/>
                        <Button Width="28" Height="28" Margin="4,0,0,0" Style="{StaticResource ErpBtnPrimary}" Padding="0" ToolTip="مشتری جدید" Click="AddCustomer_Click" Content="＋"/>
                    </StackPanel>
                </DockPanel>

                <!-- نوار اعتبار + مشتریان اخیر (یک ردیف فشرده) -->
                <DockPanel Margin="0,5,0,0" Visibility="{Binding HasCustomerInfo, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="مانده:" Foreground="{StaticResource ErpTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CustomerBalance, Converter={StaticResource Num}}" FontWeight="Bold" FontSize="11" FlowDirection="LeftToRight" Foreground="{StaticResource ErpDanger500}" Margin="4,0,0,0"/>
                        <TextBlock Text="سقف اعتبار:" Foreground="{StaticResource ErpTextMuted}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <TextBlock Text="{Binding CustomerCreditLimit, Converter={StaticResource Num}}" FontWeight="Bold" FontSize="11" FlowDirection="LeftToRight" Margin="4,0,0,0"
                                   Visibility="{Binding CustomerUnlimitedCredit, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                        <TextBlock Text="نامحدود" FontWeight="Bold" FontSize="11" Foreground="{StaticResource ErpTextMuted}" Margin="4,0,0,0"
                                   Visibility="{Binding CustomerUnlimitedCredit, Converter={StaticResource BoolVis}}"/>
                        <Border Background="{StaticResource ErpDanger500}" CornerRadius="3" Padding="7,1" Margin="14,0,0,0"
                                Visibility="{Binding IsOverCredit, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="⚠ عبور از سقف اعتبار" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left"
                                Visibility="{Binding RecentCustomers.Count, Converter={StaticResource GtzVis}}">
                        <TextBlock Text="اخیر:" Foreground="{StaticResource ErpTextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ItemsControl ItemsSource="{Binding RecentCustomers}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ErpBtnGhost}" Height="22" Padding="8,0" Margin="0,0,5,0" FontSize="10.5"
                                            Background="{StaticResource ErpBlue50}" Foreground="{StaticResource ErpBlue700}" Content="{Binding Label}"
                                            Command="{Binding DataContext.SelectRecentCustomerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ═══ بدنه: (ورود سریع + گرید) راست | پنل تسویه چپ ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>     <!-- ورود + گرید (مرکز/راست) -->
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="270"/>   <!-- پنل تسویه (چپ) -->
            </Grid.ColumnDefinitions>

            <!-- ورود سریع + گرید -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- entry-strip -->
                    <RowDefinition Height="*"/>      <!-- grid -->
                </Grid.RowDefinitions>

                <!-- ردیف ورود سریع (کیبوردمحور: بارکد → Enter) -->
                <Border Grid.Row="0" Background="{StaticResource ErpBlue50}" BorderBrush="{StaticResource ErpBlue100}" BorderThickness="1" CornerRadius="6" Padding="7,5" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>   <!-- بارکد/کد -->
                            <ColumnDefinition Width="*"/>      <!-- نام کالا -->
                            <ColumnDefinition Width="78"/>     <!-- تعداد -->
                            <ColumnDefinition Width="110"/>   <!-- فی -->
                            <ColumnDefinition Width="70"/>     <!-- تخفیف -->
                            <ColumnDefinition Width="Auto"/>   <!-- افزودن -->
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="2,0">
                            <TextBlock Text="بارکد / کد  (اسکن→⏎)" Style="{StaticResource Cap}"/>
                            <TextBox x:Name="BarcodeBox" Style="{StaticResource ErpInput}" Height="30" Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight">
                                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding ProcessBarcodeCommand}"/></TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="2,0">
                            <DockPanel>
                                <TextBlock Text="نام کالا" Style="{StaticResource Cap}"/>
                                <!-- OPT-5: موجودیِ زندهٔ کالای انتخابی -->
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left"
                                            Visibility="{Binding SelectedProductItem, Converter={StaticResource NullVis}}">
                                    <TextBlock Text="موجودی:" FontSize="10" Foreground="{StaticResource ErpTextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding EntryOnHand, Converter={StaticResource Num}}" FontSize="10.5" FontWeight="Bold" FlowDirection="LeftToRight"
                                               Margin="3,0,2,0" VerticalAlignment="Center" Foreground="{StaticResource ErpSuccess700}"/>
                                </StackPanel>
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding AllProducts}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProductItem}"
                                      IsEditable="True"
                                      Height="30"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="2,0">
                            <TextBlock Text="تعداد" Style="{StaticResource Cap}"/>
                            <TextBox Text="{Binding AddQty}" Height="30"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="2,0">
                            <TextBlock Text="فی" Style="{StaticResource Cap}"/>
                            <TextBox Text="{Binding AddUnitPrice}" Height="30"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="2,0">
                            <TextBlock Text="تخفیف ٪" Style="{StaticResource Cap}"/>
                            <TextBox Text="{Binding AddDiscountPct}" Height="30"/>
                        </StackPanel>
                        <StackPanel Grid.Column="5" Margin="2,0" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource ErpBtnPrimary}" Height="30" Padding="14,0" Command="{Binding AddSelectedProductCommand}" Content="افزودن ⏎"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- گرید اقلام (مرکز صفحه، چگالی بالا) -->
                <Border Grid.Row="1" Style="{StaticResource ErpGbox}" Padding="0">
                    <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding InvoiceItems}" SelectedItem="{Binding SelectedItem}"
                              RowHeight="27" GridLinesVisibility="All"
                             
                              FontFamily="{StaticResource VazirFont}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="38"/>
                            <DataGridTextColumn Header="کد" Binding="{Binding ProductCode}" Width="80"/>
                            <DataGridTextColumn Header="نام کالا" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTemplateColumn Header="موجودی" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StockOnHand, Converter={StaticResource Num}}" FlowDirection="LeftToRight"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource ErpTextBody}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsShort}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ErpDanger500}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="مقدار" Binding="{Binding Quantity}" Width="72"/>
                            <DataGridTextColumn Header="فی" Binding="{Binding UnitPrice, StringFormat={}{0:#,##0}}" Width="105"/>
                            <DataGridTextColumn Header="٪" Binding="{Binding DiscountPct}" Width="48"/>
                            <DataGridTextColumn Header="مالیات ٪" Binding="{Binding TaxPct}" Width="64"/>
                            <DataGridTextColumn Header="مبلغ خالص" Binding="{Binding NetAmount, StringFormat={}{0:#,##0}}" Width="125"/>
                            <DataGridTemplateColumn Width="38">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="26" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IcTrash}" Style="{StaticResource ErpToolSvg}" Width="15" Height="15" Stroke="{StaticResource ErpDanger500}"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ═══ پنل تسویه‌ی کناری (OPT-5: جریانِ فشرده، بدون فضای خالی) ═══ -->
            <Border Grid.Column="2" Style="{StaticResource ErpGbox}">
                <StackPanel Margin="10,8,10,8">
                    <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="نوع" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Height="26" ItemsSource="{Binding InvoiceTypes}" SelectedItem="{Binding InvoiceType}" Margin="6,0,0,0"/></Grid>
                    <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="سطح قیمت" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Height="26" ItemsSource="{Binding PriceLevels}" SelectedItem="{Binding PriceLevel}" Margin="6,0,0,0"/></Grid>
                    <Rectangle Height="1" Fill="{StaticResource ErpGray100}" Margin="0,6"/>
                    <DockPanel Margin="0,2"><TextBlock Text="جمع اقلام" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5"/><TextBlock DockPanel.Dock="Left" Text="{Binding SubTotal, Converter={StaticResource Num}}" FlowDirection="LeftToRight" FontWeight="SemiBold" FontSize="11.5"/></DockPanel>
                    <DockPanel Margin="0,2"><TextBlock Text="تخفیف ردیف‌ها" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5"/><TextBlock DockPanel.Dock="Left" Text="{Binding TotalDiscount, Converter={StaticResource Num}}" FlowDirection="LeftToRight" Foreground="{StaticResource ErpDanger500}" FontSize="11.5"/></DockPanel>
                    <DockPanel Margin="0,2"><TextBlock Text="مالیات ۹٪" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5"/><TextBlock DockPanel.Dock="Left" Text="{Binding TotalTax, Converter={StaticResource Num}}" FlowDirection="LeftToRight" FontSize="11.5"/></DockPanel>
                    <DockPanel Margin="0,2"><TextBlock Text="هزینه حمل" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5" VerticalAlignment="Center"/><TextBox DockPanel.Dock="Left" Width="100" Text="{Binding Shipping}" Height="24"/></DockPanel>
                    <DockPanel Margin="0,2"><TextBlock Text="تخفیف مبلغی" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5" VerticalAlignment="Center"/><TextBox DockPanel.Dock="Left" Width="100" Text="{Binding InvoiceDiscount}" Height="24"/></DockPanel>

                    <!-- مبلغ قابل پرداخت (بزرگ) -->
                    <Border Background="{StaticResource ErpBlue700}" Padding="12,9" Margin="0,8,0,0">
                        <DockPanel>
                            <TextBlock Text="قابل پرداخت" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding GrandTotal, Converter={StaticResource Num}}" Foreground="White" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight"/>
                        </DockPanel>
                    </Border>

                    <!-- روش پرداخت -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="5"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource PayBtn}" Content="💵 دریافت نقد" Command="{Binding SetPayCommand}" CommandParameter="نقدی"/>
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource PayBtn}" Content="💳 کارت‌خوان" Command="{Binding SetPayCommand}" CommandParameter="کارتخوان"/>
                        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource PayBtn}" Content="🧾 چک" Command="{Binding SetPayCommand}" CommandParameter="چک"/>
                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource PayBtn}" Content="📒 نسیه" Command="{Binding SetPayCommand}" CommandParameter="نسیه"/>
                    </Grid>
                    <DockPanel Margin="0,8,0,0"><TextBlock Text="روش:" Foreground="{StaticResource ErpTextMuted}" FontSize="11" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Left" Text="{Binding PaymentType}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource ErpBlue700}"/></DockPanel>
                    <DockPanel Margin="0,3"><TextBlock Text="پرداختی" Foreground="{StaticResource ErpTextMuted}" FontSize="11" VerticalAlignment="Center"/><TextBox DockPanel.Dock="Left" Width="120" Text="{Binding PaidAmount}" Height="26"/></DockPanel>
                    <DockPanel Margin="0,3"><TextBlock Text="مانده" Foreground="{StaticResource ErpTextMuted}" FontSize="11" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Left" Text="{Binding RemainAmount, Converter={StaticResource Num}}" FlowDirection="LeftToRight" FontWeight="Bold" FontSize="13" Foreground="{StaticResource ErpDanger500}"/></DockPanel>

                    <!-- دکمه‌ی ثبت قطعی -->
                    <Button Style="{StaticResource ErpBtnSuccess}" Height="46" Margin="0,10,0,0" FontSize="14" FontWeight="Bold"
                            Command="{Binding PostInvoiceCommand}" Content="✓ ثبت نهایی فاکتور — F9"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
