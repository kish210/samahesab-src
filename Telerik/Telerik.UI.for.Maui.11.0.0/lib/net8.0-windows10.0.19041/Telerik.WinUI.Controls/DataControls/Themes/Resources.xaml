    <Style x:Key="PropertyGridNestedToggleButtonStyle" TargetType="controls:RadToggleButton">
        <Setter Property="Template" Value="{StaticResource PropertyGridNestedToggleButtonTemplate}" />
        <Setter Property="Foreground" Value="{StaticResource TelerikPropertyGrid_NestedToggleButtonForeground}" />
        <Setter Property="Background" Value="#01FFFFFF" />
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="44"/>
