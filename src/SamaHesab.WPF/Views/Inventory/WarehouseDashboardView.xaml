<UserControl x:Class="SamaHesab.WPF.Views.Inventory.WarehouseDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <Style x:Key="Kpi" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6"/>
            <Setter Property="Width" Value="220"/><Setter Property="Height" Value="108"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="16,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceBackground}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KpiVal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryAccent}"/>
        </Style>
        <Style x:Key="KpiCap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="6,0,6,12" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right">
                <TextBlock Text="داشبورد انبار" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                <TextBlock Text="{Binding TodayText, StringFormat='امروز: {0}'}" FontSize="12.5" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Left" Content="بروزرسانی" Command="{Binding RefreshCommand}" VerticalAlignment="Center"
                    Style="{StaticResource ErpBtnSecondary}"/>
        </DockPanel>

        <WrapPanel Grid.Row="1" VerticalAlignment="Top">
            <Button Style="{StaticResource Kpi}" Command="{Binding OpenProductsCommand}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiCap}" Text="کالاهای ناموجود"/>
                    <TextBlock Style="{StaticResource KpiVal}" Foreground="#C2403A" Text="{Binding OutOfStockCount, Converter={StaticResource Num}, ConverterParameter=قلم}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Kpi}" Command="{Binding OpenReorderCommand}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiCap}" Text="زیرِ حداقلِ موجودی"/>
                    <TextBlock Style="{StaticResource KpiVal}" Foreground="#C9911B" Text="{Binding LowStockCount, Converter={StaticResource Num}, ConverterParameter=قلم}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Kpi}" Command="{Binding OpenReorderCommand}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiCap}" Text="پیشنهادِ سفارش"/>
                    <TextBlock Style="{StaticResource KpiVal}" Text="{Binding ReorderSuggestions, Converter={StaticResource Num}, ConverterParameter=قلم}"/>
                </StackPanel>
            </Button>
        </WrapPanel>
    </Grid>
</UserControl>
