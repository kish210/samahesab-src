<UserControl x:Class="SamaHesab.WPF.Views.Accounting.BankAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ErpToolbar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ErpToolButton}" Command="{Binding RefreshCommand}">
                    <StackPanel><Path Data="{StaticResource IcRefresh}" Style="{StaticResource ErpToolSvg}" Width="18" Height="18" HorizontalAlignment="Center" Stroke="{DynamicResource SecondaryText}"/><TextBlock Text="بروزرسانی" TextAlignment="Center"/></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}" Margin="3" Padding="0">
            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Accounts}" RowHeight="28"
                                >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="بانک" Binding="{Binding BankName}" Width="150"/>
                    <DataGridTextColumn Header="شماره حساب" Binding="{Binding AccountNumber}" Width="160"/>
                    <DataGridTextColumn Header="شبا" Binding="{Binding Sheba}" Width="*"/>
                    <DataGridTextColumn Header="شماره کارت" Binding="{Binding CardNumber}" Width="160"/>
                    <DataGridTextColumn Header="شعبه" Binding="{Binding BranchName}" Width="140"/>
                    <DataGridTextColumn Header="مانده اولیه" Binding="{Binding OpeningBalance, StringFormat={}{0:#,##0}}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ErpToolbar}" BorderThickness="0,1,0,0">
            <TextBlock HorizontalAlignment="Right" FontSize="12" Margin="4,2" VerticalAlignment="Center">
                <Run Text="تعداد حساب‌ها:"/><Run Text="{Binding TotalCount}" FontWeight="Bold"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
