<Project Sdk="Microsoft.NET.Sdk">

  <!-- ابزارِ گرافیکیِ آفلاینِ صدورِ «کدِ ریستِ پشتیبانی» (U-SUPPORT-RESET). فقط دستِ پشتیبانی/وندور
       اجرا می‌شود — کلیدِ خصوصیِ RSA هرگز در این مخزن یا در برنامهٔ کلاینت نیست؛ به‌عنوانِ یک فایلِ
       PEM محلی (خارج از git) از طریقِ همین برنامه انتخاب می‌شود. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <AssemblyName>SamaHesabSupportTool</AssemblyName>
    <RootNamespace>SamaHesab.SupportTool</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SamaHesab.Application\SamaHesab.Application.csproj" />
  </ItemGroup>

</Project>
