<UserControl x:Class="SamaHesab.WPF.Views.Inventory.DiscountTiersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="تخفیفِ پلکانیِ مقداری" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
            <TextBlock Text="برای هر کالا چند پله تعریف کنید؛ در فاکتور فروش بهترین پله (بزرگ‌ترین «حداقل مقدارِ» ≤ مقدار) خودکار اعمال می‌شود."
                       Foreground="{DynamicResource SecondaryText}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- انتخاب کالا -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="کالا:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" Margin="0,0,8,0"/>
            <ComboBox Width="320" Height="30" ItemsSource="{Binding Products}" DisplayMemberPath="Display"
                      SelectedValuePath="Id" SelectedValue="{Binding SelectedProductId}" IsEditable="True"/>
            <TextBox Width="180" Height="30" Margin="10,0,0,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="7,0"
                     Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}">
                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding RunSearchCommand}"/></TextBox.InputBindings>
            </TextBox>
            <Button Content="جستجو" Command="{Binding RunSearchCommand}" Margin="6,0,0,0" Padding="14,6" Cursor="Hand"
                    Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"/>
        </StackPanel>

        <!-- گرید پله‌ها -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6">
            <DataGrid ItemsSource="{Binding Tiers}" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="All" RowHeight="{DynamicResource ErpDensRowHeight}" FontSize="12.5"
                      Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="حداقل مقدار" Binding="{Binding MinQty, UpdateSourceTrigger=LostFocus}" Width="160"/>
                    <DataGridTextColumn Header="درصد تخفیف ٪" Binding="{Binding DiscountPercent, UpdateSourceTrigger=LostFocus}" Width="160"/>
                    <DataGridTemplateColumn Header="" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="حذف" HorizontalAlignment="Right" Margin="0,0,8,0" Padding="10,2" Cursor="Hand"
                                        Background="Transparent" Foreground="{DynamicResource DangerColor}" BorderThickness="0"
                                        Command="{Binding DataContext.RemoveTierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- اکشن‌ها -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="＋ افزودن پله" Command="{Binding AddTierCommand}" Padding="14,6" Cursor="Hand"
                    Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"/>
            <Button Content="💾 ذخیرهٔ پله‌ها" Command="{Binding SaveCommand}" Margin="8,0,0,0" Padding="16,6" Cursor="Hand"
                    Background="{DynamicResource PrimaryAccent}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</UserControl>
