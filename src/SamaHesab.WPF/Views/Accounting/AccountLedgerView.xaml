<UserControl x:Class="SamaHesab.WPF.Views.Accounting.AccountLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SamaHesab.WPF.Controls"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}"/>
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="دفترِ معینِ حساب (با پرش به سند)" FontSize="18" FontWeight="Bold" Margin="2,0,0,8"/>

        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="حساب:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SecondaryText}"/>
                <ctl:AccountSearchBox Width="280" Height="32" ItemsSource="{Binding Accounts}"
                          SelectedAccountId="{Binding SelectedAccountId, Mode=TwoWay}"/>
                <TextBlock Text="از:" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{DynamicResource SecondaryText}"/>
                <TextBox Width="120" Height="32" Text="{Binding FromDate}" FlowDirection="LeftToRight"/>
                <TextBlock Text="تا:" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{DynamicResource SecondaryText}"/>
                <TextBox Width="120" Height="32" Text="{Binding ToDate}" FlowDirection="LeftToRight"/>
                <Button Content="🔄 تهیه (F5)" Style="{StaticResource PrimaryButton}" Height="32" Margin="16,0,0,0"
                        Command="{Binding RunCommand}"/>
                <Button Content="📂 بازکردنِ سند" Style="{StaticResource SecondaryButton}" Height="32" Margin="8,0,0,0"
                        Command="{Binding OpenVoucherCommand}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FormSectionCard}" Padding="0" Margin="0,8,0,0">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" CanUserAddRows="False" Background="Transparent"
                      RowBackground="Transparent" BorderThickness="0" FontSize="12.5">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenVoucherCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="110"/>
                    <DataGridTextColumn Header="شمارهٔ سند" Binding="{Binding VoucherNumber}" Width="Auto"/>
                    <DataGridTextColumn Header="شرح" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="بدهکار" Binding="{Binding Debit, Converter={StaticResource Num}}" Width="Auto"/>
                    <DataGridTextColumn Header="بستانکار" Binding="{Binding Credit, Converter={StaticResource Num}}" Width="Auto"/>
                    <DataGridTextColumn Header="مانده" Binding="{Binding Balance, Converter={StaticResource Num}}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource FormSectionCard}" Padding="10" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ماندهٔ ابتدا: " FontWeight="SemiBold"/>
                <TextBlock Text="{Binding OpeningBalance, Converter={StaticResource Num}}" Margin="0,0,24,0" FontWeight="SemiBold"/>
                <TextBlock Text="جمعِ بدهکار: "/>
                <TextBlock Text="{Binding TotalDebit, Converter={StaticResource Num}}" Margin="0,0,24,0"/>
                <TextBlock Text="جمعِ بستانکار: "/>
                <TextBlock Text="{Binding TotalCredit, Converter={StaticResource Num}}" Margin="0,0,24,0"/>
                <TextBlock Text="ماندهٔ پایان: " FontWeight="Bold" Foreground="#2E5A9C"/>
                <TextBlock Text="{Binding ClosingBalance, Converter={StaticResource Num}}" FontWeight="Bold" Foreground="#2E5A9C"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
