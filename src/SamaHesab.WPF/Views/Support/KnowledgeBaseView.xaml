<UserControl x:Class="SamaHesab.WPF.Views.Support.KnowledgeBaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource VazirFont}" FlowDirection="RightToLeft"
             Background="{StaticResource ErpAppBg}">
    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,8">
            <TextBlock Text="دانشنامه" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}"/>
            <TextBlock Text="مقالات، پرسش‌های پرتکرار، راهنماها و ویدئوهای آموزشیِ سما حساب." FontSize="12" Foreground="{StaticResource ErpTextMuted}" Margin="0,3,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                         ToolTip="جست‌وجو در مقالات/راهنما/ویدئو"/>
                <Button Grid.Column="1" Style="{StaticResource ErpBtnPrimary}" Height="32" Padding="16,0" Margin="6,0,0,0"
                        Content="🔍 جست‌وجو" Command="{Binding SearchArticlesCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource ErpTextMuted}" Margin="6,4"/>
                    <ListBox ItemsSource="{Binding Articles}" SelectedItem="{Binding Selected}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,5">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Kind}" FontSize="10.5" Foreground="{StaticResource ErpTextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Selected.Title}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Selected.Summary}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource ErpTextMuted}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Selected.Body}" TextWrapping="Wrap" FontSize="12.5" Margin="0,10,0,0"/>
                        <Button Style="{StaticResource ErpBtnGhost}" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="12,4"
                                Content="🔗 بازکردن در مرورگر" Command="{Binding OpenUrlCommand}"
                                Visibility="{Binding HasUrl, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
