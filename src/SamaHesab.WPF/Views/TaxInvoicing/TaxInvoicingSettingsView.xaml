<UserControl x:Class="SamaHesab.WPF.Views.TaxInvoicing.TaxInvoicingSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,8">
            <TextBlock Text="تنظیماتِ سامانهٔ مودیان" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="ارسالِ الکترونیکیِ فاکتورِ فروش به سازمانِ امورِ مالیاتی — بدونِ گواهیِ دیجیتالِ معتبر، ارسال انجام نمی‌شود."
                       Foreground="{DynamicResource SecondaryText}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource FormSectionCard}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="شناسهٔ حافظهٔ مالیاتی (Tax Memory ID)" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox Height="32" Margin="0,2,0,8" Text="{Binding TaxMemoryId, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,14,0,0">
                        <CheckBox Content="محیطِ آزمایشی (Sandbox)" IsChecked="{Binding UseSandbox}"/>
                        <TextBlock Text="پیش از دریافتِ اعتبارنامهٔ واقعی، این گزینه باید فعال بماند."
                                   Foreground="{DynamicResource SecondaryText}" FontSize="10.5" Margin="20,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="مسیرِ فایلِ گواهیِ دیجیتال (PFX)" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                        <DockPanel Margin="0,2,0,8" LastChildFill="True">
                            <Button DockPanel.Dock="Left" Content="انتخابِ فایل..." Style="{StaticResource ErpBtnSecondary}"
                                    Padding="10,4" Margin="6,0,0,0" Click="BrowseCertificate_Click"/>
                            <TextBox Text="{Binding CertificatePath, UpdateSourceTrigger=PropertyChanged}" Height="32" FlowDirection="LeftToRight" IsReadOnly="True"/>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="رمزِ عبورِ گواهی" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                        <PasswordBox x:Name="CertPasswordBox" Height="32" Margin="0,2,0,8" FlowDirection="LeftToRight"
                                     PasswordChanged="CertPasswordBox_PasswordChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0">
                        <CheckBox Content="فعال‌سازیِ صف‌بندیِ خودکار (هر فاکتورِ فروشِ قطعی‌شده صف می‌شود)" IsChecked="{Binding Enabled}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>

        <Button Grid.Row="2" Content="💾 ذخیرهٔ تنظیمات" Style="{StaticResource PrimaryButton}" Height="38"
                HorizontalAlignment="Left" Margin="2,8,0,0" Command="{Binding SaveCommand}"/>
    </Grid>
</UserControl>
