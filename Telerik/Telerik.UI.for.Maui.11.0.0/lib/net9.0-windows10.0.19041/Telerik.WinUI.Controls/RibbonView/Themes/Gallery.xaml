<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:telerik="using:Telerik.UI.Xaml.Controls"
    xmlns:telerikRibbonViewPrimitives="using:Telerik.UI.Xaml.Controls.RibbonView.Primitives">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/RibbonView/Themes/Resources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--#region Galleries-->
    <ControlTemplate x:Key="RadGalleryItemTemplate" TargetType="telerik:RadGalleryItem">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Duration="0" Storyboard.TargetName="contentControl" Storyboard.TargetProperty="Opacity" To="{ThemeResource TelerikControlDisabledOpacity}"/>
                            <DoubleAnimation Duration="0" Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity" To="{ThemeResource TelerikControlDisabledOpacity}"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="PointerOverVisual"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="SelectedPointerOver">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NormalVisual" Storyboard.TargetProperty="CornerRadius">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <CornerRadius>2</CornerRadius>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PointerOverVisual" Storyboard.TargetProperty="CornerRadius">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <CornerRadius>2</CornerRadius>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="SelectionStates">
                    <VisualState x:Name="Unselected"/>
                    <VisualState x:Name="Selected">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NormalVisual" Storyboard.TargetProperty="CornerRadius">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <CornerRadius>2</CornerRadius>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="SelectedVisual"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="HeaderStates">
                    <VisualState x:Name="IsNotHeader"/>
                    <VisualState x:Name="IsHeader">
                        <Storyboard>
                            <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="HeaderBackground"/>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="contentControl" Storyboard.TargetProperty="HorizontalAlignment">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <HorizontalAlignment>Left</HorizontalAlignment>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
				<VisualStateGroup x:Name="KeyboardNavigationStates">
					<VisualState x:Name="KeyboardUnfocused" />
					<VisualState x:Name="KeyboardFocused">
						<Storyboard>
							<DoubleAnimation Storyboard.TargetName="KeyboardNavigationVisual" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
						</Storyboard>
					</VisualState>
				</VisualStateGroup>
			</VisualStateManager.VisualStateGroups>

            <Border x:Name="NormalVisual"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"/>
            <Border x:Name="HeaderBackground" Opacity="0" Background="{ThemeResource TelerikRibbonView_Gallery_Background}"/>
            <Border x:Name="PointerOverVisual"
                    Background="{x:Null}"
                    BorderBrush="{ThemeResource TelerikRibbonView_Gallery_ItemPointerOverBorderBrush}"
                    BorderThickness="1"
                    Opacity="0"/>
            <Border x:Name="SelectedVisual"
                    Background="{x:Null}"
                    BorderBrush="{ThemeResource TelerikRibbonView_Gallery_ItemSelectedBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="2"
                    Opacity="0"/>
            <Grid Margin="{TemplateBinding Padding}">
                <ContentControl x:Name="contentControl"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Content="{TemplateBinding Content}"
                                IsTabStop="False"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Foreground="{TemplateBinding Foreground}"/>
                <ContentPresenter x:Name="Icon"
                                  Foreground="{TemplateBinding Foreground}"
                                  Content="{TemplateBinding Icon}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Grid>
			<Border x:Name="KeyboardNavigationVisual"
                    Opacity="0" 
                    CornerRadius="2"
                    BorderThickness="2"
                    BorderBrush="{ThemeResource TelerikRibbonView_Gallery_ItemPointerOverBorderBrush}" />
		</Grid>
    </ControlTemplate>
    <Style x:Key="RadGalleryItemStyle" TargetType="telerik:RadGalleryItem">
        <Setter Property="Template" Value="{StaticResource RadGalleryItemTemplate}"/>
        <Setter Property="Background" Value="{ThemeResource TelerikRibbonView_Gallery_ItemBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TelerikRibbonView_Gallery_ItemBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Margin" Value="0 0 5 5"/>
    </Style>
    <Style TargetType="telerik:RadGalleryItem" BasedOn="{StaticResource RadGalleryItemStyle}"/>

    <Style x:Key="RadGalleryStyle" TargetType="telerik:RadGallery">
        <Setter Property="Background" Value="{ThemeResource TelerikRibbonView_Gallery_Background}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TelerikRibbonView_Gallery_BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5 5 0 0"/>
        <Setter Property="ItemWidth" Value="100"/>
        <Setter Property="ViewportWidth" Value="105"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <telerik:RadWrapPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="telerik:RadGallery">
                    <ScrollViewer x:Name="PART_ScrollViewer"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  Padding="{TemplateBinding Padding}"
                                  VerticalAlignment="Stretch"
                                  IsTabStop="False">
                        <ItemsPresenter Width="{TemplateBinding ViewportWidth}" HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="telerik:RadGallery" BasedOn="{StaticResource RadGalleryStyle}"/>

    <ControlTemplate x:Key="RadRibbonGalleryTemplate" TargetType="telerik:RadRibbonGallery">
        <Grid>
            <Border x:Name="ExpandedBorder"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="ScrollViewer" Grid.RowSpan="3" VerticalScrollBarVisibility="Hidden"
                                  IsTabStop="False" BorderThickness="0" VerticalAlignment="Stretch" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="InRibbonHost" Width="{TemplateBinding ViewportWidth}" HorizontalAlignment="Left">
                            <ContentPresenter.Content>
                                <ItemsPresenter x:Name="ItemsPresenter" />
                            </ContentPresenter.Content>
                        </ContentPresenter>
                    </ScrollViewer>
                    <Grid Grid.Column="1" Grid.RowSpan="3" Margin="0 -1 -1 0"
                          RowDefinitions="*,*,*">
                        <telerik:RadRibbonButton x:Name="ScrollUpButton"
                                                 telerik:ScreenTip.Title="{TemplateBinding UpDownButtonTitle}"
                                                 IsAutoSize="False" Padding="0"
                                                 Background="{ThemeResource TelerikRibbonView_Gallery_ButtonBackground}"
                                                 BorderBrush="{TemplateBinding BorderBrush}"
                                                 CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CornerRadius,
                                                 Converter={StaticResource CornerRadiusConverter}, ConverterParameter=TopRight}"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalContentAlignment="Center"
                                                 IsTabStop="False">
                            <FontIcon x:Name="ScrollUpButtonIcon"
                                      Foreground="{ThemeResource TelerikRibbonView_IconForeground}"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="{ThemeResource TelerikIconFontSize}"
                                      Glyph="&#xE0E4;"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </telerik:RadRibbonButton>
                        <telerik:RadRibbonButton x:Name="ScrollDownButton" Grid.Row="1"
                                                 telerik:ScreenTip.Title="{TemplateBinding UpDownButtonTitle}"
                                                 IsAutoSize="False" Padding="0"
                                                 Background="{ThemeResource TelerikRibbonView_Gallery_ButtonBackground}"
                                                 BorderBrush="{TemplateBinding BorderBrush}"
                                                 CornerRadius="0" Margin="0 -1"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalContentAlignment="Center"
                                                 IsTabStop="False">
                            <FontIcon x:Name="ScrollDownButtonIcon"
                                      Foreground="{ThemeResource TelerikRibbonView_IconForeground}"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="{ThemeResource TelerikIconFontSize}"
                                      Glyph="&#xE0E5;"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </telerik:RadRibbonButton>
                        <telerik:RadRibbonDropDownButton x:Name="PopupButton" Grid.Row="2"
                                                         telerik:ScreenTip.Title="{TemplateBinding MoreButtonTitle}"
                                                         IsAutoSize="False" Padding="0"
                                                         DropDownIndicatorVisibility="Collapsed"
                                                         Visibility="{TemplateBinding PopupLaunchButtonVisibility}" 
                                                         Background="{ThemeResource TelerikRibbonView_Gallery_ButtonBackground}"
                                                         BorderBrush="{TemplateBinding BorderBrush}" Margin="0 0 0 -1"
                                                         CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CornerRadius,
                                                         Converter={StaticResource CornerRadiusConverter}, ConverterParameter=BottomRight}"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalContentAlignment="Center">
                            <Grid x:Name="PopupButtonIcon"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <FontIcon Foreground="{ThemeResource TelerikRibbonView_IconForeground}"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="{ThemeResource TelerikIconFontSize}"
                                          Glyph="&#xE949;" Margin="0 -10 0 0"/>
                                <FontIcon Foreground="{ThemeResource TelerikRibbonView_IconForeground}"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="{ThemeResource TelerikIconFontSize}"
                                          Glyph="&#xE0E5;" Margin="0 5 0 0"/>
                            </Grid>
                        </telerik:RadRibbonDropDownButton>

                    </Grid>
                </Grid>
            </Border>
            <telerik:RadRibbonDropDownButton x:Name="CollapsedButton"
                                             Size="Large" LargeIcon="{TemplateBinding Icon}"
                                             Text="{TemplateBinding Title}"
                                             Visibility="Collapsed">
                <telerik:RadRibbonDropDownButton.Flyout>
                    <Flyout>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ScrollViewer Padding="0"
                                          HorizontalScrollBarVisibility="Hidden" IsTabStop="False"
                                          Height="{TemplateBinding PopupViewportHeight}" VerticalScrollBarVisibility="Visible"
                                          Margin="0 0 -1 -2" BorderThickness="0 0 0 1">
                                <ContentPresenter x:Name="PopupHost" Width="{TemplateBinding PopupViewportWidth}" />
                            </ScrollViewer>
                            <ItemsControl HorizontalContentAlignment="Stretch"
                                          Grid.Row="1" ItemsSource="{TemplateBinding PopupMenuItems}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderThickness="0" Margin="0 2 0 0"/>
                        </Grid>
                    </Flyout>
                </telerik:RadRibbonDropDownButton.Flyout>
            </telerik:RadRibbonDropDownButton>
        </Grid>
    </ControlTemplate>

    <Style x:Key="RadRibbonGalleryStyle" TargetType="telerik:RadRibbonGallery">
        <Setter Property="Template" Value="{StaticResource RadRibbonGalleryTemplate}" />
        <Setter Property="Background" Value="{ThemeResource TelerikRibbonView_Gallery_Background}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TelerikRibbonView_Gallery_BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource TelerikRibbonView_Gallery_CornerRadius}" />
        <Setter Property="Padding" Value="2 2 0 2" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="PopupViewportWidth" Value="320" />
        <Setter Property="ViewportWidth" Value="315" />
        <Setter Property="ItemWidth" Value="100" />
        <Setter Property="ItemHeight" Value="60" />
        <Setter Property="PopupLaunchButtonVisibility" Value="Visible" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <telerikRibbonViewPrimitives:RibbonGalleryPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="telerik:RadRibbonGallery" BasedOn="{StaticResource RadRibbonGalleryStyle}" />
    <!--#endregion-->
</ResourceDictionary>

