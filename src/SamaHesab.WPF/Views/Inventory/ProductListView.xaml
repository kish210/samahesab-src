<UserControl x:Class="SamaHesab.WPF.Views.Inventory.ProductListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Toolbar ═══ -->
        <Border Grid.Row="0" Style="{StaticResource FormSectionCard}" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <Border Width="40" Height="40" CornerRadius="8" Background="#E0EDFF">
                        <materialDesign:PackIcon Kind="PackageVariantClosed" Width="22" Height="22"
                                                 Foreground="{DynamicResource PrimaryAccent}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="مدیریت کالاها" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding NewProductCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="PlusBoxOutline" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="کالای جدید" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding EditProductCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="PencilOutline" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource WarningColor}"/><TextBlock Text="ویرایش" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding DeleteProductCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="DeleteOutline" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource DangerColor}"/><TextBlock Text="حذف" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="ExportExcel_Click">
                        <StackPanel><materialDesign:PackIcon Kind="MicrosoftExcel" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource SuccessColor}"/><TextBlock Text="خروجی اکسل" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding RefreshCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="بروزرسانی" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Filter bar ═══ -->
        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="4">
                    <TextBlock Text="جستجو (کد / بارکد / نام کالا)" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource SecondaryButton}" Height="36" Width="44" Command="{Binding SearchCommand}">
                        <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="4">
                    <TextBlock Text="گروه کالا" Style="{StaticResource FieldCaption}"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" ItemsSource="{Binding Groups}"
                              DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedGroupId}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="12,4" VerticalAlignment="Bottom">
                    <CheckBox Content="نمایش غیرفعال‌ها" IsChecked="{Binding ShowInactive}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Telerik RadGridView (filter / group / column-chooser / export) ═══ -->
        <Border Grid.Row="2" Style="{StaticResource FormSectionCard}" Padding="0">
            <telerik:RadGridView x:Name="grid"
                                 ItemsSource="{Binding Products}"
                                 SelectedItem="{Binding SelectedProduct}"
                                 AutoGenerateColumns="False" ShowSearchPanel="True"
                                 IsReadOnly="True"
                                 CanUserFreezeColumns="True"
                                 ShowGroupPanel="True"
                                 GroupRenderMode="Flat"
                                 FilteringMode="Popup"
                                 RowIndicatorVisibility="Collapsed"
                                 ColumnWidth="*"
                                 FontFamily="{StaticResource VazirFont}">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="کد" DataMemberBinding="{Binding Code}" Width="90"/>
                    <telerik:GridViewDataColumn Header="بارکد" DataMemberBinding="{Binding Barcode}" Width="130"/>
                    <telerik:GridViewDataColumn Header="نام کالا" DataMemberBinding="{Binding Name}" Width="2*"/>
                    <telerik:GridViewDataColumn Header="قیمت خرید" DataMemberBinding="{Binding PurchasePrice}" DataFormatString="{}{0:#,##0}" Width="120"/>
                    <telerik:GridViewDataColumn Header="قیمت فروش" DataMemberBinding="{Binding SalePrice}" DataFormatString="{}{0:#,##0}" Width="120"/>
                    <telerik:GridViewDataColumn Header="قیمت عمده" DataMemberBinding="{Binding WholesalePrice}" DataFormatString="{}{0:#,##0}" Width="120"/>
                    <telerik:GridViewDataColumn Header="حداقل موجودی" DataMemberBinding="{Binding MinStock}" DataFormatString="{}{0:#,##0}" Width="110"/>
                    <telerik:GridViewDataColumn Header="وضعیت" DataMemberBinding="{Binding IsActive}" Width="90">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FDE8E8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#E3F6EC"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="غیرفعال"/>
                                                <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Text" Value="فعال"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Border>

        <!-- ═══ Status footer ═══ -->
        <Border Grid.Row="3" Style="{StaticResource FormSectionCard}" Padding="12,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontSize="12">
                    <Run Text="تعداد کل کالاها:"/>
                    <Run Text="{Binding TotalCount}" FontWeight="Bold"/>
                    <Run Text="   |   فعال:"/>
                    <Run Text="{Binding ActiveCount}" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}"/>
                </TextBlock>
                <TextBlock DockPanel.Dock="Left" Text="برای گروه‌بندی، عنوان ستون را به نوار بالای جدول بکشید."
                           FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
