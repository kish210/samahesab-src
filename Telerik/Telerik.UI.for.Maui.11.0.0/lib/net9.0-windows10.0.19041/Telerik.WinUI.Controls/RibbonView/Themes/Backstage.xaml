<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:telerik="using:Telerik.UI.Xaml.Controls"
    xmlns:telerikRibbonViewPrimitives="using:Telerik.UI.Xaml.Controls.RibbonView.Primitives">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/RibbonView/Themes/Resources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="BackstageGroupSeparator" TargetType="telerik:RadRibbonBackstageItem">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="telerik:RadRibbonBackstageItem">
                    <StackPanel>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="ContentPanel" To="{ThemeResource TelerikControlDisabledOpacity}" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ContentPanel" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Margin="20 0 0 0" VerticalAlignment="Center"/>
                        <Rectangle Height="1" Margin="10 4" Fill="{ThemeResource TelerikRibbonView_Backstage_SeparatorBorderBrush}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="RadRibbonBackstageItemTemplate" TargetType="telerik:RadRibbonBackstageItem">
        <Grid x:Name="wrapper" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="BackgroundVisual.Background" Value="{ThemeResource TelerikRibbonView_Backstage_ItemBackgroundPointerOver}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Target="BackgroundVisual.Background" Value="{ThemeResource TelerikRibbonView_Backstage_ItemBackgroundSelected}"/>
                            <Setter Target="BackgroundVisual.BorderBrush" Value="{ThemeResource TelerikRibbonView_Backstage_ItemBorderBrushSelected}"/>
                            <Setter Target="Pill.Opacity" Value="1"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="HeaderElement.Opacity" Value="{ThemeResource TelerikControlDisabledOpacity}"/>
                            <Setter Target="BackgroundVisual.Background" Value="Transparent"/>
                            <Setter Target="BackgroundVisual.BorderBrush" Value="Transparent"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="ButtonStates">
                    <VisualState x:Name="ButtonNormal"/>
                    <VisualState x:Name="ButtonPointerOver">
                        <VisualState.Setters>
                            <Setter Target="BackgroundVisual.Background" Value="{ThemeResource TelerikRibbonView_Backstage_ItemBackgroundPointerOver}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="TabItemStates">
                    <VisualState x:Name="TabItemUnSelected"/>
                    <VisualState x:Name="TabItemPointerOver">
                        <VisualState.Setters>
                            <Setter Target="BackgroundVisual.Background" Value="{ThemeResource TelerikRibbonView_Backstage_ItemBackgroundPointerOver}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="TabItemSelected">
                        <VisualState.Setters>
                            <Setter Target="BackgroundVisual.Background" Value="{ThemeResource TelerikRibbonView_Backstage_ItemBackgroundSelected}"/>
                            <Setter Target="BackgroundVisual.BorderBrush" Value="{ThemeResource TelerikRibbonView_Backstage_ItemBorderBrushSelected}"/>
                            <Setter Target="Pill.Opacity" Value="1"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="BackgroundVisual"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"/>
            <Rectangle x:Name="Pill" Opacity="0"
                       Fill="{ThemeResource TelerikListView_ItemBorderBrushSelected}"
                       Width="3" RadiusX="5" RadiusY="5"
                       Margin="{Binding Margin, RelativeSource={RelativeSource TemplatedParent},
                       Converter={StaticResource ThicknessToOrientedThicknessConverter}, ConverterParameter=Left}"
                       HorizontalAlignment="Left"
                       RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <ScaleTransform ScaleY="0.8" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <StackPanel Orientation="Horizontal" x:Name="ContentPanel" Margin="{TemplateBinding Padding}">
                <ContentPresenter x:Name="Icon"
                                  Content="{TemplateBinding Icon}"
                                  Foreground="{TemplateBinding HeaderForeground}"
                                  Margin="0 0 5 0"
                                  Visibility="Collapsed"/>
                <ContentControl x:Name="HeaderElement"
                                IsTabStop="False"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Foreground="{TemplateBinding HeaderForeground}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </StackPanel>
        </Grid>
    </ControlTemplate>

    <Style x:Key="RadRibbonBackstageItemStyle" TargetType="telerik:RadRibbonBackstageItem">
        <Setter Property="Template" Value="{StaticResource RadRibbonBackstageItemTemplate}"/>
        <Setter Property="Foreground" Value="{ThemeResource TelerikRibbonView_Backstage_ContentForeground}"/>
        <Setter Property="HeaderForeground" Value="{ThemeResource TelerikRibbonView_Backstage_ItemHeaderForeground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="MinWidth" Value="5"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="{ThemeResource TelerikRibbonView_Backstage_ItemPadding}"/>
        <Setter Property="Margin" Value="4 0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style TargetType="telerik:RadRibbonBackstageItem" BasedOn="{StaticResource RadRibbonBackstageItemStyle}"/>

    <ControlTemplate TargetType="telerik:RadRibbonButton" x:Key="BackstageCloseButtonTemplate">
        <Grid x:Name="Root"
              Background="{TemplateBinding Background}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource TelerikRibbonView_Backstage_ItemBackgroundPointerOver}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource TelerikRibbonView_Backstage_ItemBackgroundSelected}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="Root" To="{ThemeResource TelerikControlDisabledOpacity}" Duration="0:0:0.1"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Viewbox Stretch="None" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                <ContentPresenter Content="{TemplateBinding LargeIcon}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="Left"
                                  Margin="{TemplateBinding Padding}"
                                  CornerRadius="17" Padding="8"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="1" />
            </Viewbox>
        </Grid>
    </ControlTemplate>

    <Style x:Key="BackstageCloseButtonStyle" TargetType="telerik:RadRibbonButton">
        <Setter Property="Template" Value="{StaticResource BackstageCloseButtonTemplate}"/>
        <Setter Property="Foreground" Value="{ThemeResource TelerikRibbonView_Backstage_ItemHeaderForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TelerikRibbonView_Backstage_ItemHeaderForeground}" />
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="25 4 0 4"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="LargeIcon">
            <Setter.Value>
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="16"
                          Glyph="&#xE72B;"
                          VerticalAlignment="Center"/>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="BackstageTemplate" TargetType="telerik:RadRibbonBackstage">
        <Grid Background="{TemplateBinding Background}"
              ColumnDefinitions="Auto,*">
            <Grid.RowDefinitions>
                <!--<RowDefinition Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RibbonTitleBarHeight, Converter={StaticResource DoubleToGridLengthConverter}, FallbackValue=32}" />-->
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="TitleBackground" Grid.Column="1"
                    Background="{ThemeResource TelerikRibbonView_Backstage_TitleBarBackground}">
                <telerikRibbonViewPrimitives:WindowTitle x:Name="WindowTitle"
                                                         Foreground="{ThemeResource TelerikRibbonView_Backstage_HeaderForeground}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
            </Border>
            <Grid Grid.ColumnSpan="2" Grid.Row="1"
                  ColumnDefinitions="Auto,*">
                <Border x:Name="HeaderBackground"
                        Grid.RowSpan="2"
                        Background="{TemplateBinding HeaderBackground}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CornerRadius, Converter={StaticResource CornerRadiusConverter}, ConverterParameter=TopLeft}"/>
                <Grid RowDefinitions="Auto,*">
                    <telerik:RadRibbonButton x:Name="CloseButton"
                                             Style="{StaticResource BackstageCloseButtonStyle}"
                                             Width="{Binding ElementName=ItemsPresenter, Path=ActualWidth}"
                                             CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CornerRadius, Converter={StaticResource CornerRadiusConverter}, ConverterParameter=TopLeft}"/>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                  BorderThickness="0" Padding="0">
                        <ItemsPresenter x:Name="ItemsPresenter"/>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="ContentBorder" Grid.Column="1">
                    <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                  Padding="0" BorderThickness="1"
                                  BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentElement"
                                              Foreground="{TemplateBinding Foreground}"
                                              Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsContentPreserved, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" 
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                            <Grid x:Name="ContentElementsPanel" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsContentPreserved, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style x:Key="RadRibbonBackstageStyle" TargetType="telerik:RadRibbonBackstage">
        <Setter Property="Template" Value="{StaticResource BackstageTemplate}"/>
        <Setter Property="CornerRadius" Value="{ThemeResource TelerikOverlayCornerRadius}"/>
        <Setter Property="Foreground" Value="{ThemeResource TelerikRibbonView_Backstage_ContentForeground}"/>
        <Setter Property="Background" Value="{ThemeResource TelerikRibbonView_Backstage_ContentBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TelerikRibbonView_Backstage_BorderBrush}"/>
        <Setter Property="HeaderBackground" Value="{ThemeResource TelerikRibbonView_Backstage_HeaderBackground}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="ItemContainerStyleSelector">
            <Setter.Value>
                <telerik:BackstageContainerStyleSelector SeparatorStyle="{StaticResource BackstageGroupSeparator}" />
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel MinWidth="170"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style TargetType="telerik:RadRibbonBackstage" BasedOn="{StaticResource RadRibbonBackstageStyle}"/>
</ResourceDictionary>

