        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="InteractionStates">
                    <VisualState x:Name="Pristine"/>
                    <VisualState x:Name="Opened">
                        <VisualState.Setters>
                            <Setter Target="PART_Button.Background" Value="{ThemeResource TelerikButton_BackgroundOpened}"/>
                            <Setter Target="PART_DropDownButton.Background" Value="{ThemeResource TelerikButton_BackgroundOpened}"/>
