<Window x:Class="SamaHesab.WPF.Views.Shell.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="سامانه جامع سما حساب - ورود"
        Height="600" Width="940"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border CornerRadius="18" Background="#161C2A" BorderBrush="#1E3A5F" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" Opacity="0.5" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ Right: Branding panel ═══ -->
            <Border Grid.Column="0" CornerRadius="18,0,0,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E3A8A" Offset="0"/>
                        <GradientStop Color="#324A7A" Offset="0.55"/>
                        <GradientStop Color="#4B5F97" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- subtle decorative circles -->
                    <Ellipse Width="320" Height="320" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-120,-120,0,0" Fill="#FFFFFF" Opacity="0.05"/>
                    <Ellipse Width="240" Height="240" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-90,-90" Fill="#FFFFFF" Opacity="0.06"/>

                    <StackPanel VerticalAlignment="Center" Margin="44,0">
                        <!-- Company logo -->
                        <Border CornerRadius="18" HorizontalAlignment="Right" Background="#FFFFFF"
                                Padding="18,14">
                            <Border.Effect>
                                <DropShadowEffect Color="#0B1220" BlurRadius="24" Opacity="0.35" ShadowDepth="0"/>
                            </Border.Effect>
                            <Image Source="pack://application:,,,/Assets/Images/logo.png"
                                   Width="170" Stretch="Uniform" FlowDirection="LeftToRight"/>
                        </Border>

                        <TextBlock Text="سما حساب" FontSize="34" FontWeight="Bold" Foreground="White"
                                   Margin="0,22,0,2" FontFamily="{StaticResource VazirFont}"/>
                        <TextBlock Text="سامانه جامع مدیریت مالی و کسب‌وکار" FontSize="14"
                                   Foreground="#DCE2EE" FontFamily="{StaticResource VazirFont}"/>

                        <Rectangle Height="1" Fill="#FFFFFF" Opacity="0.18" Margin="0,26,0,22"/>

                        <!-- Feature bullets -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <materialDesign:PackIcon Kind="ChartBoxOutline" Width="22" Height="22" Foreground="#BAC5DD" VerticalAlignment="Center"/>
                            <TextBlock Text="حسابداری دو‌طرفه و گزارش‌های مالی" Foreground="#EEF1F7" FontSize="13"
                                       Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource VazirFont}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <materialDesign:PackIcon Kind="Warehouse" Width="22" Height="22" Foreground="#BAC5DD" VerticalAlignment="Center"/>
                            <TextBlock Text="مدیریت انبار، خرید و فروش" Foreground="#EEF1F7" FontSize="13"
                                       Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource VazirFont}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="22" Height="22" Foreground="#BAC5DD" VerticalAlignment="Center"/>
                            <TextBlock Text="امنیت و کنترل دسترسی کاربران" Foreground="#EEF1F7" FontSize="13"
                                       Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource VazirFont}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- brand footer -->
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="44,0,44,26">
                        <TextBlock Text="سماع رایانه کیش" Foreground="White" FontWeight="SemiBold"
                                   FontSize="13" FontFamily="{StaticResource VazirFont}"/>
                        <TextBlock Text="kishwifi.com" Foreground="#BAC5DD" FontSize="12"
                                   FontFamily="{StaticResource VazirFont}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Left: Login form ═══ -->
            <Grid Grid.Column="1" Margin="46,0">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ورود به سیستم" FontSize="24" FontWeight="Bold" Foreground="White"
                                   VerticalAlignment="Center" FontFamily="{StaticResource VazirFont}"/>
                        <!-- Program badge: حسابداری / فروشگاه / رستوران -->
                        <Border Background="#1E3A8A" BorderBrush="#4B5F97" BorderThickness="1" CornerRadius="8"
                                Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ModuleName}" Foreground="#BAC5DD" FontSize="13" FontWeight="SemiBold"
                                       FontFamily="{StaticResource VazirFont}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="برای ادامه، اطلاعات حساب کاربری خود را وارد کنید" FontSize="12"
                               Foreground="#94A3B8" Margin="0,4,0,0" FontFamily="{StaticResource VazirFont}"/>

                    <!-- error -->
                    <Border Background="#3F1D1D" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8"
                            Padding="10,8" Margin="0,18,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="#FCA5A5" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" FontSize="12"
                                       Margin="8,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"
                                       FontFamily="{StaticResource VazirFont}"/>
                        </StackPanel>
                    </Border>

                    <!-- Company -->
                    <TextBlock Text="شرکت" Foreground="#94A3B8" FontSize="12" Margin="2,20,0,6" FontFamily="{StaticResource VazirFont}"/>
                    <Border Background="#1B2843" BorderBrush="#283A60" BorderThickness="1" CornerRadius="10">
                        <DockPanel>
                            <materialDesign:PackIcon DockPanel.Dock="Right" Kind="OfficeBuilding" Width="20" Height="20"
                                                     Foreground="#6E83AE" VerticalAlignment="Center" Margin="12,0,8,0"/>
                            <ComboBox Background="Transparent" BorderThickness="0" Foreground="White"
                                      ItemsSource="{Binding Companies}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedCompanyId}" Padding="4,11"
                                      FontFamily="{StaticResource VazirFont}">
                                <!-- T9: آیتم‌های لیستِ بازشو روی پاپ‌آپِ روشن، متنِ تیره تا خوانا باشند (نه سفیدِ ناخوانا) -->
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="#1B2843"/>
                                        <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </DockPanel>
                    </Border>

                    <!-- Username -->
                    <TextBlock Text="نام کاربری" Foreground="#94A3B8" FontSize="12" Margin="2,16,0,6" FontFamily="{StaticResource VazirFont}"/>
                    <Border Background="#1B2843" BorderBrush="#283A60" BorderThickness="1" CornerRadius="10">
                        <DockPanel>
                            <materialDesign:PackIcon DockPanel.Dock="Right" Kind="AccountOutline" Width="20" Height="20"
                                                     Foreground="#6E83AE" VerticalAlignment="Center" Margin="12,0,8,0"/>
                            <TextBox x:Name="TxtUsername" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                     Padding="4,11" FontFamily="{StaticResource VazirFont}" VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                    </Border>

                    <!-- Password -->
                    <TextBlock Text="رمز عبور" Foreground="#94A3B8" FontSize="12" Margin="2,16,0,6" FontFamily="{StaticResource VazirFont}"/>
                    <Border Background="#1B2843" BorderBrush="#283A60" BorderThickness="1" CornerRadius="10">
                        <DockPanel>
                            <materialDesign:PackIcon DockPanel.Dock="Right" Kind="LockOutline" Width="20" Height="20"
                                                     Foreground="#6E83AE" VerticalAlignment="Center" Margin="12,0,8,0"/>
                            <PasswordBox x:Name="PwdBox" Padding="4,11"
                                         Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                         FontFamily="{StaticResource VazirFont}" VerticalContentAlignment="Center"
                                         PasswordChanged="PwdBox_PasswordChanged">
                                <PasswordBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
                                </PasswordBox.InputBindings>
                            </PasswordBox>
                        </DockPanel>
                    </Border>

                    <!-- Login button -->
                    <Button Content="{Binding LoginButtonText}" Height="50" FontSize="15" FontWeight="SemiBold"
                            FontFamily="{StaticResource VazirFont}" Margin="0,26,0,0"
                            Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotLoading}" Foreground="White"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="11">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#4B5F97" Offset="0"/>
                                            <GradientStop Color="#324A7A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#324A7A"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnForgotPassword" Content="رمزِ عبور را فراموش کرده‌ام؟" HorizontalAlignment="Center" Margin="0,14,0,0"
                            Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="12.5" Cursor="Hand"
                            FontFamily="{StaticResource VazirFont}" Click="ForgotPassword_Click" Visibility="Collapsed"/>

                    <!-- U-MULTI-COMPANY-1 — ساختِ شرکتِ جدید (چند شرکت در یک DBِ مشترک) -->
                    <Button x:Name="BtnNewCompany" Content="＋ افزودنِ شرکتِ جدید" HorizontalAlignment="Center" Margin="0,6,0,0"
                            Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="12.5" Cursor="Hand"
                            FontFamily="{StaticResource VazirFont}" Click="NewCompany_Click" Visibility="Collapsed"/>

                    <Button x:Name="BtnSettings" Content="⚙  تنظیمات اتصال به پایگاه داده" HorizontalAlignment="Center" Margin="0,10,0,0"
                            Background="Transparent" Foreground="#6E83AE" BorderThickness="0" FontSize="13" Cursor="Hand"
                            FontFamily="{StaticResource VazirFont}" Click="ConnectionSettings_Click"/>

                    <TextBlock x:Name="VersionText" Text="© ۱۴۰۴ سماع رایانه کیش" Foreground="#64748B"
                               FontFamily="{StaticResource VazirFont}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Close button -->
            <Button Content="✕" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="14,14,0,0" Width="30" Height="30"
                    Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                    FontSize="15" Cursor="Hand" Grid.ColumnSpan="2"
                    Click="CloseButton_Click" FlowDirection="LeftToRight"/>
        </Grid>
    </Border>
</Window>
