<UserControl x:Class="SamaHesab.WPF.Views.Treasury.InterBranchTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Blue700" Color="#324A7A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Blue700}"/><Setter Property="Margin" Value="2,0,2,4"/>
        </Style>
        <Style x:Key="Fld" TargetType="Control">
            <Setter Property="Height" Value="34"/><Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="12.5"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <TextBlock Text="سندِ تسویهٔ بین‌شعبه" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Blue700}"/>
            <TextBlock Text="انتقالِ وجه بین دو شعبه — دو سندِ قطعیِ متوازن با «حساب جاریِ فی‌مابینِ شعب» ساخته می‌شود."
                       FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" VerticalAlignment="Top" MaxWidth="640" HorizontalAlignment="Right"
                Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- شعبهٔ مبدأ / مقصد -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Style="{StaticResource Lbl}" Text="شعبهٔ مبدأ *"/>
                    <ComboBox Style="{StaticResource Fld}" ItemsSource="{Binding Branches}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedFromBranchId}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Style="{StaticResource Lbl}" Text="شعبهٔ مقصد *"/>
                    <ComboBox Style="{StaticResource Fld}" ItemsSource="{Binding Branches}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedToBranchId}"/>
                </StackPanel>

                <!-- حساب مبدأ / مقصد -->
                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Style="{StaticResource Lbl}" Text="صندوق/بانکِ مبدأ (بستانکار) *"/>
                    <ComboBox Style="{StaticResource Fld}" ItemsSource="{Binding Accounts}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedFromAccountId}"
                              IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Style="{StaticResource Lbl}" Text="صندوق/بانکِ مقصد (بدهکار) *"/>
                    <ComboBox Style="{StaticResource Fld}" ItemsSource="{Binding Accounts}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedToAccountId}"
                              IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"/>
                </StackPanel>

                <!-- مبلغ / تاریخ -->
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Style="{StaticResource Lbl}" Text="مبلغ (ریال) *"/>
                    <TextBox Style="{StaticResource Fld}" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Style="{StaticResource Lbl}" Text="تاریخ *"/>
                    <TextBox Style="{StaticResource Fld}" Text="{Binding Date}"/>
                </StackPanel>

                <!-- حساب فی‌مابین -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                    <TextBlock Style="{StaticResource Lbl}" Text="حساب جاریِ فی‌مابینِ شعب (واسط)"/>
                    <ComboBox Style="{StaticResource Fld}" ItemsSource="{Binding Accounts}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedInterBranchAccountId}"
                              IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"/>
                    <TextBlock Style="{StaticResource Lbl}" Text="شرح"/>
                    <TextBox Style="{StaticResource Fld}" Height="48" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             Text="{Binding Description}"/>
                </StackPanel>

                <!-- دکمه ثبت -->
                <Button Grid.Row="4" Grid.Column="2" Content="ثبتِ انتقال" HorizontalAlignment="Left"
                        Padding="22,8" FontSize="13" FontWeight="Bold" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Background="{StaticResource Blue700}"
                        Command="{Binding TransferCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
