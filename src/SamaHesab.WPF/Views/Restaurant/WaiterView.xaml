<UserControl x:Class="SamaHesab.WPF.Views.Restaurant.WaiterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:NumberFormatConverter x:Key="Num"/>

        <!-- میز: بزرگ و لمسی، رنگ بر اساس وضعیت -->
        <Style x:Key="TableTile" TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="14" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusCode}" Value="0"><Setter Property="Background" Value="#16A34A"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusCode}" Value="1"><Setter Property="Background" Value="#DC2626"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusCode}" Value="2"><Setter Property="Background" Value="#D97706"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusCode}" Value="3"><Setter Property="Background" Value="#2563EB"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FoodTile" TargetType="Button">
            <Setter Property="Height" Value="86"/><Setter Property="Width" Value="150"/>
            <Setter Property="Margin" Value="5"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#EFF4FF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccent}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ نوار بالا ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="صندوق گارسون" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentTableName, StringFormat=' — میز {0}'}" FontSize="18"
                           VerticalAlignment="Center" Margin="6,0,0,0"
                           Visibility="{Binding ShowOrder, Converter={StaticResource BoolVis}}"/>
                <Button Content="بروزرسانی ⟳" DockPanel.Dock="Left" Padding="14,6" FontSize="14"
                        Command="{Binding RefreshCommand}"
                        Visibility="{Binding ShowOrder, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                <TextBlock Text="{Binding StatusText}" DockPanel.Dock="Left" Margin="16,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" FontSize="13"/>
                <TextBlock/>
            </DockPanel>
        </Border>

        <!-- ═══ صفحه میزها (وقتی سفارش باز نیست) ═══ -->
        <Grid Grid.Row="1" Visibility="{Binding ShowOrder, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- تب سالن‌ها -->
            <ItemsControl Grid.Row="0" ItemsSource="{Binding Halls}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Name}" Height="50" MinWidth="130" Margin="0,0,8,0"
                                FontSize="16" FontWeight="SemiBold" Cursor="Hand"
                                Command="{Binding DataContext.SelectHallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- شبکه‌ی میزها -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Tables}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TableTile}"
                                    Command="{Binding DataContext.OpenTableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Capacity, StringFormat='{}{0} نفره'}" FontSize="13" HorizontalAlignment="Center" Opacity="0.9" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Status}" FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ═══ صفحه سفارش (وقتی میز باز است) ═══ -->
        <Grid Grid.Row="1" Visibility="{Binding ShowOrder, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- سبد سفارش -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="10" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding OrderNumber, StringFormat='سفارش {0}'}"
                               FontSize="15" FontWeight="Bold" Margin="2,0,2,8"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding OrderLines}" BorderThickness="0"
                             Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="2,7">
                                    <DockPanel>
                                        <TextBlock Text="{Binding LineTotal, Converter={StaticResource Num}}" DockPanel.Dock="Left"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="90" TextAlignment="Left"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Qty, StringFormat='{}{0} ×'}" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                                                <TextBlock Text="{Binding UnitPrice, Converter={StaticResource Num}}" FontSize="12" Foreground="{DynamicResource MutedText}" Margin="4,0,0,0"/>
                                                <Border Background="#E5E7EB" CornerRadius="6" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Status}" FontSize="11"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="2,8,2,0">
                        <DockPanel Margin="0,3">
                            <TextBlock Text="جمع کل" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding GrandTotal, Converter={StaticResource Num}}" DockPanel.Dock="Left"
                                       FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}"/>
                        </DockPanel>
                        <Button Content="🍳  ارسال به آشپزخانه" Height="50" FontSize="16" FontWeight="Bold" Margin="0,8,0,0"
                                Background="#D97706" Foreground="White" BorderThickness="0" Cursor="Hand"
                                Command="{Binding SendToKitchenCommand}"/>
                        <Button Content="💳  تسویه و آزادسازی میز" Height="50" FontSize="16" FontWeight="Bold" Margin="0,8,0,0"
                                Background="#16A34A" Foreground="White" BorderThickness="0" Cursor="Hand"
                                Command="{Binding SettleCommand}"/>
                        <Button Content="بازگشت به میزها" Height="42" FontSize="14" Margin="0,8,0,0"
                                Cursor="Hand" Command="{Binding BackToTablesCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- منو -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0" ItemsSource="{Binding Categories}" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" Height="44" MinWidth="96" Margin="0,0,6,6"
                                    FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource FoodTile}"
                                        Command="{Binding DataContext.AddMenuItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Price, Converter={StaticResource Num}}" FontSize="13"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource PrimaryAccent}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
