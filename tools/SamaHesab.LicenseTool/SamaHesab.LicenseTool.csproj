<Project Sdk="Microsoft.NET.Sdk">
  <!--
    فاز ۱۲ P-G7 — ابزارِ صدورِ لایسنسِ وندور (keygen + sign).
    ⚠️ این پروژه به مشتری تحویل داده نمی‌شود. کلیدِ خصوصی فقط نزدِ وندور است.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SamaHesab.LicenseTool</RootNamespace>
    <AssemblyName>SamaHesab.LicenseTool</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SamaHesab.Application\SamaHesab.Application.csproj" />
  </ItemGroup>
</Project>
