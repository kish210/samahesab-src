<UserControl x:Class="SamaHesab.WPF.Views.Inventory.WarehouseOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <Style x:Key="Kpi" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="KpiVal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryAccent}"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="KpiCap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- سرتیتر -->
            <RowDefinition Height="Auto"/>   <!-- KPI -->
            <RowDefinition Height="Auto"/>   <!-- نوارِ ابزار -->
            <RowDefinition Height="*"/>      <!-- فهرست -->
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="2,0,2,10" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right">
                <TextBlock Text="نمای انبار" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                <TextBlock Text="{Binding TodayText, StringFormat='امروز: {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="📋 گزارشِ سفارش" Command="{Binding OpenReorderReportCommand}" Style="{StaticResource ErpBtnSecondary}" Margin="0,0,8,0"/>
                <Button Content="🔄 انتقالِ انبار" Command="{Binding OpenStockTransferCommand}" Style="{StaticResource ErpBtnSecondary}" Margin="0,0,8,0"/>
                <Button Content="بروزرسانی  F5" Command="{Binding RefreshCommand}" Style="{StaticResource ErpBtnSecondary}"/>
            </StackPanel>
        </DockPanel>

        <!-- نوارِ KPI -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource Kpi}">
                <StackPanel><TextBlock Style="{StaticResource KpiCap}" Text="کالاهای ناموجود"/>
                    <TextBlock Style="{StaticResource KpiVal}" Foreground="#C2403A" Text="{Binding OutOfStockCount, Converter={StaticResource Num}, ConverterParameter=قلم}"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Kpi}">
                <StackPanel><TextBlock Style="{StaticResource KpiCap}" Text="زیرِ حداقلِ موجودی"/>
                    <TextBlock Style="{StaticResource KpiVal}" Foreground="#C9911B" Text="{Binding LowStockCount, Converter={StaticResource Num}, ConverterParameter=قلم}"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Kpi}">
                <StackPanel><TextBlock Style="{StaticResource KpiCap}" Text="پیشنهادِ سفارش"/>
                    <TextBlock Style="{StaticResource KpiVal}" Text="{Binding ReorderSuggestions, Converter={StaticResource Num}, ConverterParameter=قلم}"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Kpi}" Margin="0">
                <StackPanel><TextBlock Style="{StaticResource KpiCap}" Text="ارزشِ موجودی (ریال)"/>
                    <TextBlock Style="{StaticResource KpiVal}" FontSize="18" Text="{Binding StockValue, Converter={StaticResource Num}}"/></StackPanel>
            </Border>
        </UniformGrid>

        <!-- نوارِ ابزارِ فهرست -->
        <DockPanel Grid.Row="2" Margin="0,0,0,6" LastChildFill="False">
            <TextBlock DockPanel.Dock="Right" Text="اقلامِ نیازمندِ توجه (زیرِ حداقل / ناموجود)" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
            <TextBox DockPanel.Dock="Left" Width="220" Height="30" VerticalContentAlignment="Center"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ErpInput}"/>
        </DockPanel>

        <!-- فهرستِ اقلام -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackground}" CornerRadius="10">
            <DataGrid ItemsSource="{Binding AttentionItems}" SelectedItem="{Binding SelectedItem}"
                      Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" RowHeight="28" GridLinesVisibility="Horizontal"
                      FontFamily="{StaticResource VazirFont}" BorderThickness="0">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📊 کاردکسِ کالا"
                                  Command="{Binding PlacementTarget.DataContext.ViewKardexCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="90"/>
                    <DataGridTextColumn Header="نامِ کالا" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="موجودی" Binding="{Binding OnHand, Converter={StaticResource Num}}" Width="90"/>
                    <DataGridTextColumn Header="حداقل" Binding="{Binding MinStock, Converter={StaticResource Num}}" Width="90"/>
                    <DataGridTextColumn Header="کسری" Binding="{Binding Shortage, Converter={StaticResource Num}}" Width="90"/>
                    <DataGridTextColumn Header="پیشنهادِ سفارش" Binding="{Binding SuggestedQty, Converter={StaticResource Num}}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
