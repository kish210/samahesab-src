<UserControl x:Class="SamaHesab.WPF.Views.CRM.CustomerListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- compact toolbar: actions (left) + search (right) -->
        <Border Grid.Row="0" Style="{StaticResource ErpToolbar}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ErpToolButton}" Command="{Binding NewCustomerCommand}">
                        <StackPanel><Path Data="{StaticResource IcUserPlus}" Style="{StaticResource ErpToolSvg}" Width="18" Height="18" HorizontalAlignment="Center" Stroke="{DynamicResource PrimaryAccent}"/><TextBlock Text="مشتری جدید" TextAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ErpToolButton}" Command="{Binding ExportCommand}">
                        <StackPanel><Path Data="{StaticResource IcExcel}" Style="{StaticResource ErpToolSvg}" Width="18" Height="18" HorizontalAlignment="Center" Stroke="{DynamicResource SuccessColor}"/><TextBlock Text="اکسل" TextAlignment="Center"/></StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="6,6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Path Data="{StaticResource IcSearch}" Style="{StaticResource ErpToolSvg}" Width="18" Height="18" VerticalAlignment="Center" Stroke="{DynamicResource SecondaryText}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="6,0" VerticalAlignment="Center">
                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}" Margin="3" Padding="0">
            <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Customers}" RowHeight="28"
                      SelectedItem="{Binding SelectedCustomer}">
                <!-- CC-5 — دابل‌کلیک/راست‌کلیک → کارتِ ۳۶۰° -->
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenCardCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="👤 کارتِ مشتری (۳۶۰°)"
                                  Command="{Binding PlacementTarget.DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="90"/>
                    <DataGridTextColumn Header="نام / شرکت" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile}" Width="130"/>
                    <DataGridTextColumn Header="سطح قیمت" Binding="{Binding PriceLevel}" Width="100"/>
                    <DataGridTextColumn Header="مانده حساب" Binding="{Binding Balance, StringFormat={}{0:#,##0}}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ErpToolbar}" BorderThickness="0,1,0,0">
            <TextBlock FontSize="12" HorizontalAlignment="Right" Margin="4,2" VerticalAlignment="Center">
                <Run Text="تعداد مشتریان:"/><Run Text="{Binding TotalCount}" FontWeight="Bold"/>
                <Run Text="   |   جمع مانده:"/><Run Text="{Binding TotalBalance, StringFormat={}{0:#,##0}}" FontWeight="Bold" Foreground="{DynamicResource DangerColor}"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
