<UserControl x:Class="SamaHesab.WPF.Views.Sales.SalesDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <!-- F5 = بازخوانی (کیبوردمحور، هم‌راستا با بقیهٔ داشبوردها) -->
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <Style x:Key="Kpi" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6"/>
            <Setter Property="Width" Value="230"/><Setter Property="Height" Value="112"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="16,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceBackground}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KpiVal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryAccent}"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>
        <Style x:Key="KpiCap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="KpiSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="6,0,6,12" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right">
                <TextBlock Text="داشبورد فروش" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                <TextBlock FontSize="12.5" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0">
                    <Run Text="{Binding RepName, Mode=OneWay}"/><Run Text=" · امروز: "/><Run Text="{Binding TodayText, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="＋ فاکتور جدید" Command="{Binding NewInvoiceCommand}" Style="{StaticResource ErpBtnPrimary}" Margin="0,0,8,0"/>
                <Button Content="بروزرسانی" Command="{Binding RefreshCommand}" Style="{StaticResource ErpBtnSecondary}"/>
            </StackPanel>
        </DockPanel>

        <WrapPanel Grid.Row="1" VerticalAlignment="Top">
            <!-- فروشِ امروز -->
            <Button Style="{StaticResource Kpi}" Command="{Binding OpenInvoicesCommand}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiCap}" Text="فروشِ امروز"/>
                    <TextBlock Style="{StaticResource KpiVal}" Text="{Binding TodaySales, Converter={StaticResource Num}}"/>
                    <TextBlock Style="{StaticResource KpiSub}">
                        <Run Text="{Binding TodayCount, Converter={StaticResource Num}, Mode=OneWay}"/><Run Text=" فاکتور · میانگین "/><Run Text="{Binding TodayAverage, Converter={StaticResource Num}, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Button>
            <!-- فروشِ این ماه -->
            <Button Style="{StaticResource Kpi}" Command="{Binding OpenInvoicesCommand}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiCap}" Text="فروشِ این ماه"/>
                    <TextBlock Style="{StaticResource KpiVal}" Text="{Binding MonthSales, Converter={StaticResource Num}}"/>
                    <TextBlock Style="{StaticResource KpiSub}">
                        <Run Text="{Binding MonthCount, Converter={StaticResource Num}, Mode=OneWay}"/><Run Text=" فاکتور"/>
                    </TextBlock>
                </StackPanel>
            </Button>
            <!-- طلبِ نوصول -->
            <Button Style="{StaticResource Kpi}" Command="{Binding OpenInvoicesCommand}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiCap}" Text="طلبِ نوصول"/>
                    <TextBlock Style="{StaticResource KpiVal}" Foreground="#C9911B" Text="{Binding UnpaidTotal, Converter={StaticResource Num}}"/>
                    <TextBlock Style="{StaticResource KpiSub}">
                        <Run Text="{Binding UnpaidCount, Converter={StaticResource Num}, Mode=OneWay}"/><Run Text=" فاکتورِ مانده‌دار"/>
                    </TextBlock>
                </StackPanel>
            </Button>
            <!-- معوق -->
            <Button Style="{StaticResource Kpi}" Command="{Binding OpenInvoicesCommand}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiCap}" Text="معوق (سررسید گذشته)"/>
                    <TextBlock Style="{StaticResource KpiVal}" Foreground="#C2403A" Text="{Binding OverdueTotal, Converter={StaticResource Num}}"/>
                    <TextBlock Style="{StaticResource KpiSub}">
                        <Run Text="{Binding OverdueCount, Converter={StaticResource Num}, Mode=OneWay}"/><Run Text=" فاکتورِ معوق"/>
                    </TextBlock>
                </StackPanel>
            </Button>
        </WrapPanel>
    </Grid>
</UserControl>
