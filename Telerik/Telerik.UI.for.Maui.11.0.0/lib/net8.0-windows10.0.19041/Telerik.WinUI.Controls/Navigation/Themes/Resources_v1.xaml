<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Telerik.UI.Xaml.Controls"
    xmlns:core="using:Telerik.Core" 
    xmlns:data="using:Telerik.UI.Xaml.Controls.Data"
    xmlns:localNavigation="using:Telerik.UI.Xaml.Controls.Navigation"
    xmlns:telerikPrimitives="using:Telerik.UI.Xaml.Controls.Primitives"
    xmlns:localRadialMenu="using:Telerik.UI.Xaml.Controls.Navigation.Menu"
    xmlns:tabcontrol="using:Telerik.UI.Xaml.Controls.TabControl">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/Themes/CommonThemeResources_v1.xaml"/>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/Primitives/Themes/Resources_v1.xaml"/>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/Primitives/Themes/Buttons_v1.xaml"/>

        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark" Source="ms-appx:///Telerik.WinUI.Controls/Navigation/Themes/ThemeResourcesDark_v1.xaml"/>
                <ResourceDictionary x:Key="Light" Source="ms-appx:///Telerik.WinUI.Controls/Navigation/Themes/ThemeResourcesLight_v1.xaml"/>
                <ResourceDictionary x:Key="HighContrast" Source="ms-appx:///Telerik.WinUI.Controls/Navigation/Themes/ThemeResourcesHighContrast.xaml"/>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>

    </ResourceDictionary.MergedDictionaries>
    <local:WindowCommands x:Key="WindowCommands"/>
    <tabcontrol:TabItemCommands x:Key="TabItemCommands" />
    <core:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <x:Double x:Key="TelerikRadialMenu_IconFontSize">24</x:Double>
    <x:Double x:Key="TelerikRadialMenu_NavigationButtonThickness">2</x:Double>
    <x:Double x:Key="TelerikTabControl_PinCloseButtonWidthHeight">22</x:Double>
    <x:Double x:Key="TelerikTabControl_ScrollButtonWidth">22</x:Double>
    <x:Double x:Key="TelerikTabControl_DropDownButtonWidth">32</x:Double>
    <x:Double x:Key="TelerikTabControl_FontSize">14</x:Double>

    <!-- WindowResizeThumbStyle -->
    <Style x:Key="WindowResizeThumbStyle" TargetType="Thumb">
        <Setter Property="MinWidth" Value="5" />
        <Setter Property="MinHeight" Value="5" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadWindowTemplate -->
    <ControlTemplate x:Key="RadWindowTemplate" TargetType="local:RadWindow">
        <Grid x:Name="LayoutRoot">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled" />
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused" />
                    <VisualState x:Name="Unfocused" />
                </VisualStateGroup>
                <VisualStateGroup x:Name="DragStates">
                    <VisualState x:Name="NotDragging" />
                    <VisualState x:Name="Dragging" />
                    <VisualState x:Name="Resizing" />
                </VisualStateGroup>
                <VisualStateGroup x:Name="WindowStates">
                    <VisualState x:Name="NormalWindow" />
                    <VisualState x:Name="MaximizedRestricted"/>
                    <VisualState x:Name="Maximized">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot"
                                                           Storyboard.TargetProperty="CornerRadius">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <CornerRadius>0</CornerRadius>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot"
                                                           Storyboard.TargetProperty="BorderThickness">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <Thickness>0</Thickness>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot"
                                                           Storyboard.TargetProperty="Margin">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <Thickness>0</Thickness>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Minimized">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content"
                                                           Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <Visibility>Collapsed</Visibility>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot"
                                                           Storyboard.TargetProperty="HorizontalAlignment">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <HorizontalAlignment>Left</HorizontalAlignment>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot"
                                                           Storyboard.TargetProperty="VerticalAlignment">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <VerticalAlignment>Top</VerticalAlignment>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <telerikPrimitives:RadShadow>
                <Grid Background="{TemplateBinding Background}"
                      CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Rectangle x:Name="HeaderBackgroundVisual" Grid.Row="0" Fill="{ThemeResource TelerikWindow_HeaderBackground}" />

                    <Rectangle x:Name="BackgroundVisual" Grid.Row="1" Fill="{TemplateBinding BorderBackground}" />

                    <Grid x:Name="Header">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Thumb x:Name="titleThumb" Grid.ColumnSpan="2" Style="{StaticResource WindowResizeThumbStyle}" />

                        <Grid Grid.Column="0" Margin="10 0 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ContentControl x:Name="IconContent"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding Icon}"
                                            ContentTemplate="{TemplateBinding IconTemplate}" />

                            <ContentPresenter x:Name="HeaderContent" Grid.Column="1"
                                              Foreground="{ThemeResource TelerikWindow_HeaderForeground}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Grid>

                        <Border x:Name="PART_HeaderButtonsBorder" Grid.Column="1" Margin="0 0 10 0">
                            <StackPanel x:Name="HeaderButtons" Orientation="Horizontal">
                                <local:RadButton x:Name="PART_MinimizeButton"
                                                 Background="{x:Null}" Padding="2"
                                                 Command="{core:Static Member=local:WindowCommands.Minimize}"
                                                 Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip core:LocalizationManager.PropertyName="Content" core:LocalizationManager.Key="Minimize" />
                                    </ToolTipService.ToolTip>
                                    <FontIcon Foreground="{ThemeResource TelerikWindow_HeaderButtonForeground}"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="14"
                                              Glyph="&#xE921;"/>
                                </local:RadButton>
                                <local:RadButton x:Name="PART_RestoreButton"
                                                 Background="{x:Null}" Padding="2"
                                                 Command="{core:Static Member=local:WindowCommands.Restore}"
                                                 Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip core:LocalizationManager.PropertyName="Content" core:LocalizationManager.Key="Restore" />
                                    </ToolTipService.ToolTip>
                                    <FontIcon Foreground="{ThemeResource TelerikWindow_HeaderButtonForeground}"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="14"
                                              Glyph="&#xE923;"/>
                                </local:RadButton>
                                <local:RadButton x:Name="PART_MaximizeButton"
                                                 Background="{x:Null}" Padding="2"
                                                 Command="{core:Static Member=local:WindowCommands.Maximize}"
                                                 Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip core:LocalizationManager.PropertyName="Content" core:LocalizationManager.Key="Maximize" />
                                    </ToolTipService.ToolTip>
                                    <FontIcon Foreground="{ThemeResource TelerikWindow_HeaderButtonForeground}"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="14"
                                              Glyph="&#xE922;"/>
                                </local:RadButton>
                                <local:RadButton x:Name="PART_CloseButton"
                                                 Background="{x:Null}" Padding="2"
                                                 Command="{core:Static Member=local:WindowCommands.Close}"
                                                 Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip core:LocalizationManager.PropertyName="Content" core:LocalizationManager.Key="Close" />
                                    </ToolTipService.ToolTip>
                                    <FontIcon Foreground="{ThemeResource TelerikWindow_HeaderButtonForeground}"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="14"
                                              Glyph="&#xE711;"/>
                                </local:RadButton>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="Content" Grid.Row="1"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter x:Name="ContentElement"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Grid>
                </Grid>
            </telerikPrimitives:RadShadow>
        </Grid>
    </ControlTemplate>

    <!-- telerikNavigation:RadWindow -->
    <Style x:Key="RadWindowStyle" TargetType="local:RadWindow">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{ThemeResource TelerikWindow_Background}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TelerikWindow_BorderBrush}" />
        <Setter Property="BorderBackground" Value="{ThemeResource TelerikWindow_Background}" />
        <Setter Property="BorderThickness" Value="1 0 1 1" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="110" />

        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />

        <Setter Property="Header" Value="RadWindow" />

        <Setter Property="WindowStartupLocation" Value="Manual" />
        <Setter Property="WindowState" Value="Normal" />

        <Setter Property="CaptionHeight" Value="32" />
        <Setter Property="ResizeBorder" Value="8 6 10 10" />

        <Setter Property="Template" Value="{StaticResource RadWindowTemplate}" />
        <Setter Property="ModalBackground" Value="{ThemeResource TelerikWindow_ModalBackground}" />

        <Setter Property="TabNavigation" Value="Cycle" />
    </Style>

    <Style TargetType="local:RadWindow" BasedOn="{StaticResource RadWindowStyle}" />

    <!--#region RadialMenu-->
    <Style TargetType="localRadialMenu:RadialMenuButton">
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}"/>
        <Setter Property="FontSize" Value="{ThemeResource TelerikRadialMenu_IconFontSize}"/>
        <Setter Property="Foreground" Value="{ThemeResource TelerikRadialMenu_ButtonForeground}"/>
        <Setter Property="Background" Value="{ThemeResource TelerikRadialMenu_ButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TelerikRadialMenu_ButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="CornerRadius" Value="25"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Content" Value="&#xF8B0;"/>
        <Setter Property="AutomationProperties.Name" Value="RadialMenuButton"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="localRadialMenu:RadialMenuButton">
                    <Grid x:Name="RootGrid">
                        <Grid>
                            <Border x:Name="BackgroundGlyph"
                                    Width="{TemplateBinding Width}"
                                    Height="{TemplateBinding Height}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter x:Name="NormalGlyph"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontSize="{TemplateBinding FontSize}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            <TextBlock x:Name="BackGlyph"
                                       Text="&#xE0C4;"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <Border x:Name="FocusVisual"
                                IsHitTestVisible="False"
                                BorderBrush="{ThemeResource TelerikRadialMenu_ButtonBorderBrush_Focused}"
                                BorderThickness="2"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGlyph" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_ButtonBackground_Pressed}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NormalGlyph" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_ButtonForeground_Pressed}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackGlyph" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_ButtonForeground_Pressed}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGlyph" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_ButtonBackground_PointerOver}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NormalGlyph" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_ButtonForeground_PointerOver}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackGlyph" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_ButtonForeground_PointerOver}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGlyph" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_ButtonBackground_Disabled}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NormalGlyph" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_ButtonForeground_Disabled}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackGlyph" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_ButtonForeground_Disabled}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusVisual" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="NavigationStates">
                                <VisualState x:Name="Back">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NormalGlyph" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackGlyph" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Home"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="localRadialMenu:NavigationItemButton">
        <Setter Property="Foreground" Value="{ThemeResource TelerikRadialMenu_NavigationButtonForeground}"/>
        <Setter Property="Background" Value="{ThemeResource TelerikRadialMenu_NavigationButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TelerikRadialMenu_NavigationButtonBorderBrush}"/>
        <Setter Property="ContentGlyph" Value="&#xE70E;"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="localRadialMenu:NavigationItemButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_PathElement" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_NavigationButtonBackground_PointerOver}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ArrowGlyph" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_IconForeground_PointerOver}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_PathElement" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_ButtonBackground_Disabled}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ArrowGlyph" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_IconForeground_Disabled}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <TextBlock x:Name="PART_ArrowGlyph"
                                   Text="{TemplateBinding ContentGlyph}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                   FontSize="16"
                                   Canvas.ZIndex="102"
                                   IsHitTestVisible="False"/>
                        <Path x:Name="PART_PathElement"
                              Fill="{TemplateBinding Background}"
                              Stroke="{TemplateBinding BorderBrush}"
                              StrokeThickness="{ThemeResource TelerikRadialMenu_NavigationButtonThickness}"
                              Canvas.ZIndex="100"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="localRadialMenu:DecorationItemButton">
        <Setter Property="PointerOverBackgroundBrush" Value="{ThemeResource TelerikRadialMenu_StateItemButtonBackground_PointerOver}"/>
        <Setter Property="SelectedBackgroundBrush" Value="{ThemeResource TelerikRadialMenu_StateItemButtonBackground_Selected}"/>
        <Setter Property="SelectedPointerOverBackgroundBrush" Value="{ThemeResource TelerikRadialMenu_StateItemButtonBackground_SelectedPointerOver}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="localRadialMenu:DecorationItemButton">
                    <Canvas>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_NormalPathElement.Visibility" Value="Visible"/>
                                        <Setter Target="PART_PointerOverPathElement.Visibility" Value="Visible"/>
                                        <Setter Target="PART_ArrowElement.Fill" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=PointerOverBackgroundBrush}"/>
                                        <Setter Target="PART_ArrowElement.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected"/>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="PART_NormalPathElement.Visibility" Value="Visible"/>
                                        <Setter Target="PART_PointerOverPathElement.Fill" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedBackgroundBrush}"/>
                                        <Setter Target="PART_PointerOverPathElement.Visibility" Value="Visible"/>
                                        <Setter Target="PART_SelectedPathElement.Visibility" Value="Visible"/>
                                        <Setter Target="PART_ArrowElement.Fill" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedBackgroundBrush}"/>
                                        <Setter Target="PART_ArrowElement.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_NormalPathElement.Visibility" Value="Visible"/>
                                        <Setter Target="PART_PointerOverPathElement.Fill" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedPointerOverBackgroundBrush}"/>
                                        <Setter Target="PART_PointerOverPathElement.Visibility" Value="Visible"/>
                                        <Setter Target="PART_SelectedPathElement.Fill" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedPointerOverBackgroundBrush}"/>
                                        <Setter Target="PART_SelectedPathElement.Visibility" Value="Visible"/>
                                        <Setter Target="PART_ArrowElement.Fill" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedPointerOverBackgroundBrush}"/>
                                        <Setter Target="PART_ArrowElement.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Path x:Name="PART_ArrowElement"
                              Canvas.ZIndex="101" Visibility="Collapsed"/>
                        <Path x:Name="PART_NormalPathElement"
                              Fill="{ThemeResource TelerikRadialMenu_ContentMenuBackground}"
                              Canvas.ZIndex="101" Visibility="Collapsed"/>
                        <Path x:Name="PART_PointerOverPathElement"
                              Fill="{TemplateBinding PointerOverBackgroundBrush}"
                              Canvas.ZIndex="101" Visibility="Collapsed"/>
                        <Path x:Name="PART_SelectedPathElement"
                              Fill="{TemplateBinding SelectedBackgroundBrush}"
                              Canvas.ZIndex="101" Visibility="Collapsed"/>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Rectangle" x:Key="ContentMenuStyle">
        <Setter Property="Fill" Value="{ThemeResource TelerikRadialMenu_ContentMenuBackground}"/>
        <Setter Property="Stroke" Value="{ThemeResource TelerikRadialMenu_ContentMenuBorderBrush}"/>
        <Setter Property="StrokeThickness" Value="0"/>
    </Style>

    <Style TargetType="Rectangle" x:Key="NavigationMenuStyle">
        <Setter Property="Fill" Value="{ThemeResource TelerikRadialMenu_NavigationMenuBackground}"/>
        <Setter Property="Stroke" Value="{ThemeResource TelerikRadialMenu_NavigationMenuBorderBrush}"/>
        <Setter Property="StrokeThickness" Value="2"/>
    </Style>

    <Style TargetType="localNavigation:RadRadialMenu">
        <Setter Property="NavigationMenuBackgroundStyle" Value="{StaticResource NavigationMenuStyle}"/>
        <Setter Property="ContentMenuBackgroundStyle" Value="{StaticResource ContentMenuStyle}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="AutomationProperties.LiveSetting" Value="Assertive"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="MinWidth" Value="265"/>
        <Setter Property="MinHeight" Value="265"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="localNavigation:RadRadialMenu">
                    <localRadialMenu:RadialPanel x:Name="PART_Panel">
                        <localRadialMenu:RadialMenuButton x:Name="PART_Button" />
                    </localRadialMenu:RadialPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="localRadialMenu:MenuToolTip">
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Foreground" Value="{ThemeResource TelerikRadialMenu_ToolTipForeground}"/>
        <Setter Property="Background" Value="{ThemeResource TelerikRadialMenu_ToolTipBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TelerikRadialMenu_ToolTipBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <TransitionCollection>
                    <PopupThemeTransition/>
                </TransitionCollection>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="localRadialMenu:MenuToolTip">
                    <telerikPrimitives:RadShadow BlurRadius="12"
                                                 OffsetY="3"
                                                 ShadowOpacity="0.30"
                                                 Margin="12">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                VerticalAlignment="Center">
                            <ContentControl
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                FontSize="{TemplateBinding FontSize}" 
                                HorizontalAlignment="Left"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </telerikPrimitives:RadShadow>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="localRadialMenu:RadialMenuItemControl">
        <Setter Property="Foreground" Value="{ThemeResource TelerikRadialMenu_HeaderForeground}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="localRadialMenu:RadialMenuItemControl">
                    <StackPanel>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition From="Loading" GeneratedDuration="0:0:0.3" To="*">
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="HeaderPresenter">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="HeaderPresenter">
                                                <EasingDoubleKeyFrame KeyTime="0" Value="5">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <ExponentialEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <ExponentialEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="IconPresenter">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="IconPresenter">
                                                <EasingDoubleKeyFrame KeyTime="0" Value="12">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <ExponentialEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <ExponentialEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="IconPresenter">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="{ThemeResource TelerikRadialMenu_IconForeground}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition From="Loading" GeneratedDuration="0:0:0.3" To="Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="IconPresenter">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_IconForeground_Selected}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="HeaderPresenter">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_HeaderForeground_Selected}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="HeaderPresenter">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="HeaderPresenter">
                                                <EasingDoubleKeyFrame KeyTime="0" Value="5">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <ExponentialEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <ExponentialEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="IconPresenter">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="IconPresenter">
                                                <EasingDoubleKeyFrame KeyTime="0" Value="10">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <ExponentialEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <ExponentialEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition From="Loading" GeneratedDuration="0:0:0.3" To="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="IconPresenter">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_ButtonForeground_Disabled}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="HeaderPresenter">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_ButtonForeground_Disabled}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="HeaderPresenter">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="HeaderPresenter">
                                                <EasingDoubleKeyFrame KeyTime="0" Value="5">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <ExponentialEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <ExponentialEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="IconPresenter">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="IconPresenter">
                                                <EasingDoubleKeyFrame KeyTime="0" Value="10">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <ExponentialEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <ExponentialEase EasingMode="EaseIn"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="IconPresenter">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_IconForeground_PointerOver}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="HeaderPresenter">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_HeaderForeground_PointerOver}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Loading">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="IconPresenter">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_IconForeground}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Storyboard.TargetName="IconPresenter">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Storyboard.TargetName="HeaderPresenter">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="IconPresenter">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="10"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="IconPresenter">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_IconForeground_Selected}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="HeaderPresenter">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_HeaderForeground_Selected}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="IconPresenter">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_ButtonForeground_Disabled}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="HeaderPresenter">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRadialMenu_ButtonForeground_Disabled}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="IconPresenter"
                            Content="{TemplateBinding IconContent}"
                            Foreground="{ThemeResource TelerikRadialMenu_IconForeground}"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="{ThemeResource TelerikRadialMenu_IconFontSize}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            UseLayoutRounding="True">
                            <ContentPresenter.RenderTransform>
                                <CompositeTransform/>
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                        <ContentPresenter
                            x:Name="HeaderPresenter"
                            Content="{TemplateBinding Header}"
                            Foreground="{TemplateBinding Foreground}"
                            FontSize="{TemplateBinding FontSize}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom">
                            <ContentPresenter.RenderTransform>
                                <CompositeTransform/>
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
