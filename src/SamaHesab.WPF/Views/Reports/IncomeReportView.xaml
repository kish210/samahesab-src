<UserControl x:Class="SamaHesab.WPF.Views.Reports.IncomeReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{StaticResource ErpAppBg}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">

    <!-- کیبوردمحور: F5 = محاسبهٔ سود (هم‌راستا با سایر گزارش‌ها) -->
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <Style x:Key="SumCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ErpBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style x:Key="SumCap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource ErpTextMuted}"/>
        </Style>
        <Style x:Key="SumVal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- فیلتر -->
            <RowDefinition Height="Auto"/>   <!-- کارت‌های خلاصه -->
            <RowDefinition Height="*"/>      <!-- لیست ماهانه -->
        </Grid.RowDefinitions>

        <!-- نوار فیلتر -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="درآمد و سود" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}" VerticalAlignment="Center"/>
                <TextBlock Text="سود = فروش − خرید − هزینه − مالیات" FontSize="11.5" Foreground="{StaticResource ErpTextMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="از تاریخ" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Style="{StaticResource ErpInput}" Height="30" Width="100" Text="{Binding FromDate}" FlowDirection="LeftToRight" TextAlignment="Center">
                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding RunCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="تا تاریخ" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBox Style="{StaticResource ErpInput}" Height="30" Width="100" Text="{Binding ToDate}" FlowDirection="LeftToRight" TextAlignment="Center">
                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding RunCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <Button Style="{StaticResource ErpBtnPrimary}" Height="30" Padding="16,0" Margin="10,0,0,0" Command="{Binding RunCommand}" Content="محاسبه"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- کارت‌های خلاصه -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SumCard}">
                <StackPanel><TextBlock Text="فروش" Style="{StaticResource SumCap}"/><TextBlock Text="{Binding Sales, Converter={StaticResource Num}}" Style="{StaticResource SumVal}" Foreground="{StaticResource ErpBlue700}"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SumCard}">
                <StackPanel><TextBlock Text="خرید" Style="{StaticResource SumCap}"/><TextBlock Text="{Binding Purchase, Converter={StaticResource Num}}" Style="{StaticResource SumVal}"/></StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource SumCard}">
                <StackPanel><TextBlock Text="هزینه" Style="{StaticResource SumCap}"/><TextBlock Text="{Binding Expense, Converter={StaticResource Num}}" Style="{StaticResource SumVal}"/></StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource SumCard}">
                <StackPanel><TextBlock Text="مالیات" Style="{StaticResource SumCap}"/><TextBlock Text="{Binding Tax, Converter={StaticResource Num}}" Style="{StaticResource SumVal}"/></StackPanel>
            </Border>
            <Border Grid.Column="8" Background="{StaticResource ErpBlue700}" CornerRadius="8" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="سود (درآمد)" FontSize="12" Foreground="White"/>
                    <TextBlock Text="{Binding Profit, Converter={StaticResource Num}}" FontSize="22" FontWeight="Bold" Foreground="White" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- لیست ماهانه (لیست درآمدها) -->
        <Border Grid.Row="2" Style="{StaticResource ErpGbox}" Padding="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="تفکیکِ ماهانه (لیست درآمدها)" FontWeight="Bold" FontSize="12.5"
                           Foreground="{StaticResource ErpBlue700}" Margin="10,8,10,6"/>
                <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          ItemsSource="{Binding Months}" RowHeight="30" GridLinesVisibility="All" BorderThickness="0" FontFamily="{StaticResource VazirFont}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="دوره (ماه)" Binding="{Binding Period}" Width="120">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="فروش" Binding="{Binding Sales, StringFormat={}{0:#,##0}}" Width="*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="خرید" Binding="{Binding Purchase, StringFormat={}{0:#,##0}}" Width="*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="هزینه" Binding="{Binding Expense, StringFormat={}{0:#,##0}}" Width="*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="مالیات" Binding="{Binding Tax, StringFormat={}{0:#,##0}}" Width="*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="سود" Binding="{Binding Profit, StringFormat={}{0:#,##0}}" Width="*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource ErpSuccess700}"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
