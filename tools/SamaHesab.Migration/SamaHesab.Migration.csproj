<Project Sdk="Microsoft.NET.Sdk">

  <!-- mohajerat.exe — لانچرِ GUIِ ابزارِ مهاجرت/ورودِ داده. SamaHesab.exe را با
       پرچمِ ایمپورت اجرا می‌کند تا صفحهٔ گرافیکیِ «ورودِ داده از اکسل» باز شود.
       (نسخهٔ کنسولیِ قبلی با رابطِ گرافیکی جایگزین شد.) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <AssemblyName>mohajerat</AssemblyName>
    <RootNamespace>SamaHesab.Migration</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

</Project>
