<Window x:Class="SamaHesab.WPF.Views.Shell.ShortcutHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        SizeToContent="Height" Width="560" MaxHeight="640"
        FlowDirection="RightToLeft" FontFamily="{StaticResource VazirFont}"
        KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1" CornerRadius="10" Padding="0">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.45" Color="Black"/></Border.Effect>
        <DockPanel Margin="18">
            <!-- سربرگ -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="⌨  راهنمای میان‌برهای صفحه‌کلید" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryText}"/>
                <Button Content="✕" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource SecondaryText}" Cursor="Hand" FontSize="14" Click="Close_Click"/>
            </Grid>

            <TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0" FontSize="11"
                       Foreground="{DynamicResource SecondaryText}" Text="Esc برای بستن"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Sections"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
