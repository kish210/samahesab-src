<UserControl x:Class="SamaHesab.WPF.Views.HRM.AttendanceImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ایمپورتِ ترددِ دستگاه/اکسل" FontSize="16" FontWeight="Bold" Margin="2,0,0,8"/>

        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}" Padding="12">
            <StackPanel>
                <TextBlock Text="فایلِ CSV/متنِ تردد (ستون‌ها: کدِ کارمند، تاریخ، ورود، خروج، وضعیت) را انتخاب و ایمپورت کنید."
                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="📂 انتخابِ فایل…" Style="{StaticResource SecondaryButton}" Height="34" Command="{Binding PickFileCommand}"/>
                    <TextBlock Text="{Binding FilePath}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource PrimaryText}" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" MaxWidth="700"/>
                </StackPanel>
                <Button Content="⬆ ایمپورت" Style="{StaticResource PrimaryButton}" Height="36" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding ImportCommand}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FormSectionCard}" Padding="12" Margin="0,8,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
