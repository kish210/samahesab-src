<UserControl x:Class="SamaHesab.WPF.Views.Accounting.BankReconciliationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="BrLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="BrInput" TargetType="TextBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style x:Key="BrCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style x:Key="BrGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- سرتیتر -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="مغایرت‌گیری بانکی" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
            <TextBlock Text="دفتر بانکِ سیستم را با صورت‌حساب بانک تطبیق می‌دهد. تطبیق بر اساس برابری تاریخ و مبلغ (واریز مثبت، برداشت منفی)."
                       Foreground="{DynamicResource SecondaryText}" FontSize="12.5" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- نوار ورودی: حساب + بازه + صورت‌حساب -->
        <Border Grid.Row="1" Style="{StaticResource BrCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1.6*"/>
                </Grid.ColumnDefinitions>

                <!-- ستون چپ: انتخاب حساب و بازه -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="حساب بانکی" Style="{StaticResource BrLabel}"/>
                    <ComboBox ItemsSource="{Binding BankAccounts}" DisplayMemberPath="Display" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedBankAccountId}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="از تاریخ" Style="{StaticResource BrLabel}"/>
                            <TextBox Text="{Binding FromDate}" Style="{StaticResource BrInput}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="تا تاریخ" Style="{StaticResource BrLabel}"/>
                            <TextBox Text="{Binding ToDate}" Style="{StaticResource BrInput}"/>
                        </StackPanel>
                    </Grid>
                    <Button Content="بارگذاری دفتر بانک" Command="{Binding LoadLedgerCommand}"
                            Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="14,7"
                            Cursor="Hand" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding LedgerCount, Converter={StaticResource Num}, ConverterParameter=ردیف دفتر بارگذاری شد}"
                               Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding LastReconInfo}" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- ستون راست: ورود صورت‌حساب -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="صورت‌حساب بانک (هر خط: تاریخ,مبلغ[,شرح])" Style="{StaticResource BrLabel}"/>
                    <TextBox Text="{Binding StatementText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource BrInput}" Height="92" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             FontFamily="Consolas" FlowDirection="LeftToRight"/>
                    <Button Content="تطبیق خودکار ⏎" Command="{Binding ReconcileCommand}"
                            Background="{DynamicResource PrimaryAccent}" Foreground="White" BorderThickness="0"
                            Padding="18,8" Cursor="Hand" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- نتایج: منطبق + نامنطبق دفتر + نامنطبق صورت‌حساب -->
        <Grid Grid.Row="2" Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- منطبق -->
            <Border Grid.Column="0" Style="{StaticResource BrCard}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Text="{Binding MatchedCount, Converter={StaticResource Num}, ConverterParameter=منطبق ✓}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource SuccessColor}"/>
                        <Button DockPanel.Dock="Left" Content="ثبت تطبیق" Command="{Binding CommitReconcileCommand}"
                                Background="{DynamicResource PrimaryAccent}" Foreground="White" BorderThickness="0"
                                Padding="12,5" FontSize="11.5" Cursor="Hand"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Matched}" Style="{StaticResource BrGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="84"/>
                            <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, Converter={StaticResource Num}}" Width="*"/>
                            <DataGridTextColumn Header="شرح" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- نامنطبقِ دفتر -->
            <Border Grid.Column="2" Style="{StaticResource BrCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                               Text="{Binding UnmatchedLedgerCount, Converter={StaticResource Num}, ConverterParameter=نامنطبق دفتر}"
                               FontWeight="SemiBold" Foreground="{DynamicResource WarningColor}"/>
                    <DataGrid ItemsSource="{Binding UnmatchedLedger}" Style="{StaticResource BrGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="84"/>
                            <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, Converter={StaticResource Num}}" Width="*"/>
                            <DataGridTextColumn Header="شرح" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- نامنطبقِ صورت‌حساب -->
            <Border Grid.Column="4" Style="{StaticResource BrCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                               Text="{Binding UnmatchedStatementCount, Converter={StaticResource Num}, ConverterParameter=نامنطبق صورت‌حساب}"
                               FontWeight="SemiBold" Foreground="{DynamicResource DangerColor}"/>
                    <DataGrid ItemsSource="{Binding UnmatchedStatement}" Style="{StaticResource BrGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="84"/>
                            <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, Converter={StaticResource Num}}" Width="*"/>
                            <DataGridTextColumn Header="مرجع" Binding="{Binding Reference}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
