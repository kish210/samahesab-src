<Window x:Class="SamaHesab.WPF.Views.Shell.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سامانه جامع سما حساب - ورود"
        Height="580" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border CornerRadius="16" Background="#0F172A"
            BorderBrush="#1E3A5F" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="16,16,0,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="72" Height="72" HorizontalAlignment="Center">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#1D4ED8" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#2563EB" BlurRadius="20" Opacity="0.6" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="سما حساب" FontSize="24" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,12,0,4"
                               FontFamily="{StaticResource VazirFont}"/>
                    <TextBlock Text="سامانه جامع مدیریت کسب و کار" FontSize="12"
                               Foreground="#94A3B8" HorizontalAlignment="Center"
                               FontFamily="{StaticResource VazirFont}"/>
                </StackPanel>
            </Border>

            <!-- Form -->
            <StackPanel Grid.Row="1" Margin="40,30,40,30" VerticalAlignment="Center">

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626"
                           FontFamily="{StaticResource VazirFont}" FontSize="12"
                           Margin="0,0,0,12" TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"/>

                <!-- Company -->
                <TextBlock Text="شرکت" Foreground="#94A3B8" FontFamily="{StaticResource VazirFont}"
                           FontSize="12" Margin="0,0,0,6"/>
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                        CornerRadius="8" Margin="0,0,0,16">
                    <ComboBox Background="Transparent" BorderThickness="0" Foreground="White"
                              ItemsSource="{Binding Companies}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedCompanyId}" Padding="12,10"
                              FontFamily="{StaticResource VazirFont}"/>
                </Border>

                <!-- Username -->
                <TextBlock Text="نام کاربری" Foreground="#94A3B8" FontFamily="{StaticResource VazirFont}"
                           FontSize="12" Margin="0,0,0,6"/>
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                        CornerRadius="8" Margin="0,0,0,16">
                    <TextBox x:Name="TxtUsername" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" Foreground="White"
                             Padding="12,10" FontFamily="{StaticResource VazirFont}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Border>

                <!-- Password -->
                <TextBlock Text="رمز عبور" Foreground="#94A3B8" FontFamily="{StaticResource VazirFont}"
                           FontSize="12" Margin="0,0,0,6"/>
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                        CornerRadius="8" Margin="0,0,0,24">
                    <PasswordBox x:Name="PwdBox" Padding="12,10"
                                 Background="Transparent" BorderThickness="0" Foreground="White"
                                 FontFamily="{StaticResource VazirFont}"
                                 PasswordChanged="PwdBox_PasswordChanged">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
                        </PasswordBox.InputBindings>
                    </PasswordBox>
                </Border>

                <!-- Login Button -->
                <Button Content="{Binding LoginButtonText}"
                        Height="48" FontSize="15" FontFamily="{StaticResource VazirFont}"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsNotLoading}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Connection settings -->
                <Button Content="⚙  تنظیمات اتصال به پایگاه داده"
                        HorizontalAlignment="Center" Margin="0,18,0,0"
                        Background="Transparent" Foreground="#60A5FA"
                        BorderThickness="0" FontSize="13" Cursor="Hand"
                        FontFamily="{StaticResource VazirFont}"
                        Click="ConnectionSettings_Click"/>

                <!-- Footer -->
                <StackPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock Text="نسخه ۱.۰.۰ | سماع رایانه کیش © ۱۴۰۴"
                               Foreground="#475569" FontFamily="{StaticResource VazirFont}"
                               FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Text="kishwifi.com" Foreground="#60A5FA"
                               FontFamily="{StaticResource VazirFont}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Close Button -->
            <Button Content="✕" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="12,12,0,0" Width="28" Height="28"
                    Background="Transparent" Foreground="#64748B" BorderThickness="0"
                    FontSize="14" Cursor="Hand" Grid.RowSpan="2"
                    Click="CloseButton_Click" FlowDirection="LeftToRight"/>
        </Grid>
    </Border>
</Window>
