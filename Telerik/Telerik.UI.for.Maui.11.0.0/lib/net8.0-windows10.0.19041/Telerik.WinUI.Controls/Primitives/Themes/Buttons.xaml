                            <Setter Target="PART_DropDownButton.Foreground" Value="{ThemeResource TelerikButton_ForegroundChecked}"/>
                            <Setter Target="BorderVisual.BorderBrush" Value="{ThemeResource TelerikButton_BorderBrushCheckedPressed}"/>
                            <Setter Target="Divider.BorderBrush" Value="{ThemeResource TelerikButton_DividerCheckedBorderBrush}"/>
