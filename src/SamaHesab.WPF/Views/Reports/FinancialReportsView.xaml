<UserControl x:Class="SamaHesab.WPF.Views.Reports.FinancialReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Toolbar / filters ═══ -->
        <Border Grid.Row="0" Style="{StaticResource ErpToolbar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="FileChartOutline" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/>
                <TextBlock Text="گزارش" Style="{StaticResource ErpInlineLabel}" Margin="6,0"/>
                <ComboBox Style="{StaticResource BaseComboBox}" Width="170" Height="30"
                          ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding SelectedReportType}"/>
                <TextBlock Text="از تاریخ" Style="{StaticResource ErpInlineLabel}" Margin="12,0,6,0"/>
                <TextBox Text="{Binding FromDate}" Width="100"/>
                <TextBlock Text="تا تاریخ" Style="{StaticResource ErpInlineLabel}" Margin="10,0,6,0"/>
                <TextBox Text="{Binding ToDate}" Width="100"/>
                <TextBlock Text="حساب" Style="{StaticResource ErpInlineLabel}" Margin="12,0,6,0"
                           Visibility="{Binding IsLedger, Converter={StaticResource BoolVis}}"/>
                <telerik:RadComboBox Width="240" Height="30"
                          Visibility="{Binding IsLedger, Converter={StaticResource BoolVis}}"
                          ItemsSource="{Binding Accounts}" DisplayMemberPath="Display" SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedAccountId}" IsEditable="True" IsFilteringEnabled="True"
                          CanAutocompleteSelectItems="True" OpenDropDownOnFocus="True" EmptyText="همه حساب‌ها..."/>
                <TextBlock Text="مرکز هزینه" Style="{StaticResource ErpInlineLabel}" Margin="12,0,6,0"
                           Visibility="{Binding ShowDrCrTotals, Converter={StaticResource BoolVis}}"/>
                <telerik:RadComboBox Width="170" Height="30"
                          Visibility="{Binding ShowDrCrTotals, Converter={StaticResource BoolVis}}"
                          ItemsSource="{Binding CostCenters}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedCostCenterId}" IsEditable="True" IsFilteringEnabled="True"
                          CanAutocompleteSelectItems="True" OpenDropDownOnFocus="True" EmptyText="همه مراکز..."/>
                <TextBlock Text="پروژه" Style="{StaticResource ErpInlineLabel}" Margin="12,0,6,0"
                           Visibility="{Binding ShowDrCrTotals, Converter={StaticResource BoolVis}}"/>
                <telerik:RadComboBox Width="170" Height="30"
                          Visibility="{Binding ShowDrCrTotals, Converter={StaticResource BoolVis}}"
                          ItemsSource="{Binding Projects}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedProjectId}" IsEditable="True" IsFilteringEnabled="True"
                          CanAutocompleteSelectItems="True" OpenDropDownOnFocus="True" EmptyText="همه پروژه‌ها..."/>
                <TextBlock Text="شعبه" Style="{StaticResource ErpInlineLabel}" Margin="12,0,6,0"/>
                <ComboBox Style="{StaticResource BaseComboBox}" Width="160" Height="30"
                          ItemsSource="{Binding Branches}" DisplayMemberPath="Display" SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedBranchId}"/>
                <Button Style="{StaticResource PrimaryButton}" Height="30" Padding="16,0" Margin="12,0,0,0" Command="{Binding RunCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="نمایش" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0" Margin="6,0,0,0" Command="{Binding ExportCsvCommand}" ToolTip="خروجی اکسل (CSV)">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileExcelOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="اکسل" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0" Margin="6,0,0,0" Command="{Binding PrintCommand}" ToolTip="چاپ / خروجی PDF">
                    <materialDesign:PackIcon Kind="PrinterOutline" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══ Trial Balance ═══ -->
        <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}" Padding="0"
                Visibility="{Binding IsTrial, Converter={StaticResource BoolVis}}">
            <telerik:RadGridView ItemsSource="{Binding TrialRows}" AutoGenerateColumns="False" RowIndicatorVisibility="Collapsed" RowHeight="26"
                                 IsReadOnly="True" ShowColumnFooters="True" ShowGroupPanel="False">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="کد حساب" DataMemberBinding="{Binding Code}" Width="150"/>
                    <telerik:GridViewDataColumn Header="نام حساب" DataMemberBinding="{Binding Name}" Width="*"/>
                    <telerik:GridViewDataColumn Header="بدهکار" DataMemberBinding="{Binding Debit}" DataFormatString="{}{0:#,##0}" Width="160">
                        <telerik:GridViewDataColumn.AggregateFunctions><telerik:SumFunction ResultFormatString="{}{0:#,##0}"/></telerik:GridViewDataColumn.AggregateFunctions>
                    </telerik:GridViewDataColumn>
                    <telerik:GridViewDataColumn Header="بستانکار" DataMemberBinding="{Binding Credit}" DataFormatString="{}{0:#,##0}" Width="160">
                        <telerik:GridViewDataColumn.AggregateFunctions><telerik:SumFunction ResultFormatString="{}{0:#,##0}"/></telerik:GridViewDataColumn.AggregateFunctions>
                    </telerik:GridViewDataColumn>
                    <telerik:GridViewDataColumn Header="مانده" DataMemberBinding="{Binding Balance}" DataFormatString="{}{0:#,##0}" Width="160"/>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Border>

        <!-- ═══ General / Detailed Ledger ═══ -->
        <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}" Padding="0"
                Visibility="{Binding IsLedger, Converter={StaticResource BoolVis}}">
            <telerik:RadGridView ItemsSource="{Binding LedgerRows}" AutoGenerateColumns="False" RowIndicatorVisibility="Collapsed" RowHeight="26"
                                 IsReadOnly="True" ShowColumnFooters="True" ShowGroupPanel="True">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="تاریخ" DataMemberBinding="{Binding Date}" Width="110"/>
                    <telerik:GridViewDataColumn Header="شماره سند" DataMemberBinding="{Binding VoucherNumber}" Width="120"/>
                    <telerik:GridViewDataColumn Header="کد حساب" DataMemberBinding="{Binding Code}" Width="130"/>
                    <telerik:GridViewDataColumn Header="نام حساب" DataMemberBinding="{Binding Name}" Width="*"/>
                    <telerik:GridViewDataColumn Header="شرح" DataMemberBinding="{Binding Description}" Width="*"/>
                    <telerik:GridViewDataColumn Header="بدهکار" DataMemberBinding="{Binding Debit}" DataFormatString="{}{0:#,##0}" Width="140"/>
                    <telerik:GridViewDataColumn Header="بستانکار" DataMemberBinding="{Binding Credit}" DataFormatString="{}{0:#,##0}" Width="140"/>
                    <telerik:GridViewDataColumn Header="مانده" DataMemberBinding="{Binding Balance}" DataFormatString="{}{0:#,##0}" Width="150"/>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Border>

        <!-- ═══ Profit & Loss ═══ -->
        <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}" Padding="0"
                Visibility="{Binding IsProfitLoss, Converter={StaticResource BoolVis}}">
            <telerik:RadGridView ItemsSource="{Binding PlRows}" AutoGenerateColumns="False" RowIndicatorVisibility="Collapsed" RowHeight="26"
                                 IsReadOnly="True" ShowGroupPanel="True">
                <telerik:RadGridView.GroupDescriptors>
                    <telerik:GroupDescriptor Member="Kind"/>
                </telerik:RadGridView.GroupDescriptors>
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="نوع" DataMemberBinding="{Binding Kind}" Width="120"/>
                    <telerik:GridViewDataColumn Header="کد حساب" DataMemberBinding="{Binding Code}" Width="150"/>
                    <telerik:GridViewDataColumn Header="نام حساب" DataMemberBinding="{Binding Name}" Width="*"/>
                    <telerik:GridViewDataColumn Header="مبلغ" DataMemberBinding="{Binding Amount}" DataFormatString="{}{0:#,##0}" Width="180">
                        <telerik:GridViewDataColumn.AggregateFunctions><telerik:SumFunction ResultFormatString="{}{0:#,##0}"/></telerik:GridViewDataColumn.AggregateFunctions>
                    </telerik:GridViewDataColumn>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Border>

        <!-- ═══ Balance Sheet ═══ -->
        <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}" Padding="0"
                Visibility="{Binding IsBalanceSheet, Converter={StaticResource BoolVis}}">
            <telerik:RadGridView ItemsSource="{Binding BalanceRows}" AutoGenerateColumns="False" RowIndicatorVisibility="Collapsed" RowHeight="26"
                                 IsReadOnly="True" ShowGroupPanel="True">
                <telerik:RadGridView.GroupDescriptors>
                    <telerik:GroupDescriptor Member="Section"/>
                </telerik:RadGridView.GroupDescriptors>
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="بخش" DataMemberBinding="{Binding Section}" Width="180"/>
                    <telerik:GridViewDataColumn Header="کد حساب" DataMemberBinding="{Binding Code}" Width="150"/>
                    <telerik:GridViewDataColumn Header="نام حساب" DataMemberBinding="{Binding Name}" Width="*"/>
                    <telerik:GridViewDataColumn Header="مبلغ" DataMemberBinding="{Binding Amount}" DataFormatString="{}{0:#,##0}" Width="200">
                        <telerik:GridViewDataColumn.AggregateFunctions><telerik:SumFunction ResultFormatString="{}{0:#,##0}"/></telerik:GridViewDataColumn.AggregateFunctions>
                    </telerik:GridViewDataColumn>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Border>

        <!-- ═══ Cash Flow ═══ -->
        <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}"
                Visibility="{Binding IsCashFlow, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="24,18" MaxWidth="620" HorizontalAlignment="Right">
                <TextBlock Text="صورت جریان وجوه نقد" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/>
                        <RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ماندهٔ ابتدای دوره" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CfOpening, Converter={StaticResource Num}}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="جریان نقد فعالیت‌های عملیاتی" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CfOperating, Converter={StaticResource Num}}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="جریان نقد فعالیت‌های سرمایه‌گذاری" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CfInvesting, Converter={StaticResource Num}}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="جریان نقد فعالیت‌های تأمین مالی" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CfFinancing, Converter={StaticResource Num}}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,2"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="خالص تغییر وجه نقد" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CfNetChange, Converter={StaticResource Num}}" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="ماندهٔ پایان دوره" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CfClosing, Converter={StaticResource Num}}" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══ Footer totals ═══ -->
        <Border Grid.Row="2" Style="{StaticResource ErpToolbar}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,2">
                <!-- trial/ledger totals -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowDrCrTotals, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="جمع بدهکار:" Style="{StaticResource ErpInlineLabel}"/>
                    <TextBlock Text="{Binding TotalDebit, Converter={StaticResource Num}}" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="جمع بستانکار:" Style="{StaticResource ErpInlineLabel}"/>
                    <TextBlock Text="{Binding TotalCredit, Converter={StaticResource Num}}" FontWeight="Bold" Foreground="{DynamicResource DangerColor}" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- P&L totals -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsProfitLoss, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="جمع درآمد:" Style="{StaticResource ErpInlineLabel}"/>
                    <TextBlock Text="{Binding RevenueTotal, Converter={StaticResource Num}}" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="جمع هزینه:" Style="{StaticResource ErpInlineLabel}"/>
                    <TextBlock Text="{Binding ExpenseTotal, Converter={StaticResource Num}}" FontWeight="Bold" Foreground="{DynamicResource DangerColor}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="سود (زیان) خالص:" Style="{StaticResource ErpInlineLabel}"/>
                    <TextBlock Text="{Binding NetProfit, Converter={StaticResource Num}}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Balance-sheet totals -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsBalanceSheet, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="جمع دارایی‌ها:" Style="{StaticResource ErpInlineLabel}"/>
                    <TextBlock Text="{Binding TotalAssets, Converter={StaticResource Num}}" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="جمع بدهی‌ها + سرمایه:" Style="{StaticResource ErpInlineLabel}"/>
                    <TextBlock Text="{Binding TotalLiabEquity, Converter={StaticResource Num}}" FontWeight="Bold" Foreground="{DynamicResource WarningColor}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="وضعیت تراز:" Style="{StaticResource ErpInlineLabel}"/>
                    <TextBlock VerticalAlignment="Center" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="ناتراز"/>
                                <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BalanceOk}" Value="True">
                                        <Setter Property="Text" Value="تراز ✓"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
