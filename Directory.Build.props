<Project>
  <!-- ============================================================= -->
  <!-- منبعِ واحدِ نسخه برای همهٔ پروژه‌های .NET (WPF/API/کتابخانه‌ها).  -->
  <!-- هر csproj این مقادیر را به‌صورتِ خودکار به ارث می‌برد (MSBuild). -->
  <!--                                                                 -->
  <!-- ⚠️ برای ارتقای نسخه فقط <Version> زیر را عوض کنید (+ سه اسکریپتِ Inno). -->
  <!--   AssemblyVersion/FileVersion خودکار از $(Version) مشتق می‌شوند تا دیگر -->
  <!--   جا نمانند (باگِ ۲.۵.۱۲: AssemblyVersion روی ۲.۵.۱۱ ماند → حلقهٔ آپدیت، -->
  <!--   چون UpdateService از GetName().Version=AssemblyVersion استفاده می‌کند). -->
  <!--   Inno نمی‌تواند این فایل را بخواند: installer/web-setup.iss باید برابرِ <Version> باشد. -->
  <!--   ⚠️ از v2.9 به بعد: تنها نصابِ منتشرشده installer/web-setup.iss است (فقط سرور+وب) —      -->
  <!--   SamaHesab_Setup.iss/client.iss/server.iss (دسکتاپِ WPF) دیگر build/release نمی‌شوند.     -->
  <!-- ============================================================= -->
  <PropertyGroup>
    <Version>2.9.3</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <Company>سماع رایانه کیش</Company>
    <Product>سامانه جامع سما حساب</Product>
  </PropertyGroup>
</Project>
