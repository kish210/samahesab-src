<UserControl x:Class="SamaHesab.WPF.Views.Contracting.ContractingDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadDashboardCommand}"/>
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="داشبوردِ پیمان" FontSize="18" FontWeight="Bold" Margin="2,0,0,8"/>

        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="پیمان:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" Margin="0,0,8,0"/>
                <ComboBox Width="280" Height="32" ItemsSource="{Binding Projects}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedProject}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                      DataContext="{Binding Dashboard}">
            <UniformGrid Columns="3">
                <Border Style="{StaticResource FormSectionCard}"><StackPanel><TextBlock Text="مبلغِ پیمان" Foreground="{DynamicResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding ContractAmount, StringFormat={}{0:#,##0}}" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight"/></StackPanel></Border>
                <Border Style="{StaticResource FormSectionCard}"><StackPanel><TextBlock Text="ناخالصِ صورت‌وضعیت‌شده" Foreground="{DynamicResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding GrossBilled, StringFormat={}{0:#,##0}}" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight"/></StackPanel></Border>
                <Border Style="{StaticResource FormSectionCard}"><StackPanel><TextBlock Text="پیشرفتِ مالی" Foreground="{DynamicResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0.#}٪}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" FlowDirection="LeftToRight"/></StackPanel></Border>
                <Border Style="{StaticResource FormSectionCard}"><StackPanel><TextBlock Text="خالصِ صورت‌وضعیت" Foreground="{DynamicResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding NetBilled, StringFormat={}{0:#,##0}}" FontSize="18" FontWeight="Bold" FlowDirection="LeftToRight"/></StackPanel></Border>
                <Border Style="{StaticResource FormSectionCard}"><StackPanel><TextBlock Text="حسنِ‌انجامِ نگه‌داشته" Foreground="{DynamicResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding RetentionHeld, StringFormat={}{0:#,##0}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource WarningColor}" FlowDirection="LeftToRight"/></StackPanel></Border>
                <Border Style="{StaticResource FormSectionCard}"><StackPanel><TextBlock Text="بیمهٔ نگه‌داشته" Foreground="{DynamicResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding InsuranceHeld, StringFormat={}{0:#,##0}}" FontSize="18" FontWeight="Bold" FlowDirection="LeftToRight"/></StackPanel></Border>
                <Border Style="{StaticResource FormSectionCard}"><StackPanel><TextBlock Text="مالیاتِ کسرشده" Foreground="{DynamicResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding TaxWithheld, StringFormat={}{0:#,##0}}" FontSize="18" FontWeight="Bold" FlowDirection="LeftToRight"/></StackPanel></Border>
                <Border Style="{StaticResource FormSectionCard}"><StackPanel><TextBlock Text="پیش‌پرداختِ مانده" Foreground="{DynamicResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding AdvanceOutstanding, StringFormat={}{0:#,##0}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerColor}" FlowDirection="LeftToRight"/></StackPanel></Border>
                <Border Style="{StaticResource FormSectionCard}"><StackPanel><TextBlock Text="سودِ پروژه" Foreground="{DynamicResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding Profit, StringFormat={}{0:#,##0}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}" FlowDirection="LeftToRight"/></StackPanel></Border>
            </UniformGrid>
        </ScrollViewer>
    </Grid>
</UserControl>
