<Window x:Class="SamaHesab.WPF.Views.Shell.ForcePasswordChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تغییرِ رمزِ عبور — الزامی"
        Height="420" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        Background="#161C2A">

    <Border CornerRadius="16" Background="#161C2A" BorderBrush="#1E3A5F" BorderThickness="1" Padding="28">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="⚠ تغییرِ رمزِ عبور الزامی است" FontSize="18" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="این حساب هنوز از رمزِ پیش‌فرض استفاده می‌کند. برای ادامه، یک رمزِ تازه تعیین کنید."
                       Foreground="#94A3B8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <Border Background="#3F1D1D" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8"
                    Padding="10,8" Margin="0,14,0,0" x:Name="ErrorPanel" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="رمزِ جدید (حداقل ۸ نویسه، شاملِ حرف و رقم)" Foreground="#94A3B8" FontSize="12" Margin="2,18,0,6"/>
            <Border Background="#1B2843" BorderBrush="#283A60" BorderThickness="1" CornerRadius="10">
                <PasswordBox x:Name="PwdNew" Padding="10,11" Background="Transparent" BorderThickness="0"
                             Foreground="White" CaretBrush="White"/>
            </Border>

            <TextBlock Text="تکرارِ رمزِ جدید" Foreground="#94A3B8" FontSize="12" Margin="2,14,0,6"/>
            <Border Background="#1B2843" BorderBrush="#283A60" BorderThickness="1" CornerRadius="10">
                <PasswordBox x:Name="PwdConfirm" Padding="10,11" Background="Transparent" BorderThickness="0"
                             Foreground="White" CaretBrush="White"/>
            </Border>

            <Button x:Name="BtnSubmit" Content="ثبتِ رمزِ جدید و ادامه" Height="46" FontSize="14" FontWeight="SemiBold"
                    Margin="0,22,0,0" Foreground="White" Cursor="Hand" Click="BtnSubmit_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="#324A7A">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4B5F97"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
