<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:dash="clr-namespace:SamaHesab.WPF.ViewModels.Dashboard"
                    xmlns:acc="clr-namespace:SamaHesab.WPF.ViewModels.Accounting"
                    xmlns:inv="clr-namespace:SamaHesab.WPF.ViewModels.Inventory"
                    xmlns:sal="clr-namespace:SamaHesab.WPF.ViewModels.Sales"
                    xmlns:pur="clr-namespace:SamaHesab.WPF.ViewModels.Purchase"
                    xmlns:pos="clr-namespace:SamaHesab.WPF.ViewModels.POS"
                    xmlns:crm="clr-namespace:SamaHesab.WPF.ViewModels.CRM"
                    xmlns:hrm="clr-namespace:SamaHesab.WPF.ViewModels.HRM"
                    xmlns:rep="clr-namespace:SamaHesab.WPF.ViewModels.Reports"
                    xmlns:cfg="clr-namespace:SamaHesab.WPF.ViewModels.Settings"
                    xmlns:vd="clr-namespace:SamaHesab.WPF.Views.Dashboard"
                    xmlns:va="clr-namespace:SamaHesab.WPF.Views.Accounting"
                    xmlns:vi="clr-namespace:SamaHesab.WPF.Views.Inventory"
                    xmlns:vsal="clr-namespace:SamaHesab.WPF.Views.Sales"
                    xmlns:vpur="clr-namespace:SamaHesab.WPF.Views.Purchase"
                    xmlns:vpos="clr-namespace:SamaHesab.WPF.Views.POS"
                    xmlns:vcrm="clr-namespace:SamaHesab.WPF.Views.CRM"
                    xmlns:vhrm="clr-namespace:SamaHesab.WPF.Views.HRM"
                    xmlns:vrep="clr-namespace:SamaHesab.WPF.Views.Reports"
                    xmlns:vcfg="clr-namespace:SamaHesab.WPF.Views.Settings"
                    xmlns:tr="clr-namespace:SamaHesab.WPF.ViewModels.Treasury"
                    xmlns:vtr="clr-namespace:SamaHesab.WPF.Views.Treasury"
                    xmlns:sec="clr-namespace:SamaHesab.WPF.ViewModels.Security"
                    xmlns:vsec="clr-namespace:SamaHesab.WPF.Views.Security"
                    xmlns:sup="clr-namespace:SamaHesab.WPF.ViewModels.Support"
                    xmlns:vsup="clr-namespace:SamaHesab.WPF.Views.Support"
                    xmlns:auto="clr-namespace:SamaHesab.WPF.ViewModels.Automation"
                    xmlns:vauto="clr-namespace:SamaHesab.WPF.Views.Automation"
                    xmlns:tur="clr-namespace:SamaHesab.WPF.ViewModels.Tourism"
                    xmlns:vtur="clr-namespace:SamaHesab.WPF.Views.Tourism"
                    xmlns:con="clr-namespace:SamaHesab.WPF.ViewModels.Contracting"
                    xmlns:vcon="clr-namespace:SamaHesab.WPF.Views.Contracting">

    <!-- ✈️ TUR-C2-4 — گردشگری -->
    <DataTemplate DataType="{x:Type tur:TourismSaleViewModel}"><vtur:TourismSaleView/></DataTemplate>
    <DataTemplate DataType="{x:Type tur:TourismDepositsViewModel}"><vtur:TourismDepositsView/></DataTemplate>
    <DataTemplate DataType="{x:Type tur:TourismCommissionsViewModel}"><vtur:TourismCommissionsView/></DataTemplate>
    <DataTemplate DataType="{x:Type tur:TourismSettingsViewModel}"><vtur:TourismSettingsView/></DataTemplate>
    <DataTemplate DataType="{x:Type tur:TourismReportsViewModel}"><vtur:TourismReportsView/></DataTemplate>

    <!-- 🏗 CON-C2-2 — پیمانکاری -->
    <DataTemplate DataType="{x:Type con:ContractingStatementViewModel}"><vcon:ContractingStatementView/></DataTemplate>
    <DataTemplate DataType="{x:Type con:ContractingDashboardViewModel}"><vcon:ContractingDashboardView/></DataTemplate>

    <!-- کار #۲۵ — مرکزِ اعلان‌ها -->
    <DataTemplate DataType="{x:Type auto:AlertsViewModel}"><vauto:AlertsView/></DataTemplate>

    <!-- 🆘 HC-1 — مرکزِ پشتیبانی -->
    <DataTemplate DataType="{x:Type sup:HelpCenterViewModel}"><vsup:HelpCenterView/></DataTemplate>
    <DataTemplate DataType="{x:Type sup:DiagnosticsViewModel}"><vsup:DiagnosticsView/></DataTemplate>
    <DataTemplate DataType="{x:Type sup:BugReportViewModel}"><vsup:BugReportView/></DataTemplate>
    <DataTemplate DataType="{x:Type sup:FeatureRequestViewModel}"><vsup:FeatureRequestView/></DataTemplate>
    <DataTemplate DataType="{x:Type sup:SupportTicketViewModel}"><vsup:SupportTicketView/></DataTemplate>
    <DataTemplate DataType="{x:Type sup:MyRequestsViewModel}"><vsup:MyRequestsView/></DataTemplate>
    <DataTemplate DataType="{x:Type sup:ReleaseNotesViewModel}"><vsup:ReleaseNotesView/></DataTemplate>
    <DataTemplate DataType="{x:Type sup:KnowledgeBaseViewModel}"><vsup:KnowledgeBaseView/></DataTemplate>
    <DataTemplate DataType="{x:Type sup:RemoteSupportViewModel}"><vsup:RemoteSupportView/></DataTemplate>

    <!-- Treasury (#20) دریافتنی/پرداختنی -->
    <DataTemplate DataType="{x:Type tr:ReceivablesViewModel}"><vtr:ReceivablesView/></DataTemplate>
    <DataTemplate DataType="{x:Type tr:InterBranchTransferViewModel}"><vtr:InterBranchTransferView/></DataTemplate>

    <!-- Dashboard -->
    <DataTemplate DataType="{x:Type dash:DashboardViewModel}">
        <vd:DashboardView/>
    </DataTemplate>

    <!-- Accounting -->
    <DataTemplate DataType="{x:Type acc:VoucherEditViewModel}"><va:VoucherEditView/></DataTemplate>
    <DataTemplate DataType="{x:Type acc:VoucherListViewModel}"><va:VoucherListView/></DataTemplate>
    <DataTemplate DataType="{x:Type acc:ChartOfAccountsViewModel}"><va:ChartOfAccountsView/></DataTemplate>
    <DataTemplate DataType="{x:Type acc:ChequeListViewModel}"><va:ChequeListView/></DataTemplate>
    <DataTemplate DataType="{x:Type acc:ChequeBoardViewModel}"><va:ChequeBoardView/></DataTemplate>
    <DataTemplate DataType="{x:Type acc:EndOfPeriodViewModel}"><va:EndOfPeriodView/></DataTemplate>
    <DataTemplate DataType="{x:Type acc:VoucherApprovalsViewModel}"><va:VoucherApprovalsView/></DataTemplate>
    <DataTemplate DataType="{x:Type acc:AccountantDashboardViewModel}"><va:AccountantDashboardView/></DataTemplate>
    <DataTemplate DataType="{x:Type acc:ManagerDashboardViewModel}"><va:ManagerDashboardView/></DataTemplate>
    <DataTemplate DataType="{x:Type acc:VoucherProductivityViewModel}"><va:VoucherProductivityView/></DataTemplate>
    <DataTemplate DataType="{x:Type acc:BankReconciliationViewModel}"><va:BankReconciliationView/></DataTemplate>
    <DataTemplate DataType="{x:Type acc:AccountingDimensionsViewModel}"><va:AccountingDimensionsView/></DataTemplate>
    <DataTemplate DataType="{x:Type sec:SecurityManagementViewModel}"><vsec:SecurityManagementView/></DataTemplate>
    <DataTemplate DataType="{x:Type sec:AuditLogViewModel}"><vsec:AuditLogView/></DataTemplate>
    <DataTemplate DataType="{x:Type cfg:BranchManagementViewModel}"><vcfg:BranchManagementView/></DataTemplate>

    <!-- Inventory -->
    <DataTemplate DataType="{x:Type inv:ProductEditViewModel}"><vi:ProductEditView/></DataTemplate>
    <DataTemplate DataType="{x:Type inv:ProductListViewModel}"><vi:ProductListView/></DataTemplate>
    <DataTemplate DataType="{x:Type inv:BatchSerialViewModel}"><vi:BatchSerialView/></DataTemplate>
    <DataTemplate DataType="{x:Type inv:InventoryReportViewModel}"><vi:InventoryReportView/></DataTemplate>
    <DataTemplate DataType="{x:Type inv:WarehouseDashboardViewModel}"><vi:WarehouseDashboardView/></DataTemplate>
    <DataTemplate DataType="{x:Type inv:WarehouseOverviewViewModel}"><vi:WarehouseOverviewView/></DataTemplate>
    <DataTemplate DataType="{x:Type inv:ReorderReportViewModel}"><vi:ReorderReportView/></DataTemplate>
    <DataTemplate DataType="{x:Type inv:PriceListViewModel}"><vi:PriceListView/></DataTemplate>
    <DataTemplate DataType="{x:Type inv:DiscountTiersViewModel}"><vi:DiscountTiersView/></DataTemplate>
    <DataTemplate DataType="{x:Type inv:StockTransferViewModel}"><vi:StockTransferView/></DataTemplate>
    <DataTemplate DataType="{x:Type inv:StockCountViewModel}"><vi:StockCountView/></DataTemplate>
    <DataTemplate DataType="{x:Type inv:KardexViewModel}"><vi:KardexView/></DataTemplate>
    <DataTemplate DataType="{x:Type inv:ProductCardViewModel}"><vi:ProductCardView/></DataTemplate>

    <!-- Sales -->
    <DataTemplate DataType="{x:Type sal:SalesDashboardViewModel}"><vsal:SalesDashboardView/></DataTemplate>
    <DataTemplate DataType="{x:Type sal:RecurringInvoiceListViewModel}"><vsal:RecurringInvoiceListView/></DataTemplate>
    <DataTemplate DataType="{x:Type sal:SalesInvoiceEditViewModel}"><vsal:SalesInvoiceEditView/></DataTemplate>
    <DataTemplate DataType="{x:Type sal:SalesInvoiceListViewModel}"><vsal:SalesInvoiceListView/></DataTemplate>
    <DataTemplate DataType="{x:Type sal:SalesReportViewModel}"><vsal:SalesReportView/></DataTemplate>
    <DataTemplate DataType="{x:Type pur:PurchaseReportViewModel}"><vpur:PurchaseReportView/></DataTemplate>

    <!-- Purchase -->
    <DataTemplate DataType="{x:Type pur:PurchaseOrderListViewModel}"><vpur:PurchaseOrderListView/></DataTemplate>
    <DataTemplate DataType="{x:Type pur:SupplierStatementViewModel}"><vpur:SupplierStatementView/></DataTemplate>
    <DataTemplate DataType="{x:Type pur:PurchaseInvoiceEditViewModel}"><vpur:PurchaseInvoiceEditView/></DataTemplate>

    <!-- POS -->
    <DataTemplate DataType="{x:Type pos:PosDashboardViewModel}"><vpos:PosDashboardView/></DataTemplate>
    <DataTemplate DataType="{x:Type pos:PosViewModel}"><vpos:PosView/></DataTemplate>
    <DataTemplate DataType="{x:Type pos:ShiftViewModel}"><vpos:ShiftView/></DataTemplate>

    <!-- CRM -->
    <DataTemplate DataType="{x:Type crm:CustomerEditViewModel}"><vcrm:CustomerEditView/></DataTemplate>
    <DataTemplate DataType="{x:Type crm:CustomerListViewModel}"><vcrm:CustomerListView/></DataTemplate>
    <DataTemplate DataType="{x:Type crm:PersonsListViewModel}"><vcrm:PersonsListView/></DataTemplate>
    <DataTemplate DataType="{x:Type crm:CustomerCardViewModel}"><vcrm:CustomerCardView/></DataTemplate>
    <DataTemplate DataType="{x:Type crm:SupplierListViewModel}"><vcrm:SupplierListView/></DataTemplate>

    <!-- HRM -->
    <DataTemplate DataType="{x:Type hrm:SalaryViewModel}"><vhrm:SalaryView/></DataTemplate>
    <DataTemplate DataType="{x:Type hrm:EmployeeListViewModel}"><vhrm:EmployeeListView/></DataTemplate>

    <!-- Reports -->
    <DataTemplate DataType="{x:Type rep:ReportsViewModel}"><vrep:ReportsView/></DataTemplate>
    <DataTemplate DataType="{x:Type rep:IncomeReportViewModel}"><vrep:IncomeReportView/></DataTemplate>
    <DataTemplate DataType="{x:Type rep:FinancialReportsViewModel}"><vrep:FinancialReportsView/></DataTemplate>
    <DataTemplate DataType="{x:Type rep:BranchReportViewModel}"><vrep:BranchReportView/></DataTemplate>
    <DataTemplate DataType="{x:Type rep:AgedBalanceViewModel}"><vrep:AgedBalanceView/></DataTemplate>
    <DataTemplate DataType="{x:Type rep:VatSummaryViewModel}"><vrep:VatSummaryView/></DataTemplate>
    <DataTemplate DataType="{x:Type rep:DaybookViewModel}"><vrep:DaybookView/></DataTemplate>
    <DataTemplate DataType="{x:Type rep:DeadStockViewModel}"><vrep:DeadStockView/></DataTemplate>
    <DataTemplate DataType="{x:Type rep:ProductProfitViewModel}"><vrep:ProductProfitView/></DataTemplate>
    <DataTemplate DataType="{x:Type rep:AbcAnalysisViewModel}"><vrep:AbcAnalysisView/></DataTemplate>
    <DataTemplate DataType="{x:Type rep:InventoryTurnoverViewModel}"><vrep:InventoryTurnoverView/></DataTemplate>

    <!-- Settings -->
    <DataTemplate DataType="{x:Type cfg:SettingsViewModel}"><vcfg:SettingsView/></DataTemplate>
    <DataTemplate DataType="{x:Type cfg:ModulesViewModel}"><vcfg:ModulesView/></DataTemplate>
    <DataTemplate DataType="{x:Type cfg:BackupViewModel}"><vcfg:BackupView/></DataTemplate>
    <DataTemplate DataType="{x:Type cfg:DocumentTemplatesViewModel}"><vcfg:DocumentTemplatesView/></DataTemplate>
    <DataTemplate DataType="{x:Type cfg:DataImportViewModel}"><vcfg:DataImportView/></DataTemplate>

    <!-- ── Placeholder for screens still under construction ── -->
    <DataTemplate x:Key="UnderConstruction">
        <Border Background="{DynamicResource AppBackground}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="HammerWrench" Width="64" Height="64"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource SecondaryText}"/>
                <TextBlock Text="این بخش در حال توسعه است"
                           FontSize="18" Margin="0,16,0,0"
                           Foreground="{DynamicResource SecondaryText}"/>
            </StackPanel>
        </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type acc:BankAccountViewModel}"><va:BankAccountView/></DataTemplate>
    <DataTemplate DataType="{x:Type inv:WarehouseViewModel}"><vi:WarehouseView/></DataTemplate>
    <DataTemplate DataType="{x:Type inv:StockAdjustViewModel}"><vi:StockAdjustView/></DataTemplate>
    <DataTemplate DataType="{x:Type hrm:AttendanceViewModel}"><vhrm:AttendanceView/></DataTemplate>

</ResourceDictionary>
