                                <controls:RadButton IsEnabled="{TemplateBinding IsEnabled}"
                                                    Command="{core:Static Member=controls:CollectionEditorCommands.MoveCurrentToNext}"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    MinWidth="32" Padding="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE70D;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                                </controls:RadButton>
                                <controls:RadButton IsEnabled="{TemplateBinding IsEnabled}"
                                                    Command="{core:Static Member=controls:CollectionEditorCommands.MoveCurrentToPrevious}"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    MinWidth="32" Padding="0" Margin="2 0 0 0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE70E;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                                </controls:RadButton>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ListBox x:Name="PART_CollectionListBox" Grid.Row="1"
                             IsEnabled="{TemplateBinding IsEnabled}"
                             ItemsSource="{TemplateBinding CollectionView}"
                             ItemTemplate="{TemplateBinding ItemTemplate}"
                             SelectedItem="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=CurrentItem, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"/>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="2"
                      RowDefinitions="Auto,*">
                    <Border MinHeight="39"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1 0 0 1">
                        <TextBlock x:Name="PropertiesTextBlock"
                                   core:LocalizationManager.PropertyName="Text"
                                   core:LocalizationManager.Key="CollectionEditor_Properties"
                                   VerticalAlignment="Center"
                                   Margin="{TemplateBinding Padding}" />
                    </Border>
                    <controls:RadPropertyGrid Grid.Row="1"
                                              IsReadOnly="{TemplateBinding IsReadOnly}"
                                              IsEnabled="{TemplateBinding IsEnabled}"
                                              Item="{TemplateBinding CurrentItem}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="1 0 0 0"
                                              LabelColumnWidth="100"
                                              SortAndGroupButtonsVisibility="Collapsed"
                                              SearchBoxVisibility="Collapsed"
                                              DescriptionPanelVisibility="Collapsed"/>
                </Grid>
                <Border x:Name="FooterPanel_Background"
                        Grid.Row="2" Grid.ColumnSpan="2" MinHeight="48"
                        Background="{ThemeResource TelerikCollectionEditor_FooterBackground}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="0 1 0 0"
                        CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CornerRadius, Converter={StaticResource CornerRadiusConverter}, ConverterParameter=BottomLeftRight}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 16 0">
                            <controls:RadButton core:LocalizationManager.PropertyName="Content"
                                                core:LocalizationManager.Key="CollectionEditor_Add"
                                                IsEnabled="{TemplateBinding IsEnabled}"
                                                Command="{core:Static Member=controls:CollectionEditorCommands.AddNew}"
                                                MinWidth="120" VerticalAlignment="Center"/>
                            <controls:RadButton core:LocalizationManager.PropertyName="Content"
                                                core:LocalizationManager.Key="CollectionEditor_Remove"
                                                IsEnabled="{TemplateBinding IsEnabled}"
                                                Command="{core:Static Member=controls:CollectionEditorCommands.Delete}"
                                                MinWidth="120" VerticalAlignment="Center"
                                                Margin="8 0 0 0"/>
                        </StackPanel>
                        <Thumb x:Name="PART_ResizeThumb"
                               Style="{StaticResource CollectionEditorGripperStyle}"
                               Visibility="{TemplateBinding ResizeGripperVisibility}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </ControlTemplate>
