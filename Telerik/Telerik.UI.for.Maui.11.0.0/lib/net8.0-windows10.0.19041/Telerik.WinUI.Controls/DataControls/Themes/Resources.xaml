    <ControlTemplate x:Key="PropertyGridToggleButtonTemplate" TargetType="controls:RadToggleButton">
        <Grid UseLayoutRounding="True" ColumnDefinitions="Auto,*">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver"/>
                    <VisualState x:Name="Pressed"/>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="IconDown.Foreground" Value="{ThemeResource TelerikPropertyGrid_ToggleButtonDisabledForeground}"/>
                            <Setter Target="PART_ContentPresenter.Foreground" Value="{ThemeResource TelerikPropertyGrid_ToggleButtonDisabledForeground}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedDisabled">
                        <VisualState.Setters>
                            <Setter Target="IconUp.Foreground" Value="{ThemeResource TelerikPropertyGrid_ToggleButtonDisabledForeground}"/>
                            <Setter Target="PART_ContentPresenter.Foreground" Value="{ThemeResource TelerikPropertyGrid_ToggleButtonDisabledForeground}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked"/>
                    <VisualState x:Name="CheckedPointerOver"/>
                    <VisualState x:Name="CheckedPressed"/>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="PointerFocused"/>
                    <VisualState x:Name="Focused"/>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Arrow"
                    MinWidth="44"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                    <FontIcon x:Name="IconUp"
                              Glyph="&#xE70D;"
                              Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolToVisibilityConverter}}"
                              Foreground="{ThemeResource TelerikPropertyGrid_ToggleButtonIconForeground}"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="16"/>
                    <FontIcon x:Name="IconDown"
                              Glyph="&#xE70E;"
                              Visibility="{Binding ElementName=IconUp, Path=Visibility, Converter={StaticResource InvertedVisibilityConverter}}"
                              Foreground="{ThemeResource TelerikPropertyGrid_ToggleButtonIconForeground}"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="16"/>
                </Grid>
            </Border>
            <Border Grid.Column="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Content="{TemplateBinding Content}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  Margin="{TemplateBinding Padding}" UseLayoutRounding="True"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
        </Grid>
    </ControlTemplate>
