<mah:MetroWindow x:Class="SamaHesab.WPF.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
        Title="{Binding CompanyName}"
        WindowState="Maximized"
        MinWidth="1200" MinHeight="760"
        FlowDirection="RightToLeft"
        TitleCharacterCasing="Normal"
        FontFamily="{StaticResource VazirFont}"
        Background="{StaticResource ErpAppBg}"
        GlowBrush="{StaticResource ErpBlue700}"
        BorderThickness="0">

    <mah:MetroWindow.Resources>
        <conv:NavActiveToVisibilityConverter x:Key="NavActive"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>

        <!-- آیتم‌های فهرست بازشونده‌ی منوی بالا: متن تیره روی پس‌زمینه‌ی روشن (خوانا) -->
        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <!-- دکمه‌ی منوی تاپ‌بار (سفید روی آبی) -->
        <Style x:Key="TopMenuBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#1AFFFFFF"/><Setter Property="Foreground" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- آیکون تاپ‌بار -->
        <Style x:Key="TbIc" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#CFD9EC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#1AFFFFFF"/><Setter Property="Foreground" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- آیتم سایدبار: آیکون + لیبل + نوار طلاییِ فعال -->
        <Style x:Key="SideItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Command" Value="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Margin="8,2" Padding="9,0">
                            <Grid>
                                <Rectangle Width="3" HorizontalAlignment="Right" Margin="-6,8,0,8" RadiusX="2" RadiusY="2"
                                           Fill="{StaticResource ErpGold500}">
                                    <Rectangle.Visibility>
                                        <MultiBinding Converter="{StaticResource NavActive}">
                                            <Binding Path="DataContext.ActiveMenu" RelativeSource="{RelativeSource AncestorType=mah:MetroWindow}"/>
                                            <Binding Path="CommandParameter" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        </MultiBinding>
                                    </Rectangle.Visibility>
                                </Rectangle>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/><Setter Property="Foreground" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>     <!-- تاپ‌بار -->
            <RowDefinition Height="*"/>      <!-- سایدبار + محتوا -->
            <RowDefinition Height="26"/>     <!-- نوار وضعیت -->
        </Grid.RowDefinitions>

        <!-- ═══ تاپ‌بار (۵۶px، آبی) ═══ -->
        <Border Grid.Row="0" Background="{StaticResource ErpBlue700}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- برند -->
                    <ColumnDefinition Width="Auto"/>   <!-- منو -->
                    <ColumnDefinition Width="*"/>      <!-- جستجو -->
                    <ColumnDefinition Width="Auto"/>   <!-- آیکون‌ها -->
                    <ColumnDefinition Width="Auto"/>   <!-- کاربر -->
                </Grid.ColumnDefinitions>

                <!-- برند -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Border Width="30" Height="30" CornerRadius="7" Background="#26FFFFFF">
                        <TextBlock Text="س" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="سماع‌حساب" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="نسخه ۳٫۲ سازمانی" Foreground="#9FB0D0" FontSize="10"/>
                    </StackPanel>
                </StackPanel>

                <!-- منو (دکمه‌های بازشونده) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TopMenuBtn}" Content="حسابداری" Click="TopMenu_Click"
                            Visibility="{Binding CanAccounting, Converter={StaticResource BoolVis}}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="ثبت سند" Command="{Binding NavigateCommand}" CommandParameter="VoucherEdit"/>
                                <MenuItem Header="اسناد حسابداری" Command="{Binding NavigateCommand}" CommandParameter="Vouchers"/>
                                <MenuItem Header="نمودار حساب‌ها" Command="{Binding NavigateCommand}" CommandParameter="ChartOfAccounts"/>
                                <MenuItem Header="ابعاد حسابداری (سال مالی/مرکز هزینه/پروژه)" Command="{Binding NavigateCommand}" CommandParameter="AccDimensions"/>
                                <Separator/>
                                <MenuItem Header="بهره‌وری سند (الگو/تکرارشونده)" Command="{Binding NavigateCommand}" CommandParameter="VoucherTools"/>
                                <MenuItem Header="عملیات پایان دوره" Command="{Binding NavigateCommand}" CommandParameter="EndOfPeriod"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource TopMenuBtn}" Content="خزانه‌داری" Click="TopMenu_Click"
                            Visibility="{Binding CanTreasury, Converter={StaticResource BoolVis}}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="مدیریت چک" Command="{Binding NavigateCommand}" CommandParameter="Cheques"/>
                                <MenuItem Header="تابلوی چک" Command="{Binding NavigateCommand}" CommandParameter="ChequeBoard"/>
                                <MenuItem Header="دریافتنی/پرداختنی" Command="{Binding NavigateCommand}" CommandParameter="Receivables"/>
                                <MenuItem Header="حساب‌های بانکی" Command="{Binding NavigateCommand}" CommandParameter="BankAccounts"/>
                                <MenuItem Header="مغایرت‌گیری بانکی" Command="{Binding NavigateCommand}" CommandParameter="BankRecon"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource TopMenuBtn}" Content="خرید" Click="TopMenu_Click"
                            Visibility="{Binding CanPurchase, Converter={StaticResource BoolVis}}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="فاکتور خرید" Command="{Binding NavigateCommand}" CommandParameter="PurchaseInvoice"/>
                                <MenuItem Header="لیست خریدها" Command="{Binding NavigateCommand}" CommandParameter="PurchaseInvoiceList"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource TopMenuBtn}" Content="فروش" Click="TopMenu_Click"
                            Visibility="{Binding CanSales, Converter={StaticResource BoolVis}}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="فاکتور فروش" Command="{Binding NavigateCommand}" CommandParameter="SalesInvoice"/>
                                <MenuItem Header="لیست فاکتورها" Command="{Binding NavigateCommand}" CommandParameter="SalesInvoiceList"/>
                                <MenuItem Header="صندوق فروش" Command="{Binding NavigateCommand}" CommandParameter="POS" Visibility="{Binding PosEnabled, Converter={StaticResource BoolVis}}"/>
                                <MenuItem Header="صندوق / شیفت (Z/X)" Command="{Binding NavigateCommand}" CommandParameter="CashShift" Visibility="{Binding PosEnabled, Converter={StaticResource BoolVis}}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource TopMenuBtn}" Content="انبار" Click="TopMenu_Click"
                            Visibility="{Binding CanInventory, Converter={StaticResource BoolVis}}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="کالاها" Command="{Binding NavigateCommand}" CommandParameter="Products"/>
                                <MenuItem Header="بچ و سریال (انقضا)" Command="{Binding NavigateCommand}" CommandParameter="BatchSerial"/>
                                <MenuItem Header="گزارش موجودی/ارزش انبار" Command="{Binding NavigateCommand}" CommandParameter="InventoryReport"/>
                                <MenuItem Header="کارت کالا" Command="{Binding NavigateCommand}" CommandParameter="ProductCard"/>
                                <MenuItem Header="انبارها" Command="{Binding NavigateCommand}" CommandParameter="Warehouses"/>
                                <MenuItem Header="تعدیل موجودی" Command="{Binding NavigateCommand}" CommandParameter="StockAdjust"/>
                                <MenuItem Header="انبارگردانی" Command="{Binding NavigateCommand}" CommandParameter="StockCount"/>
                                <MenuItem Header="انتقال بین انبار" Command="{Binding NavigateCommand}" CommandParameter="StockTransfer"/>
                                <MenuItem Header="کاردکس کالا" Command="{Binding NavigateCommand}" CommandParameter="Kardex"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource TopMenuBtn}" Content="اشخاص" Click="TopMenu_Click"
                            Visibility="{Binding CanCustomers, Converter={StaticResource BoolVis}}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="مشتریان" Command="{Binding NavigateCommand}" CommandParameter="Customers"/>
                                <MenuItem Header="تأمین‌کنندگان" Command="{Binding NavigateCommand}" CommandParameter="Suppliers"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource TopMenuBtn}" Content="گزارشات" Click="TopMenu_Click"
                            Visibility="{Binding CanReports, Converter={StaticResource BoolVis}}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="گزارش‌ها" Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
                                <MenuItem Header="گزارش‌های مالی" Command="{Binding NavigateCommand}" CommandParameter="FinancialReports"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource TopMenuBtn}" Content="سیستم" Click="TopMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="میز کار / داشبورد" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                                <MenuItem Header="امنیت و دسترسی (نقش‌ها/کاربران)" Command="{Binding NavigateCommand}" CommandParameter="Security"
                                          Visibility="{Binding CanSecurity, Converter={StaticResource BoolVis}}"/>
                                <MenuItem Header="مدیریت شعب" Command="{Binding NavigateCommand}" CommandParameter="Branches"
                                          Visibility="{Binding CanSecurity, Converter={StaticResource BoolVis}}"/>
                                <MenuItem Header="کارکنان" Command="{Binding NavigateCommand}" CommandParameter="Employees" Visibility="{Binding HrEnabled, Converter={StaticResource BoolVis}}"/>
                                <MenuItem Header="حقوق و دستمزد" Command="{Binding NavigateCommand}" CommandParameter="Salary" Visibility="{Binding HrEnabled, Converter={StaticResource BoolVis}}"/>
                                <MenuItem Header="مدیریت ماژول‌ها" Command="{Binding NavigateCommand}" CommandParameter="Modules"/>
                                <MenuItem Header="تنظیمات" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                                <MenuItem Header="مدیریت ماژول‌ها" Command="{Binding NavigateCommand}" CommandParameter="Modules"/>
                                <MenuItem Header="تنظیمات چاپ" Command="{Binding OpenPrintSettingsCommand}"/>
                                <MenuItem Header="پشتیبان‌گیری" Command="{Binding NavigateCommand}" CommandParameter="Backup"/>
                                <Separator/>
                                <MenuItem Header="خروج" Command="{Binding LogoutCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!-- M4: منوی گردشگری فقط وقتی ماژول فعال است ظاهر می‌شود -->
                    <Button Style="{StaticResource TopMenuBtn}" Content="گردشگری" Click="TopMenu_Click"
                            Visibility="{Binding TourismEnabled, Converter={StaticResource BoolVis}}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="رزروها" Command="{Binding NavigateCommand}" CommandParameter="TourismBookings"/>
                                <MenuItem Header="تورها" Command="{Binding NavigateCommand}" CommandParameter="TourismTours"/>
                                <MenuItem Header="هتل‌ها" Command="{Binding NavigateCommand}" CommandParameter="TourismHotels"/>
                                <MenuItem Header="پروازها" Command="{Binding NavigateCommand}" CommandParameter="TourismFlights"/>
                                <MenuItem Header="ترانسفر" Command="{Binding NavigateCommand}" CommandParameter="TourismTransfer"/>
                                <MenuItem Header="واچرها" Command="{Binding NavigateCommand}" CommandParameter="TourismVouchers"/>
                                <MenuItem Header="کمیسیون‌ها" Command="{Binding NavigateCommand}" CommandParameter="TourismCommissions"/>
                                <MenuItem Header="گزارشات گردشگری" Command="{Binding NavigateCommand}" CommandParameter="TourismReports"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <!-- جستجو -->
                <Border Grid.Column="2" Background="#1AFFFFFF" CornerRadius="6" Height="32" Margin="14,0" MaxWidth="360" HorizontalAlignment="Stretch"
                        BorderBrush="#2EFFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9FB0D0"/>
                        <TextBox Grid.Column="1" Text="{Binding QuickSearch, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                 Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" Padding="8,0"
                                 materialDesign:HintAssist.Hint="جستجو در همه‌جا…  Ctrl+K" materialDesign:HintAssist.Foreground="#8294B6"/>
                    </Grid>
                </Border>

                <!-- آیکون‌ها -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TbIc}" Command="{Binding OpenCalculatorCommand}" ToolTip="ماشین حساب">
                        <materialDesign:PackIcon Kind="Calculator" Width="19" Height="19"/>
                    </Button>
                    <Button Style="{StaticResource TbIc}" Command="{Binding ShowMessagesCommand}" ToolTip="پیام‌ها">
                        <materialDesign:Badged Badge="{Binding MessageCount}" BadgeColorZoneMode="SecondaryMid">
                            <materialDesign:PackIcon Kind="EmailOutline" Width="19" Height="19"/>
                        </materialDesign:Badged>
                    </Button>
                    <Button Style="{StaticResource TbIc}" Command="{Binding ShowNotificationsCommand}" ToolTip="اعلان‌ها">
                        <materialDesign:Badged Badge="{Binding NotificationCount}" BadgeColorZoneMode="SecondaryMid">
                            <materialDesign:PackIcon Kind="BellOutline" Width="19" Height="19"/>
                        </materialDesign:Badged>
                    </Button>
                </StackPanel>

                <!-- کاربر -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource ErpGold500}">
                        <TextBlock Text="ر.م" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUserName}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentUserRole}" Foreground="#9FB0D0" FontSize="10"/>
                    </StackPanel>
                    <Button Style="{StaticResource TbIc}" Command="{Binding LogoutCommand}" ToolTip="خروج" Margin="6,0,0,0">
                        <materialDesign:PackIcon Kind="LogoutVariant" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ سایدبارِ هاوریِ جمع‌شونده (۶۰→۲۲۰px، طبق سیستم‌دیزاین) + RadDocking (MDI) ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>    <!-- ریلِ جمع‌شده (راست در RTL) -->
                <ColumnDefinition Width="*"/>      <!-- محتوا -->
            </Grid.ColumnDefinitions>

            <!-- ═══ تب‌های MDI (WPF خالص، بدون Telerik) — عینِ .erp-tabs ═══ -->
            <TabControl Grid.Column="1" Background="{StaticResource ErpAppBg}" BorderThickness="0"
                        ItemsSource="{Binding OpenTabs}" SelectedItem="{Binding SelectedTab}">
                <!-- پوستهٔ TabControl: نوار تب ۳۴px با اسکرول افقی + ناحیهٔ محتوا -->
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="34" Background="{StaticResource ErpGray150}"
                                    BorderBrush="{StaticResource ErpBorderStrong}" BorderThickness="0,0,0,1">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="8,0,8,0">
                                    <TabPanel IsItemsHost="True" VerticalAlignment="Bottom"/>
                                </ScrollViewer>
                            </Border>
                            <Border Background="{StaticResource ErpAppBg}">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </TabControl.Template>
                <!-- محتوای هر تب: VM → View از طریق DataTemplates -->
                <TabControl.ContentTemplate>
                    <DataTemplate><ContentControl Content="{Binding Content}"/></DataTemplate>
                </TabControl.ContentTemplate>
                <!-- چرومِ هر تب مطابق .erp-tabs .dt -->
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="dt" Height="30" Margin="0,0,2,0" Padding="12,0" CornerRadius="6,6,0,0"
                                            Background="Transparent" BorderThickness="1,1,1,0" BorderBrush="Transparent" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="tabText" Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{StaticResource ErpTextMuted}"/>
                                            <Button Margin="8,0,0,0" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanClose, Converter={StaticResource BoolVis}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="cb" Width="16" Height="16" CornerRadius="4" Background="{TemplateBinding Background}">
                                                            <TextBlock Text="✕" FontSize="10.5" Foreground="{StaticResource ErpTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="cb" Property="Background" Value="{StaticResource ErpGray150}"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="dt" Property="Background" Value="{StaticResource ErpAppBg}"/>
                                            <Setter TargetName="dt" Property="BorderBrush" Value="{StaticResource ErpBorderStrong}"/>
                                            <Setter TargetName="dt" Property="Margin" Value="0,0,2,-1"/>
                                            <Setter TargetName="tabText" Property="Foreground" Value="{StaticResource ErpBlue700}"/>
                                            <Setter TargetName="tabText" Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="False"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="dt" Property="Background" Value="#99FFFFFF"/>
                                            <Setter TargetName="tabText" Property="Foreground" Value="{StaticResource ErpTextStrong}"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.ItemContainerStyle>
            </TabControl>

            <!-- سایدبارِ هاوری: ۶۰px جمع‌شده (فقط آیکون)، با hover به ۲۲۰px باز و روی محتوا overlay می‌شود -->
            <Border x:Name="SideNav" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right"
                    Width="60" ClipToBounds="True" Panel.ZIndex="50" Background="{StaticResource ErpBlue900}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.28" Color="#1B2843"/>
                </Border.Effect>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width" To="220" Duration="0:0:0.16"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Border.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width" To="60" Duration="0:0:0.16"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel VerticalAlignment="Top" Margin="0,10">
                    <Button Style="{StaticResource SideItem}" CommandParameter="Dashboard">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="HomeOutline" Width="22" Height="22" VerticalAlignment="Center"/><TextBlock Text="میز کار" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideItem}" CommandParameter="Vouchers">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FileDocumentOutline" Width="22" Height="22" VerticalAlignment="Center"/><TextBlock Text="حسابداری" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideItem}" CommandParameter="SalesInvoice">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CartOutline" Width="22" Height="22" VerticalAlignment="Center"/><TextBlock Text="فروش" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideItem}" CommandParameter="PurchaseInvoice">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="TruckOutline" Width="22" Height="22" VerticalAlignment="Center"/><TextBlock Text="خرید" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideItem}" CommandParameter="Products">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="PackageVariant" Width="22" Height="22" VerticalAlignment="Center"/><TextBlock Text="انبار" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideItem}" CommandParameter="ChequeBoard">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Bank" Width="22" Height="22" VerticalAlignment="Center"/><TextBlock Text="خزانه‌داری" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideItem}" CommandParameter="POS"
                            Visibility="{Binding DataContext.PosEnabled, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CreditCardOutline" Width="22" Height="22" VerticalAlignment="Center"/><TextBlock Text="صندوق فروش" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideItem}" CommandParameter="Customers">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="AccountGroupOutline" Width="22" Height="22" VerticalAlignment="Center"/><TextBlock Text="اشخاص" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideItem}" CommandParameter="Reports">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ChartBar" Width="22" Height="22" VerticalAlignment="Center"/><TextBlock Text="گزارش‌ها" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/></StackPanel>
                    </Button>
                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="14,8"/>
                    <Button Style="{StaticResource SideItem}" CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CogOutline" Width="22" Height="22" VerticalAlignment="Center"/><TextBlock Text="تنظیمات" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/></StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ نوار وضعیت (۲۶px، آبی) ═══ -->
        <Border Grid.Row="2" Background="{StaticResource ErpBlue700}">
            <DockPanel LastChildFill="False" Margin="12,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#6FCF97"/>
                    <TextBlock Text="متصل" Foreground="#D6DEEF" FontSize="11" Margin="6,0,0,0"/>
                    <Rectangle Width="1" Fill="#24FFFFFF" Margin="11,5"/>
                    <TextBlock Foreground="#9FB0D0" FontSize="11"><Run Text="کاربر: "/><Run Text="{Binding CurrentUserName, Mode=OneWay}" Foreground="White"/></TextBlock>
                    <Rectangle Width="1" Fill="#24FFFFFF" Margin="11,5"/>
                    <TextBlock Foreground="#9FB0D0" FontSize="11"><Run Text="شعبه: "/><Run Text="{Binding CurrentBranch, Mode=OneWay}" Foreground="White"/></TextBlock>
                    <Rectangle Width="1" Fill="#24FFFFFF" Margin="11,5"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#9FB0D0" FontSize="11"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="سماع رایانه کیش · kishwifi.com" Foreground="#7F90B2" FontSize="11"/>
                    <Rectangle Width="1" Fill="#24FFFFFF" Margin="11,5"/>
                    <TextBlock Text="{Binding TodayPersianDate}" Foreground="#9FB0D0" FontSize="11"/>
                    <Rectangle Width="1" Fill="#24FFFFFF" Margin="11,5"/>
                    <TextBlock Foreground="#9FB0D0" FontSize="11"><Run Text="سرور: "/><Run Text="SRV-01" Foreground="White"/></TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
