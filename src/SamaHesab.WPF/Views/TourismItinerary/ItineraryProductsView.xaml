<UserControl x:Class="SamaHesab.WPF.Views.TourismItinerary.ItineraryProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NewProductCommand}"/>
        <KeyBinding Key="F7" Command="{Binding SaveProductCommand}"/>
    </UserControl.InputBindings>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="محصولاتِ اقامتی" FontSize="18" FontWeight="Bold"
                   Foreground="#2E7D52" Margin="0,0,0,8"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- فهرستِ محصولات -->
            <Border Grid.Column="0" Margin="0,0,6,0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="8">
                <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" CanUserAddRows="False" Background="Transparent"
                          RowBackground="Transparent" BorderThickness="0" FontSize="12.5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="تأمین‌کننده" Binding="{Binding SupplierName}" Width="Auto"/>
                        <DataGridTextColumn Header="فروش" Binding="{Binding SalePrice, StringFormat='{}{0:#,##0}'}" Width="Auto"/>
                        <DataGridTextColumn Header="سود" Binding="{Binding NetProfit, StringFormat='{}{0:#,##0}'}" Width="Auto"/>
                        <DataGridTextColumn Header="پورسانت" Binding="{Binding MarketerCommission, StringFormat='{}{0:#,##0}'}" Width="Auto"/>
                        <DataGridTextColumn Header="ظرفیت" Binding="{Binding Capacity}" Width="Auto"/>
                        <DataGridCheckBoxColumn Header="فعال" Binding="{Binding Active}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- فرمِ ویرایش + سانس‌ها -->
            <Border Grid.Column="1" Margin="6,0,0,0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="مشخصاتِ محصول" FontWeight="Bold" FontSize="14"/>
                            <Button DockPanel.Dock="Left" Content="＋ جدید (F2)" Command="{Binding NewProductCommand}" Padding="8,3"/>
                        </DockPanel>

                        <TextBlock Text="نام" Margin="0,4,0,2"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="تأمین‌کننده (از او خریداری می‌شود)" Margin="0,6,0,2"/>
                        <ComboBox ItemsSource="{Binding Suppliers}" SelectedValue="{Binding SupplierPartyId}"
                                  SelectedValuePath="Id" DisplayMemberPath="Name" IsEditable="False"/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="قیمتِ فروش"/>
                                <TextBox Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0">
                                <TextBlock Text="هزینه"/>
                                <TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0">
                                <TextBlock Text="سودِ خالص"/>
                                <TextBox Text="{Binding NetProfitPreview, StringFormat='{}{0:#,##0}', Mode=OneWay}" IsReadOnly="True" Foreground="#2E7D52"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="4,0,0,0">
                                <TextBlock Text="ظرفیت"/>
                                <TextBox Text="{Binding Capacity, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- پورسانتِ بازاریاب -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="پورسانتِ بازاریاب — مبنا"/>
                                <ComboBox ItemsSource="{Binding CommissionBasisOptions}" SelectedValue="{Binding CommissionBasis}"
                                          SelectedValuePath="Value" DisplayMemberPath="Label"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0">
                                <TextBlock Text="مقدار (مبلغ/درصد)"/>
                                <TextBox Text="{Binding CommissionValue, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                <TextBlock Text="پورسانتِ هر واحد"/>
                                <TextBox Text="{Binding CommissionPreview, StringFormat='{}{0:#,##0}', Mode=OneWay}" IsReadOnly="True" Foreground="#7A5BB0"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="فعال" IsChecked="{Binding Active}" Margin="0,8,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="💾 ذخیره (F7)" Command="{Binding SaveProductCommand}" Padding="10,4" Background="#2E7D52" Foreground="White"/>
                            <Button Content="🗑 غیرفعال" Command="{Binding DeleteProductCommand}" Padding="10,4" Margin="6,0,0,0"/>
                        </StackPanel>

                        <Separator Margin="0,12"/>

                        <TextBlock Text="سانس‌های زمانیِ این محصول" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding SelectedProductSessions}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" CanUserAddRows="False" Background="Transparent"
                                  MaxHeight="150" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="برچسب" Binding="{Binding Label}" Width="*"/>
                                <DataGridTextColumn Header="شروع (دقیقه)" Binding="{Binding StartMinute}" Width="Auto"/>
                                <DataGridTextColumn Header="پایان (دقیقه)" Binding="{Binding EndMinute}" Width="Auto"/>
                                <DataGridTextColumn Header="ظرفیت" Binding="{Binding Capacity}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="برچسب"/><TextBox Text="{Binding SessionLabel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0">
                                <TextBlock Text="شروع HH:mm"/><TextBox Text="{Binding SessionStart, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0">
                                <TextBlock Text="پایان HH:mm"/><TextBox Text="{Binding SessionEnd, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="4,0">
                                <TextBlock Text="ظرفیت"/><TextBox Text="{Binding SessionCapacity, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <Button Grid.Column="4" Content="＋ سانس" Command="{Binding AddSessionCommand}" VerticalAlignment="Bottom" Padding="8,4" Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
