<UserControl x:Class="SamaHesab.WPF.Views.Automation.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource VazirFont}"
             Background="{DynamicResource AppBackground}">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left" Content="↻ تازه‌سازی (F5)" Command="{Binding RefreshCommand}"
                    Padding="14,7" Cursor="Hand"/>
            <StackPanel>
                <TextBlock Text="🔔 مرکزِ اعلان‌ها" FontSize="19" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryText}"/>
                <TextBlock Text="چکِ سررسید · کسریِ موجودی · بدهیِ معوق · انقضای موجودی"
                           FontSize="12" Foreground="{DynamicResource MutedText}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- خلاصهٔ شمارش -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Border Background="#1FDC2626" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                <TextBlock Foreground="#DC2626" FontWeight="SemiBold">
                    <Run Text="بحرانی: "/><Run Text="{Binding CriticalCount}"/>
                </TextBlock>
            </Border>
            <Border Background="#1FD97706" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                <TextBlock Foreground="#D97706" FontWeight="SemiBold">
                    <Run Text="هشدار: "/><Run Text="{Binding WarningCount}"/>
                </TextBlock>
            </Border>
            <Border Background="#1F2563EB" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                <TextBlock Foreground="#2563EB" FontWeight="SemiBold">
                    <Run Text="اطلاع: "/><Run Text="{Binding InfoCount}"/>
                </TextBlock>
            </Border>
            <Border Background="#22808080" CornerRadius="6" Padding="12,6">
                <TextBlock Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold">
                    <Run Text="کل: "/><Run Text="{Binding TotalCount}"/>
                </TextBlock>
            </Border>
        </StackPanel>

        <!-- فهرستِ اعلان‌ها -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" CornerRadius="8" BorderThickness="1,1,5,1"
                                    BorderBrush="{Binding Accent}" Background="{DynamicResource CardBackground}">
                                <Grid Margin="12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="18"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border CornerRadius="4" Padding="7,1" Background="{Binding Accent}">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding AmountText}" FontSize="12" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SeverityText}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{Binding Accent}" FontWeight="Bold"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- حالتِ خالی -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                <TextBlock Text="✅" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="اعلانِ فعالی وجود ندارد." FontSize="14" Margin="0,8,0,0"
                           Foreground="{DynamicResource MutedText}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
