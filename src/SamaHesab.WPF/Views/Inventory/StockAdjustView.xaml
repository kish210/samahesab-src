<UserControl x:Class="SamaHesab.WPF.Views.Inventory.StockAdjustView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource FormSectionCard}" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <Border Width="40" Height="40" CornerRadius="8" Background="#DCE2EE">
                        <Path Data="{StaticResource IcSwap}" Style="{StaticResource ErpToolSvg}" Width="22" Height="22"
                              Stroke="{DynamicResource PrimaryAccent}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="تعدیل موجودی" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Command="{Binding SaveCommand}">
                    <StackPanel><Path Data="{StaticResource IcSave}" Style="{StaticResource ErpToolSvg}" Width="22" Height="22" HorizontalAlignment="Center" Stroke="{DynamicResource SuccessColor}"/><TextBlock Text="ذخیره تعدیل" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="4" Width="260">
                    <TextBlock Text="انبار" Style="{StaticResource FieldCaption}"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" ItemsSource="{Binding Warehouses}"
                              DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedWarehouseId}"/>
                </StackPanel>
                <TextBlock Text="مقدار جدید را در ستون «موجودی جدید» ویرایش و سپس «ذخیره تعدیل» را بزنید."
                           VerticalAlignment="Bottom" Margin="12,0,0,10" FontSize="11"
                           Foreground="{DynamicResource SecondaryText}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FormSectionCard}" Padding="0">
            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Rows}"
                                
                                
                                 FontFamily="{StaticResource VazirFont}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد" Binding="{Binding ProductCode}" Width="100"/>
                    <DataGridTextColumn Header="نام کالا" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="موجودی فعلی" Binding="{Binding CurrentQty, StringFormat={}{0:#,##0}}" Width="130"/>
                    <DataGridTextColumn Header="موجودی جدید" Binding="{Binding NewQty}" Width="130"/>
                    <DataGridTextColumn Header="توضیحات" Binding="{Binding Notes}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
