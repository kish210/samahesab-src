<UserControl x:Class="SamaHesab.WPF.Views.Accounting.VoucherListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft"
             Background="{StaticResource ErpAppBg}">
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>

        <!-- دکمه‌ی تولبار فشرده -->
        <Style x:Key="TBtn" TargetType="Button" BasedOn="{StaticResource ErpBtnGhost}">
            <Setter Property="Height" Value="28"/><Setter Property="Padding" Value="9,0"/><Setter Property="Margin" Value="0,0,1,0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="FChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="999" Background="White" BorderBrush="{StaticResource ErpBorderStrong}" BorderThickness="1" Padding="13,3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource ErpBlue600}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource ErpBlue600}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- KV فشرده -->
        <Style x:Key="Kv" TargetType="DockPanel"><Setter Property="Margin" Value="0,1"/></Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- تولبار -->
            <RowDefinition Height="Auto"/>   <!-- فیلتر -->
            <RowDefinition Height="*"/>      <!-- بدنه (لیست + پیش‌نمایش) -->
        </Grid.RowDefinitions>

        <!-- ═══ تولبار فشرده ═══ -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,0,5">
            <DockPanel>
                <!-- سند جدید (primary) -->
                <Button DockPanel.Dock="Right" Style="{StaticResource ErpBtnPrimary}" Height="28" Padding="11,0" Margin="0,0,5,0" Command="{Binding NewVoucherCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDocumentPlusOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="سند جدید" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <Border CornerRadius="3" Background="#33FFFFFF" Padding="4,0" Margin="6,0,0,0"><TextBlock Text="F2" FontSize="9.5" Foreground="White" VerticalAlignment="Center"/></Border>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource TBtn}" Command="{Binding EditVoucherCommand}">
                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="PencilOutline" Width="15" Height="15" VerticalAlignment="Center"/><TextBlock Text="ویرایش" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource TBtn}" Command="{Binding LedgerCommand}">
                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="BookOpenOutline" Width="15" Height="15" VerticalAlignment="Center"/><TextBlock Text="دفتر کل" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource TBtn}" Command="{Binding TrialBalanceCommand}">
                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FormatListBulleted" Width="15" Height="15" VerticalAlignment="Center"/><TextBlock Text="تراز آزمایشی" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel>
                </Button>
                <Rectangle DockPanel.Dock="Right" Width="1" Fill="{StaticResource ErpBorder}" Margin="5,4"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource TBtn}" Command="{Binding ExportCommand}">
                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="TrayArrowDown" Width="15" Height="15" VerticalAlignment="Center"/><TextBlock Text="خروجی اکسل" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource TBtn}" Command="{Binding PrintVoucherCommand}">
                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="PrinterOutline" Width="15" Height="15" VerticalAlignment="Center"/><TextBlock Text="چاپ" VerticalAlignment="Center" Margin="5,0,0,0"/><Border CornerRadius="3" Background="{StaticResource ErpGray150}" Padding="4,0" Margin="6,0,0,0"><TextBlock Text="F8" FontSize="9.5" Foreground="{StaticResource ErpTextMuted}" VerticalAlignment="Center"/></Border></StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource ErpTextMuted}" FontSize="11"
                           Text="{Binding TotalCount, StringFormat='{}{0} سند · دوره ۱۴۰۵'}"/>
            </DockPanel>
        </Border>

        <!-- ═══ فیلتر تک‌ردیفه ═══ -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="7,4" Margin="0,0,0,5">
            <DockPanel>
                <!-- جستجو با آیکون -->
                <Border DockPanel.Dock="Right" Background="White" BorderBrush="{StaticResource ErpBorderStrong}" BorderThickness="1"
                        CornerRadius="6" Height="28" Width="250" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="15" Height="15" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource ErpTextMuted}"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="6,0"
                                 materialDesign:HintAssist.Hint="جستجوی شماره، شرح، مبلغ…" FontSize="12.5">
                            <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>
                <TextBox DockPanel.Dock="Right" Style="{StaticResource ErpInput}" Height="28" Width="100" Margin="0,0,5,0" Text="{Binding FromDate}" FlowDirection="LeftToRight" TextAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="تا" VerticalAlignment="Center" Foreground="{StaticResource ErpTextMuted}" FontSize="12" Margin="0,0,5,0"/>
                <TextBox DockPanel.Dock="Right" Style="{StaticResource ErpInput}" Height="28" Width="100" Margin="0,0,8,0" Text="{Binding ToDate}" FlowDirection="LeftToRight" TextAlignment="Center"/>
                <ComboBox DockPanel.Dock="Right" Width="130" Height="28" Margin="0,0,10,0" ItemsSource="{Binding TypeOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedTypeId}"/>
                <RadioButton DockPanel.Dock="Right" Style="{StaticResource FChip}" Content="همه" IsChecked="True" GroupName="st" Command="{Binding FilterStatusCommand}" CommandParameter="همه"/>
                <RadioButton DockPanel.Dock="Right" Style="{StaticResource FChip}" Content="قطعی" GroupName="st" Command="{Binding FilterStatusCommand}" CommandParameter="قطعی"/>
                <RadioButton DockPanel.Dock="Right" Style="{StaticResource FChip}" Content="پیش‌نویس" GroupName="st" Command="{Binding FilterStatusCommand}" CommandParameter="پیش‌نویس"/>
                <TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource ErpTextMuted}" FontSize="11"
                           Text="{Binding TotalCount, StringFormat='{}{0} نتیجه'}"/>
            </DockPanel>
        </Border>

        <!-- ═══ بدنه: لیست (مرکز) + پیش‌نمایش master-detail (چپ) ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- لیست اسناد با چگالی بالا -->
            <Border Grid.Column="0" Style="{StaticResource ErpGbox}">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource ErpGray100}" BorderBrush="{StaticResource ErpBorderStrong}" BorderThickness="0,1,0,0" Padding="0,4">
                        <DockPanel Margin="9,0">
                            <TextBlock Text="{Binding TotalCount, StringFormat='جمع اسناد فیلترشده — {0} سند'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource ErpTextStrong}"/>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding TotalDebit, Converter={StaticResource Num}}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource ErpTextStrong}" FlowDirection="LeftToRight"/>
                        </DockPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Vouchers}" SelectedItem="{Binding SelectedVoucher}" Style="{StaticResource ErpDataGrid}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="شماره" Binding="{Binding VoucherNumber}" Width="75">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding VoucherDate}" Width="88">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource ErpTextMuted}"/><Setter Property="Margin" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="نوع" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="7,0" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource ErpBlue50}"/><Style.Triggers><DataTrigger Binding="{Binding VoucherTypeName}" Value="عمومی"><Setter Property="Background" Value="{StaticResource ErpGray150}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource ErpBlue700}"/><Style.Triggers><DataTrigger Binding="{Binding VoucherTypeName}" Value="عمومی"><Setter Property="Fill" Value="{StaticResource ErpTextMuted}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding VoucherTypeName}" FontSize="11" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource ErpBlue700}"/><Style.Triggers><DataTrigger Binding="{Binding VoucherTypeName}" Value="عمومی"><Setter Property="Foreground" Value="{StaticResource ErpTextMuted}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="شرح سند" Binding="{Binding Description}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource ErpTextStrong}"/><Setter Property="Margin" Value="8,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="مبلغ (ریال)" Binding="{Binding TotalDebit, Converter={StaticResource Num}}" Width="120">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="8,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="وضعیت" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="7,0" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource ErpSuccess50}"/><Style.Triggers><DataTrigger Binding="{Binding StatusName}" Value="پیش‌نویس"><Setter Property="Background" Value="{StaticResource ErpWarning50}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource ErpSuccess700}"/><Style.Triggers><DataTrigger Binding="{Binding StatusName}" Value="پیش‌نویس"><Setter Property="Fill" Value="{StaticResource ErpWarning700}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusName}" FontSize="11" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource ErpSuccess700}"/><Style.Triggers><DataTrigger Binding="{Binding StatusName}" Value="پیش‌نویس"><Setter Property="Foreground" Value="{StaticResource ErpWarning700}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="کاربر" Binding="{Binding UserName}" Width="80">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource ErpTextMuted}"/><Setter Property="Margin" Value="8,0"/><Setter Property="FontSize" Value="11.5"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- پنل پیش‌نمایش (master-detail) — همیشه پر -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- خلاصه -->
                    <RowDefinition Height="*"/>       <!-- جدول حساب (پرکننده) -->
                    <RowDefinition Height="Auto"/>   <!-- تراز -->
                    <RowDefinition Height="Auto"/>   <!-- اقدامات سریع -->
                </Grid.RowDefinitions>

                <!-- خلاصه‌ی سند -->
                <Border Grid.Row="0" Style="{StaticResource ErpGbox}">
                    <StackPanel>
                        <Border Style="{StaticResource ErpGboxHeader}" Height="30">
                            <DockPanel>
                                <TextBlock Style="{StaticResource ErpGboxTitle}" FontSize="11.5" Text="{Binding SelectedVoucher.VoucherNumber, StringFormat='پیش‌نمایش سند {0}', FallbackValue='پیش‌نمایش سند'}"/>
                                <Border DockPanel.Dock="Left" CornerRadius="4" Padding="6,0" VerticalAlignment="Center" Visibility="{Binding SelectedVoucher, Converter={StaticResource BoolVis}}">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource ErpSuccess50}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedVoucher.StatusName}" Value="پیش‌نویس"><Setter Property="Background" Value="{StaticResource ErpWarning50}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="{Binding SelectedVoucher.StatusName}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ErpWarning700}"/>
                                </Border>
                            </DockPanel>
                        </Border>
                        <StackPanel Margin="10,6">
                            <DockPanel Style="{StaticResource Kv}"><TextBlock Text="تاریخ" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5"/><TextBlock DockPanel.Dock="Left" Text="{Binding SelectedVoucher.VoucherDate}" FontWeight="Bold" FontSize="11.5"/></DockPanel>
                            <DockPanel Style="{StaticResource Kv}"><TextBlock Text="نوع" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5"/><TextBlock DockPanel.Dock="Left" Text="{Binding SelectedVoucher.VoucherTypeName}" FontWeight="Bold" FontSize="11.5"/></DockPanel>
                            <DockPanel Style="{StaticResource Kv}"><TextBlock Text="مرکز هزینه" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5"/><TextBlock DockPanel.Dock="Left" Text="شعبه مرکزی" FontWeight="Bold" FontSize="11.5"/></DockPanel>
                            <TextBlock Text="{Binding SelectedVoucher.Description}" Foreground="{StaticResource ErpTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- جدول حساب/بدهکار/بستانکار — پرکننده -->
                <Border Grid.Row="1" Style="{StaticResource ErpGbox}" Margin="0,6,0,0">
                    <DataGrid ItemsSource="{Binding PreviewLines}" Style="{StaticResource ErpDataGrid}" IsReadOnly="True" FontSize="11.5" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="حساب" Binding="{Binding Account}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Margin" Value="7,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="بدهکار" Binding="{Binding Debit, Converter={StaticResource Num}}" Width="88">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="6,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="بستانکار" Binding="{Binding Credit, Converter={StaticResource Num}}" Width="88">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="6,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- جمع/تراز -->
                <Border Grid.Row="2" Margin="0,6,0,0" CornerRadius="6" Padding="9,5"
                        Background="{StaticResource ErpSuccess50}" BorderBrush="#BFDDC9" BorderThickness="1">
                    <DockPanel>
                        <TextBlock Text="✓ تراز" FontWeight="Bold" FontSize="12" Foreground="{StaticResource ErpSuccess700}"
                                   Visibility="{Binding PreviewBalanced, Converter={StaticResource BoolVis}}"/>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <TextBlock Text="بد: " FontSize="11" Foreground="{StaticResource ErpTextMuted}"/>
                            <TextBlock Text="{Binding PreviewDebit, Converter={StaticResource Num}}" FontSize="11.5" FontWeight="Bold" FlowDirection="LeftToRight" Foreground="{StaticResource ErpTextStrong}"/>
                            <TextBlock Text="  بس: " FontSize="11" Foreground="{StaticResource ErpTextMuted}"/>
                            <TextBlock Text="{Binding PreviewCredit, Converter={StaticResource Num}}" FontSize="11.5" FontWeight="Bold" FlowDirection="LeftToRight" Foreground="{StaticResource ErpTextStrong}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- اقدامات سریع -->
                <Grid Grid.Row="3" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="5"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="باز کردن سند کامل ↗" Style="{StaticResource ErpBtnPrimary}" Height="32" Command="{Binding EditVoucherCommand}"/>
                    <Button Grid.Column="2" Content="✓ قطعی" Style="{StaticResource ErpBtnSecondary}" Height="32" Padding="12,0" Command="{Binding PostVoucherCommand}"/>
                    <Button Grid.Column="4" Content="🖨" Style="{StaticResource ErpBtnSecondary}" Height="32" Width="38" Command="{Binding PrintVoucherCommand}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
