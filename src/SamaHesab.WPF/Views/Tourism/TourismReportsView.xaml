<UserControl x:Class="SamaHesab.WPF.Views.Tourism.TourismReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}"/>
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="گزارش‌های گردشگری" FontSize="18" FontWeight="Bold" Margin="2,0,0,8"/>

        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="گزارش:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" Margin="0,0,8,0"/>
                <ComboBox Width="240" Height="32" ItemsSource="{Binding Reports}" DisplayMemberPath="Display"
                          SelectedIndex="{Binding SelectedReportIndex}"/>
                <TextBlock Text="دوره (YYYYMM):" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" Margin="16,0,8,0"/>
                <TextBox Width="110" Height="32" Text="{Binding Period}" FlowDirection="LeftToRight"
                         ToolTip="ماهِ شمسی برای پورسانت/عملکرد؛ خالی = همهٔ دوره‌ها"/>
                <Button Content="🔄 تهیه (F5)" Style="{StaticResource PrimaryButton}" Height="32" Margin="16,0,0,0"
                        Command="{Binding RunCommand}"/>
                <Button Content="⬇ اکسل (CSV)" Style="{StaticResource SecondaryButton}" Height="32" Margin="8,0,0,0"
                        Command="{Binding ExportCsvCommand}"/>
                <Button Content="🖨 چاپ (HTML)" Style="{StaticResource SecondaryButton}" Height="32" Margin="8,0,0,0"
                        Command="{Binding PrintCommand}"/>
                <Button Content="📄 PDF" Style="{StaticResource SecondaryButton}" Height="32" Margin="8,0,0,0"
                        Command="{Binding ExportPdfCommand}"/>
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="16,2,16,2"/>
                <TextBlock Text="واچرِ مسافر — شمارهٔ فروش:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" Margin="0,0,8,0"/>
                <TextBox Width="70" Height="32" Text="{Binding VoucherSaleId}" FlowDirection="LeftToRight"/>
                <Button Content="🎫 چاپِ واچر" Style="{StaticResource SecondaryButton}" Height="32" Margin="8,0,0,0"
                        Command="{Binding PrintTravelVoucherCommand}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FormSectionCard}" Padding="0" Margin="0,8,0,0">
            <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="True"
                      ItemsSource="{Binding CurrentView}" RowHeight="{DynamicResource ErpDensRowHeight}"
                      FontFamily="{StaticResource VazirFont}"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2,8,2,0">
            <TextBlock Text="{Binding CurrentTitle}" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}"/>
            <TextBlock Text=" — تعداد ردیف: " Foreground="{DynamicResource SecondaryText}"/>
            <TextBlock Text="{Binding RowCount, Converter={StaticResource Num}}" FontWeight="Bold" FlowDirection="LeftToRight"/>
        </StackPanel>
    </Grid>
</UserControl>
