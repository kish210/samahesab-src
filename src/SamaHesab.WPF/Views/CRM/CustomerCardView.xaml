<UserControl x:Class="SamaHesab.WPF.Views.CRM.CustomerCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft"
             Background="#F4F5F7">

    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:IntEqualsVisibilityConverter x:Key="IntEqVis"/>

        <!-- مینی‌تب -->
        <Style x:Key="MiniTabBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource ErpTextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F7F8FA"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MiniTab0" TargetType="Button" BasedOn="{StaticResource MiniTabBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                    <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource ErpBlue700}"/><Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MiniTab1" TargetType="Button" BasedOn="{StaticResource MiniTabBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                    <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource ErpBlue700}"/><Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MiniTab2" TargetType="Button" BasedOn="{StaticResource MiniTabBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="2">
                    <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource ErpBlue700}"/><Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MiniTab3" TargetType="Button" BasedOn="{StaticResource MiniTabBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="3">
                    <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource ErpBlue700}"/><Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MiniTab4" TargetType="Button" BasedOn="{StaticResource MiniTabBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="4">
                    <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource ErpBlue700}"/><Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- دکمه‌ی تولبار -->
        <Style x:Key="TBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/><Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource ErpTextStrong}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#EEF2FB"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TBtnPrimary" TargetType="Button" BasedOn="{StaticResource TBtn}">
            <Setter Property="Background" Value="{StaticResource ErpBlue700}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- اقدام سریع -->
        <Style x:Key="QaBtn" TargetType="Button" BasedOn="{StaticResource TBtn}">
            <Setter Property="Height" Value="38"/><Setter Property="Margin" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="*"/>       <!-- body -->
        </Grid.RowDefinitions>

        <!-- ═══ تولبار ═══ -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1"
                CornerRadius="8" Padding="8,6" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource TBtnPrimary}" Content="✎  ویرایش" Command="{Binding EditCommand}"/>
                    <Button Style="{StaticResource TBtn}" Content="🧾  فاکتور جدید" Command="{Binding NewInvoiceCommand}"/>
                    <Button Style="{StaticResource TBtn}" Content="💵  دریافت وجه" Command="{Binding ReceiptCommand}"/>
                    <Rectangle Width="1" Fill="{StaticResource ErpBorder}" Margin="4,5"/>
                    <Button Style="{StaticResource TBtn}" Content="🖨  صورت‌حساب (F8)" Command="{Binding PrintStatementCommand}"/>
                    <Button Style="{StaticResource TBtn}" Content="✉  پیامک مانده" Command="{Binding SmsBalanceCommand}"/>
                </StackPanel>
                <Border DockPanel.Dock="Left" VerticalAlignment="Center" Background="#E7F3EC" CornerRadius="6" Padding="10,4">
                    <TextBlock VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource ErpSuccess700}">
                        <Run Text="●"/><Run Text="{Binding StatusLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding GroupLabel, Mode=OneWay}"/>
                    </TextBlock>
                </Border>
            </DockPanel>
        </Border>

        <!-- ═══ بدنه ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>   <!-- شناسنامه (راست) -->
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>      <!-- اصلی -->
            </Grid.ColumnDefinitions>

            <!-- ── ستون شناسنامه ── -->
            <StackPanel Grid.Column="0">
                <!-- کارت هویت -->
                <Border Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="46" Height="46" CornerRadius="10" Background="{StaticResource ErpBlue100}">
                                <TextBlock Text="{Binding Initials}" Foreground="{StaticResource ErpBlue700}" FontWeight="Bold"
                                           FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource ErpTextStrong}"/>
                                <TextBlock FontSize="11.5" Foreground="{StaticResource ErpTextMuted}">
                                    <Run Text="کد: "/><Run Text="{Binding Code, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding GroupLabel, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Rectangle Height="1" Fill="{StaticResource ErpGray100}" Margin="0,11"/>

                        <!-- KV ها -->
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="موبایل" Foreground="{StaticResource ErpTextMuted}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding Mobile}" Foreground="{StaticResource ErpTextStrong}" FontSize="12" FlowDirection="LeftToRight"/></Grid>
                        <Rectangle Height="1" Fill="{StaticResource ErpGray100}"/>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="تلفن" Foreground="{StaticResource ErpTextMuted}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding Phone}" Foreground="{StaticResource ErpTextStrong}" FontSize="12" FlowDirection="LeftToRight"/></Grid>
                        <Rectangle Height="1" Fill="{StaticResource ErpGray100}"/>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="شناسه/کد ملی" Foreground="{StaticResource ErpTextMuted}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding NationalCode}" Foreground="{StaticResource ErpTextStrong}" FontSize="12" FlowDirection="LeftToRight"/></Grid>
                        <Rectangle Height="1" Fill="{StaticResource ErpGray100}"/>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="کد اقتصادی" Foreground="{StaticResource ErpTextMuted}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding EconomicCode}" Foreground="{StaticResource ErpTextStrong}" FontSize="12" FlowDirection="LeftToRight"/></Grid>
                        <Rectangle Height="1" Fill="{StaticResource ErpGray100}"/>
                        <!-- کارِ ۱۰: شخص رابط + ویزیتور -->
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="شخص رابط" Foreground="{StaticResource ErpTextMuted}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ContactPerson}" Foreground="{StaticResource ErpTextStrong}" FontSize="12"/></Grid>
                        <Rectangle Height="1" Fill="{StaticResource ErpGray100}"/>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="ویزیتور" Foreground="{StaticResource ErpTextMuted}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding Visitor}" Foreground="{StaticResource ErpTextStrong}" FontSize="12"/></Grid>
                        <Rectangle Height="1" Fill="{StaticResource ErpGray100}"/>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="آدرس" Foreground="{StaticResource ErpTextMuted}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding Address}" Foreground="{StaticResource ErpTextStrong}" FontSize="11"
                                       TextWrapping="Wrap" TextAlignment="Left" Margin="8,0,0,0"/></Grid>
                    </StackPanel>
                </Border>

                <!-- کارت مانده/اعتبار -->
                <Border Background="{StaticResource ErpDanger50}" BorderBrush="#E8C5C3" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="مانده حساب (بدهکار)" FontSize="11" Foreground="{StaticResource ErpDanger700}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Balance, Converter={StaticResource Num}}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource ErpDanger700}" FlowDirection="LeftToRight"/>
                            <TextBlock Text=" ریال" FontSize="12" Foreground="{StaticResource ErpDanger700}" VerticalAlignment="Bottom" Margin="3,0,0,3"/>
                        </StackPanel>
                        <ProgressBar Height="5" Margin="0,7,0,0" Minimum="0" Maximum="100" Value="{Binding CreditPercent}"
                                     Background="White" Foreground="{StaticResource ErpDanger500}" BorderThickness="0"/>
                        <Grid Margin="0,4,0,0">
                            <TextBlock FontSize="11" Foreground="{StaticResource ErpTextMuted}">
                                <Run Text="سقف اعتبار: "/><Run Text="{Binding CreditLimit, Mode=OneWay, Converter={StaticResource Num}}"/>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Left" Text="{Binding CreditPercentLabel}" FontSize="11" Foreground="{StaticResource ErpTextMuted}"/>
                        </Grid>
                        <Border Background="{StaticResource ErpDanger500}" CornerRadius="4" Padding="8,2" Margin="0,7,0,0" HorizontalAlignment="Right"
                                Visibility="{Binding IsOverCredit, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="⚠ عبور از سقف اعتبار" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- اقدامات سریع -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource QaBtn}" Content="🧾 تسویه حساب" Command="{Binding ReceiptCommand}"/>
                    <Button Grid.Column="2" Style="{StaticResource QaBtn}" Content="🧾 چک‌های مشتری"/>
                </Grid>

                <!-- 📊 تحلیلِ خرید — پرخریدترین کالاها + روندِ ماهانه (داده از GetCustomerAnalyticsQuery) -->
                <Border Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="8" Padding="13,11" Margin="0,10,0,0"
                        Visibility="{Binding HasData, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="📊 تحلیلِ خرید" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ErpBlue700}"/>

                        <TextBlock Text="پرخریدترین کالاها" FontSize="11" Foreground="{StaticResource ErpTextMuted}" Margin="0,9,0,3"/>
                        <ItemsControl ItemsSource="{Binding TopProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{StaticResource ErpTextStrong}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Total, Converter={StaticResource Num}}" FontSize="11" FontWeight="SemiBold" FlowDirection="LeftToRight" Margin="6,0,0,0" Foreground="{StaticResource ErpBlue700}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="روندِ ماهانهٔ خرید (امسال)" FontSize="11" Foreground="{StaticResource ErpTextMuted}" Margin="0,11,0,3"/>
                        <ItemsControl ItemsSource="{Binding MonthlyTrend}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Period}" FontSize="10" FlowDirection="LeftToRight" Foreground="{StaticResource ErpTextMuted}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" HorizontalAlignment="Left" Height="12" CornerRadius="3"
                                                Background="{StaticResource ErpBlue700}" Width="{Binding BarWidth}"
                                                ToolTip="{Binding Total, Converter={StaticResource Num}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ── ستون اصلی ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- KPI -->
                    <RowDefinition Height="Auto"/>   <!-- minitabs -->
                    <RowDefinition Height="*"/>       <!-- grid -->
                    <RowDefinition Height="Auto"/>   <!-- اسناد ضمیمه (کارِ ۹) -->
                </Grid.RowDefinitions>

                <!-- KPI ها -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel><TextBlock Text="جمع خرید امسال" FontSize="11" Foreground="{StaticResource ErpTextMuted}"/>
                            <TextBlock Text="{Binding TotalSales, Converter={StaticResource Num}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ErpTextStrong}" FlowDirection="LeftToRight" Margin="0,3,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel><TextBlock Text="تعداد فاکتور" FontSize="11" Foreground="{StaticResource ErpTextMuted}"/>
                            <TextBlock Text="{Binding InvoiceCount, Converter={StaticResource Num}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ErpTextStrong}" FlowDirection="LeftToRight" Margin="0,3,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel><TextBlock Text="مهلت تسویه (روز)" FontSize="11" Foreground="{StaticResource ErpTextMuted}"/>
                            <TextBlock Text="{Binding SettlementDays, Converter={StaticResource Num}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ErpTextStrong}" FlowDirection="LeftToRight" Margin="0,3,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Column="6" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel><TextBlock Text="امتیاز وفاداری" FontSize="11" Foreground="{StaticResource ErpTextMuted}"/>
                            <TextBlock Text="{Binding LoyaltyPoints, Converter={StaticResource Num}}" FontSize="16" FontWeight="Bold" Foreground="#B18A5A" FlowDirection="LeftToRight" Margin="0,3,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Column="8" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel><TextBlock Text="چک در جریان" FontSize="11" Foreground="{StaticResource ErpTextMuted}"/>
                            <TextBlock Text="{Binding ChequeInProgress, Converter={StaticResource Num}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ErpWarning700}" FlowDirection="LeftToRight" Margin="0,3,0,0"/></StackPanel>
                    </Border>
                </Grid>

                <!-- minitabs -->
                <Border Grid.Row="1" Background="#EDEEF1" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1,1,1,0"
                        CornerRadius="8,8,0,0" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MiniTab0}" Content="گردش حساب" Command="{Binding SelectTabCommand}" CommandParameter="0"/>
                        <Button Style="{StaticResource MiniTab1}" Content="فاکتورها" Command="{Binding SelectTabCommand}" CommandParameter="1"/>
                        <Button Style="{StaticResource MiniTab2}" Content="چک‌ها" Command="{Binding SelectTabCommand}" CommandParameter="2"/>
                        <Button Style="{StaticResource MiniTab3}" Content="تماس‌ها و پیگیری" Command="{Binding SelectTabCommand}" CommandParameter="3"/>
                        <Button Style="{StaticResource MiniTab4}" Content="اسناد ضمیمه" Command="{Binding SelectTabCommand}" CommandParameter="4"/>
                    </StackPanel>
                </Border>

                <!-- تبِ ۱: فاکتورهای مشتری -->
                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="0,0,8,8"
                        Visibility="{Binding SelectedTab, Converter={StaticResource IntEqVis}, ConverterParameter=1}">
                    <DataGrid ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" HeadersVisibility="Column"
                              GridLinesVisibility="All" CanUserAddRows="False" IsReadOnly="True"
                              RowHeight="{DynamicResource ErpDensRowHeight}" FontSize="12" Background="White" BorderThickness="0"
                              HorizontalGridLinesBrush="{StaticResource ErpGray100}" VerticalGridLinesBrush="{StaticResource ErpGray100}"
                              AlternatingRowBackground="#FAFBFC" RowBackground="White">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F6F7F9"/>
                                <Setter Property="Foreground" Value="{StaticResource ErpTextMuted}"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ErpBorder}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شماره" Binding="{Binding Number}" Width="110">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="Margin" Value="6,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="110"/>
                            <DataGridTextColumn Header="مبلغ کل" Binding="{Binding Total, Converter={StaticResource Num}}" Width="120">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="6,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="پرداخت‌شده" Binding="{Binding Paid, Converter={StaticResource Num}}" Width="120">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="6,0"/><Setter Property="Foreground" Value="#1E7A4D"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="مانده" Binding="{Binding Remain, Converter={StaticResource Num}}" Width="120">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="6,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="90">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- تبِ ۲: چک‌های مشتری -->
                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="0,0,8,8"
                        Visibility="{Binding SelectedTab, Converter={StaticResource IntEqVis}, ConverterParameter=2}">
                    <DataGrid ItemsSource="{Binding Cheques}" AutoGenerateColumns="False" HeadersVisibility="Column"
                              GridLinesVisibility="All" CanUserAddRows="False" IsReadOnly="True"
                              RowHeight="{DynamicResource ErpDensRowHeight}" FontSize="12" Background="White" BorderThickness="0"
                              HorizontalGridLinesBrush="{StaticResource ErpGray100}" VerticalGridLinesBrush="{StaticResource ErpGray100}"
                              AlternatingRowBackground="#FAFBFC" RowBackground="White">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F6F7F9"/>
                                <Setter Property="Foreground" Value="{StaticResource ErpTextMuted}"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ErpBorder}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نوع" Binding="{Binding TypeLabel}" Width="80"/>
                            <DataGridTextColumn Header="شماره چک" Binding="{Binding ChequeNumber}" Width="110">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="Margin" Value="6,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="بانک" Binding="{Binding BankName}" Width="*"/>
                            <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, Converter={StaticResource Num}}" Width="120">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="6,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="سررسید" Binding="{Binding DueDate}" Width="110"/>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusLabel}" Width="100">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- تبِ ۳: تماس‌ها و پیگیری (هنوز پیاده‌سازی نشده) -->
                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="0,0,8,8"
                        Visibility="{Binding SelectedTab, Converter={StaticResource IntEqVis}, ConverterParameter=3}">
                    <TextBlock Text="این بخش هنوز پیاده‌سازی نشده — به‌زودی" FontSize="13" Foreground="{StaticResource ErpTextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- تبِ ۴: اسناد ضمیمه (پنلِ واقعی پایینِ همین صفحه است) -->
                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="0,0,8,8"
                        Visibility="{Binding SelectedTab, Converter={StaticResource IntEqVis}, ConverterParameter=4}">
                    <TextBlock Text="اسناد ضمیمه در پایینِ همین صفحه نمایش داده می‌شود ⬇" FontSize="13" Foreground="{StaticResource ErpTextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- تبِ ۰: گردش حساب -->
                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="0,0,8,8"
                        Visibility="{Binding SelectedTab, Converter={StaticResource IntEqVis}, ConverterParameter=0}">
                    <DockPanel>
                        <!-- جمع پایین -->
                        <Border DockPanel.Dock="Bottom" Background="#F6F7F9" BorderBrush="{StaticResource ErpBorder}" BorderThickness="0,1,0,0" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/><ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="جمع گردش" FontWeight="Bold" FontSize="12" Margin="12,8" Foreground="{StaticResource ErpTextStrong}"/>
                                <TextBlock Grid.Column="1" Text="{Binding LedgerTotalDebit, Converter={StaticResource Num}}" FontWeight="Bold" FontSize="12" Margin="8,8" TextAlignment="Left" FlowDirection="LeftToRight"/>
                                <TextBlock Grid.Column="2" Text="{Binding LedgerTotalCredit, Converter={StaticResource Num}}" FontWeight="Bold" FontSize="12" Margin="8,8" TextAlignment="Left" FlowDirection="LeftToRight" Foreground="{StaticResource ErpSuccess700}"/>
                                <TextBlock Grid.Column="3" Text="{Binding LedgerClosing, Converter={StaticResource Num}}" FontWeight="Bold" FontSize="12" Margin="8,8" TextAlignment="Left" FlowDirection="LeftToRight"/>
                                <TextBlock Grid.Column="4"/>
                            </Grid>
                        </Border>

                        <DataGrid ItemsSource="{Binding Ledger}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                  GridLinesVisibility="All" CanUserAddRows="False" IsReadOnly="True"
                                  RowHeight="{DynamicResource ErpDensRowHeight}" FontSize="12" Background="White" BorderThickness="0"
                                  HorizontalGridLinesBrush="{StaticResource ErpGray100}" VerticalGridLinesBrush="{StaticResource ErpGray100}"
                                  AlternatingRowBackground="#FAFBFC" RowBackground="White">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F6F7F9"/>
                                    <Setter Property="Foreground" Value="{StaticResource ErpTextMuted}"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource ErpBorder}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="110"/>
                                <DataGridTextColumn Header="سند" Binding="{Binding DocNumber}" Width="100"/>
                                <DataGridTextColumn Header="شرح" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="بدهکار" Binding="{Binding Debit, Converter={StaticResource Num}}" Width="120">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="6,0"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="بستانکار" Binding="{Binding Credit, Converter={StaticResource Num}}" Width="120">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="6,0"/><Setter Property="Foreground" Value="#1E7A4D"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="مانده" Binding="{Binding Balance, Converter={StaticResource Num}}" Width="130">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="6,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="وضعیت" Binding="{Binding Side}" Width="60">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- ── اسناد ضمیمه (کارِ ۹) ── -->
                <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="8" Margin="0,8,0,0" Padding="10,8">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Left" HorizontalAlignment="Left" Style="{StaticResource ErpBtnGhost}" Height="26" Padding="9,0"
                                    Command="{Binding AddAttachmentCommand}" Content="＋ افزودن فایل"/>
                            <TextBlock Text="اسناد ضمیمه" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ErpBlue700}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Attachments}" MaxHeight="120">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource ErpGray100}" BorderThickness="0,0,0,1" Padding="2,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="{StaticResource ErpTextStrong}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding UploadedAt}" FontSize="10" Foreground="{StaticResource ErpTextMuted}" FlowDirection="LeftToRight"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource ErpBtnGhost}" Height="24" Padding="8,0" Margin="4,0,0,0" Content="باز کردن"
                                                    Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <Button Grid.Column="3" Style="{StaticResource ErpBtnGhost}" Height="24" Padding="8,0" Margin="4,0,0,0" Content="حذف"
                                                    Foreground="{StaticResource ErpDanger500}"
                                                    Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
