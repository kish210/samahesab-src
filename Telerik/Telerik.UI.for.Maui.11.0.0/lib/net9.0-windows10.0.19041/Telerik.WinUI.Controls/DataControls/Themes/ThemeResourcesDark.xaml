<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:telerik="using:Telerik.UI.Xaml.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/Primitives/Themes/ThemeColorsDark.xaml"/>
        <ResourceDictionary>
            <telerik:UserThemeResources x:Key="ResourceLoaderInitializer"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="{CustomResource DarkResourcesPath}"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>

    <!--#region ListView-->
    <SolidColorBrush x:Key="TelerikListView_Foreground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikListView_Background" Color="{ThemeResource ControlFillColorDefault}"/>
    <SolidColorBrush x:Key="TelerikListView_BorderBrush" Color="{ThemeResource ControlStrokeColorDefault}"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBackgroundFocused" Color="{ThemeResource SubtleFillColorSecondary}"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBackgroundSelected" Color="{ThemeResource SubtleFillColorSecondary}"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBackgroundSelectedPointerOver" Color="{ThemeResource SubtleFillColorTertiary}"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBackgroundDragging" Color="{ThemeResource SubtleFillColorSecondary}"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBorderBrush_Focused" Color="{ThemeResource FocusStrokeColorOuter}"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBorderBrushSelected" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBorderBrushDragging" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikListView_GroupHeaderForeground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikListView_GroupHeaderBackground" Color="{ThemeResource SolidBackgroundFillColorBase}"/>
    <SolidColorBrush x:Key="TelerikListView_GroupHeaderBorderBrush" Color="{ThemeResource SystemChromeMediumColor}"/>
    <SolidColorBrush x:Key="TelerikListView_HeaderForeground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikListView_HeaderBackground" Color="{ThemeResource SolidBackgroundFillColorBase}"/>
    <SolidColorBrush x:Key="TelerikListView_FooterForeground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikListView_FooterBackground" Color="{ThemeResource SolidBackgroundFillColorBase}"/>
    <SolidColorBrush x:Key="TelerikListView_IconForeground" Color="{ThemeResource TextFillColorPrimary}"/>
    <!--#endregion-->

    <!--#region DataForm-->
    <SolidColorBrush x:Key="TelerikDataForm_Foreground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikDataForm_Background" Color="{ThemeResource SolidBackgroundFillColorTertiary}"/>
    <SolidColorBrush x:Key="TelerikDataForm_BorderBrush" Color="{ThemeResource ControlStrokeColorDefault}"/>
    <SolidColorBrush x:Key="TelerikDataForm_ValidationSummaryForeground" Color="#FFFF99A4"/>
    <SolidColorBrush x:Key="TelerikDataForm_ValidationSummaryBackground" Color="{ThemeResource SolidBackgroundFillColorBase}"/>
    <!--#endregion-->

    <!--#region PropertyGrid-->
    <SolidColorBrush x:Key="TelerikCollectionNavigator_ButtonForeground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikCollectionNavigator_Foreground" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TelerikCollectionNavigator_Background" Color="{ThemeResource SolidBackgroundFillColorBase}" />
    <SolidColorBrush x:Key="TelerikCollectionNavigator_BorderBrush" Color="{ThemeResource ControlStrokeColorDefault}" />

    <SolidColorBrush x:Key="TelerikCollectionEditorPicker_Foreground" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TelerikCollectionEditorPicker_ForegroundDisabled" Color="{ThemeResource TextFillColorDisabled}" />
    <SolidColorBrush x:Key="TelerikCollectionEditorPicker_Background" Color="{ThemeResource ControlFillColorDefault}" />
    <SolidColorBrush x:Key="TelerikCollectionEditorPicker_BackgroundDisabled" Color="{ThemeResource ControlFillColorDisabled}" />
    <LinearGradientBrush x:Key="TelerikCollectionEditorPicker_BorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform ScaleY="-1" CenterY="0.5"/>
        </LinearGradientBrush.RelativeTransform>
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0.5" Color="{ThemeResource ControlStrongStrokeColorDefault}"/>
            <GradientStop Offset="1.0" Color="{ThemeResource ControlStrokeColorDefault}"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TelerikCollectionEditorPicker_BorderBrushDisabled" Color="{ThemeResource ControlStrokeColorDefault}" />
    <SolidColorBrush x:Key="TelerikCollectionEditorPicker_DropDownIndicatorForeground" Color="{ThemeResource TextFillColorSecondary}" />

    <SolidColorBrush x:Key="TelerikCollectionEditor_Foreground" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TelerikCollectionEditor_ForegroundDisabled" Color="{ThemeResource TextFillColorDisabled}" />
    <SolidColorBrush x:Key="TelerikCollectionEditor_HeaderForeground" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TelerikCollectionEditor_Background" Color="{ThemeResource ControlFillColorDefault}" />
    <SolidColorBrush x:Key="TelerikCollectionEditor_HeaderBackground" Color="{ThemeResource SolidBackgroundFillColorBase}" />
    <SolidColorBrush x:Key="TelerikCollectionEditor_FooterBackground" Color="{ThemeResource SolidBackgroundFillColorBase}" />
    <SolidColorBrush x:Key="TelerikCollectionEditor_BorderBrush" Color="{ThemeResource ControlStrokeColorDefault}" />

    <SolidColorBrush x:Key="TelerikPropertyGrid_EditorForeground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikPropertyGrid_EditorBackground" Color="{ThemeResource ControlFillColorDefault}"/>
    <SolidColorBrush x:Key="TelerikPropertyGrid_EditorBorderBrush" Color="{ThemeResource ControlStrokeColorDefault}"/>

    <SolidColorBrush x:Key="TelerikPropertyGrid_NestedToggleButtonForeground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikPropertyGrid_NestedToggleButtonDisabledForeground" Color="{ThemeResource TextFillColorDisabled}"/>

    <SolidColorBrush x:Key="TelerikPropertyGrid_ToggleButtonForeground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikPropertyGrid_ToggleButtonIconForeground" Color="{ThemeResource TextFillColorSecondary}"/>
    <SolidColorBrush x:Key="TelerikPropertyGrid_ToggleButtonDisabledForeground" Color="{ThemeResource TextFillColorDisabled}"/>
    <SolidColorBrush x:Key="TelerikPropertyGrid_ToggleButtonBackground" Color="{ThemeResource SolidBackgroundFillColorQuarternary}"/>
    <SolidColorBrush x:Key="TelerikPropertyGrid_ToggleButtonBorderBrush" Color="{ThemeResource ControlStrokeColorDefault}"/>

    <SolidColorBrush x:Key="TelerikPropertyGrid_Foreground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikPropertyGrid_ForegroundInvalid" Color="#FFFF99A4"/>
    <SolidColorBrush x:Key="TelerikPropertyGrid_ForegroundDisabled" Color="{ThemeResource TextFillColorDisabled}"/>
    <SolidColorBrush x:Key="TelerikPropertyGrid_Background" Color="{ThemeResource SolidBackgroundFillColorQuarternary}"/>
    <SolidColorBrush x:Key="TelerikPropertyGrid_BorderBrush" Color="{ThemeResource ControlStrokeColorDefault}"/>
    <SolidColorBrush x:Key="TelerikPropertyGrid_HeaderBackground" Color="{ThemeResource SolidBackgroundFillColorBase}"/>
    <SolidColorBrush x:Key="TelerikPropertyGrid_FieldForeground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikPropertyGrid_FieldBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikPropertyGrid_FieldBorderBrush" Color="{ThemeResource ControlStrokeColorDefault}"/>
    <SolidColorBrush x:Key="TelerikPropertyGrid_FieldBackgroundPointerOver" Color="{ThemeResource SubtleFillColorTertiary}"/>
    <SolidColorBrush x:Key="TelerikPropertyGrid_FieldBackgroundSelected" Color="{ThemeResource SubtleFillColorSecondary}"/>
    <!--#endregion-->
</ResourceDictionary>

