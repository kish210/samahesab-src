<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:telerik="using:Telerik.UI.Xaml.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/Primitives/Themes/ThemeColorsHighContrast.xaml"/>
        <ResourceDictionary>
            <telerik:UserThemeResources x:Key="ResourceLoaderInitializer"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="{CustomResource HighContrastResourcesPath}"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>

    <!--#region SegmentedControl Brushes-->
    <SolidColorBrush x:Key="TelerikSegmentedControl_Foreground" Color="{ThemeResource SystemColorButtonTextColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_ForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_ForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_Background" Color="{ThemeResource SystemColorWindowColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_BackgroundPointerOver" Color="{ThemeResource SystemColorButtonFaceColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_BackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_BackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColorDark1}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_BackgroundPressed" Color="{ThemeResource SystemColorButtonFaceColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_BorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_BorderBrushDisabled" Color="{ThemeResource SystemColorButtonTextColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_SeparatorBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
    <!--#endregion-->

    <!--#region NumericBox-->
    <SolidColorBrush x:Key="TelerikNumericBox_Foreground" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_ForegroundFocused" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_ForegroundDisabled" Color="{ThemeResource SystemChromeDisabledLowColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_Background" Color="{ThemeResource SystemColorWindowColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_BackgroundFocused" Color="{ThemeResource SystemColorButtonFaceColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_BorderBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_BorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_BorderBrushFocused" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_BackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_BorderBrushDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <!--Buttons-->
    <SolidColorBrush x:Key="TelerikNumericBox_ButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_ButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorButtonFaceColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_ButtonBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_ButtonBorderBrushDisabled" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <!--Clear button-->
    <SolidColorBrush x:Key="TelerikNumericBox_ClearButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
    <SolidColorBrush x:Key="TelerikNumericBox_ClearButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
    <!--#endregion-->

    <!--#region Rating-->
    <SolidColorBrush x:Key="TelerikRating_IconForeground" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikRating_IconForeground_Filled" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikRating_IconForeground_Highlighted" Color="{ThemeResource SystemAccentColor}" Opacity="0.9"/>
    <!--#endregion-->

    <!--#region DateTimePicker-->
    <SolidColorBrush x:Key="TelerikDateTimePicker_Foreground" Color="{ThemeResource SystemColorWindowTextColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_Background" Color="{ThemeResource SystemColorButtonFaceColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_BorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikDateTimePicker_BackgroundPointerOver" Color="{ThemeResource SystemColorButtonFaceColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_BackgroundPressed" Color="{ThemeResource SystemColorButtonFaceColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_BackgroundFocused" Color="{ThemeResource SystemColorButtonFaceColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_BorderBrushPressed" Color="{ThemeResource SystemColorButtonTextColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_BorderBrushFocused" Color="{ThemeResource SystemColorWindowTextColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_BorderBrushDisabled" Color="{ThemeResource SystemColorButtonTextColor}" />
    <!--Selector-->
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorBackground" Color="{ThemeResource SystemColorWindowColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    <!--SelectorItem-->
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorItem_Foreground" Color="{ThemeResource SystemColorButtonTextColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorItem_ForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorItem_Background" Color="Transparent" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorItem_BackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
    <!--SelectorButton-->
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorButton_Foreground" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorButton_Background" Color="Transparent" />
    <!--#endregion-->

    <!--#region MaskedInput-->
    <SolidColorBrush x:Key="TelerikMaskedInput_Foreground" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_ForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_HeaderForeground" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_HeaderForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_DescriptionForeground" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_Background" Color="{ThemeResource SystemColorWindowColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_BackgroundPointerOver" Color="{ThemeResource SystemColorButtonFaceColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_BackgroundFocused" Color="{ThemeResource SystemColorButtonFaceColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_BackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_BorderBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_BorderBrushPointerOver" Color="{ThemeResource SystemColorHotlightColor}"/>
    <LinearGradientBrush x:Key="TelerikMaskedInput_BorderBrushFocused" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform ScaleY="-1" CenterY="0.5"/>
        </LinearGradientBrush.RelativeTransform>
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="1.0" Color="{ThemeResource SystemAccentColorLight2}"/>
            <GradientStop Offset="1.0" Color="{StaticResource ControlStrokeColorDefault}"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TelerikMaskedInput_BorderBrushInvalid" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_BorderBrushDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_ValidationBrush" Color="#A80000"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_ClearButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_ClearButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_ClearButtonBackgroundPointerOver" Color="{ThemeResource SystemColorButtonFaceColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_ClearButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
    <!--#endregion-->
</ResourceDictionary>

