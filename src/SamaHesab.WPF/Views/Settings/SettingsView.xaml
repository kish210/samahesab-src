<UserControl x:Class="SamaHesab.WPF.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Settings Menu -->
        <Border Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="تنظیماتِ همین صفحه" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}"
                           FontFamily="{StaticResource VazirFont}" FontSize="11" Margin="16,0,16,8"/>
                <Button Content="🏢 اطلاعات شرکت"    Style="{StaticResource SidebarItemButton}" Click="Section_Click" Tag="Company"/>
                <Button Content="🎨 ظاهر و ارز"      Style="{StaticResource SidebarItemButton}" Click="Section_Click" Tag="Appearance"/>
                <Button Content="📱 پیام کوتاه (SMS)" Style="{StaticResource SidebarItemButton}" Click="Section_Click" Tag="Sms"/>
                <Button Content="ℹ نسخه و به‌روزرسانی" Style="{StaticResource SidebarItemButton}" Click="Section_Click" Tag="About"/>

                <TextBlock Text="تنظیماتِ تخصصی" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}"
                           FontFamily="{StaticResource VazirFont}" FontSize="11" Margin="16,18,16,8"/>
                <Button Content="👤 کاربران و دسترسی‌ها" Style="{StaticResource SidebarItemButton}" Command="{Binding OpenSecurityCommand}"/>
                <Button Content="🧩 مدیریت ماژول‌ها"     Style="{StaticResource SidebarItemButton}" Command="{Binding OpenModulesCommand}"/>
                <Button Content="🏢 مدیریت شعب"          Style="{StaticResource SidebarItemButton}" Command="{Binding OpenBranchesCommand}"/>
                <Button Content="💾 پشتیبان‌گیری"         Style="{StaticResource SidebarItemButton}" Command="{Binding OpenBackupCommand}"/>
            </StackPanel>
        </Border>

        <!-- Settings Panel -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">

                <!-- Company Info -->
                <Border x:Name="CompanySection" Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🏢 اطلاعات شرکت" FontWeight="Bold" FontSize="15"
                                   Foreground="{DynamicResource PrimaryText}"
                                   FontFamily="{StaticResource VazirFont}" Margin="0,0,0,20"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="نام شرکت *"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Text="{Binding CompanyName}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FormLabel}" Text="تلفن شرکت"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Text="{Binding CompanyPhone}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="شروع سال مالی"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Text="{Binding FiscalYearStart}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FormLabel}" Text="پایان سال مالی"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Text="{Binding FiscalYearEnd}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="شناسهٔ ملی"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Text="{Binding CompanyNationalId}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FormLabel}" Text="کدِ اقتصادی"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Text="{Binding CompanyEconomicCode}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="شمارهٔ ثبت"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Text="{Binding CompanyRegNumber}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FormLabel}" Text="کدِ پستی"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Text="{Binding CompanyPostalCode}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="ایمیل"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Text="{Binding CompanyEmail}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}" FlowDirection="LeftToRight"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FormLabel}" Text="وب‌سایت"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Text="{Binding CompanyWebsite}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}" FlowDirection="LeftToRight"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource FormLabel}" Text="نشانی"/>
                            <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                <TextBox Text="{Binding CompanyAddress}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Financial defaults -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="💲 پیش‌فرض‌های مالی" FontWeight="Bold" FontSize="15"
                                   Foreground="{DynamicResource PrimaryText}" FontFamily="{StaticResource VazirFont}" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="نرخِ مالیات بر ارزش افزوده (٪)"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Text="{Binding DefaultVatRate}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FormLabel}" Text="ارقامِ اعشارِ مبالغ"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Text="{Binding DecimalPlaces}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="پیشوندِ شمارهٔ سند"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Text="{Binding VoucherPrefix}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FormLabel}" Text="پیشوندِ شمارهٔ فاکتور"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Text="{Binding InvoicePrefix}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Backup config -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="💾 پشتیبان‌گیری" FontWeight="Bold" FontSize="15"
                                       Foreground="{DynamicResource PrimaryText}" FontFamily="{StaticResource VazirFont}"/>
                            <CheckBox Content="پشتیبان‌گیریِ خودکار" IsChecked="{Binding AutoBackupEnabled}"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Foreground="{DynamicResource PrimaryText}" FontFamily="{StaticResource VazirFont}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="مسیرِ پشتیبان"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Text="{Binding BackupPath}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}" FlowDirection="LeftToRight"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FormLabel}" Text="بازهٔ روز"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" Width="80">
                                    <TextBox Text="{Binding BackupIntervalDays}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}" FlowDirection="LeftToRight" HorizontalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Button Content="💾 پشتیبان‌گیری اکنون" Style="{StaticResource SecondaryButton}" Height="36"
                                HorizontalAlignment="Right" Margin="0,12,0,0" FontFamily="{StaticResource VazirFont}"
                                Command="{Binding OpenBackupCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border x:Name="AppearanceSection" Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🎨 ظاهر و تم نرم‌افزار" FontWeight="Bold" FontSize="15"
                                   Foreground="{DynamicResource PrimaryText}"
                                   FontFamily="{StaticResource VazirFont}" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="تم رابط کاربری"/>
                                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Height="36">
                                    <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource BaseComboBox}"/></ComboBox.Style>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FormLabel}" Text="نمایش ارز"/>
                                <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}" Height="36">
                                    <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource BaseComboBox}"/></ComboBox.Style>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <!-- حالتِ فشرده (چگالی): کاهشِ فضای خالی و نمایشِ اطلاعاتِ بیشتر — اعمالِ زنده -->
                        <CheckBox Content="حالتِ فشرده (نمایشِ اطلاعاتِ بیشتر در هر صفحه؛ مناسبِ کارِ روزانه)"
                                  IsChecked="{Binding CompactMode}" Margin="0,16,0,0"
                                  FontFamily="{StaticResource VazirFont}" Foreground="{DynamicResource PrimaryText}"/>
                    </StackPanel>
                </Border>

                <!-- SMS Settings -->
                <Border x:Name="SmsSection" Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="📱 تنظیمات پیام کوتاه" FontWeight="Bold" FontSize="15"
                                       Foreground="{DynamicResource PrimaryText}"
                                       FontFamily="{StaticResource VazirFont}"/>
                            <CheckBox Content="فعال‌سازی SMS" IsChecked="{Binding SmsEnabled}"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Foreground="{DynamicResource PrimaryText}"
                                      FontFamily="{StaticResource VazirFont}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FormLabel}" Text="درگاه پیامک"/>
                                <ComboBox ItemsSource="{Binding SmsProviders}" SelectedItem="{Binding SmsProvider}" Height="36" IsEnabled="{Binding SmsEnabled}">
                                    <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource BaseComboBox}"/></ComboBox.Style>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FormLabel}" Text="API Key / نام کاربری"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Text="{Binding SmsApiKey}" Background="Transparent" BorderThickness="0" IsEnabled="{Binding SmsEnabled}" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource FormLabel}" Text="شماره فرستنده"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Text="{Binding SmsSender}" Background="Transparent" BorderThickness="0" IsEnabled="{Binding SmsEnabled}" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                                </Border>
                                <Button Grid.Column="2" Content="🧪 آزمایش ارسال" Style="{StaticResource SecondaryButton}" Height="36" IsEnabled="{Binding SmsEnabled}" Command="{Binding TestSmsCommand}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- About & Update -->
                <Border x:Name="AboutSection" Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="ℹ نسخه و به‌روزرسانی" FontWeight="Bold" FontSize="15"
                                   Foreground="{DynamicResource PrimaryText}"
                                   FontFamily="{StaticResource VazirFont}" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppVersionText}" Foreground="{DynamicResource PrimaryText}"
                                           FontFamily="{StaticResource VazirFont}" FontSize="13"/>
                                <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource SecondaryText}"
                                           FontFamily="{StaticResource VazirFont}" FontSize="12" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="© ۱۴۰۴ سماع رایانه کیش" Foreground="{DynamicResource SecondaryText}"
                                           FontFamily="{StaticResource VazirFont}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="🔄 بررسی به‌روزرسانی" Style="{StaticResource SecondaryButton}"
                                    Height="38" VerticalAlignment="Center" FontFamily="{StaticResource VazirFont}"
                                    Command="{Binding CheckUpdateCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Save Button -->
                <Button Content="💾 ذخیره تمام تنظیمات" Style="{StaticResource SuccessButton}"
                        Height="46" FontSize="14" FontFamily="{StaticResource VazirFont}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
