<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:telerik="using:Telerik.UI.Xaml.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/Primitives/Themes/ThemeColorsLight.xaml"/>
        <ResourceDictionary>
            <telerik:UserThemeResources x:Key="ResourceLoaderInitializer"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="{CustomResource LightResourcesPath}"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>

    <!-- Axis -->
    <SolidColorBrush x:Key="TelerikChart_AxisBorderBrush" Color="#30000000" />
    <SolidColorBrush x:Key="TelerikChart_AxisLabelsForeground" Color="{StaticResource TelerikDisabledColor}"/>
    <SolidColorBrush x:Key="TelerikChart_AxisTitleForeground" Color="{StaticResource TelerikSecondaryForegroundColor}"/>

    <!-- Grid -->
    <SolidColorBrush x:Key="TelerikChart_GridLineBorderBrush" Color="#23000000" />
    <SolidColorBrush x:Key="TelerikChart_StripeBackground" Color="#0A000000" />

    <!-- Annotations -->
    <SolidColorBrush x:Key="TelerikChart_GridLineAnnotationBorderBrush" Color="#991D1D1D" />
    <SolidColorBrush x:Key="TelerikChart_PlotBandAnnotationBackground" Color="#190D486B" />
    <SolidColorBrush x:Key="TelerikChart_MarkedZoneAnnotationBackground" Color="#190D486B" />

    <!-- TrackBall -->
    <SolidColorBrush x:Key="TelerikChart_TrackBallInfoForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TelerikChart_TrackBallInfoBackground" Color="#DE000000" />
    <SolidColorBrush x:Key="TelerikChart_TrackBallInfoBorderBrush" Color="#DE000000" />
    <SolidColorBrush x:Key="TelerikChart_TrackBallLineBorderBrush" Color="#DE000000" />

    <SolidColorBrush x:Key="TelerikChart_ToolTipForeground" Color="{StaticResource TelerikBlackColor}"/>
    <SolidColorBrush x:Key="TelerikChart_ToolTipBackground" Color="{StaticResource TelerikWhiteColor}"/>

    <SolidColorBrush x:Key="TelerikChart_PolarChartGridStripeBrush" Color="#66000000" Opacity="0.15"/>
</ResourceDictionary>

