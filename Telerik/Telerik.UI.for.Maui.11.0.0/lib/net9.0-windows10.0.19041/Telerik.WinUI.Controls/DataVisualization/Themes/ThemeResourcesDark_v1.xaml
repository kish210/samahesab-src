<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:telerik="using:Telerik.UI.Xaml.Controls"
    xmlns:dataVisualization="using:Telerik.UI.Xaml.Controls.DataVisualization">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/Primitives/Themes/ThemeColorsDark.xaml"/>
        <ResourceDictionary>
            <telerik:UserThemeResources x:Key="ResourceLoaderInitializer"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="{CustomResource DarkResourcesPath}"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>

    <!--Demos resource-->
    <Color x:Key="TelerikDataVisualizationColor5">#FF00CC6A</Color>
    <Color x:Key="TelerikDataVisualizationColor6">#FFFF99A4</Color>

    <!--#region Gauges-->
    <!--Default styles resources-->
    <SolidColorBrush x:Key="TelerikGauge_RangeForegroundBrush" Color="{StaticResource TelerikSecondaryForegroundColor}"/>
    <SolidColorBrush x:Key="TelerikGauge_TickBackgroundBrush" Color="#FF999999"/>
    <!--Demos resources-->
    <SolidColorBrush x:Key="TelerikGauge_RangeBackgroundBrush" Color="{StaticResource TelerikSecondaryForegroundColor}"/>
    <SolidColorBrush x:Key="TelerikGauge_MainIndicatorBackgroundBrush" Color="{StaticResource TelerikForegroundColor}"/>
    <SolidColorBrush x:Key="TelerikGauge_SecondaryIndicatorBackgroundBrush" Color="{StaticResource TelerikSecondaryForegroundColor}"/>
    <SolidColorBrush x:Key="TelerikGauge_ThirdIndicatorBackgroundBrush" Color="#21FFFFFF"/>
    <SolidColorBrush x:Key="TelerikGauge_GoodBackgroundBrush" Color="#FF999999"/>
    <SolidColorBrush x:Key="TelerikGauge_BadBackgroundBrush" Color="#FFFF0000"/>
    <SolidColorBrush x:Key="TelerikGauge_IndicatorBrush" Color="#FF00CC6A"/>
    <SolidColorBrush x:Key="TelerikGauge_MarkerBrush" Color="#FF0078D4"/>
    <!--#endregion-->

    <!--#region BulletGraph-->
    <!--Default styles resources-->
    <SolidColorBrush x:Key="TelerikBulletGraph_FeaturedMeasureBackgroundBrush" Color="{StaticResource TelerikBlackColor}"/>
    <SolidColorBrush x:Key="TelerikBulletGraph_TickBackgroundBrush" Color="{StaticResource TelerikSecondaryForegroundColor}"/>
    <SolidColorBrush x:Key="TelerikBulletGraph_ComparitiveMeasureBackgroundBrush" Color="#FFFF8000"/>
    <!--Demos resources-->
    <SolidColorBrush x:Key="TelerikBulletGraph_LabelBrush" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikBulletGraph_GoodQualitativeRangeBackgroundBrush" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="TelerikBulletGraph_SatisfactoryQualitativeRangeBackgroundBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="TelerikBulletGraph_BadQualitativeRangeBackgroundBrush" Color="#19FFFFFF"/>
    <!--#endregion-->

    <!--#region Sparklines-->
    <SolidColorBrush x:Key="TelerikSparkline_Stroke" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikSparkline_AxisStroke" Color="{ThemeResource SystemBaseMediumLowColor}"/>
    <SolidColorBrush x:Key="TelerikSparkline_MarkersBrush" Color="#FF0099BC"/>
    <SolidColorBrush x:Key="TelerikSparkline_NormalRangeFill" Color="{ThemeResource SystemChromeLowColor}"/>
    <SolidColorBrush x:Key="TelerikSparkline_PositiveAreaFill" Color="#FF15D7FF"/>
    <SolidColorBrush x:Key="TelerikSparkline_NegativeAreaFill" Color="#FF15D7FF"/>
    <SolidColorBrush x:Key="TelerikSparkline_NegativeAreaStroke" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikSparkline_FirstLastPointBrush" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikSparkline_HighLowPointBrush" Color="#FF00CC6A"/>
    <SolidColorBrush x:Key="TelerikSparkline_NegativePointBrush" Color="#FFFF4343"/>
    <SolidColorBrush x:Key="TelerikSparkline_Fill_Column" Color="{ThemeResource SystemChromeHighColor}"/>
    <SolidColorBrush x:Key="TelerikSparkline_FirstLastPointBrush_Column" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikSparkline_HighLowPointBrush_Column" Color="#FF00CC6A"/>
    <SolidColorBrush x:Key="TelerikSparkline_NegativePointBrush_Column" Color="#FFFF4343"/>
    <!--#endregion-->

    <!--#region Databars-->
    <Color x:Key="TelerikDataBarThemeColor1">#FF0066D4</Color>
    <Color x:Key="TelerikDataBarThemeColor2">#FFFFB900</Color>
    <Color x:Key="TelerikDataBarThemeColor3">#FFC239BE</Color>
    <Color x:Key="TelerikDataBarThemeColor4">#FF00CC6A</Color>
    <dataVisualization:BrushCollection x:Key="TelerikDataBar_StackedBrushes">
        <SolidColorBrush Color="{StaticResource TelerikDataBarThemeColor1}"/>
        <SolidColorBrush Color="{StaticResource TelerikDataBarThemeColor2}"/>
        <SolidColorBrush Color="{StaticResource TelerikDataBarThemeColor3}"/>
        <SolidColorBrush Color="{StaticResource TelerikDataBarThemeColor4}"/>
    </dataVisualization:BrushCollection>
    <dataVisualization:BrushCollection x:Key="TelerikDataBar_StackedBorderBrushes">
        <SolidColorBrush Color="{StaticResource TelerikDataBarThemeColor1}"/>
        <SolidColorBrush Color="{StaticResource TelerikDataBarThemeColor2}"/>
        <SolidColorBrush Color="{StaticResource TelerikDataBarThemeColor3}"/>
        <SolidColorBrush Color="{StaticResource TelerikDataBarThemeColor4}"/>
    </dataVisualization:BrushCollection>
    <SolidColorBrush x:Key="TelerikDataBar_Foreground" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikDataBar_AxisStroke" Color="{ThemeResource SystemBaseMediumLowColor}"/>
    <SolidColorBrush x:Key="TelerikDataBar_ValueBrush" Color="{StaticResource TelerikDataBarThemeColor1}"/>
    <SolidColorBrush x:Key="TelerikDataBar_NegativeValueBrush" Color="#FFFF4343"/>
    <!--#endregion-->

    <!--#region Map-->
    <SolidColorBrush x:Key="TelerikMap_Background" Color="{ThemeResource SystemAltHighColor}"/>
    <SolidColorBrush x:Key="TelerikMap_SeparatorBorderBrush" Color="{ThemeResource SystemChromeMediumColor}"/>
    <SolidColorBrush x:Key="TelerikMap_NavigationBarBackground" Color="{ThemeResource SystemChromeBlackHighColor}" Opacity="0.4"/>
    <SolidColorBrush x:Key="TelerikMap_NavigationButton_Foreground" Color="{ThemeResource SystemChromeWhiteColor}"/>
    <SolidColorBrush x:Key="TelerikMap_NavigationButton_Foreground_PointerOver" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikMap_NavigationButton_Foreground_Accent" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikMap_Scale_Foreground" Color="{ThemeResource SystemChromeWhiteColor}"/>
    <SolidColorBrush x:Key="TelerikMap_Scale_Background" Color="{ThemeResource SystemChromeWhiteColor}"/>
    <SolidColorBrush x:Key="TelerikMap_NoIndicatorDropDownButton_Foreground" Color="{ThemeResource SystemChromeWhiteColor}"/>
    <SolidColorBrush x:Key="TelerikMap_NoIndicatorDropDownButton_Foreground_PointerOver" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikMap_NoIndicatorDropDownButton_Foreground_Pressed" Color="{ThemeResource SystemListAccentHighColor}"/>
    <SolidColorBrush x:Key="TelerikMap_MouseLocationIndicator_Foreground" Color="{ThemeResource SystemChromeWhiteColor}"/>
    <SolidColorBrush x:Key="TelerikMap_MouseLocationIndicator_Background" Color="{ThemeResource SystemChromeBlackHighColor}" Opacity="0.4"/>
    <SolidColorBrush x:Key="TelerikMap_Expander_Background" Color="{ThemeResource SystemListLowColor}"/>
    <SolidColorBrush x:Key="TelerikMap_Expander_BackgroundCollapsed" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikMap_Expander_BorderBrush" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikMap_Expander_BorderBrushCollapsed" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikMap_Expander_HeaderButton_Foreground" Color="{ThemeResource SystemChromeWhiteColor}"/>
    <SolidColorBrush x:Key="TelerikMap_Expander_HeaderButton_ForegroundChecked" Color="{ThemeResource SystemChromeWhiteColor}"/>
    <SolidColorBrush x:Key="TelerikMap_Expander_HeaderButton_UnderlayBackground" Color="{ThemeResource SystemAltHighColor}"/>
    <SolidColorBrush x:Key="TelerikMap_Expander_HeaderButton_Background" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikMap_Expander_HeaderButton_BackgroundPointerOver" Color="{ThemeResource SystemListAccentLowColor}"/>
    <SolidColorBrush x:Key="TelerikMap_Expander_HeaderButton_BackgroundPressed" Color="{ThemeResource SystemListAccentHighColor}"/>
    <SolidColorBrush x:Key="TelerikMap_Expander_HeaderButton_BackgroundChecked" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikMap_Expander_HeaderButton_BackgroundCheckedPointerOver" Color="{ThemeResource SystemListAccentLowColor}"/>
    <SolidColorBrush x:Key="TelerikMap_Expander_HeaderButton_BackgroundCheckedPressed" Color="{ThemeResource SystemListAccentHighColor}"/>
    <SolidColorBrush x:Key="TelerikMap_MiniMap_ViewportArea_Stroke" Color="{ThemeResource SystemBaseMediumLowColor}"/>
    <SolidColorBrush x:Key="TelerikMap_MiniMap_ViewportArea_Fill" Color="{ThemeResource SystemAltLowColor}"/>
    <SolidColorBrush x:Key="TelerikMap_Pushpin_Background" Color="#FFF7630C"/>
    <!--#endregion-->
</ResourceDictionary>

