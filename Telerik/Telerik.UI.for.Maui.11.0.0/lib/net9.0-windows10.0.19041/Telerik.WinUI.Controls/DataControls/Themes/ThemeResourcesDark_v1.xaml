<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:telerik="using:Telerik.UI.Xaml.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/Primitives/Themes/ThemeColorsDark.xaml"/>
        <ResourceDictionary>
            <telerik:UserThemeResources x:Key="ResourceLoaderInitializer"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="{CustomResource DarkResourcesPath}"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>

    <!--#region ListView-->
    <SolidColorBrush x:Key="TelerikListView_Foreground" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikListView_Background" Color="{ThemeResource SystemAltHighColor}"/>
    <SolidColorBrush x:Key="TelerikListView_BorderBrush" Color="{ThemeResource SystemChromeMediumLowColor}"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBackgroundPointerOver" Color="{ThemeResource SystemListLowColor}"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.4"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBackgroundDragging" Color="{ThemeResource SystemAccentColor}" Opacity="0.6"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBorderBrush_Focused" Color="{ThemeResource SystemBaseMediumHighColor}"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBorderBrushSelected" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikListView_ItemBorderBrushDragging" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikListView_GroupHeaderForeground" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikListView_GroupHeaderBackground" Color="{ThemeResource SystemAltHighColor}"/>
    <SolidColorBrush x:Key="TelerikListView_GroupHeaderBorderBrush" Color="{ThemeResource SystemChromeMediumColor}"/>
    <SolidColorBrush x:Key="TelerikListView_HeaderForeground" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikListView_HeaderBackground" Color="{ThemeResource SystemChromeMediumColor}"/>
    <SolidColorBrush x:Key="TelerikListView_FooterForeground" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikListView_FooterBackground" Color="{ThemeResource SystemChromeMediumColor}"/>
    <SolidColorBrush x:Key="TelerikListView_IconForeground" Color="{ThemeResource SystemBaseHighColor}"/>
    <!--#endregion-->

    <!--#region DataForm-->
    <SolidColorBrush x:Key="TelerikDataForm_Foreground" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikDataForm_Background" Color="{ThemeResource SystemAltHighColor}"/>
    <SolidColorBrush x:Key="TelerikDataForm_BorderBrush" Color="{ThemeResource SystemChromeMediumLowColor}"/>
    <SolidColorBrush x:Key="TelerikDataForm_ValidationSummaryForeground" Color="#A80000"/>
    <SolidColorBrush x:Key="TelerikDataForm_ValidationSummaryBackground" Color="{ThemeResource SystemChromeLowColor}"/>
    <!--#endregion-->
</ResourceDictionary>

