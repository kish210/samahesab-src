<UserControl x:Class="SamaHesab.WPF.Views.Purchase.PurchaseOrderListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft"
             Background="{StaticResource ErpAppBg}">
    <!-- F5 = بازخوانی (کیبوردمحور، هم‌راستا با بقیهٔ صفحات) -->
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- تولبار -->
            <RowDefinition Height="*"/>      <!-- سفارش‌ها -->
            <RowDefinition Height="Auto"/>   <!-- پیشنهادِ نقطهٔ سفارش -->
        </Grid.RowDefinitions>

        <!-- ═══ تولبار ═══ -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IcTruck}" Style="{StaticResource ErpToolSvg}" Width="18" Height="18" Stroke="{StaticResource ErpBlue700}"/>
                    <TextBlock Text="سفارش‌های خرید" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource ErpBtnPrimary}" Height="30" Padding="14,0" Margin="0,0,6,0"
                            Content="＋ ساخت سفارش از نقطهٔ سفارش" Command="{Binding CreateFromReorderCommand}"/>
                    <Button Style="{StaticResource ErpBtnGhost}" Height="30" Padding="12,0" Content="بازخوانی" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ فهرستِ سفارش‌های خرید ═══ -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="0">
            <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      ItemsSource="{Binding Orders}" RowHeight="{DynamicResource ErpDensRowHeight}" GridLinesVisibility="All" FontFamily="{StaticResource VazirFont}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="شماره" Binding="{Binding OrderNumber}" Width="120"/>
                    <DataGridTextColumn Header="تاریخ" Binding="{Binding OrderDate}" Width="110"/>
                    <DataGridTextColumn Header="منبع" Binding="{Binding Source}" Width="120"/>
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusCode}" Width="110"/>
                    <DataGridTextColumn Header="تعداد اقلام" Binding="{Binding ItemCount}" Width="100"/>
                    <DataGridTextColumn Header="جمع (ریال)" Binding="{Binding Total, StringFormat={}{0:#,##0}}" Width="*">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══ پیشنهادِ نقطهٔ سفارش ═══ -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="0" Margin="0,6,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#FFF7ED" CornerRadius="6,6,0,0" Padding="10,6">
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="#B45309"
                               Text="{Binding SuggestionCount, StringFormat='پیشنهادِ نقطهٔ سفارش — {0} کالا زیرِ آستانه'}"/>
                </Border>
                <DataGrid Grid.Row="1" Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          ItemsSource="{Binding Suggestions}" RowHeight="26" MaxHeight="200" GridLinesVisibility="All" FontFamily="{StaticResource VazirFont}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="موجودیِ فعلی" Binding="{Binding OnHand, StringFormat={}{0:#,##0.##}}" Width="130">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="Foreground" Value="{StaticResource ErpDanger500}"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="آستانه" Binding="{Binding Threshold, StringFormat={}{0:#,##0.##}}" Width="110">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="مقدارِ پیشنهادی" Binding="{Binding SuggestedQty, StringFormat={}{0:#,##0.##}}" Width="140">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource ErpBlue700}"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
