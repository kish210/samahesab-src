    <!--#region RibbonScrollViewer-->
    <ControlTemplate x:Key="RibbonScrollButtonTemplate" TargetType="RepeatButton">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="HighlightedVisual.Background" Value="{ThemeResource TelerikRibbonView_Button_BackgroundPointerOver}"/>
                            <Setter Target="HighlightedVisual.BorderBrush" Value="{ThemeResource TelerikRibbonView_Button_BorderBrushPointerOver}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="HighlightedVisual.Background" Value="{ThemeResource TelerikRibbonView_Button_BackgroundPressed}"/>
                            <Setter Target="HighlightedVisual.BorderBrush" Value="{ThemeResource TelerikRibbonView_Button_BorderBrushPressed}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundVisual" Storyboard.TargetProperty="Background">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TelerikRibbonView_Button_BackgroundDisabled}"/>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="BackgroundVisual"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"/>
            <Border x:Name="HighlightedVisual"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"/>
            <ContentPresenter x:Name="ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              ContentTransitions="{TemplateBinding ContentTransitions}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Grid>
    </ControlTemplate>

    <Style x:Key="RibbonScrollButtonStyle" TargetType="RepeatButton">
        <Setter Property="Template" Value="{StaticResource RibbonScrollButtonTemplate}"/>
        <Setter Property="Background" Value="{ThemeResource TelerikRibbonView_ContentBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TelerikRibbonView_BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Interval" Value="50"/>
        <Setter Property="Width" Value="{ThemeResource TelerikRibbonView_Button_MinSize}"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <ControlTemplate x:Key="RibbonScrollViewerTemplate" TargetType="telerikRibbonViewPrimitives:RibbonScrollViewer">
        <Grid>
            <ContentPresenter x:Name="Content" Margin="1 0" />
            <Grid x:Name="ButtonsGrid" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <RepeatButton x:Name="LeftScrollButtonElement"
                              Style="{StaticResource RibbonScrollButtonStyle}"
                              CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CornerRadius,
                              Converter={StaticResource CornerRadiusConverter}, ConverterParameter=TopBottomLeft}">
                    <FontIcon x:Name="LeftScrollButtonIcon"
                              Foreground="{ThemeResource TelerikRibbonView_IconForeground}"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="{ThemeResource TelerikRibbonView_IconFontSize}"
                              Glyph="&#xE76B;"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </RepeatButton>
                <RepeatButton x:Name="RightScrollButtonElement" Grid.Column="2"
                              Style="{StaticResource RibbonScrollButtonStyle}"
                              CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CornerRadius,
                              Converter={StaticResource CornerRadiusConverter}, ConverterParameter=TopBottomRight}">
                    <FontIcon x:Name="RightScrollButtonIcon"
                              Foreground="{ThemeResource TelerikRibbonView_IconForeground}"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="{ThemeResource TelerikRibbonView_IconFontSize}"
                              Glyph="&#xE76C;"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </RepeatButton>
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style x:Key="RibbonScrollViewerStyle" TargetType="telerikRibbonViewPrimitives:RibbonScrollViewer">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template" Value="{StaticResource RibbonScrollViewerTemplate}" />
    </Style>

    <Style TargetType="telerikRibbonViewPrimitives:RibbonScrollViewer" BasedOn="{StaticResource RibbonScrollViewerStyle}" />
    <!--#endregion-->

    <!--#region GroupChrome-->
    <ControlTemplate x:Key="GroupChromeTemplate" TargetType="telerikRibbonViewPrimitives:GroupChrome">
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="2" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"/>
            <Grid x:Name="Tray" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentControl
                        Content="{TemplateBinding Header}"
                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsTabStop="False"
                        Foreground="{TemplateBinding Foreground}"
                        Margin="0 0 0 2"
                        Opacity="0.8"/>
                <telerik:RadRibbonButton
                        x:Name="DialogLauncher"
                        Grid.Column="1"
                        Padding="2" Margin="0 4 4 0"
                        MinWidth="{ThemeResource TelerikRibbonView_IconFontSize}"
                        MinHeight="{ThemeResource TelerikRibbonView_IconFontSize}"
                        Visibility="{TemplateBinding DialogLauncherVisibility}"
                        IsAutoSize="False"
                        FocusVisualPrimaryBrush="{StaticResource TelerikRibbonView_FocusVisualPrimaryBrush}"
                        TabIndex="1" IsTabStop="False"
                        Command="{TemplateBinding DialogLauncherCommand}"
                        CommandParameter="{TemplateBinding DialogLauncherCommandParameter}">
                    <FontIcon x:Name="DialogLauncherIcon"
                              Foreground="{ThemeResource TelerikRibbonView_IconForeground}"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="{ThemeResource TelerikRibbonView_IconFontSize}"
                              Glyph="&#xE8A7;"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
