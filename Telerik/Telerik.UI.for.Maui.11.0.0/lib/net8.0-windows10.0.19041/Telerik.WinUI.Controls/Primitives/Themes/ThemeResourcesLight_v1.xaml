<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:telerik="using:Telerik.UI.Xaml.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/Primitives/Themes/ThemeColorsLight.xaml"/>
        <ResourceDictionary>
            <telerik:UserThemeResources x:Key="ResourceLoaderInitializer"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="{CustomResource LightResourcesPath}"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="TelerikSecondaryForegroundBrush" Color="{StaticResource TelerikSecondaryForegroundColor}"/>
    <SolidColorBrush x:Key="TelerikWhiteBrush" Color="{StaticResource TelerikWhiteColor}"/>
    <SolidColorBrush x:Key="TelerikBlackBrush" Color="{StaticResource TelerikBlackColor}"/>

    <!--#region Buttons-->
    <SolidColorBrush x:Key="TelerikButton_Foreground" Color="{ThemeResource SystemBaseHighColor}" />
    <SolidColorBrush x:Key="TelerikButton_ForegroundPointerOver" Color="{ThemeResource SystemBaseHighColor}" />
    <SolidColorBrush x:Key="TelerikButton_ForegroundPressed" Color="{ThemeResource SystemBaseHighColor}" />
    <SolidColorBrush x:Key="TelerikButton_ForegroundChecked" Color="{ThemeResource SystemChromeWhiteColor}"/>
    <SolidColorBrush x:Key="TelerikButton_ForegroundCheckedPointerOver" Color="{ThemeResource SystemChromeWhiteColor}" />
    <SolidColorBrush x:Key="TelerikButton_ForegroundCheckedPressed" Color="{ThemeResource SystemChromeWhiteColor}" />
    <SolidColorBrush x:Key="TelerikButton_ForegroundDisabled" Color="{ThemeResource SystemBaseMediumLowColor}" />
    <SolidColorBrush x:Key="TelerikButton_Background" Color="{ThemeResource SystemBaseLowColor}" />
    <SolidColorBrush x:Key="TelerikButton_BackgroundPointerOver" Color="{ThemeResource SystemListLowColor}" />
    <SolidColorBrush x:Key="TelerikButton_BackgroundPressed" Color="{ThemeResource SystemBaseMediumLowColor}" />
    <SolidColorBrush x:Key="TelerikButton_BackgroundChecked" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikButton_BackgroundCheckedPointerOver" Color="{ThemeResource SystemAccentColorLight1}"/>
    <SolidColorBrush x:Key="TelerikButton_BackgroundCheckedPressed" Color="{ThemeResource SystemAccentColorDark1}"/>
    <SolidColorBrush x:Key="TelerikButton_BackgroundOpened" Color="{ThemeResource SystemBaseLowColor}" />
    <SolidColorBrush x:Key="TelerikButton_BackgroundFocused" Color="Transparent" />
    <SolidColorBrush x:Key="TelerikButton_BackgroundDisabled" Color="{ThemeResource SystemBaseLowColor}" />
    <SolidColorBrush x:Key="TelerikButton_BorderBrush" Color="{ThemeResource SystemBaseMediumLowColor}" />
    <SolidColorBrush x:Key="TelerikButton_BorderBrushPointerOver" Color="{ThemeResource SystemBaseMediumColor}" />
    <SolidColorBrush x:Key="TelerikButton_BorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="TelerikButton_BorderBrushChecked" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikButton_BorderBrushCheckedPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikButton_BorderBrushCheckedPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikButton_BorderBrushOpened" Color="Transparent" />
    <SolidColorBrush x:Key="TelerikButton_BorderBrushFocused" Color="{ThemeResource SystemBaseHighColor}" />
    <SolidColorBrush x:Key="TelerikButton_BorderBrushDisabled" Color="Transparent" />
    <!--Dropdown Popup-->
    <SolidColorBrush x:Key="TelerikButton_DropdownBackground" Color="{ThemeResource SystemChromeMediumLowColor}" />
    <SolidColorBrush x:Key="TelerikButton_DropdownBorderBrush" Color="{ThemeResource SystemChromeHighColor}" />
    <!--#endregion-->

    <SolidColorBrush x:Key="TelerikBusyIndicator_Foreground" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikBusyIndicator_IndicatorBackground" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikBusyIndicator_OverlayBackground" Color="{ThemeResource SystemAltMediumLowColor}"/>

    <!--#region PaginationControl-->
    <SolidColorBrush x:Key="TelerikPaginationControl_Foreground" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_ForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_Foreground" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_ForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_Background" Color="{ThemeResource SystemBaseLowColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_BackgroundPointerOver" Color="{ThemeResource SystemListLowColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_BackgroundPressed" Color="{ThemeResource SystemBaseMediumLowColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_BorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_BorderBrushDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Item_Background" Color="{ThemeResource SystemBaseLowColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Item_BackgroundSelected" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Item_BackgroundSelectedDisabled" Color="{ThemeResource SystemAccentColor}" Opacity="0.8"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Item_BackgroundDisabled" Color="{ThemeResource SystemBaseLowColor}" Opacity="0.8"/>
    <!--#endregion-->

    <!--#region SideDrawerControl-->
    <SolidColorBrush x:Key="TelerikSideDrawer_Foreground" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikSideDrawer_BorderBrush" Color="Transparent"/>
    <!--#endregion-->

    <!--#region Hubtile-->
    <SolidColorBrush x:Key="TelerikHubTile_Foreground" Color="{ThemeResource SystemChromeWhiteColor}"/>
    <SolidColorBrush x:Key="TelerikHubTile_Background" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikHubTile_Background_PointerOver" Color="{ThemeResource SystemListLowColor}"/>
    <SolidColorBrush x:Key="TelerikHubTile_BorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikHubTile_BorderBrush_PointerOver" Color="{ThemeResource SystemAccentColorLight1}"/>
    <!--#endregion-->

    <!--#region RangeSlider-->
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionThumb_Background" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionThumb_Background_Disabled" Color="{ThemeResource SystemBaseLowColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionMiddleThumb_Background" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionMiddleThumb_Background_Disabled" Color="{ThemeResource SystemBaseLowColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionMiddleThumb_Background_Pressed" Color="{ThemeResource SystemAccentColorDark1}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionMiddleThumb_Background_PointerOver" Color="{ThemeResource SystemAccentColorLight1}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Track_Background" Color="{ThemeResource SystemBaseMediumLowColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Track_Background_Disabled" Color="{ThemeResource SystemChromeDisabledHighColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Track_Background_PointerOver" Color="{ThemeResource SystemBaseMediumColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_ToolTip_Foreground" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_ToolTip_Foreground_Range" Color="Gray"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_ToolTip_Background" Color="{ThemeResource SystemChromeMediumLowColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_ToolTip_BorderBrush" Color="{ThemeResource SystemChromeHighColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Label_Foreground" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Tick_Fill" Color="{ThemeResource SystemBaseMediumLowColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Line_Fill" Color="Transparent"/>
    <!--#endregion-->

    <!--#region LoopingList-->
    <SolidColorBrush x:Key="TelerikLoopingList_Background" Color="{ThemeResource SystemAltHighColor}" />
    <SolidColorBrush x:Key="TelerikLoopingList_BorderBrush" Color="{ThemeResource SystemBaseMediumLowColor}" />
    <SolidColorBrush x:Key="TelerikLoopingList_ItemForeground" Color="{ThemeResource SystemBaseHighColor}" />
    <SolidColorBrush x:Key="TelerikLoopingList_ItemForegroundSelected" Color="{ThemeResource SystemBaseHighColor}" />
    <SolidColorBrush x:Key="TelerikLoopingList_ItemBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TelerikLoopingList_ItemBackgroundSelected" Color="{ThemeResource SystemListAccentLowColor}" />
    <!--#endregion-->

    <SolidColorBrush x:Key="TelerikShadow_Foreground" Color="{ThemeResource SystemBaseHighColor}" />
    <SolidColorBrush x:Key="TelerikShadow_Background" Color="{ThemeResource SystemAltHighColor}" />

    <SolidColorBrush x:Key="TelerikGridSplitter_Foreground" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikGridSplitter_Background" Color="{ThemeResource SystemChromeMediumLowColor}"/>
    <SolidColorBrush x:Key="TelerikGridSplitter_Background_PointerOver" Color="{ThemeResource SystemListLowColor}"/>
    <SolidColorBrush x:Key="TelerikGridSplitter_Background_Pressed" Color="{ThemeResource SystemBaseMediumLowColor}"/>

    <!--#region Expander-->
    <SolidColorBrush x:Key="TelerikExpander_Foreground" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikExpander_Background" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikExpander_BorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikExpander_HeaderButton_Foreground" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikExpander_HeaderButton_ForegroundPressed" Color="{ThemeResource SystemBaseHighColor}"/>
    <SolidColorBrush x:Key="TelerikExpander_HeaderButton_Background" Color="{ThemeResource SystemBaseLowColor}"/>
    <SolidColorBrush x:Key="TelerikExpander_HeaderButton_BackgroundPointerOver" Color="{ThemeResource SystemListLowColor}"/>
    <SolidColorBrush x:Key="TelerikExpander_HeaderButton_BackgroundPressed" Color="{ThemeResource SystemBaseMediumLowColor}"/>
    <!--#endregion-->

</ResourceDictionary>

