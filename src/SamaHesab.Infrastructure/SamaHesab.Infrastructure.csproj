<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SamaHesab.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- اسکریپت‌های مهاجرتِ DB به‌صورتِ منبعِ توکار (برای DatabaseMigratorِ زمانِ استارت‌آپ) -->
    <EmbeddedResource Include="..\..\database\*.sql" Link="database\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SamaHesab.Application\SamaHesab.Application.csproj" />
    <ProjectReference Include="..\SamaHesab.Domain\SamaHesab.Domain.csproj" />
    <ProjectReference Include="..\SamaHesab.Modules.Abstractions\SamaHesab.Modules.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="QuestPDF" Version="2026.6.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="PdfSharpCore" Version="1.3.65" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="System.Management" Version="9.0.0" /><!-- P-G7 — WMI: مادربرد/CPU -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" /><!-- P-G7 — MachineGuid -->
  </ItemGroup>
</Project>
