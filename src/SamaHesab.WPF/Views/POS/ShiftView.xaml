<UserControl x:Class="SamaHesab.WPF.Views.POS.ShiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft"
             Background="{StaticResource ErpAppBg}">
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="KV" TargetType="DockPanel"><Setter Property="Margin" Value="0,6"/></Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Width="460" Margin="0,24,0,0">
        <Border Style="{StaticResource ErpGbox}" CornerRadius="12">
            <StackPanel Margin="22,18">
                <DockPanel>
                    <TextBlock Text="صندوق فروش — شیفت" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}"/>
                    <Button DockPanel.Dock="Left" Style="{StaticResource ErpBtnSecondary}" Content="بروزرسانی ⟳ (X)" Padding="10,0" FontSize="12"
                            Command="{Binding RefreshCommand}"
                            Visibility="{Binding HasOpenShift, Converter={StaticResource BoolVis}}"/>
                </DockPanel>
                <Rectangle Height="1" Fill="{StaticResource ErpGray100}" Margin="0,14"/>

                <!-- ═══ صندوق بسته: باز کردن ═══ -->
                <StackPanel Visibility="{Binding HasOpenShift, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                    <TextBlock Text="صندوق بسته است. برای شروع، موجودی اولیه را وارد کنید." Foreground="{StaticResource ErpTextMuted}" FontSize="13" TextWrapping="Wrap"/>
                    <TextBlock Text="موجودی اولیه (ریال)" Style="{StaticResource ErpFieldLabel}" Margin="0,14,0,5"/>
                    <TextBox Style="{StaticResource ErpInput}" Height="40" Text="{Binding NewFloat, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16" FontWeight="Bold" FlowDirection="LeftToRight" TextAlignment="Right"/>
                    <Button Style="{StaticResource ErpBtnPrimary}" Content="باز کردن صندوق" Height="46" Margin="0,16,0,0" FontSize="15" FontWeight="Bold"
                            Command="{Binding OpenShiftCommand}"/>
                </StackPanel>

                <!-- ═══ صندوق باز: گزارش X/Z ═══ -->
                <StackPanel Visibility="{Binding HasOpenShift, Converter={StaticResource BoolVis}}">
                    <DockPanel Style="{StaticResource KV}"><TextBlock Text="موجودی اولیه" Foreground="{StaticResource ErpTextMuted}" FontSize="13"/><TextBlock DockPanel.Dock="Left" Text="{Binding OpeningFloat, Converter={StaticResource Num}}" FontWeight="SemiBold" FlowDirection="LeftToRight"/></DockPanel>
                    <DockPanel Style="{StaticResource KV}"><TextBlock Text="فروش نقدی" Foreground="{StaticResource ErpTextMuted}" FontSize="13"/><TextBlock DockPanel.Dock="Left" Text="{Binding CashSales, Converter={StaticResource Num}}" FontWeight="SemiBold" FlowDirection="LeftToRight"/></DockPanel>
                    <DockPanel Style="{StaticResource KV}"><TextBlock Text="فروش کارت‌خوان" Foreground="{StaticResource ErpTextMuted}" FontSize="13"/><TextBlock DockPanel.Dock="Left" Text="{Binding CardSales, Converter={StaticResource Num}}" FontWeight="SemiBold" FlowDirection="LeftToRight"/></DockPanel>
                    <DockPanel Style="{StaticResource KV}"><TextBlock Text="تعداد فروش" Foreground="{StaticResource ErpTextMuted}" FontSize="13"/><TextBlock DockPanel.Dock="Left" Text="{Binding SalesCount, Converter={StaticResource Num}}" FontWeight="SemiBold" FlowDirection="LeftToRight"/></DockPanel>
                    <Border Background="{StaticResource ErpBlue50}" CornerRadius="8" Padding="12,10" Margin="0,8">
                        <DockPanel>
                            <TextBlock Text="نقد مورد انتظار در صندوق" FontWeight="Bold" Foreground="{StaticResource ErpTextStrong}" FontSize="13"/>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding ExpectedCash, Converter={StaticResource Num}}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource ErpBlue700}" FlowDirection="LeftToRight"/>
                        </DockPanel>
                    </Border>

                    <Rectangle Height="1" Fill="{StaticResource ErpGray100}" Margin="0,8"/>
                    <TextBlock Text="شمارش نقد واقعی (ریال)" Style="{StaticResource ErpFieldLabel}" Margin="0,4,0,5"/>
                    <TextBox Style="{StaticResource ErpInput}" Height="40" Text="{Binding CountedCash, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16" FontWeight="Bold" FlowDirection="LeftToRight" TextAlignment="Right"/>
                    <Button Style="{StaticResource ErpBtnDanger}" Content="بستن صندوق و صدور گزارش Z" Height="46" Margin="0,14,0,0" FontSize="15" FontWeight="Bold"
                            Command="{Binding CloseShiftCommand}"/>
                </StackPanel>

                <!-- ═══ نتیجه‌ی بستن (Z) ═══ -->
                <Border Style="{StaticResource ErpSumBarOk}" Margin="0,16,0,0"
                        Visibility="{Binding ShowClosedSummary, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="✓ شیفت بسته شد — گزارش Z صادر شد" FontWeight="Bold" Foreground="{StaticResource ErpSuccess700}" FontSize="14"/>
                        <TextBlock Text="{Binding VarianceLabel}" Foreground="{StaticResource ErpTextStrong}" FontSize="13" Margin="0,6,0,0" FlowDirection="LeftToRight" TextAlignment="Right"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
