<UserControl x:Class="SamaHesab.WPF.Views.Restaurant.PrintStationsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="ایستگاه‌های چاپ / فیش‌پرینترِ رستوران" FontSize="18" FontWeight="Bold" Margin="2,0,0,8"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ستونِ راست: ایستگاه‌ها -->
            <Border Grid.Column="0" Style="{StaticResource FormSectionCard}" Padding="10" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="ایستگاه‌ها" FontWeight="Bold" FontSize="14"/>
                        <Button DockPanel.Dock="Left" Content="＋ جدید" Command="{Binding NewStationCommand}" Padding="8,3"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                              Background="Transparent" RowBackground="Transparent" BorderThickness="0" FontSize="12.5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ایستگاه" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="پرینتر" Binding="{Binding PrinterName}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="پیش‌فرض" Binding="{Binding IsDefault, Mode=OneWay}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="نامِ ایستگاه" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="پرینتر (خالی = پیش‌فرضِ سیستم)" Margin="0,6,0,2"/>
                        <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}" IsEditable="False"/>
                        <CheckBox Content="ایستگاهِ پیش‌فرض (آیتمِ بدونِ نگاشت)" IsChecked="{Binding IsDefault}" Margin="0,8,0,0"/>
                        <CheckBox Content="فعال" IsChecked="{Binding Active}" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="💾 ذخیرهٔ ایستگاه" Command="{Binding SaveStationCommand}" Padding="10,4" Background="#2E7D52" Foreground="White"/>
                            <Button Content="🗑 حذف" Command="{Binding DeleteStationCommand}" Padding="10,4" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ستونِ چپ: نگاشتِ کالا → ایستگاه -->
            <Border Grid.Column="1" Style="{StaticResource FormSectionCard}" Padding="10" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="نگاشتِ آیتمِ منو (کالا) → ایستگاه" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Left" Content="🔍 جست‌وجو" Command="{Binding SearchProductsCommand}" Padding="8,3" Margin="6,0,0,0"/>
                        <TextBox DockPanel.Dock="Left" Width="200" Margin="6,0,0,0" Text="{Binding ProductFilter, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Products}" AutoGenerateColumns="False" HeadersVisibility="Column"
                              CanUserAddRows="False" Background="Transparent" RowBackground="Transparent" BorderThickness="0" FontSize="12.5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="Auto" IsReadOnly="True"/>
                            <DataGridTextColumn Header="کالا (آیتمِ منو)" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="ایستگاه" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.StationOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValue="{Binding StationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Id" DisplayMemberPath="Name" Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="💾 ذخیرهٔ نگاشت‌ها" Command="{Binding SaveAssignmentsCommand}" Padding="12,5" Background="#2E5A9C" Foreground="White"/>
                        <TextBlock Text="آیتمِ بدونِ نگاشت → ایستگاهِ پیش‌فرض می‌رود." VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource MutedText}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
