    <ControlTemplate x:Key="CollectionEditorTemplate" TargetType="controls:RadCollectionEditor">
        <Border x:Name="PART_RootBorder"
                Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, Path=Height}"
                Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, Path=Width}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Header.Foreground" Value="{ThemeResource TelerikCollectionEditor_ForegroundDisabled}"/>
                            <Setter Target="ItemsTextBlock.Foreground" Value="{ThemeResource TelerikCollectionEditor_ForegroundDisabled}"/>
                            <Setter Target="PropertiesTextBlock.Foreground" Value="{ThemeResource TelerikCollectionEditor_ForegroundDisabled}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid Background="Transparent"
                  RowDefinitions="Auto,*,Auto"
                  ColumnDefinitions="2*,3*">
                <Border x:Name="HeaderBorder" Grid.ColumnSpan="2" MinHeight="32"
                        Visibility="{Binding Header,RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DescriptionVisibilityConverter}}"
                        Background="{ThemeResource TelerikCollectionEditor_HeaderBackground}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="0 0 0 1"
                        CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CornerRadius, Converter={StaticResource CornerRadiusConverter}, ConverterParameter=TopLeftRight}">
                    <ContentControl x:Name="Header"
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Header}"
                                    Foreground="{ThemeResource TelerikCollectionEditor_HeaderForeground}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>
                <Grid Grid.Row="1" RowDefinitions="Auto,*">
                    <Border MinHeight="39"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0 0 0 1">
                        <Grid>
                            <TextBlock x:Name="ItemsTextBlock"
                                       core:LocalizationManager.PropertyName="Text"
                                       core:LocalizationManager.Key="CollectionEditor_Items"
                                       VerticalAlignment="Center"
                                       Margin="{TemplateBinding Padding}"/>
