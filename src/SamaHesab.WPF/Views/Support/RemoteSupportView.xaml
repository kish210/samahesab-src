<UserControl x:Class="SamaHesab.WPF.Views.Support.RemoteSupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource VazirFont}" FlowDirection="RightToLeft"
             Background="{StaticResource ErpAppBg}">
    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,8">
            <TextBlock Text="پشتیبانیِ ریموت" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}"/>
            <TextBlock Text="یک کدِ پشتیبانی بسازید و به کارشناسِ سما حساب بدهید. لاگِ نشست فقط دادهٔ فنی دارد."
                       FontSize="12" Foreground="{StaticResource ErpTextMuted}" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- تولیدِ کد -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="یادداشتِ نشست (اختیاری)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="6,4" Width="360" HorizontalAlignment="Right"/>
                    <Border Background="#EEF6FF" CornerRadius="6" Padding="14,10" Margin="0,12,0,0" HorizontalAlignment="Right"
                            Visibility="{Binding HasCode, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="کدِ پشتیبانی:" VerticalAlignment="Center" Foreground="{StaticResource ErpTextMuted}"/>
                            <TextBlock Text="{Binding CurrentCode}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}"
                                       FontFamily="Consolas" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <Button Content="📋" Command="{Binding CopyCodeCommand}" Margin="10,0,0,0" Padding="8,2" ToolTip="کپی"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding InfoMessage}" FontSize="11.5" Foreground="{StaticResource ErpTextMuted}" Margin="0,6,0,0"
                               Visibility="{Binding HasCode, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ErpBtnPrimary}" Height="40" Padding="20,0" VerticalAlignment="Top"
                        Content="🔐 تولیدِ کدِ پشتیبانی" Command="{Binding GenerateCommand}"/>
            </Grid>
        </Border>

        <!-- فهرستِ نشست‌ها -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,8">
                    <Button DockPanel.Dock="Left" Style="{StaticResource ErpBtnGhost}" Height="28" Padding="10,0" Content="🔄" Command="{Binding RefreshCommand}"/>
                    <TextBlock Text="نشست‌های پشتیبانی" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </DockPanel>
                <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0"
                          CanUserAddRows="False" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="130" FontFamily="Consolas"/>
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="110"/>
                        <DataGridTextColumn Header="درخواست‌کننده" Binding="{Binding RequestedBy}" Width="*"/>
                        <DataGridTextColumn Header="انقضا" Binding="{Binding ExpiresAt, StringFormat=yyyy/MM/dd HH:mm}" Width="150"/>
                        <DataGridTemplateColumn Header="" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="پایان" Padding="10,2" Margin="2"
                                            Command="{Binding DataContext.EndSessionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
