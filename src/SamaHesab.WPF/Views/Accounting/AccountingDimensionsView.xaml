<UserControl x:Class="SamaHesab.WPF.Views.Accounting.AccountingDimensionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <Style x:Key="DLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="DInput" TargetType="TextBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style x:Key="DPrimary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DGhost" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="DGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="RowHeight" Value="29"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="ابعاد حسابداری" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
            <TextBlock Text="مدیریت سال مالی (قفل دوره)، مرکز هزینه و پروژه — ابعاد تحلیلیِ سند و گزارش."
                       Foreground="{DynamicResource SecondaryText}" FontSize="12.5" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- ═══ سال مالی ═══ -->
            <TabItem Header="سال مالی">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="0" Style="{StaticResource DGrid}" ItemsSource="{Binding FiscalYears}"
                              SelectedItem="{Binding SelectedFiscalYear}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="از تاریخ" Binding="{Binding StartDate}" Width="100"/>
                            <DataGridTextColumn Header="تا تاریخ" Binding="{Binding EndDate}" Width="100"/>
                            <DataGridTemplateColumn Header="وضعیت" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="باز"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                                            <Setter Property="Text" Value="بسته"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="عملیات" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="باز/بستن" FontSize="11" Padding="6,2" Cursor="Hand"
                                                Command="{Binding DataContext.ToggleFiscalYearClosedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="10,0,0,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="سال مالی جدید/ویرایش" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>
                            <TextBlock Text="عنوان (مثل ۱۴۰۴)" Style="{StaticResource DLabel}"/>
                            <TextBox Text="{Binding FyTitle}" Style="{StaticResource DInput}"/>
                            <TextBlock Text="از تاریخ" Style="{StaticResource DLabel}"/>
                            <TextBox Text="{Binding FyStart}" Style="{StaticResource DInput}"/>
                            <TextBlock Text="تا تاریخ" Style="{StaticResource DLabel}"/>
                            <TextBox Text="{Binding FyEnd}" Style="{StaticResource DInput}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <Button Content="جدید" Style="{StaticResource DGhost}" Command="{Binding NewFiscalYearCommand}"/>
                                <Button Content="ذخیره" Style="{StaticResource DPrimary}" Command="{Binding SaveFiscalYearCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ مرکز هزینه ═══ -->
            <TabItem Header="مرکز هزینه">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="0" Style="{StaticResource DGrid}" ItemsSource="{Binding CostCenters}"
                              SelectedItem="{Binding SelectedCostCenter}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="100"/>
                            <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*"/>
                            <DataGridTemplateColumn Header="عملیات" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="فعال/غیرفعال" FontSize="10.5" Padding="5,2" Cursor="Hand"
                                                Command="{Binding DataContext.ToggleCostCenterActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="10,0,0,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="مرکز هزینه جدید/ویرایش" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>
                            <TextBlock Text="کد" Style="{StaticResource DLabel}"/>
                            <TextBox Text="{Binding CcCode}" Style="{StaticResource DInput}"/>
                            <TextBlock Text="نام" Style="{StaticResource DLabel}"/>
                            <TextBox Text="{Binding CcName}" Style="{StaticResource DInput}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <Button Content="جدید" Style="{StaticResource DGhost}" Command="{Binding NewCostCenterCommand}"/>
                                <Button Content="ذخیره" Style="{StaticResource DPrimary}" Command="{Binding SaveCostCenterCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ پروژه ═══ -->
            <TabItem Header="پروژه">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="0" Style="{StaticResource DGrid}" ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="90"/>
                            <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="بودجه" Binding="{Binding Budget, Converter={StaticResource Num}}" Width="120"/>
                            <DataGridTemplateColumn Header="عملیات" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="باز/بستن" FontSize="11" Padding="6,2" Cursor="Hand"
                                                Command="{Binding DataContext.ToggleProjectClosedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="10,0,0,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="پروژه جدید/ویرایش" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>
                            <TextBlock Text="کد" Style="{StaticResource DLabel}"/>
                            <TextBox Text="{Binding PrCode}" Style="{StaticResource DInput}"/>
                            <TextBlock Text="نام" Style="{StaticResource DLabel}"/>
                            <TextBox Text="{Binding PrName}" Style="{StaticResource DInput}"/>
                            <TextBlock Text="بودجه (ریال)" Style="{StaticResource DLabel}"/>
                            <TextBox Text="{Binding PrBudget}" Style="{StaticResource DInput}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <Button Content="جدید" Style="{StaticResource DGhost}" Command="{Binding NewProjectCommand}"/>
                                <Button Content="ذخیره" Style="{StaticResource DPrimary}" Command="{Binding SaveProjectCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
