                            <Image Name="PART_Image" Visibility="Collapsed" Stretch="None" Source="{TemplateBinding ImageSource}" />
                            <TextBlock Name="PART_Text" Margin="2 0 0 0" VerticalAlignment="Center" Text="{TemplateBinding Text}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PushpinStyle" TargetType="telerikMap:Pushpin">
        <Setter Property="Background" Value="{ThemeResource TelerikMap_Pushpin_Background}" />
        <Setter Property="telerikMap:MapLayer.HotSpot" Value="0.5,Fraction,40,InsetPixels" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="telerikMap:Pushpin">
                    <Border>
                        <telerikMap:MapLayer.HotSpot>
                            <local:HotSpot X="0.5" Y="40" XUnits="Fraction" YUnits="InsetPixels" />
                        </telerikMap:MapLayer.HotSpot>
                        <Path Data="M256,0C158.8,0,80,78.8,80,176s176,336,176,336s176-238.8,176-336S353.2,0,256,0z M256,288c-61.9,0-112-50.1-112-112  S194.1,64,256,64s112,50.1,112,112S317.9,288,256,288z M304,176c0,26.5-21.5,48-48,48s-48-21.5-48-48s21.5-48,48-48  S304,149.5,304,176z"
                              Width="22" Height="32"
                              Stretch="Fill" Fill="{TemplateBinding Background}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BalloonStyle" TargetType="telerikMap:Balloon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="telerikMap:Balloon">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ContentPresenter Margin="5"
                                          Content="{TemplateBinding Content}" 
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="telerikMap:Pushpin" BasedOn="{StaticResource PushpinStyle}" />
    <Style TargetType="telerikMap:Balloon" BasedOn="{StaticResource BalloonStyle}" />
    <Style TargetType="telerikMap:MiniMap" BasedOn="{StaticResource MiniMapStyle}"/>
    <Style TargetType="telerikMap:MapScale" BasedOn="{StaticResource MapScaleStyle}"/>
    <Style TargetType="telerikMap:MapLegend" BasedOn="{StaticResource MapLegendStyle}" />
    <Style TargetType="telerikMap:MapZoomBar" BasedOn="{StaticResource MapZoomBarStyle}"/>
    <Style TargetType="telerikMap:MapPinPoint" BasedOn="{StaticResource MapPinPointStyle}" />
    <Style TargetType="telerikMap:DynamicLayer" BasedOn="{StaticResource DynamicLayerStyle}" />
    <Style TargetType="telerikMap:MouseControl" BasedOn="{StaticResource MouseControlStyle}"/>
    <Style TargetType="telerikMap:MapNavigation" BasedOn="{StaticResource MapNavigationStyle}"/>
    <Style TargetType="telerikMap:MapCommandBar" BasedOn="{StaticResource MapCommandBarStyle}"/>
    <Style TargetType="telerikMap:InformationLayer" BasedOn="{StaticResource InformationLayerStyle}" />
    <Style TargetType="telerikMap:VisualizationLayer" BasedOn="{StaticResource VisualizationLayerStyle}" />
    <Style TargetType="telerikMap:MapLegendCanvasItem" BasedOn="{StaticResource MapLegendCanvasItemStyle}" />
    <Style TargetType="telerikMap:TilesVisualizationLayer" BasedOn="{StaticResource TilesVisualizationLayerStyle}"/>
    <Style TargetType="telerikMap:MapMouseLocationIndicator" BasedOn="{StaticResource MapMouseLocationIndicatorStyle}" />
    <!--#endregion-->

    <!--#region RadHeatMap-->
    <local:PositionToGridRowConverter x:Key="PositionToGridRowConverter"/>
    <local:PositionToGridColumnConverter x:Key="PositionToGridColumnConverter"/>
    <Style x:Key="HeatMapColumnHeaderDecoratorStyle" TargetType="local:HeatMapColumnHeaderDecorator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HeatMapColumnHeaderDecorator">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HeatMapRowHeaderDecoratorStyle" TargetType="local:HeatMapRowHeaderDecorator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HeatMapRowHeaderDecorator">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HeatMapColorGridStyle" TargetType="local:HeatMapColorGrid">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HeatMapColorGrid">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Image Source="{TemplateBinding Bitmap}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HeatMapLabelsGridStyle" TargetType="local:HeatMapLabelsGrid">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HeatMapLabelsGrid">
                    <Canvas x:Name="PART_RenderSurface"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HeatMapRowLabelStyle" TargetType="local:HeatMapRowLabel">
        <Setter Property="Margin" Value="2 0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HeatMapRowLabel">
                    <TextBlock Text="{TemplateBinding LabelText}" Style="{TemplateBinding AppliedLabelStyle}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HeatMapColumnLabelStyle" TargetType="local:HeatMapColumnLabel">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HeatMapColumnLabel">
                    <primitives:RadLayoutTransformControl x:Name="PART_LayoutTransformControl" VerticalAlignment="{TemplateBinding VerticalAlignment}" HorizontalAlignment="{TemplateBinding HorizontalAlignment}">
                        <primitives:RadLayoutTransformControl.Content>
                            <TextBlock Style="{TemplateBinding AppliedLabelStyle}" Text="{Binding LabelText}"/>
                        </primitives:RadLayoutTransformControl.Content>
                        <primitives:RadLayoutTransformControl.LayoutTransform>
                            <RotateTransform x:Name="PART_RotateTransform"/>
                        </primitives:RadLayoutTransformControl.LayoutTransform>
                    </primitives:RadLayoutTransformControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RadHeatMapStyle" TargetType="local:RadHeatMap">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RadHeatMap">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <local:HeatMapColorGrid
                                    Definition="{TemplateBinding Definition}"
                                    CellBorderThickness="{TemplateBinding CellBorderThickness}"
                                    CellBorderColor="{TemplateBinding CellBorderColor}"
                                    HoveredCellDataPoint="{Binding HoveredCellDataPoint, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                    HoveredCellBorderThickness="{TemplateBinding HoveredCellBorderThickness}"
                                    HoveredCellBorderColor="{TemplateBinding HoveredCellBorderColor}"
                                    SelectedCellBorderThickness="{TemplateBinding SelectedCellBorderThickness}"
                                    SelectedCellBorderColor="{TemplateBinding SelectedCellBorderColor}"
                                    ShowToolTips="{TemplateBinding ShowToolTips}"
                                    ToolTipSettings="{TemplateBinding ToolTipSettings}"
                                    Grid.Row="1"
                                    Grid.Column="1">
                            </local:HeatMapColorGrid>
                            <local:HeatMapLabelsGrid
                                    Definition="{TemplateBinding Definition}"
                                    CellBorderThickness="{TemplateBinding CellBorderThickness}"
                                    CellLabelSettings="{TemplateBinding CellLabelSettings}"
                                    Grid.Row="1"
                                    Grid.Column="1"/>
                            <local:HeatMapColumnHeaderDecorator Grid.ColumnSpan="3" Grid.Row="{Binding ColumnHeaderSettings.LabelsPanelPosition, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PositionToGridRowConverter}}"/>
                            <local:HeatMapRowHeaderDecorator Grid.RowSpan="3" Grid.Column="{Binding RowHeaderSettings.LabelsPanelPosition, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PositionToGridColumnConverter}}"/>
                            <local:HeatMapColumnLabelsControl
                                    ItemsSource="{TemplateBinding ColumnHeaders}"
                                    LabelRotationAngle="{Binding ColumnHeaderSettings.LabelRotationAngle, RelativeSource={RelativeSource TemplatedParent}}"
                                    LabelStyle="{Binding ColumnHeaderSettings.LabelStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                    HoveredLabelStyle="{Binding ColumnHeaderSettings.HoveredLabelStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                    Position="{Binding ColumnHeaderSettings.LabelsPanelPosition, RelativeSource={RelativeSource TemplatedParent}}"
                                    LabelHorizontalAlignment="{Binding ColumnHeaderSettings.LabelHorizontalAlignment, RelativeSource={RelativeSource TemplatedParent}}"
                                    LabelVerticalAlignment="{Binding ColumnHeaderSettings.LabelVerticalAlignment, RelativeSource={RelativeSource TemplatedParent}}"
                                    LabelClipToBounds="{Binding ColumnHeaderSettings.LabelClipToBounds, RelativeSource={RelativeSource TemplatedParent}}"
                                    CellBorderThickness="{TemplateBinding CellBorderThickness}"
                                    ColumnsCount="{TemplateBinding ColumnsCount}"
                                    Grid.Row="{Binding ColumnHeaderSettings.LabelsPanelPosition, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PositionToGridRowConverter}}"
                                    Grid.Column="1"/>
                            <local:HeatMapRowLabelsControl
                                    ItemsSource="{TemplateBinding RowHeaders}"
                                    LabelStyle="{Binding RowHeaderSettings.LabelStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                    HoveredLabelStyle="{Binding RowHeaderSettings.HoveredLabelStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                    Position="{Binding RowHeaderSettings.LabelsPanelPosition, RelativeSource={RelativeSource TemplatedParent}}"
                                    LabelHorizontalAlignment="{Binding RowHeaderSettings.LabelHorizontalAlignment, RelativeSource={RelativeSource TemplatedParent}}"
                                    LabelVerticalAlignment="{Binding RowHeaderSettings.LabelVerticalAlignment, RelativeSource={RelativeSource TemplatedParent}}"
                                    LabelClipToBounds="{Binding RowHeaderSettings.LabelClipToBounds, RelativeSource={RelativeSource TemplatedParent}}"
                                    CellBorderThickness="{TemplateBinding CellBorderThickness}"
                                    RowsCount="{TemplateBinding RowsCount}"
                                    Grid.Row="1"
                                    Grid.Column="{Binding RowHeaderSettings.LabelsPanelPosition, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PositionToGridColumnConverter}}"/>
                            <ContentPresenter Content="{TemplateBinding DescriptionContent}" Grid.Row="{Binding ColumnHeaderSettings.LabelsPanelPosition, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PositionToGridRowConverter}}" Grid.Column="{Binding RowHeaderSettings.LabelsPanelPosition, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PositionToGridColumnConverter}}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:HeatMapColumnHeaderDecorator" BasedOn="{StaticResource HeatMapColumnHeaderDecoratorStyle}"/>
    <Style TargetType="local:HeatMapRowHeaderDecorator" BasedOn="{StaticResource HeatMapRowHeaderDecoratorStyle}"/>
    <Style TargetType="local:HeatMapColorGrid" BasedOn="{StaticResource HeatMapColorGridStyle}"/>
    <Style TargetType="local:HeatMapLabelsGrid" BasedOn="{StaticResource HeatMapLabelsGridStyle}"/>
    <Style TargetType="local:HeatMapRowLabel" BasedOn="{StaticResource HeatMapRowLabelStyle}"/>
    <Style TargetType="local:HeatMapColumnLabel" BasedOn="{StaticResource HeatMapColumnLabelStyle}"/>
    <Style TargetType="local:RadHeatMap" BasedOn="{StaticResource RadHeatMapStyle}"/>
    <Style TargetType="local:HeatMapColumnLabelsControl" BasedOn="{StaticResource FastItemsControlBaseStyle}"/>
    <Style TargetType="local:HeatMapRowLabelsControl" BasedOn="{StaticResource FastItemsControlBaseStyle}"/>
    <!--#endregion-->
</ResourceDictionary>

