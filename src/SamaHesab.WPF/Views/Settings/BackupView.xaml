<UserControl x:Class="SamaHesab.WPF.Views.Settings.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             Background="{DynamicResource AppBackground}"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Header -->
            <TextBlock Text="💾 مدیریت پشتیبان‌گیری" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryText}"
                       FontFamily="{StaticResource VazirFont}" Margin="0,0,0,20"/>

            <!-- Last Backup Status -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="آخرین پشتیبان‌گیری" Foreground="{DynamicResource SecondaryText}"
                                   FontFamily="{StaticResource VazirFont}" FontSize="12"/>
                        <TextBlock Text="{Binding LastBackupTime}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessColor}"
                                   FontFamily="{StaticResource VazirFont}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🔄 پشتیبان‌گیری اکنون" Style="{StaticResource PrimaryButton}"
                            Height="42" Command="{Binding ManualBackupCommand}"/>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- Manual Backup -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="📤 پشتیبان‌گیری دستی" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource PrimaryText}"
                                   FontFamily="{StaticResource VazirFont}" Margin="0,0,0,16"/>
                        <TextBlock Style="{StaticResource FormLabel}" Text="مسیر ذخیره فایل پشتیبان"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                <TextBox Text="{Binding BackupPath}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                            </Border>
                            <Button Grid.Column="2" Content="📁" Style="{StaticResource SecondaryButton}" Width="36" Command="{Binding BrowseBackupPathCommand}"/>
                        </Grid>
                        <CheckBox Content="پشتیبان‌گیری خودکار روزانه" IsChecked="{Binding AutoBackup}"
                                  Foreground="{DynamicResource PrimaryText}"
                                  FontFamily="{StaticResource VazirFont}" Margin="0,12,0,12"/>
                        <Button Content="🚀 شروع پشتیبان‌گیری" Style="{StaticResource SuccessButton}"
                                Height="40" Command="{Binding ManualBackupCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Restore -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="📥 بازیابی پایگاه داده" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource PrimaryText}"
                                   FontFamily="{StaticResource VazirFont}" Margin="0,0,0,16"/>
                        <Border Background="#7F1D1D20" BorderBrush="#C2403A" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                            <TextBlock TextWrapping="Wrap" Foreground="#C2403A"
                                       FontFamily="{StaticResource VazirFont}" FontSize="12">
                                ⚠ هشدار: بازیابی پایگاه داده تمام اطلاعات فعلی را با فایل پشتیبان جایگزین می‌کند.
                            </TextBlock>
                        </Border>
                        <TextBlock Style="{StaticResource FormLabel}" Text="فایل پشتیبان (.bak)"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4">
                                <TextBox Text="{Binding RestoreFilePath}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Padding="10,8" FontFamily="{StaticResource VazirFont}"/>
                            </Border>
                            <Button Grid.Column="2" Content="📁" Style="{StaticResource SecondaryButton}" Width="36" Command="{Binding BrowseRestoreFileCommand}"/>
                        </Grid>
                        <Button Content="⚠ بازیابی پایگاه داده" Style="{StaticResource DangerButton}"
                                Height="40" Margin="0,12,0,0" Command="{Binding RestoreCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Backup History -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="📜 تاریخچه پشتیبان‌گیری‌ها" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource PrimaryText}"
                               FontFamily="{StaticResource VazirFont}" Margin="0,0,0,16"/>
                    <telerik:RadGridView ItemsSource="{Binding BackupHistory}" AutoGenerateColumns="False"
                              CanUserInsertRows="False" CanUserDeleteRows="False" RowIndicatorVisibility="Collapsed"
                              ShowGroupPanel="False" MaxHeight="300" FontFamily="{StaticResource VazirFont}">
                        <telerik:RadGridView.Columns>
                            <telerik:GridViewDataColumn Header="تاریخ"       DataMemberBinding="{Binding CreatedAt}" DataFormatString="{}{0:yyyy/MM/dd HH:mm}" Width="140"/>
                            <telerik:GridViewDataColumn Header="نوع"          DataMemberBinding="{Binding BackupType}" Width="80"/>
                            <telerik:GridViewDataColumn Header="فایل"         DataMemberBinding="{Binding FilePath}" Width="*"/>
                            <telerik:GridViewDataColumn Header="حجم"          DataMemberBinding="{Binding FileSize}" Width="90"/>
                            <telerik:GridViewDataColumn Header="وضعیت"        DataMemberBinding="{Binding Status}" Width="80"/>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
