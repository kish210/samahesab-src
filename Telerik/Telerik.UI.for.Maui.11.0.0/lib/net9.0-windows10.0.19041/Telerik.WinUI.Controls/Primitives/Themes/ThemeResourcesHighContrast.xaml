<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:telerik="using:Telerik.UI.Xaml.Controls">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/Primitives/Themes/ThemeColorsHighContrast.xaml"/>
        <ResourceDictionary>
            <telerik:UserThemeResources x:Key="ResourceLoaderInitializer"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="{CustomResource HighContrastResourcesPath}"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="TelerikSecondaryForegroundBrush" Color="{StaticResource TelerikSecondaryForegroundColor}"/>
    <SolidColorBrush x:Key="TelerikWhiteBrush" Color="Red"/>
    <SolidColorBrush x:Key="TelerikBlackBrush" Color="Green"/>

    <!--#region Buttons-->
    <SolidColorBrush x:Key="TelerikButton_Foreground" Color="{ThemeResource SystemColorWindowTextColor}" />
    <SolidColorBrush x:Key="TelerikButton_ForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
    <SolidColorBrush x:Key="TelerikButton_ForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
    <SolidColorBrush x:Key="TelerikButton_ForegroundChecked" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikButton_ForegroundCheckedPointerOver" Color="{ThemeResource SystemColorButtonFaceColor}" />
    <SolidColorBrush x:Key="TelerikButton_ForegroundCheckedPressed" Color="{ThemeResource SystemColorButtonTextColor}" />
    <SolidColorBrush x:Key="TelerikButton_ForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
    <SolidColorBrush x:Key="TelerikButton_Background" Color="{ThemeResource SystemColorButtonFaceColor}" />
    <SolidColorBrush x:Key="TelerikButton_BackgroundPointerOver" Color="{ThemeResource SystemColorButtonFaceColor}" />
    <SolidColorBrush x:Key="TelerikButton_BackgroundPressed" Color="{ThemeResource SystemColorButtonFaceColor}" />
    <SolidColorBrush x:Key="TelerikButton_BackgroundChecked" Color="{ThemeResource SystemColorHighlightColor}"/>
    <SolidColorBrush x:Key="TelerikButton_BackgroundCheckedPointerOver" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikButton_BackgroundCheckedPressed" Color="{ThemeResource SystemColorButtonFaceColor}"/>
    <SolidColorBrush x:Key="TelerikButton_BackgroundOpened" Color="{ThemeResource SystemColorButtonFaceColor}" />
    <SolidColorBrush x:Key="TelerikButton_BackgroundFocused" Color="{ThemeResource SystemColorButtonFaceColor}" />
    <SolidColorBrush x:Key="TelerikButton_BackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
    <SolidColorBrush x:Key="TelerikButton_BorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikButton_BorderBrushPointerOver" Color="{ThemeResource SystemColorWindowTextColor}" />
    <SolidColorBrush x:Key="TelerikButton_BorderBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
    <SolidColorBrush x:Key="TelerikButton_BorderBrushChecked" Color="Transparent" />
    <SolidColorBrush x:Key="TelerikButton_BorderBrushCheckedPointerOver" Color="{ThemeResource SystemColorButtonTextColor}" />
    <SolidColorBrush x:Key="TelerikButton_BorderBrushCheckedPressed" Color="{ThemeResource SystemColorButtonFaceColor}" />
    <SolidColorBrush x:Key="TelerikButton_BorderBrushOpened" Color="Transparent" />
    <SolidColorBrush x:Key="TelerikButton_BorderBrushFocused" Color="{ThemeResource SystemColorWindowTextColor}" />
    <SolidColorBrush x:Key="TelerikButton_BorderBrushDisabled" Color="{ThemeResource SystemColorButtonTextColor}" />
    <!--Divider-->
    <SolidColorBrush x:Key="TelerikButton_DividerBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
    <SolidColorBrush x:Key="TelerikButton_DividerCheckedBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
    <!--Dropdown Popup-->
    <SolidColorBrush x:Key="TelerikButton_DropdownBackground" Color="{ThemeResource SystemColorWindowColor}" />
    <SolidColorBrush x:Key="TelerikButton_DropdownBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    <!--#endregion-->

    <SolidColorBrush x:Key="TelerikBusyIndicator_Foreground" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikBusyIndicator_IndicatorBackground" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikBusyIndicator_OverlayBackground" Color="{ThemeResource SystemColorButtonTextColor}"/>

    <!--#region PaginationControl-->
    <SolidColorBrush x:Key="TelerikPaginationControl_Foreground" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_ForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_Foreground" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_ForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_Background" Color="{ThemeResource SystemColorWindowColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_BackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_BackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_BorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_BorderBrushDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Item_Background" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Item_BackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Item_BackgroundSelectedDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Item_BackgroundDisabled" Color="{ThemeResource SystemColorWindowColor}"/>
    <!--#endregion-->

    <!--#region SideDrawerControl-->
    <SolidColorBrush x:Key="TelerikSideDrawer_Foreground" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikSideDrawer_BorderBrush" Color="Transparent"/>
    <!--#endregion-->

    <!--#region Hubtile-->
    <SolidColorBrush x:Key="TelerikHubTile_Foreground" Color="{ThemeResource SystemColorHighlightTextColor}"/>
    <SolidColorBrush x:Key="TelerikHubTile_Background" Color="{ThemeResource SystemColorHighlightColor}"/>
    <SolidColorBrush x:Key="TelerikHubTile_Background_PointerOver" Color="{ThemeResource SystemColorButtonFaceColor}"/>
    <SolidColorBrush x:Key="TelerikHubTile_BorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikHubTile_BorderBrush_PointerOver" Color="{ThemeResource SystemColorHotlightColor}"/>
    <!--#endregion-->

    <!--#region RangeSlider-->
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionThumb_Background" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionThumb_Background_Outer" Color="{ThemeResource SystemColorWindowColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionThumb_Background_Disabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionThumb_BorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionThumb_BorderBrush_Disabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionMiddleThumb_Background" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionMiddleThumb_Background_Disabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionMiddleThumb_Background_Pressed" Color="{ThemeResource SystemColorHighlightColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionMiddleThumb_Background_PointerOver" Color="{ThemeResource SystemColorHotlightColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Track_Background" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Track_Background_Disabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Track_Background_PointerOver" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_ToolTip_Foreground" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_ToolTip_Foreground_Range" Color="Gray"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_ToolTip_Background" Color="{ThemeResource SystemColorWindowColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_ToolTip_BorderBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Label_Foreground" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Tick_Fill" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Line_Fill" Color="Transparent"/>
    <!--#endregion-->

    <!--#region LoopingList-->
    <SolidColorBrush x:Key="TelerikLoopingList_Background" Color="{ThemeResource SystemColorWindowColor}" />
    <SolidColorBrush x:Key="TelerikLoopingList_BorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
    <SolidColorBrush x:Key="TelerikLoopingList_ItemForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
    <SolidColorBrush x:Key="TelerikLoopingList_ItemForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}" />
    <SolidColorBrush x:Key="TelerikLoopingList_ItemBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TelerikLoopingList_ItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
    <!--#endregion-->

    <SolidColorBrush x:Key="TelerikShadow_Foreground" Color="{ThemeResource SystemColorButtonTextColor}" />
    <SolidColorBrush x:Key="TelerikShadow_Background" Color="{ThemeResource SystemColorWindowColor}" />

    <SolidColorBrush x:Key="TelerikGridSplitter_Foreground" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikGridSplitter_Background" Color="{ThemeResource SystemColorWindowColor}"/>
    <SolidColorBrush x:Key="TelerikGridSplitter_Background_PointerOver" Color="{ThemeResource SystemColorButtonFaceColor}"/>
    <SolidColorBrush x:Key="TelerikGridSplitter_Background_Pressed" Color="{ThemeResource SystemColorButtonTextColor}"/>

    <!--#region Expander-->
    <SolidColorBrush x:Key="TelerikExpander_Foreground" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikExpander_Background" Color="{ThemeResource SystemColorWindowColor}"/>
    <SolidColorBrush x:Key="TelerikExpander_BorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikExpander_HeaderButton_Foreground" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikExpander_HeaderButton_ForegroundPressed" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikExpander_HeaderButton_Background" Color="{ThemeResource SystemColorWindowColor}"/>
    <SolidColorBrush x:Key="TelerikExpander_HeaderButton_BackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/>
    <SolidColorBrush x:Key="TelerikExpander_HeaderButton_BackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
    <!--#endregion-->

</ResourceDictionary>

