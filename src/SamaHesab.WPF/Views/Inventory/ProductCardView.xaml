<UserControl x:Class="SamaHesab.WPF.Views.Inventory.ProductCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <Style x:Key="PcLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
            <Setter Property="Margin" Value="0,4,0,1"/>
        </Style>
        <Style x:Key="PcValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- انتخاب کالا + وضعیت -->
            <RowDefinition Height="Auto"/>   <!-- نوار موجودی انبارها -->
            <RowDefinition Height="Auto"/>   <!-- سه گروه‌باکس -->
            <RowDefinition Height="*"/>      <!-- کاردکس -->
        </Grid.RowDefinitions>

        <!-- ═══ انتخاب کالا + کد/وضعیت ═══ -->
        <!-- U-INV-2: عنوانِ «کارت کالا» با Dock=Right در واقع به سمتِ چپِ صفحه می‌رفت (همان مشکلِ
             آینه‌شدنِ Dock در RTL که پایین‌تر هم رفع شد) — یعنی عنوانِ بخش، برخلافِ انتظار، آخرین
             چیزی بود که در خواندنِ راست‌به‌چپ دیده می‌شد. حالا Dock=Left (⇒ راستِ فیزیکی) دارد. -->
        <Border Grid.Row="0" Style="{StaticResource ErpGbox}" Margin="0,0,0,6">
            <DockPanel Margin="8,6">
                <TextBlock DockPanel.Dock="Left" Text="کارت کالا" Style="{StaticResource ErpGboxTitle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Border DockPanel.Dock="Left" Background="{DynamicResource SuccessColor}" CornerRadius="999" Padding="10,2" VerticalAlignment="Center">
                    <TextBlock Text="فعال" Foreground="White" FontSize="11"/>
                </Border>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Code, StringFormat='کد {0}'}" VerticalAlignment="Center"
                           Margin="10,0" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                <ComboBox ItemsSource="{Binding Products}" DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedProduct}" IsEditable="True"

                          Height="32" Width="360" HorizontalAlignment="Left" Margin="0"/>
            </DockPanel>
        </Border>

        <!-- ═══ نوار موجودی انبارها ═══ -->
        <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <Border DockPanel.Dock="Right" Style="{StaticResource ErpGbox}" Width="150" Margin="0,0,6,0">
                <StackPanel Margin="12,8">
                    <TextBlock Text="موجودی کل" Style="{StaticResource PcLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TotalStock, Converter={StaticResource Num}}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}"/>
                        <TextBlock Text=" واحد" FontSize="11" VerticalAlignment="Bottom" Margin="3,0,0,3" Foreground="{DynamicResource MutedText}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ReorderPoint, StringFormat='نقطه سفارش: {0:#,##0}'}" Style="{StaticResource PcLabel}"/>
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding WarehouseStocks}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ErpGbox}" Width="150" Margin="0,0,6,0">
                            <StackPanel Margin="12,8">
                                <TextBlock Text="{Binding WarehouseName}" Style="{StaticResource PcLabel}"/>
                                <TextBlock Text="{Binding Quantity, Converter={StaticResource Num}}" FontSize="20" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PcValue}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="واحد" Style="{StaticResource PcLabel}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- ═══ سه گروه‌باکس: مشخصات / قیمت / کنترل ═══ -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,6">
            <Border Style="{StaticResource ErpGbox}" Margin="0,0,3,0">
                <StackPanel Margin="12,8">
                    <TextBlock Text="مشخصات اصلی" Style="{StaticResource ErpGboxTitle}"/>
                    <TextBlock Text="کد کالا" Style="{StaticResource PcLabel}"/><TextBlock Text="{Binding Code}" Style="{StaticResource PcValue}"/>
                    <TextBlock Text="نام کالا" Style="{StaticResource PcLabel}"/><TextBlock Text="{Binding Name}" Style="{StaticResource PcValue}" TextWrapping="Wrap"/>
                    <TextBlock Text="بارکد" Style="{StaticResource PcLabel}"/><TextBlock Text="{Binding Barcode, FallbackValue='—'}" Style="{StaticResource PcValue}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ErpGbox}" Margin="3,0">
                <StackPanel Margin="12,8">
                    <TextBlock Text="قیمت‌گذاری" Style="{StaticResource ErpGboxTitle}"/>
                    <!-- U-INV-1: این ردیف‌ها قبلاً در یک Grid بدونِ RowDefinitions/ColumnDefinitions
                         بودند — یعنی برچسب و مقدار هر دو در همان سلولِ (0,0) می‌نشستند و روی هم
                         می‌افتادند (متنِ نامفهوم/هم‌پوشان). نکتهٔ RTL: چون کلِ UserControl
                         FlowDirection=RightToLeft دارد، WPF جهتِ Dock/HorizontalAlignment را هم
                         آینه می‌کند — یعنی برایِ این‌که برچسب واقعاً در سمتِ راستِ صفحه بیفتد،
                         باید Dock="Left" نوشت (نه Right) و برایِ مقدار HorizontalAlignment="Right"
                         (تأییدشده با تستِ زندهٔ بصری، نه فقط با خواندنِ کد). -->
                    <DockPanel><TextBlock DockPanel.Dock="Left" Text="قیمت خرید" Style="{StaticResource PcLabel}"/><TextBlock Text="{Binding PurchasePrice, Converter={StaticResource Num}}" Style="{StaticResource PcValue}" HorizontalAlignment="Right"/></DockPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Left" Text="فروش خرده" Style="{StaticResource PcLabel}"/><TextBlock Text="{Binding SalePrice, Converter={StaticResource Num}}" Style="{StaticResource PcValue}" HorizontalAlignment="Right"/></DockPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Left" Text="فروش عمده" Style="{StaticResource PcLabel}"/><TextBlock Text="{Binding WholesalePrice, Converter={StaticResource Num}}" Style="{StaticResource PcValue}" HorizontalAlignment="Right"/></DockPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Left" Text="٪ سود خرده" Style="{StaticResource PcLabel}"/><TextBlock Text="{Binding RetailMarginPct, StringFormat='{}{0}٪'}" Style="{StaticResource PcValue}" HorizontalAlignment="Right" Foreground="{DynamicResource SuccessColor}"/></DockPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Left" Text="مالیات" Style="{StaticResource PcLabel}"/><TextBlock Text="{Binding TaxRate, StringFormat='{}{0}٪'}" Style="{StaticResource PcValue}" HorizontalAlignment="Right"/></DockPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ErpGbox}" Margin="3,0,0,0">
                <StackPanel Margin="12,8">
                    <TextBlock Text="انبار و کنترل" Style="{StaticResource ErpGboxTitle}"/>
                    <DockPanel><TextBlock DockPanel.Dock="Left" Text="نقطه سفارش" Style="{StaticResource PcLabel}"/><TextBlock Text="{Binding ReorderPoint, Converter={StaticResource Num}, FallbackValue='—'}" Style="{StaticResource PcValue}" HorizontalAlignment="Right"/></DockPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Left" Text="حداقل موجودی" Style="{StaticResource PcLabel}"/><TextBlock Text="{Binding MinStock, Converter={StaticResource Num}}" Style="{StaticResource PcValue}" HorizontalAlignment="Right"/></DockPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Left" Text="حداکثر موجودی" Style="{StaticResource PcLabel}"/><TextBlock Text="{Binding MaxStock, Converter={StaticResource Num}, FallbackValue='—'}" Style="{StaticResource PcValue}" HorizontalAlignment="Right"/></DockPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Left" Text="کنترل سریال/بچ" Style="{StaticResource PcLabel}"/><TextBlock Text="{Binding Tracking}" Style="{StaticResource PcValue}" HorizontalAlignment="Right"/></DockPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ═══ کاردکس ═══ -->
        <Border Grid.Row="3" Style="{StaticResource ErpGbox}">
            <DockPanel Margin="2">
                <TextBlock DockPanel.Dock="Top" Text="کاردکس (گردش کالا)" Style="{StaticResource ErpGboxTitle}"/>
                <DataGrid ItemsSource="{Binding Kardex}" Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="All" CanUserAddRows="False" Margin="6,4,6,6">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="110"/>
                        <DataGridTextColumn Header="نوع" Binding="{Binding Type}" Width="90"/>
                        <DataGridTextColumn Header="سند" Binding="{Binding DocumentNumber}" Width="100"/>
                        <DataGridTextColumn Header="شرح" Binding="{Binding Notes}" Width="*"/>
                        <DataGridTextColumn Header="ورود" Binding="{Binding In, Converter={StaticResource Num}}" Width="80"/>
                        <DataGridTextColumn Header="خروج" Binding="{Binding Out, Converter={StaticResource Num}}" Width="80"/>
                        <DataGridTextColumn Header="مانده" Binding="{Binding Balance, Converter={StaticResource Num}}" Width="90"/>
                        <DataGridTextColumn Header="فی" Binding="{Binding UnitCost, Converter={StaticResource Num}}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
