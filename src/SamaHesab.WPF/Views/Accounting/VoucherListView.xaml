<UserControl x:Class="SamaHesab.WPF.Views.Accounting.VoucherListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- actions -->
            <RowDefinition Height="Auto"/>   <!-- filters -->
            <RowDefinition Height="*"/>      <!-- grid -->
            <RowDefinition Height="Auto"/>   <!-- summary footer -->
        </Grid.RowDefinitions>

        <!-- actions -->
        <Border Grid.Row="0" Style="{StaticResource ErpToolbar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ErpToolButton}" Command="{Binding NewVoucherCommand}">
                    <StackPanel><materialDesign:PackIcon Kind="FilePlusOutline" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="سند جدید" TextAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ErpToolButton}" Command="{Binding EditVoucherCommand}">
                    <StackPanel><materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{DynamicResource WarningColor}"/><TextBlock Text="ویرایش" TextAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ErpToolButton}" Command="{Binding PostVoucherCommand}">
                    <StackPanel><materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{DynamicResource SuccessColor}"/><TextBlock Text="قطعی" TextAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ErpToolButton}" Command="{Binding PrintVoucherCommand}">
                    <StackPanel><materialDesign:PackIcon Kind="PrinterOutline" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="چاپ" TextAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ErpToolButton}" Command="{Binding SearchCommand}">
                    <StackPanel><materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="بروزرسانی" TextAlignment="Center"/></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- filters -->
        <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}" Margin="3,3,3,0" Padding="8,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="از تاریخ" Style="{StaticResource ErpInlineLabel}"/>
                <TextBox Text="{Binding FromDate}" Width="110" Margin="0,0,12,0"/>
                <TextBlock Text="تا تاریخ" Style="{StaticResource ErpInlineLabel}"/>
                <TextBox Text="{Binding ToDate}" Width="110" Margin="0,0,12,0"/>
                <TextBlock Text="وضعیت" Style="{StaticResource ErpInlineLabel}"/>
                <ComboBox Style="{StaticResource BaseComboBox}" Width="120" Height="30" Margin="0,0,12,0"
                          ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedStatus}"/>
                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                <TextBox Text="{Binding SearchText}" Width="220" Margin="6,0">
                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                </TextBox>
                <Button Content="جستجو" Style="{StaticResource PrimaryButton}" Height="30" Command="{Binding SearchCommand}"/>
            </StackPanel>
        </Border>

        <!-- grid -->
        <Border Grid.Row="2" Style="{StaticResource ErpCardPanel}" Margin="3" Padding="0">
            <telerik:RadGridView ItemsSource="{Binding Vouchers}" SelectedItem="{Binding SelectedVoucher}"
                      AutoGenerateColumns="False" RowIndicatorVisibility="Collapsed" RowHeight="28" IsReadOnly="True"
                      ShowSearchPanel="True" ShowGroupPanel="True" ShowColumnFooters="True">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="شماره سند" DataMemberBinding="{Binding VoucherNumber}" Width="110"/>
                    <telerik:GridViewDataColumn Header="تاریخ" DataMemberBinding="{Binding VoucherDate}" Width="100"/>
                    <telerik:GridViewDataColumn Header="نوع" DataMemberBinding="{Binding VoucherTypeName}" Width="110"/>
                    <telerik:GridViewDataColumn Header="شرح" DataMemberBinding="{Binding Description}" Width="*"/>
                    <telerik:GridViewDataColumn Header="بدهکار" DataMemberBinding="{Binding TotalDebit}" DataFormatString="{}{0:N0}" Width="130">
                        <telerik:GridViewDataColumn.AggregateFunctions><telerik:SumFunction ResultFormatString="{}{0:N0}"/></telerik:GridViewDataColumn.AggregateFunctions>
                    </telerik:GridViewDataColumn>
                    <telerik:GridViewDataColumn Header="بستانکار" DataMemberBinding="{Binding TotalCredit}" DataFormatString="{}{0:N0}" Width="130">
                        <telerik:GridViewDataColumn.AggregateFunctions><telerik:SumFunction ResultFormatString="{}{0:N0}"/></telerik:GridViewDataColumn.AggregateFunctions>
                    </telerik:GridViewDataColumn>
                    <telerik:GridViewDataColumn Header="وضعیت" DataMemberBinding="{Binding StatusName}" Width="90"/>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Border>

        <!-- summary -->
        <Border Grid.Row="3" Style="{StaticResource ErpToolbar}" BorderThickness="0,1,0,0">
            <TextBlock Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Right" Margin="4,2" VerticalAlignment="Center" FontSize="12">
                <Run Text="تعداد اسناد: "/><Run Text="{Binding TotalCount}" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold"/>
                <Run Text="  |  جمع بدهکار: "/><Run Text="{Binding TotalDebit, StringFormat='{}{0:N0}'}" Foreground="{DynamicResource InfoColor}" FontWeight="Bold"/>
                <Run Text="  |  جمع بستانکار: "/><Run Text="{Binding TotalCredit, StringFormat='{}{0:N0}'}" Foreground="{DynamicResource SuccessColor}" FontWeight="Bold"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
