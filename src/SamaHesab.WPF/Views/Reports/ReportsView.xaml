<UserControl x:Class="SamaHesab.WPF.Views.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Report categories -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
            <StackPanel>
                <Border Background="{DynamicResource RibbonBackground}" Padding="16,14"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                    <TextBlock Text="📊 مرکز گزارشات" FontWeight="Bold" FontSize="15"
                               Foreground="{DynamicResource PrimaryText}"
                               FontFamily="{StaticResource VazirFont}"/>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                                               Foreground="{DynamicResource SecondaryText}"
                                               FontFamily="{StaticResource VazirFont}"
                                               Margin="16,8,16,4"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SidebarItemButton}"
                                                        Command="{Binding DataContext.SelectReportCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontFamily="{StaticResource VazirFont}"
                                                               FontSize="13"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Right Panel: Report Parameters + Results -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Report Title + Toolbar -->
            <Border Grid.Row="0" Background="{DynamicResource RibbonBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedReport.Name, FallbackValue='یک گزارش را انتخاب کنید'}"
                                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"
                                   FontFamily="{StaticResource VazirFont}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="▶ اجرا"      Style="{StaticResource PrimaryButton}"   Height="36" Margin="0,0,6,0" Command="{Binding RunReportCommand}"/>
                        <Button Content="📄 PDF"       Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,6,0" Command="{Binding ExportPdfCommand}"/>
                        <Button Content="📊 Excel"     Style="{StaticResource SuccessButton}"   Height="36" Margin="0,0,6,0" Command="{Binding ExportExcelCommand}"/>
                        <Button Content="🖨 چاپ"       Style="{StaticResource SecondaryButton}" Height="36" Command="{Binding PrintCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Parameters -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="از تاریخ:" Style="{StaticResource FormLabel}"/>
                        <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" Width="130">
                            <TextBox Text="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryText}" Padding="10,7"
                                     FontFamily="{StaticResource VazirFont}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="تا تاریخ:" Style="{StaticResource FormLabel}"/>
                        <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" Width="130">
                            <TextBox Text="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryText}" Padding="10,7"
                                     FontFamily="{StaticResource VazirFont}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom">
                        <Button Content="▶ اجرای گزارش" Style="{StaticResource PrimaryButton}" Height="36" Command="{Binding RunReportCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Results Grid -->
            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Grid.Row="2" ItemsSource="{Binding Results}"
                     
                      FontFamily="{StaticResource VazirFont}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="120"/>
                    <DataGridTextColumn Header="شرح" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="بدهکار" Binding="{Binding Debit, StringFormat={}{0:N0}}" Width="160"/>
                    <DataGridTextColumn Header="بستانکار" Binding="{Binding Credit, StringFormat={}{0:N0}}" Width="160"/>
                    <DataGridTextColumn Header="مانده" Binding="{Binding Balance, StringFormat={}{0:N0}}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Summary Footer -->
            <Border Grid.Row="3" Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Results.Count, StringFormat='تعداد ردیف‌ها: {0}'}"
                               Foreground="{DynamicResource SecondaryText}"
                               FontFamily="{StaticResource VazirFont}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
