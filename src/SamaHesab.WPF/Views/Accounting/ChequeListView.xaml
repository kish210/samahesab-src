<UserControl x:Class="SamaHesab.WPF.Views.Accounting.ChequeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft"
             Background="#F4F5F7">

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NewChequeCommand}"/>
        <KeyBinding Key="F5" Command="{Binding SearchCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <conv:GreaterThanZeroVisibilityConverter x:Key="GtzVis"/>

        <SolidColorBrush x:Key="Blue600" Color="#4B5F97"/>
        <SolidColorBrush x:Key="Blue700" Color="#324A7A"/>
        <SolidColorBrush x:Key="Line" Color="#E3E6EC"/>
        <SolidColorBrush x:Key="HeadBg" Color="#EFF2F7"/>
        <SolidColorBrush x:Key="Zebra" Color="#FAFBFC"/>
        <SolidColorBrush x:Key="TextStrong" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>

        <!-- دکمهٔ تولبار -->
        <Style x:Key="TBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D5D9E0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F0F3F9"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- کارتِ آماریِ کلیک‌پذیر -->
        <Style x:Key="StatCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="11,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#9DB0D6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardLbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
        <Style x:Key="CardVal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrong}"/><Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="CardSum" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/><Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- چیپِ نوع (دریافتنی/پرداختنی) -->
        <Style x:Key="TypeChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="14" Background="White" BorderBrush="#CBD2DD" BorderThickness="1" Padding="14,5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Blue600}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Blue600}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputC" TargetType="TextBox">
            <Setter Property="Height" Value="30"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="7,0"/><Setter Property="BorderBrush" Value="#CBD0D8"/>
            <Setter Property="Background" Value="White"/><Setter Property="FontSize" Value="12.5"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- تولبار -->
            <RowDefinition Height="Auto"/>   <!-- کارت‌های آماری -->
            <RowDefinition Height="Auto"/>   <!-- فیلتر -->
            <RowDefinition Height="*"/>      <!-- گرید -->
            <RowDefinition Height="Auto"/>   <!-- نوار جمع -->
        </Grid.RowDefinitions>

        <!-- ═══ تولبار ═══ -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource TBtn}" Command="{Binding NewChequeCommand}" Background="{StaticResource Blue600}" Foreground="White" BorderBrush="{StaticResource Blue600}">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcFilePlus}" Style="{StaticResource ErpToolSvg}" Stroke="White"/><TextBlock Text="چک جدید" Margin="5,0,0,0"/><Border Background="#5E6FA8" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"><TextBlock Text="F2" FontSize="10.5" Foreground="White"/></Border></StackPanel>
                    </Button>
                    <Border Width="1" Background="{StaticResource Line}" Margin="4,2"/>
                    <Button Style="{StaticResource TBtn}" Command="{Binding ClearChequeCommand}" Background="#E8F5EC" BorderBrush="#A7D7B6"
                            ToolTip="ثبتِ وصولِ چکِ انتخاب‌شده — یک سندِ حسابداریِ خودکار می‌سازد">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcCheck}" Style="{StaticResource ErpToolSvg}" Stroke="#15803D"/><TextBlock Text="وصول" Margin="5,0,0,0" Foreground="#15803D"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource TBtn}" Command="{Binding TransferChequeCommand}"
                            ToolTip="واگذاریِ چکِ انتخاب‌شده به بانک برایِ وصول (فقط تغییرِ وضعیت، بدونِ سند)">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcTransfer}" Style="{StaticResource ErpToolSvg}"/><TextBlock Text="واگذاری به بانک" Margin="5,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource TBtn}" Command="{Binding ReturnChequeCommand}" Foreground="#B91C1C" BorderBrush="#E6BCBC"
                            ToolTip="ثبتِ برگشت‌خوردنِ چکِ انتخاب‌شده (بی‌محلی/سایرِ دلایل) — نیازمندِ ذکرِ علت">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcUndo}" Style="{StaticResource ErpToolSvg}" Stroke="#B91C1C"/><TextBlock Text="برگشت چک" Margin="5,0,0,0"/></StackPanel>
                    </Button>
                    <!-- P1/DT-6: چاپِ چکِ انتخاب‌شده با قالبِ پویا -->
                    <Menu Background="Transparent" VerticalAlignment="Center"
                          Visibility="{Binding PrintTemplates.Count, Converter={StaticResource GtzVis}}">
                        <MenuItem Header="چاپ با قالب ▼" ItemsSource="{Binding PrintTemplates}" FontSize="12">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Name}"/>
                                    <Setter Property="Command" Value="{Binding DataContext.PrintWithTemplateCommand, RelativeSource={RelativeSource AncestorType=Menu}}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </Menu>
                </StackPanel>
                <!-- خلاصهٔ سررسیدِ هفتهٔ جاری -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="سررسید هفته جاری: " FontSize="11.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontSize="11.5" Foreground="#B7791F">
                        <Run Text="{Binding DueWeekCount, Converter={StaticResource Num}, ConverterParameter='فقره'}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding DueWeekSum, Converter={StaticResource Num}, ConverterParameter='ریال'}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ کارت‌های آماری ═══ -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,10">
            <Button Style="{StaticResource StatCard}" Command="{Binding SelectStatusCommand}" CommandParameter="همه">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource Blue600}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="همه چک‌ها" Style="{StaticResource CardLbl}"/></StackPanel>
                    <TextBlock Style="{StaticResource CardVal}" Text="{Binding AllCount, Converter={StaticResource Num}, ConverterParameter='فقره'}"/>
                    <TextBlock Style="{StaticResource CardSum}" Text="{Binding AllSum, Converter={StaticResource Num}, ConverterParameter='ریال'}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource StatCard}" Command="{Binding SelectStatusCommand}" CommandParameter="InProcess">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#D97706" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="در جریان وصول" Style="{StaticResource CardLbl}"/></StackPanel>
                    <TextBlock Style="{StaticResource CardVal}" Text="{Binding InProcessCount, Converter={StaticResource Num}, ConverterParameter='فقره'}"/>
                    <TextBlock Style="{StaticResource CardSum}" Text="{Binding InProcessSum, Converter={StaticResource Num}, ConverterParameter='ریال'}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource StatCard}" Command="{Binding SelectStatusCommand}" CommandParameter="Transferred">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#7E93C8" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="واگذار به بانک" Style="{StaticResource CardLbl}"/></StackPanel>
                    <TextBlock Style="{StaticResource CardVal}" Text="{Binding TransferredCount, Converter={StaticResource Num}, ConverterParameter='فقره'}"/>
                    <TextBlock Style="{StaticResource CardSum}" Text="{Binding TransferredSum, Converter={StaticResource Num}, ConverterParameter='ریال'}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource StatCard}" Command="{Binding SelectStatusCommand}" CommandParameter="Cleared">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#15803D" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="وصول‌شده" Style="{StaticResource CardLbl}"/></StackPanel>
                    <TextBlock Style="{StaticResource CardVal}" Text="{Binding ClearedCount, Converter={StaticResource Num}, ConverterParameter='فقره'}"/>
                    <TextBlock Style="{StaticResource CardSum}" Text="{Binding ClearedSum, Converter={StaticResource Num}, ConverterParameter='ریال'}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource StatCard}" Command="{Binding SelectStatusCommand}" CommandParameter="Returned" Margin="0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#DC2626" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="برگشتی" Style="{StaticResource CardLbl}"/></StackPanel>
                    <TextBlock Style="{StaticResource CardVal}" Text="{Binding ReturnedCount, Converter={StaticResource Num}, ConverterParameter='فقره'}"/>
                    <TextBlock Style="{StaticResource CardSum}" Text="{Binding ReturnedSum, Converter={StaticResource Num}, ConverterParameter='ریال'}"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- ═══ فیلتر ═══ -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource TypeChip}" Content="دریافتنی" GroupName="ctype" IsChecked="True"
                                 Command="{Binding SelectTypeCommand}" CommandParameter="دریافتی"/>
                    <RadioButton Style="{StaticResource TypeChip}" Content="پرداختنی" GroupName="ctype"
                                 Command="{Binding SelectTypeCommand}" CommandParameter="پرداختی"/>
                    <Border Width="1" Background="{StaticResource Line}" Margin="6,2"/>
                    <Path Data="{StaticResource IcSearch}" Style="{StaticResource ErpToolSvg}" Stroke="{StaticResource TextMuted}" Width="14" Height="14" Margin="0,0,4,0"/>
                    <TextBox Style="{StaticResource InputC}" Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             materialDesign:HintAssist.Hint="جستجوی شماره چک / صادرکننده / بانک…">
                        <!-- Enter در باکسِ جست‌وجو = جست‌وجو (هم‌راستا با بقیهٔ لیست‌ها؛ افزون بر F5) -->
                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                           Text="{Binding TotalCount, Converter={StaticResource Num}, ConverterParameter='نتیجه'}"/>
            </DockPanel>
        </Border>

        <!-- ═══ گرید ═══ -->
        <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Background="White">
            <DockPanel>
            <!-- P-G10 — ناوبریِ صفحه (صفحه‌بندیِ سمتِ کلاینت) -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource HeadBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="9,4" CornerRadius="0,0,8,8">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="« اول"  Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanPrevPage}" Style="{StaticResource ErpBtnSecondary}" Height="26" Padding="8,0" Margin="0,0,4,0"/>
                        <Button Content="‹ قبلی" Command="{Binding PrevPageCommand}"  IsEnabled="{Binding CanPrevPage}" Style="{StaticResource ErpBtnSecondary}" Height="26" Padding="8,0" Margin="0,0,4,0"/>
                        <Button Content="بعدی ›" Command="{Binding NextPageCommand}"  IsEnabled="{Binding CanNextPage}" Style="{StaticResource ErpBtnSecondary}" Height="26" Padding="8,0" Margin="0,0,4,0"/>
                        <Button Content="آخر »"  Command="{Binding LastPageCommand}"  IsEnabled="{Binding CanNextPage}" Style="{StaticResource ErpBtnSecondary}" Height="26" Padding="8,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="صفحهٔ " FontSize="11.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PageNumber, Converter={StaticResource Num}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" VerticalAlignment="Center"/>
                        <TextBlock Text=" از " FontSize="11.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalPages, Converter={StaticResource Num}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataGrid x:Name="Grid" ItemsSource="{Binding Cheques}" SelectedItem="{Binding SelectedCheque}" AutoGenerateColumns="False" IsReadOnly="True"
                      PreviewKeyDown="Grid_PreviewKeyDown"
                      HeadersVisibility="Column" CanUserAddRows="False" Background="White"
                      GridLinesVisibility="All" HorizontalGridLinesBrush="#EDEFF3" VerticalGridLinesBrush="#EDEFF3"
                      RowBackground="White" AlternatingRowBackground="{StaticResource Zebra}" RowHeight="{DynamicResource ErpDensRowHeight}" FontSize="12.5"
                      BorderThickness="0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource HeadBg}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderBrush" Value="#E1E4EA"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <!-- هایلایتِ سررسیدِ نزدیک (ردیفِ کهربایی) -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDueSoon}" Value="True">
                                <Setter Property="Background" Value="#FBF4EA"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="40">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextMuted}"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="شماره چک" Binding="{Binding Number}" Width="100">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="Margin" Value="6,0"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="بانک" Binding="{Binding Bank}" Width="95"/>
                    <DataGridTextColumn Header="صادرکننده / در وجه" Binding="{Binding IssuedBy}" Width="*">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="سررسید" Binding="{Binding DueDate}" Width="110">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextMuted}"/><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="مانده تا سررسید" Binding="{Binding DaysLeftText}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDueSoon}" Value="True">
                                        <Setter Property="Foreground" Value="#B7791F"/><Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="مبلغ (ریال)" Binding="{Binding Amount, Converter={StaticResource Num}}" Width="130">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="6,0"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- وضعیت: چیپِ نقطه‌دار (.st) -->
                    <DataGridTemplateColumn Header="وضعیت" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="chip" CornerRadius="10" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F1F2F4">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="dot" Width="6" Height="6" Fill="#9CA3AF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="txt" Text="{Binding Status}" FontSize="11" Foreground="#6B7280"/>
                                    </StackPanel>
                                    <Border.Style>
                                        <Style TargetType="Border"/>
                                    </Border.Style>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ChipKind}" Value="a">
                                        <Setter TargetName="chip" Property="Background" Value="#FDF3E3"/>
                                        <Setter TargetName="dot" Property="Fill" Value="#D97706"/>
                                        <Setter TargetName="txt" Property="Foreground" Value="#B7791F"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChipKind}" Value="g">
                                        <Setter TargetName="chip" Property="Background" Value="#E8F5EC"/>
                                        <Setter TargetName="dot" Property="Fill" Value="#15803D"/>
                                        <Setter TargetName="txt" Property="Foreground" Value="#15803D"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChipKind}" Value="b">
                                        <Setter TargetName="chip" Property="Background" Value="#EAF0FB"/>
                                        <Setter TargetName="dot" Property="Fill" Value="#4B5F97"/>
                                        <Setter TargetName="txt" Property="Foreground" Value="#324A7A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChipKind}" Value="r">
                                        <Setter TargetName="chip" Property="Background" Value="#FBEAEA"/>
                                        <Setter TargetName="dot" Property="Fill" Value="#DC2626"/>
                                        <Setter TargetName="txt" Property="Foreground" Value="#B91C1C"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="بابت" Binding="{Binding Reference}" Width="100">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextMuted}"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            </DockPanel>
        </Border>

        <!-- ═══ نوار جمع ═══ -->
        <Border Grid.Row="4" Background="{StaticResource Blue700}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Text="جمع چک‌های فیلترشده" Foreground="White" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                    <StackPanel Margin="18,0,0,0">
                        <TextBlock Text="تعداد" FontSize="10.5" Foreground="#C8D2E8"/>
                        <TextBlock Text="{Binding TotalCount, Converter={StaticResource Num}, ConverterParameter='فقره'}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="22,0,0,0">
                        <TextBlock Text="جمع مبلغ (ریال)" FontSize="10.5" Foreground="#C8D2E8"/>
                        <TextBlock Text="{Binding TotalAmount, Converter={StaticResource Num}}" Foreground="White" FontWeight="Bold" FontSize="14" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
