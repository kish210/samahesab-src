<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:telerik="using:Telerik.UI.Xaml.Controls">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/Primitives/Themes/ThemeColorsDark.xaml"/>
        <ResourceDictionary>
            <telerik:UserThemeResources x:Key="ResourceLoaderInitializer"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="{CustomResource DarkResourcesPath}"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="TelerikSecondaryForegroundBrush" Color="{StaticResource TelerikSecondaryForegroundColor}"/>
    <SolidColorBrush x:Key="TelerikWhiteBrush" Color="{StaticResource TelerikWhiteColor}"/>
    <SolidColorBrush x:Key="TelerikBlackBrush" Color="{StaticResource TelerikBlackColor}"/>

    <!--#region Buttons-->
    <SolidColorBrush x:Key="TelerikButton_Foreground" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TelerikButton_ForegroundPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TelerikButton_ForegroundPressed" Color="{ThemeResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="TelerikButton_ForegroundChecked" Color="{ThemeResource TextOnAccentFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikButton_ForegroundCheckedPointerOver" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
    <SolidColorBrush x:Key="TelerikButton_ForegroundCheckedPressed" Color="{ThemeResource TextOnAccentFillColorSecondary}" />
    <SolidColorBrush x:Key="TelerikButton_ForegroundDisabled" Color="{ThemeResource TextFillColorDisabled}" />
    <SolidColorBrush x:Key="TelerikButton_Background" Color="{ThemeResource ControlFillColorDefault}" />
    <SolidColorBrush x:Key="TelerikButton_BackgroundPointerOver" Color="{ThemeResource ControlFillColorSecondary}" />
    <SolidColorBrush x:Key="TelerikButton_BackgroundPressed" Color="{ThemeResource ControlFillColorTertiary}" />
    <SolidColorBrush x:Key="TelerikButton_BackgroundChecked" Color="{ThemeResource SystemAccentColorLight1}"/>
    <SolidColorBrush x:Key="TelerikButton_BackgroundCheckedPointerOver" Color="{ThemeResource SystemAccentColorLight1}" Opacity="0.9"/>
    <SolidColorBrush x:Key="TelerikButton_BackgroundCheckedPressed" Color="{ThemeResource SystemAccentColorLight1}" Opacity="0.8"/>
    <SolidColorBrush x:Key="TelerikButton_BackgroundOpened" Color="{ThemeResource ControlFillColorDefault}" />
    <SolidColorBrush x:Key="TelerikButton_BackgroundFocused" Color="{ThemeResource FocusStrokeColorInner}" />
    <SolidColorBrush x:Key="TelerikButton_BackgroundDisabled" Color="{ThemeResource ControlFillColorDisabled}" />
    <LinearGradientBrush x:Key="TelerikButton_BorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0.33" Color="{ThemeResource ControlStrokeColorSecondary}"/>
            <GradientStop Offset="1.0" Color="{ThemeResource ControlStrokeColorDefault}"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TelerikButton_BorderBrushPointerOver" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0.33" Color="{ThemeResource ControlStrokeColorSecondary}"/>
            <GradientStop Offset="1.0" Color="{ThemeResource ControlStrokeColorDefault}"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TelerikButton_BorderBrushPressed" Color="{ThemeResource ControlStrokeColorDefault}" />
    <LinearGradientBrush x:Key="TelerikButton_BorderBrushChecked" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform ScaleY="-1" CenterY="0.5"/>
        </LinearGradientBrush.RelativeTransform>
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0.33" Color="{ThemeResource ControlStrokeColorOnAccentSecondary}"/>
            <GradientStop Offset="1.0" Color="{ThemeResource ControlStrokeColorOnAccentDefault}"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TelerikButton_BorderBrushCheckedPointerOver" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform ScaleY="-1" CenterY="0.5"/>
        </LinearGradientBrush.RelativeTransform>
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0.33" Color="{ThemeResource ControlStrokeColorOnAccentSecondary}"/>
            <GradientStop Offset="1.0" Color="{ThemeResource ControlStrokeColorOnAccentDefault}"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TelerikButton_BorderBrushCheckedPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikButton_BorderBrushOpened" Color="Transparent" />
    <SolidColorBrush x:Key="TelerikButton_BorderBrushFocused" Color="{ThemeResource FocusStrokeColorOuter}" />
    <SolidColorBrush x:Key="TelerikButton_BorderBrushDisabled" Color="{ThemeResource ControlStrokeColorDefault}" />
    <!--Divider-->
    <SolidColorBrush x:Key="TelerikButton_DividerBorderBrush" Color="{ThemeResource ControlStrokeColorDefault}" />
    <SolidColorBrush x:Key="TelerikButton_DividerCheckedBorderBrush" Color="{ThemeResource ControlStrokeColorOnAccentTertiary}" />
    <!--Dropdown Popup-->
    <AcrylicBrush x:Key="TelerikButton_DropdownBackground" TintColor="#2C2C2C" TintOpacity="0.15" FallbackColor="#2C2C2C"/>
    <SolidColorBrush x:Key="TelerikButton_DropdownBorderBrush" Color="{ThemeResource SurfaceStrokeColorFlyout}" />
    <!--#endregion-->

    <SolidColorBrush x:Key="TelerikBusyIndicator_Foreground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikBusyIndicator_IndicatorBackground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikBusyIndicator_OverlayBackground" Color="{ThemeResource ControlStrokeColorForStrongFillWhenOnImage}"/>

    <!--#region PaginationControl-->
    <SolidColorBrush x:Key="TelerikPaginationControl_Foreground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_ForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_Foreground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_ForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_Background" Color="{ThemeResource ControlFillColorDefault}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_BackgroundPointerOver" Color="{ThemeResource ControlFillColorSecondary}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_BackgroundPressed" Color="{ThemeResource ControlFillColorTertiary}"/>
    <LinearGradientBrush x:Key="TelerikPaginationControl_Button_BorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0.33" Color="{ThemeResource ControlStrokeColorSecondary}"/>
            <GradientStop Offset="1.0" Color="{ThemeResource ControlStrokeColorDefault}"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TelerikPaginationControl_Button_BorderBrushDisabled" Color="{ThemeResource ControlStrokeColorDefault}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Item_Background" Color="{ThemeResource ControlFillColorDefault}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Item_BackgroundSelected" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Item_BackgroundSelectedDisabled" Color="{ThemeResource SystemAccentColor}" Opacity="0.8"/>
    <SolidColorBrush x:Key="TelerikPaginationControl_Item_BackgroundDisabled" Color="{ThemeResource ControlFillColorDisabled}"/>
    <!--#endregion-->

    <!--#region SideDrawerControl-->
    <SolidColorBrush x:Key="TelerikSideDrawer_Foreground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikSideDrawer_BorderBrush" Color="Transparent"/>
    <!--#endregion-->

    <!--#region Hubtile-->
    <SolidColorBrush x:Key="TelerikHubTile_Foreground" Color="{ThemeResource TextOnAccentFillColorSelectedText}"/>
    <SolidColorBrush x:Key="TelerikHubTile_Background" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikHubTile_Background_PointerOver" Color="{ThemeResource SubtleFillColorTertiary}"/>
    <SolidColorBrush x:Key="TelerikHubTile_BorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikHubTile_BorderBrush_PointerOver" Color="{ThemeResource SystemAccentColorLight1}"/>
    <!--#endregion-->

    <!--#region RangeSlider-->
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionThumb_Background" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionThumb_Background_Outer" Color="{ThemeResource SolidBackgroundFillColorQuarternary}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionThumb_Background_Disabled" Color="{ThemeResource TextFillColorDisabled}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionThumb_BorderBrush" Color="{ThemeResource CardStrokeColorDefault}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionThumb_BorderBrush_Disabled" Color="{ThemeResource ControlStrokeColorDefault}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionMiddleThumb_Background" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionMiddleThumb_Background_Disabled" Color="{ThemeResource TextFillColorDisabled}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionMiddleThumb_Background_Pressed" Color="{ThemeResource SystemAccentColorDark1}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_SelectionMiddleThumb_Background_PointerOver" Color="{ThemeResource SystemAccentColorLight1}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Track_Background" Color="{ThemeResource ControlStrongStrokeColorDefault}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Track_Background_Disabled" Color="{ThemeResource TextFillColorDisabled}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Track_Background_PointerOver" Color="{ThemeResource ControlStrongStrokeColorDefault}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_ToolTip_Foreground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_ToolTip_Foreground_Range" Color="{ThemeResource TextFillColorTertiary}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_ToolTip_Background" Color="{ThemeResource SolidBackgroundFillColorTertiary}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_ToolTip_BorderBrush" Color="{ThemeResource ControlStrokeColorDefault}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Label_Foreground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Tick_Fill" Color="{ThemeResource ControlStrongStrokeColorDefault}"/>
    <SolidColorBrush x:Key="TelerikRangeSlider_Line_Fill" Color="Transparent"/>
    <!--#endregion-->

    <!--#region LoopingList-->
    <SolidColorBrush x:Key="TelerikLoopingList_Background" Color="{ThemeResource ControlFillColorDefault}" />
    <SolidColorBrush x:Key="TelerikLoopingList_BorderBrush" Color="{ThemeResource ControlStrokeColorDefault}" />
    <SolidColorBrush x:Key="TelerikLoopingList_ItemForeground" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TelerikLoopingList_ItemForegroundSelected" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TelerikLoopingList_ItemBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TelerikLoopingList_ItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.6" />
    <!--#endregion-->

    <SolidColorBrush x:Key="TelerikShadow_Foreground" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TelerikShadow_Background" Color="{ThemeResource TextOnAccentFillColorPrimary}" />

    <SolidColorBrush x:Key="TelerikGridSplitter_Foreground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikGridSplitter_Background" Color="{ThemeResource SolidBackgroundFillColorBase}"/>
    <SolidColorBrush x:Key="TelerikGridSplitter_Background_PointerOver" Color="#FF2C2C2C"/>
    <SolidColorBrush x:Key="TelerikGridSplitter_Background_Pressed" Color="#FF313131"/>

    <!--#region Expander-->
    <SolidColorBrush x:Key="TelerikExpander_Foreground" Color="{ThemeResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TelerikExpander_Background" Color="{ThemeResource ControlFillColorDefault}"/>
    <SolidColorBrush x:Key="TelerikExpander_BorderBrush" Color="{ThemeResource ControlStrokeColorDefault}"/>
    <SolidColorBrush x:Key="TelerikExpander_HeaderButton_Foreground" Color="{ThemeResource TextFillColorSecondary}"/>
    <SolidColorBrush x:Key="TelerikExpander_HeaderButton_ForegroundPressed" Color="{ThemeResource TextFillColorTertiary}"/>
    <SolidColorBrush x:Key="TelerikExpander_HeaderButton_Background" Color="Transparent"/>
    <SolidColorBrush x:Key="TelerikExpander_HeaderButton_BackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}"/>
    <SolidColorBrush x:Key="TelerikExpander_HeaderButton_BackgroundPressed" Color="{ThemeResource SubtleFillColorTertiary}"/>
    <!--#endregion-->

</ResourceDictionary>

