<UserControl x:Class="SamaHesab.WPF.Views.Accounting.VoucherListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft"
             Background="{StaticResource ErpAppBg}">
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>

        <!-- دکمه‌ی تولبار متن+آیکون -->
        <Style x:Key="TBtn" TargetType="Button" BasedOn="{StaticResource ErpBtnGhost}">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,0"/><Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <!-- چیپ فیلتر وضعیت -->
        <Style x:Key="FChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="999" Background="White" BorderBrush="{StaticResource ErpBorderStrong}" BorderThickness="1" Padding="14,4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource ErpBlue600}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource ErpBlue600}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- تولبار -->
            <RowDefinition Height="Auto"/>   <!-- نوار فیلتر -->
            <RowDefinition Height="*"/>      <!-- لیست + پیش‌نمایش -->
        </Grid.RowDefinitions>

        <!-- ═══ تولبار ═══ -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ErpBtnPrimary}" Height="32" Padding="12,0" Margin="0,0,6,0" Command="{Binding NewVoucherCommand}">
                    <TextBlock><Run Text="🧾 سند جدید"/><Run Text="  F2" FontSize="10" Foreground="#CFE0FF"/></TextBlock>
                </Button>
                <Button Style="{StaticResource TBtn}" Content="✎ ویرایش" Command="{Binding EditVoucherCommand}"/>
                <Button Style="{StaticResource TBtn}" Content="📒 دفتر کل" Command="{Binding LedgerCommand}"/>
                <Button Style="{StaticResource TBtn}" Content="≣ تراز آزمایشی" Command="{Binding TrialBalanceCommand}"/>
                <Rectangle Width="1" Fill="{StaticResource ErpBorder}" Margin="5,5"/>
                <Button Style="{StaticResource TBtn}" Content="⤓ خروجی اکسل" Command="{Binding ExportCommand}"/>
                <Button Style="{StaticResource TBtn}" Command="{Binding PrintVoucherCommand}"><TextBlock><Run Text="🖨 چاپ"/><Run Text="  F8" FontSize="10" Foreground="{StaticResource ErpTextMuted}"/></TextBlock></Button>
                <TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5"
                           Text="{Binding TotalCount, StringFormat='{}{0} سند · دوره ۱۴۰۵'}"/>
            </DockPanel>
        </Border>

        <!-- ═══ نوار فیلتر ═══ -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
            <DockPanel>
                <TextBox DockPanel.Dock="Right" Style="{StaticResource ErpInput}" Width="240" Margin="0,0,8,0"
                         Text="{Binding SearchText}" VerticalContentAlignment="Center">
                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                </TextBox>
                <TextBlock DockPanel.Dock="Right" Text="از" VerticalAlignment="Center" Foreground="{StaticResource ErpTextMuted}" FontSize="12" Margin="0,0,4,0"/>
                <TextBox DockPanel.Dock="Right" Style="{StaticResource ErpInput}" Width="110" Margin="0,0,4,0" Text="{Binding FromDate}" FlowDirection="LeftToRight" TextAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="تا" VerticalAlignment="Center" Foreground="{StaticResource ErpTextMuted}" FontSize="12" Margin="0,0,4,0"/>
                <TextBox DockPanel.Dock="Right" Style="{StaticResource ErpInput}" Width="110" Margin="0,0,8,0" Text="{Binding ToDate}" FlowDirection="LeftToRight" TextAlignment="Center"/>
                <ComboBox DockPanel.Dock="Right" Width="120" Height="32" Margin="0,0,10,0"
                          ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedStatus}"/>
                <RadioButton Style="{StaticResource FChip}" Content="همه" IsChecked="True" GroupName="st"/>
                <RadioButton Style="{StaticResource FChip}" Content="قطعی" GroupName="st"/>
                <RadioButton Style="{StaticResource FChip}" Content="پیش‌نویس" GroupName="st"/>
                <Button Style="{StaticResource ErpBtnSecondary}" Height="32" Content="🔍 جستجو" Command="{Binding SearchCommand}" Margin="6,0,0,0"/>
                <TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5"
                           Text="{Binding TotalCount, StringFormat='{}{0} نتیجه'}"/>
            </DockPanel>
        </Border>

        <!-- ═══ لیست + پیش‌نمایش ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- لیست اسناد -->
            <Border Grid.Column="0" Style="{StaticResource ErpGbox}">
                <DockPanel>
                    <!-- نوار جمع پایین -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource ErpGray100}" BorderBrush="{StaticResource ErpBorderStrong}" BorderThickness="0,1,0,0" Padding="0,7">
                        <DockPanel Margin="9,0">
                            <TextBlock Text="{Binding TotalCount, StringFormat='جمع اسناد فیلترشده — {0} سند'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource ErpTextStrong}"/>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding TotalDebit, Converter={StaticResource Num}}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource ErpTextStrong}" FlowDirection="LeftToRight"/>
                        </DockPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding Vouchers}" SelectedItem="{Binding SelectedVoucher}"
                              Style="{StaticResource ErpDataGrid}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شماره" Binding="{Binding VoucherNumber}" Width="80">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding VoucherDate}" Width="95">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource ErpTextMuted}"/><Setter Property="Margin" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- نوع: بج رنگی -->
                            <DataGridTemplateColumn Header="نوع" Width="84">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource ErpBlue50}"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding VoucherTypeName}" Value="عمومی"><Setter Property="Background" Value="{StaticResource ErpGray150}"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding VoucherTypeName}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource ErpBlue700}"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding VoucherTypeName}" Value="عمومی"><Setter Property="Foreground" Value="{StaticResource ErpTextMuted}"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="شرح سند" Binding="{Binding Description}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource ErpTextStrong}"/><Setter Property="Margin" Value="8,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="مبلغ (ریال)" Binding="{Binding TotalDebit, Converter={StaticResource Num}}" Width="130">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="8,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- وضعیت: بج رنگی -->
                            <DataGridTemplateColumn Header="وضعیت" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource ErpSuccess50}"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding StatusName}" Value="پیش‌نویس"><Setter Property="Background" Value="{StaticResource ErpWarning50}"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusName}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource ErpSuccess700}"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding StatusName}" Value="پیش‌نویس"><Setter Property="Foreground" Value="{StaticResource ErpWarning700}"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- پنل پیش‌نمایش سند -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource ErpGbox}">
                    <StackPanel>
                        <Border Style="{StaticResource ErpGboxHeader}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource ErpGboxTitle}" Text="{Binding SelectedVoucher.VoucherNumber, StringFormat='پیش‌نمایش سند {0}', FallbackValue='پیش‌نمایش سند'}"/>
                                <Border DockPanel.Dock="Left" CornerRadius="4" Padding="7,1" VerticalAlignment="Center"
                                        Visibility="{Binding SelectedVoucher, Converter={StaticResource BoolVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border"><Setter Property="Background" Value="{StaticResource ErpSuccess50}"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding SelectedVoucher.StatusName}" Value="پیش‌نویس"><Setter Property="Background" Value="{StaticResource ErpWarning50}"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedVoucher.StatusName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ErpWarning700}"/>
                                </Border>
                            </DockPanel>
                        </Border>
                        <StackPanel Margin="12,10">
                            <DockPanel Margin="0,3"><TextBlock Text="تاریخ" Foreground="{StaticResource ErpTextMuted}" FontSize="12"/><TextBlock DockPanel.Dock="Left" Text="{Binding SelectedVoucher.VoucherDate}" FontWeight="Bold" FontSize="12"/></DockPanel>
                            <DockPanel Margin="0,3"><TextBlock Text="نوع" Foreground="{StaticResource ErpTextMuted}" FontSize="12"/><TextBlock DockPanel.Dock="Left" Text="{Binding SelectedVoucher.VoucherTypeName}" FontWeight="Bold" FontSize="12"/></DockPanel>
                            <DockPanel Margin="0,3"><TextBlock Text="مرکز هزینه" Foreground="{StaticResource ErpTextMuted}" FontSize="12"/><TextBlock DockPanel.Dock="Left" Text="شعبه مرکزی" FontWeight="Bold" FontSize="12"/></DockPanel>
                            <TextBlock Text="{Binding SelectedVoucher.Description}" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ردیف‌های حساب -->
                <Border Style="{StaticResource ErpGbox}" Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding PreviewLines}" Style="{StaticResource ErpDataGrid}" IsReadOnly="True" FontSize="11.5" HeadersVisibility="Column" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="حساب" Binding="{Binding Account}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Margin" Value="7,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="بدهکار" Binding="{Binding Debit, Converter={StaticResource Num}}" Width="95">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="6,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="بستانکار" Binding="{Binding Credit, Converter={StaticResource Num}}" Width="95">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="6,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- تراز -->
                <Border Style="{StaticResource ErpSumBarOk}" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                        Visibility="{Binding PreviewBalanced, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="✓ تراز" FontWeight="Bold" Foreground="{StaticResource ErpSuccess700}" HorizontalAlignment="Center"/>
                </Border>

                <Button Content="باز کردن سند کامل ↗" Style="{StaticResource ErpBtnPrimary}" Height="38" Margin="0,10,0,0" Command="{Binding EditVoucherCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
