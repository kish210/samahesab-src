<UserControl x:Class="SamaHesab.WPF.Views.Accounting.VoucherProductivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <!-- F5 = بازخوانی (کیبوردمحور، هم‌راستا با بقیهٔ صفحات) -->
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <Style x:Key="VpLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="VpInput" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style x:Key="VpCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style x:Key="VpPrimary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Left" Content="🔄 بازخوانی" Command="{Binding RefreshCommand}"
                    Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="14,7" Cursor="Hand"/>
            <StackPanel>
                <TextBlock Text="بهره‌وری سند" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                <TextBlock Text="ساخت سریع سند از الگو و مدیریت اسناد تکرارشونده (ماهانه/سالانه)."
                           Foreground="{DynamicResource SecondaryText}" FontSize="12.5" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── الگوهای سند ── -->
            <Border Grid.Column="0" Style="{StaticResource VpCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="الگوهای سند" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>

                    <!-- نوار ساخت از الگو -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                            Padding="0,10,0,0" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="تاریخ سند جدید" Style="{StaticResource VpLabel}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="ساخت سند از الگو" Style="{StaticResource VpPrimary}"
                                        Command="{Binding CreateFromTemplateCommand}" Margin="8,0,0,0"/>
                                <TextBox Text="{Binding CreateDate}" Style="{StaticResource VpInput}" Margin="0"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="All" RowHeight="30" FontSize="12.5"
                              Background="Transparent" BorderThickness="0" CanUserAddRows="False"
                              Foreground="{DynamicResource PrimaryText}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام الگو" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="ردیف" Binding="{Binding LineCount, Converter={StaticResource Num}}" Width="60"/>
                            <DataGridTextColumn Header="بدهکار" Binding="{Binding TotalDebit, Converter={StaticResource Num}}" Width="120"/>
                            <DataGridTextColumn Header="بستانکار" Binding="{Binding TotalCredit, Converter={StaticResource Num}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ── اسناد تکرارشونده ── -->
            <Border Grid.Column="2" Style="{StaticResource VpCard}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="اسناد تکرارشونده" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource PrimaryText}"/>
                        <Button DockPanel.Dock="Left" Content="تولید سررسیدشده‌ها" Style="{StaticResource VpPrimary}"
                                Command="{Binding GenerateDueCommand}"/>
                    </DockPanel>

                    <!-- تعریف سند تکرارشونده‌ی جدید روی الگوی انتخاب‌شده -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                            Padding="0,10,0,0" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="تعریف سند تکرارشونده روی الگوی انتخاب‌شده"
                                       Foreground="{DynamicResource PrimaryText}" FontSize="12.5" FontWeight="Medium" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="نام" Style="{StaticResource VpLabel}"/>
                                    <TextBox Text="{Binding RecurringName}" Style="{StaticResource VpInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="تاریخ شروع" Style="{StaticResource VpLabel}"/>
                                    <TextBox Text="{Binding RecurringStartDate}" Style="{StaticResource VpInput}"/>
                                </StackPanel>
                            </Grid>
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="ذخیرهٔ سند تکرارشونده" Style="{StaticResource VpPrimary}"
                                        Command="{Binding SaveRecurringCommand}" Margin="8,0,0,0"/>
                                <CheckBox Content="سالانه (پیش‌فرض: ماهانه)" IsChecked="{Binding IsYearly}"
                                          VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding Recurring}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="All" RowHeight="30" FontSize="12.5"
                              Background="Transparent" BorderThickness="0" CanUserAddRows="False"
                              Foreground="{DynamicResource PrimaryText}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="تناوب" Binding="{Binding Frequency}" Width="70"/>
                            <DataGridTextColumn Header="سررسید بعدی" Binding="{Binding NextDate}" Width="100"/>
                            <DataGridTextColumn Header="آخرین تولید" Binding="{Binding LastGeneratedDate}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
