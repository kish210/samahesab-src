<UserControl x:Class="SamaHesab.WPF.Views.Sales.SalesInvoiceEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="Auto"/>   <!-- Header fields -->
            <RowDefinition Height="Auto"/>   <!-- Add item bar -->
            <RowDefinition Height="*"/>      <!-- Items grid -->
            <RowDefinition Height="Auto"/>   <!-- Totals -->
        </Grid.RowDefinitions>

        <!-- ═══ Toolbar ═══ -->
        <Border Grid.Row="0" Style="{StaticResource FormSectionCard}" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <Border Width="40" Height="40" CornerRadius="8" Background="#E0EDFF">
                        <materialDesign:PackIcon Kind="CartArrowRight" Width="22" Height="22"
                                                 Foreground="{DynamicResource PrimaryAccent}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="فاکتور فروش" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding InvoiceNumber, StringFormat=شماره سند: {0}}"
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding NewInvoiceCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="FilePlusOutline" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="جدید (F2)" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding SaveDraftCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="ContentSaveOutline" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource WarningColor}"/><TextBlock Text="پیش‌نویس" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding PostInvoiceCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="CheckCircleOutline" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource SuccessColor}"/><TextBlock Text="ثبت قطعی" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding PrintCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="PrinterOutline" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="چاپ (F8)" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Header fields ═══ -->
        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="6">
                    <TextBlock Text="مشتری (جستجو)" Style="{StaticResource FieldCaption}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Width="34" Height="36" Margin="6,0,0,0"
                                Style="{StaticResource PrimaryButton}" Padding="0"
                                ToolTip="افزودن مشتری جدید" Click="AddCustomer_Click">
                            <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18"/>
                        </Button>
                        <ComboBox Style="{StaticResource BaseComboBox}" ItemsSource="{Binding Customers}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedCustomerId}"
                                  IsEditable="True" IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="6">
                    <TextBlock Text="انبار" Style="{StaticResource FieldCaption}"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" ItemsSource="{Binding Warehouses}"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedWarehouseId}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="6">
                    <TextBlock Text="تاریخ فاکتور" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding InvoiceDate}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="6">
                    <TextBlock Text="شماره سند" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding InvoiceNumber}" IsReadOnly="True"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="6">
                    <TextBlock Text="نوع فاکتور" Style="{StaticResource FieldCaption}"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" ItemsSource="{Binding InvoiceTypes}"
                              SelectedItem="{Binding InvoiceType}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="6">
                    <TextBlock Text="سطح قیمت" Style="{StaticResource FieldCaption}"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" ItemsSource="{Binding PriceLevels}"
                              SelectedItem="{Binding PriceLevel}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="6">
                    <TextBlock Text="نحوه پرداخت" Style="{StaticResource FieldCaption}"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" ItemsSource="{Binding PaymentTypes}"
                              SelectedItem="{Binding PaymentType}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="6">
                    <TextBlock Text="تاریخ سررسید" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding DueDate}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Add item bar ═══ -->
        <Border Grid.Row="2" Style="{StaticResource FormSectionCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="4">
                    <TextBlock Text="جستجوی کالا (کد / بارکد / نام)" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchProductCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource SecondaryButton}" Height="36" Width="44" Command="{Binding SearchProductCommand}">
                        <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="4">
                    <TextBlock Text="مقدار" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding AddQty}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="4">
                    <TextBlock Text="قیمت واحد" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding AddUnitPrice}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="4">
                    <TextBlock Text="تخفیف ٪" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding AddDiscountPct}"/>
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="4">
                    <TextBlock Text="مالیات ٪" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding AddTaxPct}"/>
                </StackPanel>
                <StackPanel Grid.Column="6" Margin="4" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource PrimaryButton}" Height="36" Padding="16,0" Command="{Binding SearchProductCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="افزودن" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Items grid + search results ═══ -->
        <Grid Grid.Row="3" Margin="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource FormSectionCard}" Margin="0,0,4,0" Padding="0">
                <telerik:RadGridView ItemsSource="{Binding InvoiceItems}" SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False" CanUserInsertRows="False" CanUserDeleteRows="False"
                          RowIndicatorVisibility="Collapsed" ShowGroupPanel="False" FontFamily="{StaticResource VazirFont}">
                    <telerik:RadGridView.Columns>
                        <telerik:GridViewDataColumn Header="ردیف" DataMemberBinding="{Binding RowNumber}" Width="50" IsReadOnly="True"/>
                        <telerik:GridViewDataColumn Header="کد" DataMemberBinding="{Binding ProductCode}" Width="80" IsReadOnly="True"/>
                        <telerik:GridViewDataColumn Header="نام کالا" DataMemberBinding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                        <telerik:GridViewDataColumn Header="مقدار" DataMemberBinding="{Binding Quantity}" Width="80"/>
                        <telerik:GridViewDataColumn Header="قیمت واحد" DataMemberBinding="{Binding UnitPrice}" DataFormatString="{}{0:#,##0}" Width="110"/>
                        <telerik:GridViewDataColumn Header="تخفیف ٪" DataMemberBinding="{Binding DiscountPct}" Width="70"/>
                        <telerik:GridViewDataColumn Header="مالیات ٪" DataMemberBinding="{Binding TaxPct}" Width="70"/>
                        <telerik:GridViewDataColumn Header="مبلغ خالص" DataMemberBinding="{Binding NetAmount}" DataFormatString="{}{0:#,##0}" Width="120" IsReadOnly="True"/>
                        <telerik:GridViewDataColumn Header="حذف" Width="50" IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ToolbarButton}" Width="34" Height="30"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="{DynamicResource DangerColor}"/>
                                    </Button>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>
            </Border>

            <!-- Search results -->
            <Border Grid.Column="1" Style="{StaticResource FormSectionCard}" Width="240" Margin="4,0,0,0"
                    Visibility="{Binding SearchResults.Count, Converter={x:Static conv:GreaterThanZeroVisibilityConverter.Instance}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="نتایج جستجو" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding SearchResults}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Padding="6"
                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                                        <DockPanel Margin="0,2,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Code}" FontSize="10" Foreground="{DynamicResource SecondaryText}"/>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Price, StringFormat={}{0:#,##0}}" FontSize="10" Foreground="{DynamicResource PrimaryAccent}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ Totals + description ═══ -->
        <Border Grid.Row="4" Style="{StaticResource FormSectionCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="4">
                    <TextBlock Text="توضیحات" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding Description}" Height="96" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource AppBackground}" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="جمع کل" Foreground="{DynamicResource SecondaryText}"/><TextBlock DockPanel.Dock="Left" Text="{Binding SubTotal, StringFormat={}{0:#,##0}}"/></DockPanel>
                        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="تخفیف" Foreground="{DynamicResource SecondaryText}"/><TextBlock DockPanel.Dock="Left" Text="{Binding TotalDiscount, StringFormat={}{0:#,##0}}" Foreground="{DynamicResource DangerColor}"/></DockPanel>
                        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="مالیات" Foreground="{DynamicResource SecondaryText}"/><TextBlock DockPanel.Dock="Left" Text="{Binding TotalTax, StringFormat={}{0:#,##0}}"/></DockPanel>
                        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="هزینه حمل" Foreground="{DynamicResource SecondaryText}"/><TextBox DockPanel.Dock="Left" Width="120" Text="{Binding Shipping}" Padding="6,2"/></DockPanel>
                        <Separator Margin="0,8"/>
                        <DockPanel Margin="0,3">
                            <TextBlock DockPanel.Dock="Right" Text="مبلغ قابل پرداخت" FontWeight="Bold" FontSize="15"/>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding GrandTotal, StringFormat={}{0:#,##0}}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryAccent}"/>
                        </DockPanel>
                        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="پرداختی" Foreground="{DynamicResource SecondaryText}"/><TextBox DockPanel.Dock="Left" Width="120" Text="{Binding PaidAmount}" Padding="6,2"/></DockPanel>
                        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="مانده" Foreground="{DynamicResource SecondaryText}"/><TextBlock DockPanel.Dock="Left" Text="{Binding RemainAmount, StringFormat={}{0:#,##0}}" FontWeight="Bold" Foreground="{DynamicResource DangerColor}"/></DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
