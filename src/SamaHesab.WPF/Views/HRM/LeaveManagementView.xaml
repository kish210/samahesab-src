<UserControl x:Class="SamaHesab.WPF.Views.HRM.LeaveManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="مدیریتِ مرخصی" FontSize="16" FontWeight="Bold" Margin="2,0,0,8"/>

        <!-- جدولِ درخواست‌ها -->
        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}" Padding="0">
            <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest}"
                      RowHeight="{DynamicResource ErpDensRowHeight}" FontFamily="{StaticResource VazirFont}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کارمند" Binding="{Binding EmployeeName}" Width="*"/>
                    <DataGridTextColumn Header="نوع" Binding="{Binding LeaveType}" Width="110"/>
                    <DataGridTextColumn Header="از تاریخ" Binding="{Binding StartDate}" Width="110"/>
                    <DataGridTextColumn Header="تا تاریخ" Binding="{Binding EndDate}" Width="110"/>
                    <DataGridTextColumn Header="روز" Binding="{Binding Days, Converter={StaticResource Num}}" Width="70" ElementStyle="{StaticResource NumCell}"/>
                    <DataGridTextColumn Header="ساعت" Binding="{Binding Hours, Converter={StaticResource Num}}" Width="70" ElementStyle="{StaticResource NumCell}"/>
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="100"/>
                    <DataGridTemplateColumn Header="اقدام" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="✓ تأیید" FontSize="11" Padding="6,2" Margin="0,0,4,0" Cursor="Hand"
                                            Foreground="{DynamicResource SuccessColor}" Background="Transparent" BorderThickness="0"
                                            Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    <Button Content="✕ رد" FontSize="11" Padding="6,2" Cursor="Hand"
                                            Foreground="{DynamicResource DangerColor}" Background="Transparent" BorderThickness="0"
                                            Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- فرمِ درخواستِ نو -->
        <Border Grid.Row="2" Style="{StaticResource FormSectionCard}" Padding="10" Margin="0,8,0,0">
            <DockPanel>
                <CheckBox DockPanel.Dock="Left" Content="فقط در انتظار" IsChecked="{Binding PendingOnly}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <WrapPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="کارمند" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                        <ComboBox Width="160" Height="30" ItemsSource="{Binding Employees}" DisplayMemberPath="FullName" SelectedValuePath="Id" SelectedValue="{Binding NewEmployeeId}"/></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="نوع" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                        <ComboBox Width="110" Height="30" ItemsSource="{Binding LeaveTypes}" SelectedItem="{Binding NewLeaveType}"/></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="از تاریخ" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox Width="100" Height="30" Text="{Binding NewStartDate}" FlowDirection="LeftToRight"/></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="تا تاریخ" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox Width="100" Height="30" Text="{Binding NewEndDate}" FlowDirection="LeftToRight"/></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="روز" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox Width="60" Height="30" Text="{Binding NewDays}" FlowDirection="LeftToRight"/></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="ساعت" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox Width="60" Height="30" Text="{Binding NewHours}" FlowDirection="LeftToRight"/></StackPanel>
                    <Button Content="➕ ثبتِ درخواست" Style="{StaticResource PrimaryButton}" Height="30" VerticalAlignment="Bottom" Command="{Binding SubmitRequestCommand}"/>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
