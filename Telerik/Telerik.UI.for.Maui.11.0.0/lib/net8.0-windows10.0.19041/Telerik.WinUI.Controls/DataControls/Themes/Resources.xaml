    <ControlTemplate x:Key="PropertyGridNestedToggleButtonTemplate" TargetType="controls:RadToggleButton">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver"/>
                    <VisualState x:Name="Pressed"/>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Plus.Foreground" Value="{ThemeResource TelerikPropertyGrid_NestedToggleButtonDisabledForeground}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedDisabled">
                        <VisualState.Setters>
                            <Setter Target="Minus.Foreground" Value="{ThemeResource TelerikPropertyGrid_NestedToggleButtonDisabledForeground}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked"/>
                    <VisualState x:Name="CheckedPointerOver"/>
                    <VisualState x:Name="CheckedPressed"/>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="PointerFocused"/>
                    <VisualState x:Name="Focused"/>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid x:Name="IconGrid"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <FontIcon x:Name="Minus"
                          Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolToVisibilityConverter}}"
                          Glyph="&#xE738;"
                          Foreground="{TemplateBinding Foreground}"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="16"/>
                <FontIcon x:Name="Plus"
                          Visibility="{Binding ElementName=Minus, Path=Visibility, Converter={StaticResource InvertedVisibilityConverter}}"
                          Glyph="&#xE710;"
                          Foreground="{TemplateBinding Foreground}"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="16"/>
            </Grid>
        </Border>
