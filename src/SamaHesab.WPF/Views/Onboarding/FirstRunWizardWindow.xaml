<Window x:Class="SamaHesab.WPF.Views.Onboarding.FirstRunWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="راه‌اندازیِ اولیه — سما حساب"
        Height="640" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource VazirFont}"
        Background="{DynamicResource AppBackground}">
    <Window.Resources>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
            <Setter Property="Margin" Value="2,8,0,3"/>
        </Style>
        <Style x:Key="Sec" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryAccent}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="به سما حساب خوش آمدید 👋" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryAccent}"/>
            <TextBlock Text="برای شروع، چند موردِ پایه را تنظیم کنید. بعداً از «تنظیمات» قابلِ تغییر است."
                       FontSize="12" Foreground="{DynamicResource MutedText}" Margin="0,3,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">

                <!-- ۱) شرکت -->
                <TextBlock Text="۱) اطلاعاتِ شرکت" Style="{StaticResource Sec}"/>
                <TextBlock Text="نامِ شرکت *" Style="{StaticResource Cap}"/>
                <TextBox Height="32" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="تلفن" Style="{StaticResource Cap}"/>
                        <TextBox Height="32" Text="{Binding CompanyPhone}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="شناسهٔ ملی" Style="{StaticResource Cap}"/>
                        <TextBox Height="32" Text="{Binding CompanyNationalId}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="کدِ اقتصادی" Style="{StaticResource Cap}"/>
                <TextBox Height="32" Text="{Binding CompanyEconomicCode}"/>
                <TextBlock Text="نشانی" Style="{StaticResource Cap}"/>
                <TextBox Height="48" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding CompanyAddress}"/>
                <TextBlock Text="لوگو" Style="{StaticResource Cap}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="انتخابِ لوگو…" Height="30" Padding="12,0" Click="Logo_Click"/>
                    <TextBox Height="30" IsReadOnly="True" Text="{Binding LogoPath}" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                </DockPanel>

                <!-- ۲) سالِ مالی -->
                <TextBlock Text="۲) سالِ مالی" Style="{StaticResource Sec}"/>
                <TextBlock Text="عنوان" Style="{StaticResource Cap}"/>
                <TextBox Height="32" Text="{Binding FiscalTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="از تاریخ (۱۴۰۵/۰۱/۰۱)" Style="{StaticResource Cap}"/>
                        <TextBox Height="32" Text="{Binding FiscalStart}" FlowDirection="LeftToRight" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="تا تاریخ (۱۴۰۵/۱۲/۲۹)" Style="{StaticResource Cap}"/>
                        <TextBox Height="32" Text="{Binding FiscalEnd}" FlowDirection="LeftToRight" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ۳) رمزِ مدیر -->
                <TextBlock Text="۳) رمزِ عبورِ مدیر (admin)" Style="{StaticResource Sec}"/>
                <TextBlock Text="⚠ رمزِ پیش‌فرض admin123 است. برای امنیت، رمزِ تازه‌ای بگذارید."
                           FontSize="11" Foreground="{DynamicResource WarningColor}" Margin="0,0,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="رمزِ جدید" Style="{StaticResource Cap}"/>
                        <PasswordBox x:Name="PwdNew" Height="32" PasswordChanged="PwdNew_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="تکرارِ رمز" Style="{StaticResource Cap}"/>
                        <PasswordBox x:Name="PwdConfirm" Height="32" PasswordChanged="PwdConfirm_Changed"/>
                    </StackPanel>
                </Grid>

                <!-- ۴) انبارها -->
                <TextBlock Text="۴) انبارها" Style="{StaticResource Sec}"/>
                <TextBlock Text="نامِ انبار(ها) را وارد کنید (مثلاً انبار مرکزی، انبار فروشگاه)." Style="{StaticResource Cap}"/>
                <DataGrid ItemsSource="{Binding Warehouses}" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" MaxHeight="140" Margin="0,2,0,0" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نامِ انبار" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTemplateColumn Width="38">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Padding="4,0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                            Command="{Binding DataContext.RemoveWarehouseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Content="+ افزودنِ انبار" Command="{Binding AddWarehouseCommand}"
                        HorizontalAlignment="Right" Margin="0,4,0,0" Padding="12,3" Cursor="Hand"/>

                <!-- ۵) کالاها و خدمات -->
                <TextBlock Text="۵) کالاها و خدمات" Style="{StaticResource Sec}"/>
                <TextBlock Text="کالاها/خدماتِ پایه را وارد کنید. کد در صورتِ خالی‌بودن خودکار ساخته می‌شود." Style="{StaticResource Cap}"/>
                <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" MaxHeight="160" Margin="0,2,0,0" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="کد" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <DataGridTextColumn Header="نام" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridCheckBoxColumn Header="خدمات؟" Binding="{Binding IsService, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridTextColumn Header="قیمتِ فروش" Binding="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn Header="قیمتِ خرید" Binding="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTemplateColumn Width="38">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Padding="4,0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                            Command="{Binding DataContext.RemoveProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Content="+ افزودنِ کالا/خدمت" Command="{Binding AddProductCommand}"
                        HorizontalAlignment="Right" Margin="0,4,0,0" Padding="12,3" Cursor="Hand"/>

                <!-- ۶) مشتری‌ها -->
                <TextBlock Text="۶) مشتری‌ها" Style="{StaticResource Sec}"/>
                <TextBlock Text="مشتریانِ اصلی را وارد کنید (برای شرکت، تیکِ «حقوقی» را بزنید)." Style="{StaticResource Cap}"/>
                <DataGrid ItemsSource="{Binding Customers}" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" MaxHeight="160" Margin="0,2,0,0" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نام" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        <DataGridCheckBoxColumn Header="حقوقی؟" Binding="{Binding IsCompany, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridTemplateColumn Width="38">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Padding="4,0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                            Command="{Binding DataContext.RemoveCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Content="+ افزودنِ مشتری" Command="{Binding AddCustomerCommand}"
                        HorizontalAlignment="Right" Margin="0,4,0,0" Padding="12,3" Cursor="Hand"/>

                <!-- ۷) ماژول‌های موردِ استفاده (اختیاری) -->
                <TextBlock Text="۷) ماژول‌های موردِ استفاده" Style="{StaticResource Sec}"/>
                <TextBlock Text="فقط ماژول‌هایی را که استفاده می‌کنید روشن کنید؛ بقیه از منو پنهان می‌مانند. بعداً از «تنظیمات → مدیریت ماژول‌ها» قابلِ تغییر است." Style="{StaticResource Cap}"/>
                <ItemsControl ItemsSource="{Binding Modules}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" Margin="0,0,18,6" MinWidth="150"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ۸) داده‌های نمونه/دمو (اختیاری) -->
                <TextBlock Text="۸) داده‌های نمونه" Style="{StaticResource Sec}"/>
                <CheckBox IsChecked="{Binding LoadDemoData}" Margin="0,2,0,0"
                          Content="ورودِ داده‌های دمو (مشتری/کالا/فاکتورِ نمونه) برای آشنایی و آزمایش"/>
            </StackPanel>
        </ScrollViewer>

        <!-- دکمه‌ها -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="✔ اتمام و ورود" Height="38" Padding="20,0" FontWeight="Bold"
                    Background="#2E7D52" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Command="{Binding FinishCommand}"/>
            <Button Content="بعداً" Height="38" Padding="18,0" Margin="8,0,0,0" Cursor="Hand"
                    Command="{Binding SkipCommand}"/>
        </StackPanel>
    </Grid>
</Window>
