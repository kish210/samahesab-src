<UserControl x:Class="SamaHesab.WPF.Views.Settings.BranchManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <Style x:Key="BLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="BInput" TargetType="TextBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style x:Key="BPrimary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="مدیریت شعب" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
            <TextBlock Text="تعریف و ویرایش شعب شرکت (چندشعبه). شعبهٔ مرکزی همیشه فعال است."
                       Foreground="{DynamicResource SecondaryText}" FontSize="12.5" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="All" RowHeight="30" FontSize="12.5" SelectionMode="Single"
                      Background="Transparent" BorderThickness="0" CanUserAddRows="False"
                      Foreground="{DynamicResource PrimaryText}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="90"/>
                    <DataGridTextColumn Header="نام شعبه" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="مدیر" Binding="{Binding ManagerName}" Width="130"/>
                    <DataGridCheckBoxColumn Header="مرکزی" Binding="{Binding IsHQ}" Width="60"/>
                    <DataGridCheckBoxColumn Header="فعال" Binding="{Binding IsActive}" Width="55"/>
                    <DataGridTemplateColumn Header="وضعیت" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="فعال/غیرفعال" FontSize="10.5" Padding="6,2" Cursor="Hand"
                                        Background="Transparent" Foreground="{DynamicResource PrimaryAccent}" BorderThickness="0"
                                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="مشخصات شعبه" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource PrimaryText}"/>
                        <Button DockPanel.Dock="Left" Content="جدید" Command="{Binding NewBranchCommand}"
                                Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="12,4" Cursor="Hand"/>
                    </DockPanel>
                    <TextBlock Text="کد شعبه" Style="{StaticResource BLabel}"/>
                    <TextBox Text="{Binding Code}" Style="{StaticResource BInput}"/>
                    <TextBlock Text="نام شعبه" Style="{StaticResource BLabel}"/>
                    <TextBox Text="{Binding Name}" Style="{StaticResource BInput}"/>
                    <TextBlock Text="مدیر شعبه" Style="{StaticResource BLabel}"/>
                    <TextBox Text="{Binding ManagerName}" Style="{StaticResource BInput}"/>
                    <TextBlock Text="تلفن" Style="{StaticResource BLabel}"/>
                    <TextBox Text="{Binding Phone}" Style="{StaticResource BInput}"/>
                    <TextBlock Text="آدرس" Style="{StaticResource BLabel}"/>
                    <TextBox Text="{Binding Address}" Style="{StaticResource BInput}" Height="48" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <CheckBox Content="شعبهٔ مرکزی (HQ)" IsChecked="{Binding IsHQ}" Margin="0,2,0,12"
                              Foreground="{DynamicResource PrimaryText}"/>
                    <Button Content="ذخیرهٔ شعبه" Style="{StaticResource BPrimary}" HorizontalAlignment="Left"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
