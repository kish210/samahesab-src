<UserControl x:Class="SamaHesab.WPF.Views.HRM.EmployeeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding AddNewCommand}"/>
    </UserControl.InputBindings>
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ErpToolbar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ErpToolButton}" Command="{Binding AddNewCommand}">
                    <StackPanel><materialDesign:PackIcon Kind="AccountPlusOutline" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="کارمند جدید" TextAlignment="Center"/></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}" Margin="3" Padding="0">
            <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Employees}" RowHeight="28"
                                
                                >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="80"/>
                    <DataGridTextColumn Header="نام" Binding="{Binding FirstName}" Width="*"/>
                    <DataGridTextColumn Header="نام خانوادگی" Binding="{Binding LastName}" Width="*"/>
                    <DataGridTextColumn Header="کد ملی" Binding="{Binding NationalCode}" Width="120"/>
                    <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile}" Width="120"/>
                    <DataGridTextColumn Header="نوع قرارداد" Binding="{Binding ContractType}" Width="100"/>
                    <DataGridTextColumn Header="تاریخ استخدام" Binding="{Binding HireDate}" Width="110"/>
                    <DataGridTextColumn Header="حقوق پایه" Binding="{Binding BaseSalary, StringFormat={}{0:#,##0}}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ErpToolbar}" BorderThickness="0,1,0,0">
            <TextBlock FontSize="12" HorizontalAlignment="Right" Text="فهرست کارکنان فعال" Margin="4,2" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
