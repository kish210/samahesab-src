@page "/"
@using SamaHesab.SellerWeb.Services
@inject SellerApi Api

<PageTitle>پنلِ فروشِ گردشگری</PageTitle>

@if (!Api.IsLoggedIn)
{
    <div class="login-wrap">
        <div class="login-card">
            <h3 class="mb-1">سما حساب — پنلِ فروش</h3>
            <p class="text-muted small mb-3">فروشنده با کاربرِ خودش وارد می‌شود؛ فروش‌ها خودکار به‌نامِ او ثبت می‌شود.</p>
            <div class="mb-2">
                <label class="form-label small">آدرسِ سرور</label>
                <input class="form-control" @bind="_server" placeholder="http://192.168.1.10:5080" />
            </div>
            <div class="row g-2 mb-2">
                <div class="col-8">
                    <label class="form-label small">نام کاربری</label>
                    <input class="form-control" @bind="_user" />
                </div>
                <div class="col-4">
                    <label class="form-label small">شرکت</label>
                    <input class="form-control" type="number" @bind="_company" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label small">رمز عبور</label>
                <input class="form-control" type="password" @bind="_pass" @bind:event="oninput"
                       @onkeydown="@(e => { if (e.Key == "Enter") _ = DoLogin(); })" />
            </div>
            @if (_error is not null) { <div class="alert alert-danger py-2 small">@_error</div> }
            <button class="btn btn-primary w-100" @onclick="DoLogin" disabled="@_busy">
                @(_busy ? "در حال ورود…" : "ورود به سیستم")
            </button>
        </div>
    </div>
}
else
{
    <div class="panel-top">
        <div>
            <strong>@Api.Context?.FullName</strong>
            <span class="text-muted small"> · سالِ مالی @Api.Context?.FiscalYearTitle</span>
        </div>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Logout">خروج</button>
    </div>

    @if (Api.Context?.IsSeller != true)
    {
        <div class="alert alert-warning py-2 small m-2">
            این کاربر به «فروشنده» نگاشته نشده — مدیر باید در «امنیت ← کاربران» فروشنده را تعیین کند.
        </div>
    }

    <div class="sell-grid">
        <div class="products">
            @if (_products is null) { <p class="p-3 text-muted">در حال بارگذاری…</p> }
            else if (_products.Count == 0) { <p class="p-3 text-muted">محصولی تعریف نشده.</p> }
            else
            {
                @foreach (var p in _products)
                {
                    <button class="product @(p.IsSoldOut ? "soldout" : "")" disabled="@p.IsSoldOut" @onclick="() => Add(p)">
                        <div class="pname">@p.Name</div>
                        <div class="pprice">@Money(p.SalePrice)</div>
                        <div class="pcap">@(p.Capacity is null ? "نامحدود" : $"مانده: {p.Remaining}")</div>
                    </button>
                }
            }
        </div>

        <div class="cart">
            <h6 class="px-2 pt-2">سبدِ فروش</h6>
            @if (_cart.Count == 0) { <p class="text-muted small px-2">محصولی انتخاب نشده.</p> }
            else
            {
                <div class="cart-lines">
                    @foreach (var c in _cart)
                    {
                        <div class="cart-line">
                            <div class="cl-name">@c.Name</div>
                            <input class="cl-qty form-control form-control-sm" type="number" min="1"
                                   value="@c.Qty" @onchange="e => SetQty(c, e.Value?.ToString())" />
                            <div class="cl-sum">@Money(c.Qty * c.Price)</div>
                            <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => _cart.Remove(c)">✕</button>
                        </div>
                    }
                </div>
                <div class="cart-total">جمع: <strong>@Money(Total)</strong></div>
                <div class="px-2">
                    <select class="form-select form-select-sm mb-2" @bind="_payment">
                        <option value="نقدی">نقدی</option>
                        <option value="کارت">کارت</option>
                        <option value="نسیه">نسیه</option>
                    </select>
                    @if (_saleMsg is not null) { <div class="alert @(_saleOk ? "alert-success" : "alert-danger") py-1 small">@_saleMsg</div> }
                    <button class="btn btn-success w-100" @onclick="Submit" disabled="@_submitting">
                        @(_submitting ? "در حال ثبت…" : "ثبتِ فروش")
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    string _server = "http://localhost:5080";
    string _user = "", _pass = "";
    int _company = 1;
    bool _busy, _submitting, _saleOk;
    string? _error, _saleMsg, _payment = "نقدی";

    List<SellerApi.AvailabilityRow>? _products;
    readonly List<CartItem> _cart = new();
    decimal Total => _cart.Sum(c => c.Qty * c.Price);

    static string Money(decimal v) => v.ToString("#,0") + " ریال";

    async Task DoLogin()
    {
        _busy = true; _error = null;
        _error = await Api.LoginAsync(_server, _user.Trim(), _pass, _company);
        _busy = false;
        if (_error is null) await LoadProducts();
    }

    void Logout() { Api.Logout(); _cart.Clear(); _products = null; }

    async Task LoadProducts() => _products = await Api.GetAvailabilityAsync() ?? new();

    void Add(SellerApi.AvailabilityRow p)
    {
        var existing = _cart.FirstOrDefault(c => c.ProductId == p.ProductId);
        if (existing is not null) existing.Qty++;
        else _cart.Add(new CartItem { ProductId = p.ProductId, Name = p.Name, Price = p.SalePrice, Qty = 1 });
        _saleMsg = null;
    }

    void SetQty(CartItem c, string? v)
    {
        if (decimal.TryParse(v, out var q) && q > 0) c.Qty = q;
    }

    async Task Submit()
    {
        if (_cart.Count == 0) return;
        _submitting = true; _saleMsg = null;
        var lines = _cart.Select(c => new SellerApi.SaleLine(c.ProductId, c.Qty, c.Price)).ToList();
        var (ok, err, saleId) = await Api.CreateSaleAsync(_payment ?? "نقدی", lines, null, null);
        _saleOk = ok;
        _saleMsg = ok ? $"فروش ثبت شد (شناسه {saleId})." : err;
        _submitting = false;
        if (ok) { _cart.Clear(); await LoadProducts(); }
    }

    class CartItem { public int ProductId; public string Name = ""; public decimal Price; public decimal Qty; }
}
