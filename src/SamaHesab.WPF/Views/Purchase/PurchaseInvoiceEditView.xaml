<UserControl x:Class="SamaHesab.WPF.Views.Purchase.PurchaseInvoiceEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <conv:NumberFormatConverter x:Key="Num"/>
        <conv:NullToVisibilityConverter x:Key="NullVis"/>
    </UserControl.Resources>

    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- toolbar + supplier (top) -->
            <RowDefinition Height="Auto"/>   <!-- add-item line -->
            <RowDefinition Height="*"/>      <!-- products grid + summary -->
            <RowDefinition Height="Auto"/>   <!-- payment bar -->
        </Grid.RowDefinitions>

        <!-- ═══ Top: actions + supplier header ═══ -->
        <Border Grid.Row="0" Style="{StaticResource ErpToolbar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ErpToolButton}" Command="{Binding NewInvoiceCommand}">
                        <StackPanel><Path Data="{StaticResource IcFilePlus}" Style="{StaticResource ErpToolSvg}" Width="18" Height="18" HorizontalAlignment="Center" Stroke="{DynamicResource PrimaryAccent}"/><TextBlock Text="جدید" TextAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ErpToolButton}" Command="{Binding PrintCommand}">
                        <StackPanel><Path Data="{StaticResource IcPrinter}" Style="{StaticResource ErpToolSvg}" Width="18" Height="18" HorizontalAlignment="Center" Stroke="{DynamicResource SecondaryText}"/><TextBlock Text="چاپ" TextAlignment="Center"/></StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="6,6"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <Path Data="{StaticResource IcTruck}" Style="{StaticResource ErpToolSvg}" Width="20" Height="20" VerticalAlignment="Center" Stroke="{DynamicResource WarningColor}"/>
                    <TextBlock Text="تأمین‌کننده" Style="{StaticResource ErpInlineLabel}" Margin="6,0"/>
                    <ComboBox ItemsSource="{Binding Suppliers}" Width="320"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedSupplierId}"
                              IsEditable="True"

                              Height="32"/>
                    <!-- OPT-6: بجِ ماندهٔ تأمین‌کننده -->
                    <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="8,2" Margin="8,0,0,0"
                            VerticalAlignment="Center" Visibility="{Binding HasSupplierInfo, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="مانده:" Style="{StaticResource ErpInlineLabel}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SupplierBalance, Converter={StaticResource Num}}" FlowDirection="LeftToRight"
                                       FontWeight="Bold" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource DangerColor}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="انبار" Style="{StaticResource ErpInlineLabel}"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" Width="130" Height="30"
                              ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedWarehouseId}"/>
                    <TextBlock Text="تاریخ" Style="{StaticResource ErpInlineLabel}" Margin="10,0,6,0"/>
                    <TextBox Text="{Binding InvoiceDate}" Width="95"/>
                    <TextBlock Text="شماره" Style="{StaticResource ErpInlineLabel}" Margin="10,0,6,0"/>
                    <TextBox Text="{Binding InvoiceNumber}" Width="92" IsReadOnly="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Add-item line ═══ -->
        <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}" Margin="3,3,3,0" Padding="6,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="3,0">
                    <DockPanel>
                        <TextBlock Text="کالا (کد / بارکد / نام)" Style="{StaticResource FieldCaption}"/>
                        <!-- OPT-6: موجودیِ زندهٔ کالای انتخابی -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left"
                                    Visibility="{Binding SelectedProductItem, Converter={StaticResource NullVis}}">
                            <TextBlock Text="موجودی:" FontSize="10" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding EntryOnHand, Converter={StaticResource Num}}" FontSize="10.5" FontWeight="Bold" FlowDirection="LeftToRight"
                                       Margin="3,0,2,0" VerticalAlignment="Center" Foreground="{DynamicResource SuccessColor}"/>
                        </StackPanel>
                    </DockPanel>
                    <ComboBox x:Name="ProductCombo" ItemsSource="{Binding AllProducts}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedProductItem}"
                              IsEditable="True"
                              Height="32"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="3,0">
                    <TextBlock Text="مقدار" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding AddQty}" Height="32"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="3,0">
                    <TextBlock Text="قیمت خرید" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding AddUnitPrice}" Height="32"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="3,0">
                    <TextBlock Text="تخفیف ٪" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding AddDiscountPct}" Height="32"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="3,0">
                    <TextBlock Text="مالیات ٪" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding AddTaxPct}" Height="32"/>
                </StackPanel>
                <!-- OPT-6: بچ/سری + انقضا (بک‌اندش در C2-B وصل است) -->
                <StackPanel Grid.Column="5" Margin="3,0">
                    <TextBlock Text="بچ / شمارهٔ سری" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding AddBatchNumber}" Height="32"/>
                </StackPanel>
                <StackPanel Grid.Column="6" Margin="3,0">
                    <TextBlock Text="انقضا" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding AddExpiryDate}" Height="32" FlowDirection="LeftToRight" TextAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="7" Margin="3,0" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Command="{Binding AddSelectedProductCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcPlus}" Style="{StaticResource ErpToolSvg}" Width="16" Height="16" VerticalAlignment="Center" Stroke="White"/>
                            <TextBlock Text="افزودن" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Center: products grid + financial summary ═══ -->
        <Grid Grid.Row="2" Margin="0,3,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ErpCardPanel}" Padding="0">
                <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" ItemsSource="{Binding InvoiceItems}" SelectedItem="{Binding SelectedItem}"
                          RowHeight="28"
                          GridLinesVisibility="All">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ردیف" Binding="{Binding RowNumber}" Width="48" IsReadOnly="True"/>
                        <DataGridTextColumn Header="کد" Binding="{Binding ProductCode}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="نام کالا" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="موجودی" Binding="{Binding StockOnHand, StringFormat={}{0:#,##0}}" Width="72" IsReadOnly="True"/>
                        <DataGridTextColumn Header="مقدار" Binding="{Binding Quantity}" Width="80">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="قیمت خرید" Binding="{Binding UnitPrice}" Width="110">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="تخفیف ٪" Binding="{Binding DiscountPct}" Width="70">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="مالیات ٪" Binding="{Binding TaxPct}" Width="70">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="بچ/سری" Binding="{Binding BatchNumber}" Width="100"/>
                        <DataGridTextColumn Header="انقضا" Binding="{Binding ExpiryDate}" Width="90"/>
                        <DataGridTextColumn Header="مبلغ خالص" Binding="{Binding NetAmount, StringFormat={}{0:#,##0}}" Width="130" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="حذف" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ErpToolButton}" Width="34" Height="26"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IcTrash}" Style="{StaticResource ErpToolSvg}" Width="16" Height="16" Stroke="{DynamicResource DangerColor}"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource ErpCardPanel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource ErpPanelHeader}">
                        <TextBlock Text="خلاصه مالی خرید" FontWeight="Bold" FontSize="12"/></Border>
                    <StackPanel Margin="10,8">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="نوع" Style="{StaticResource ErpInlineLabel}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource BaseComboBox}" Height="28" ItemsSource="{Binding InvoiceTypes}" SelectedItem="{Binding InvoiceType}"/>
                        </Grid>
                        <Separator Margin="0,6"/>
                        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="جمع کل" Foreground="{DynamicResource SecondaryText}"/><TextBlock DockPanel.Dock="Left" Text="{Binding SubTotal, StringFormat={}{0:#,##0}}"/></DockPanel>
                        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="تخفیف" Foreground="{DynamicResource SecondaryText}"/><TextBlock DockPanel.Dock="Left" Text="{Binding TotalDiscount, StringFormat={}{0:#,##0}}" Foreground="{DynamicResource DangerColor}"/></DockPanel>
                        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="مالیات" Foreground="{DynamicResource SecondaryText}"/><TextBlock DockPanel.Dock="Left" Text="{Binding TotalTax, StringFormat={}{0:#,##0}}"/></DockPanel>
                        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="هزینه حمل" Foreground="{DynamicResource SecondaryText}"/><TextBox DockPanel.Dock="Left" Width="120" Text="{Binding Shipping}" Height="28"/></DockPanel>
                        <Separator Margin="0,8"/>
                        <DockPanel Margin="0,3">
                            <TextBlock DockPanel.Dock="Right" Text="قابل پرداخت" FontWeight="Bold" FontSize="14"/>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding GrandTotal, StringFormat={}{0:#,##0}}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryAccent}"/>
                        </DockPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ Bottom: payment bar ═══ -->
        <Border Grid.Row="3" Style="{StaticResource ErpToolbar}" BorderThickness="0,1,0,0">
            <Grid Margin="4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IcCash}" Style="{StaticResource ErpToolSvg}" Width="20" Height="20" VerticalAlignment="Center" Stroke="{DynamicResource WarningColor}"/>
                    <TextBlock Text="نحوه پرداخت" Style="{StaticResource ErpInlineLabel}" Margin="6,0"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" Width="120" Height="30" ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding PaymentType}"/>
                    <TextBlock Text="پرداختی" Style="{StaticResource ErpInlineLabel}" Margin="12,0,6,0"/>
                    <TextBox Text="{Binding PaidAmount}" Width="140" Height="30"/>
                    <TextBlock Text="سررسید" Style="{StaticResource ErpInlineLabel}" Margin="12,0,6,0"/>
                    <TextBox Text="{Binding DueDate}" Width="95"/>
                    <TextBlock Text="مانده" Style="{StaticResource ErpInlineLabel}" Margin="12,0,6,0"/>
                    <TextBlock Text="{Binding RemainAmount, StringFormat={}{0:#,##0}}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource DangerColor}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource SuccessButton}" Height="40" Padding="24,0" Command="{Binding PostInvoiceCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IcCheck}" Style="{StaticResource ErpToolSvg}" Width="20" Height="20" VerticalAlignment="Center" Stroke="White"/>
                        <TextBlock Text="ثبت قطعی فاکتور خرید" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
