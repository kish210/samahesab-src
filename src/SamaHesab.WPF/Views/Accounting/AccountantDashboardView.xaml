<UserControl x:Class="SamaHesab.WPF.Views.Accounting.AccountantDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <!-- کاشیِ KPI کلیک‌پذیر -->
        <Style x:Key="Kpi" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Width" Value="210"/>
            <Setter Property="Height" Value="104"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="16,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KpiVal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryAccent}"/>
        </Style>
        <Style x:Key="KpiCap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="6,0,6,12" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right">
                <TextBlock Text="داشبورد حسابدار" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                <TextBlock Text="{Binding TodayText, StringFormat='امروز: {0}'}" FontSize="12.5" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Left" Content="بروزرسانی" Command="{Binding RefreshCommand}" VerticalAlignment="Center"
                    Padding="14,6" Cursor="Hand" BorderThickness="1"
                    Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}"
                    BorderBrush="{DynamicResource BorderColor}"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel>
                <Button Style="{StaticResource Kpi}" Command="{Binding OpenVouchersCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiCap}" Text="اسنادِ پیش‌نویس"/>
                        <TextBlock Style="{StaticResource KpiVal}" Text="{Binding DraftVouchers, Converter={StaticResource Num}, ConverterParameter=سند}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Kpi}" Command="{Binding OpenReceivablesCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiCap}" Text="جمعِ دریافتنی"/>
                        <TextBlock Style="{StaticResource KpiVal}" FontSize="20" Foreground="#2E7D52" Text="{Binding ReceivablesTotal, Converter={StaticResource Num}, ConverterParameter=ریال}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Kpi}" Command="{Binding OpenReceivablesCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiCap}" Text="جمعِ پرداختنی"/>
                        <TextBlock Style="{StaticResource KpiVal}" FontSize="20" Foreground="#C2403A" Text="{Binding PayablesTotal, Converter={StaticResource Num}, ConverterParameter=ریال}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Kpi}" Command="{Binding OpenChequesCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiCap}" Text="چک‌های در جریان"/>
                        <TextBlock Style="{StaticResource KpiVal}" Text="{Binding ChequesInProcess, Converter={StaticResource Num}, ConverterParameter=فقره}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Kpi}" Command="{Binding OpenChequesCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiCap}" Text="چکِ سررسیدِ امروز"/>
                        <TextBlock Style="{StaticResource KpiVal}" Foreground="#C9911B" Text="{Binding ChequesDueToday, Converter={StaticResource Num}, ConverterParameter=فقره}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Kpi}" Command="{Binding OpenChequesCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiCap}" Text="چکِ سررسیدگذشته"/>
                        <TextBlock Style="{StaticResource KpiVal}" Foreground="#C2403A" Text="{Binding ChequesOverdue, Converter={StaticResource Num}, ConverterParameter=فقره}"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
