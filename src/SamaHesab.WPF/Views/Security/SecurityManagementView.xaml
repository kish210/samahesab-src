<UserControl x:Class="SamaHesab.WPF.Views.Security.SecurityManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <Style x:Key="SLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="SInput" TargetType="TextBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style x:Key="SPrimary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="RowHeight" Value="29"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="امنیت و دسترسی" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
            <TextBlock Text="مدیریت نقش‌ها و مجوزهای دانه‌ریز و تخصیص نقش به کاربران (RBAC)."
                       Foreground="{DynamicResource SecondaryText}" FontSize="12.5" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- ═══ نقش‌ها و مجوزها ═══ -->
            <TabItem Header="نقش‌ها و مجوزها">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- فهرست نقش‌ها + ساخت نقش -->
                    <DockPanel Grid.Column="0">
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="نقش جدید" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8"/>
                                <TextBlock Text="کد (مثل ACCOUNTANT)" Style="{StaticResource SLabel}"/>
                                <TextBox Text="{Binding NewRoleCode}" Style="{StaticResource SInput}"/>
                                <TextBlock Text="نام" Style="{StaticResource SLabel}"/>
                                <TextBox Text="{Binding NewRoleName}" Style="{StaticResource SInput}"/>
                                <Button Content="ساخت نقش" Style="{StaticResource SPrimary}" HorizontalAlignment="Left"
                                        Command="{Binding SaveRoleCommand}"/>
                            </StackPanel>
                        </Border>
                        <DataGrid Style="{StaticResource SGrid}" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="110"/>
                                <DataGridTextColumn Header="نام نقش" Binding="{Binding Name}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- مجوزهای نقش انتخاب‌شده -->
                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="10" Padding="14">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="مجوزهای نقش" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{DynamicResource PrimaryText}"/>
                                <Button DockPanel.Dock="Left" Content="ذخیرهٔ مجوزها" Style="{StaticResource SPrimary}"
                                        Command="{Binding SaveRolePermissionsCommand}"/>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Permissions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}" Margin="8,3"
                                                      Foreground="{DynamicResource PrimaryText}" FontSize="12.5">
                                                <TextBlock><Run Text="{Binding Module, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" — "/><Run Text="{Binding Label, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Code, Mode=OneWay}" Foreground="{DynamicResource MutedText}"/></TextBlock>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ کاربران و نقش‌ها ═══ -->
            <TabItem Header="کاربران">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <!-- جست‌وجوی کاربر (نام کاربری/نام) -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Background="{DynamicResource InputBackground}"
                                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="6">
                            <TextBox Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"
                                     BorderThickness="0" Padding="10,7" Foreground="{DynamicResource PrimaryText}"
                                     materialDesign:HintAssist.Hint="🔍 جست‌وجوی کاربر…" FontFamily="{StaticResource VazirFont}"/>
                        </Border>
                        <DataGrid Style="{StaticResource SGrid}" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="نام کاربری" Binding="{Binding Username}" Width="150"/>
                                <DataGridTextColumn Header="نام کامل" Binding="{Binding FullName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="10" Padding="14">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="نقش‌های کاربر" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"/>
                                <Button DockPanel.Dock="Left" Content="ذخیره" Style="{StaticResource SPrimary}"
                                        Command="{Binding SaveUserRolesCommand}"/>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding UserRoleChecks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Title}"
                                                      Margin="4,4" Foreground="{DynamicResource PrimaryText}" FontSize="12.5"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
