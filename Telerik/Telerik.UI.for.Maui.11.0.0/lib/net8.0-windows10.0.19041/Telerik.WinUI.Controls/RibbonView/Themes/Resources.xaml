<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Telerik.Core"
    xmlns:telerik="using:Telerik.UI.Xaml.Controls"
    xmlns:telerikRibbonViewPrimitives="using:Telerik.UI.Xaml.Controls.RibbonView.Primitives"
    xmlns:telerikRibbonKeyTips="using:Telerik.UI.Xaml.Controls.RibbonView.KeyTips"
    xmlns:telerikPrimitives="using:Telerik.UI.Xaml.Controls.Primitives">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/Themes/CommonThemeResources.xaml"/>

        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark" Source="ms-appx:///Telerik.WinUI.Controls/RibbonView/Themes/ThemeResourcesDark.xaml"/>
                <ResourceDictionary x:Key="Light" Source="ms-appx:///Telerik.WinUI.Controls/RibbonView/Themes/ThemeResourcesLight.xaml"/>
                <ResourceDictionary x:Key="HighContrast" Source="ms-appx:///Telerik.WinUI.Controls/RibbonView/Themes/ThemeResourcesHighContrast.xaml"/>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>

        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark" Source="{CustomResource DarkResourcesPath}"/>
                <ResourceDictionary x:Key="Light" Source="{CustomResource LightResourcesPath}"/>
                <ResourceDictionary x:Key="HighContrast" Source="{CustomResource HighContrastResourcesPath}"/>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>

    <!--#region Converters-->
    <core:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <core:CornerRadiusConverter x:Key="CornerRadiusConverter" />
    <core:ThicknessToOrientedThicknessConverter x:Key="ThicknessToOrientedThicknessConverter" />
    <!--#endregion-->

    <!--#region Sizes, offsets, opacities and corner radius-->
    <x:Double x:Key="TelerikRibbonView_FontSize">14</x:Double>
    <x:Double x:Key="TelerikRibbonView_IconFontSize">12</x:Double>
    <x:Double x:Key="TelerikRibbonView_ContentHeight">140</x:Double>
    <Thickness x:Key="TelerikRibbonView_Padding">4</Thickness>

    <Thickness x:Key="TelerikRibbonView_WindowTitleMargin">0 10</Thickness>

    <GridLength x:Key="TelerikRibbonView_TabStripMinHeight">32</GridLength>

    <Thickness x:Key="TelerikRibbonView_RibbonTab_Padding">10 0</Thickness>

    <CornerRadius x:Key="TelerikRibbonView_Button_CornerRadius">4</CornerRadius>
    <x:Double x:Key="TelerikRibbonView_Button_MinSize">24</x:Double>
    <Thickness x:Key="TelerikRibbonView_Button_Padding">6</Thickness>

	<Thickness x:Key="TelerikRibbonView_MinimizeButton_Margin">0</Thickness>
    <Thickness x:Key="TelerikRibbonView_HelpButton_Margin">0 0 0 0</Thickness>

    <Thickness x:Key="TelerikRibbonView_Backstage_ItemPadding">16 0</Thickness>

    <CornerRadius x:Key="TelerikRibbonView_Gallery_CornerRadius">4</CornerRadius>
    <x:Double x:Key="TelerikRibbonView_Gallery_ButtonMinSize">32</x:Double>

    <x:Double x:Key="TelerikRibbonView_QuickAccessToolbar_BelowRibbonMinHeight">32</x:Double>
    <!--#endregion-->

    <!--#region KeyTips-->
    <ControlTemplate x:Key="KeyTipControlTemplate" TargetType="telerikRibbonKeyTips:KeyTipControl">
        <Grid Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Margin="{TemplateBinding Padding}"/>
        </Grid>
    </ControlTemplate>

    <Style x:Key="KeyTipControlStyle" TargetType="telerikRibbonKeyTips:KeyTipControl">
        <Setter Property="Template" Value="{StaticResource KeyTipControlTemplate}"/>
        <Setter Property="Foreground" Value="{ThemeResource TelerikRibbonView_KeyTip_Foreground}"/>
        <Setter Property="Background" Value="{ThemeResource TelerikRibbonView_KeyTip_Background}"/>
        <Setter Property="Padding" Value="2 -2 2 -1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="MinWidth" Value="16"/>
        <Setter Property="MinHeight" Value="16"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style TargetType="telerikRibbonKeyTips:KeyTipControl" BasedOn="{StaticResource KeyTipControlStyle}"/>
    <!--#endregion-->

    <!--#region WindowTitle-->
    <Style x:Key="WindowTitleStyle" TargetType="telerikRibbonViewPrimitives:WindowTitle">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Margin" Value="{ThemeResource TelerikRibbonView_WindowTitleMargin}"/>
        <Setter Property="Foreground" Value="{ThemeResource TelerikRibbonView_HeaderForeground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="false"/>
        <Setter Property="IsActive" Value="True"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="telerikRibbonViewPrimitives:WindowTitle">
                    <telerikRibbonViewPrimitives:WindowTitlePanel Background="{TemplateBinding Background}">
                        <TextBlock x:Name="Title" Text="{TemplateBinding Title}" Foreground="{TemplateBinding Foreground}" TextTrimming="WordEllipsis"/>
                        <TextBlock x:Name="Divider"
                                   Text="-" Margin="4 0"
                                   Visibility="{TemplateBinding DividerVisibility}"
                                   Foreground="{TemplateBinding Foreground}"/>
                        <TextBlock x:Name="ApplicationName" Text="{TemplateBinding ApplicationName}" Foreground="{TemplateBinding Foreground}" TextTrimming="WordEllipsis"/>
                    </telerikRibbonViewPrimitives:WindowTitlePanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="telerikRibbonViewPrimitives:WindowTitle" BasedOn="{StaticResource WindowTitleStyle}"/>
    <!--#endregion-->

    <Style x:Key="HelpButtonStyle" TargetType="telerik:RadRibbonButton">
        <Setter Property="Foreground" Value="{ThemeResource TelerikRibbonView_IconForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource TelerikRibbonView_FocusVisualPrimaryBrush}"/>
        <Setter Property="Padding" Value="{ThemeResource TelerikRibbonView_Button_Padding}" />
        <Setter Property="Margin" Value="{ThemeResource TelerikRibbonView_HelpButton_Margin}" />
        <Setter Property="CornerRadius" Value="{ThemeResource TelerikRibbonView_Button_CornerRadius}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <ControlTemplate x:Key="MinimizeButtonTemplate" TargetType="telerik:RadRibbonToggleButton">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PointerOverVisual"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PressedVisual"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Checked"/>
                    <VisualState x:Name="CheckedPointerOver">
                        <Storyboard>
                            <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PointerOverVisual"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="CheckedPressed">
                        <Storyboard>
                            <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PressedVisual"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="DisabledVisual"/>
                            <DoubleAnimation Duration="0" To="{ThemeResource TelerikControlDisabledOpacity}" Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="CheckedDisabled">
                        <Storyboard>
                            <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="DisabledVisual"/>
                            <DoubleAnimation Duration="0" To="{ThemeResource TelerikControlDisabledOpacity}" Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="KeyboardNavigationStates">
                    <VisualState x:Name="KeyboardUnfocused"/>
                    <VisualState x:Name="KeyboardFocused">
                        <Storyboard>
                            <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="KeyboardNavigationVisual"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="NormalVisual"
                    Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"/>
            <Border x:Name="PointerOverVisual"
                    Background="{ThemeResource TelerikRibbonView_Button_BackgroundPointerOver}"
                    BorderBrush="{ThemeResource TelerikRibbonView_Button_BorderBrushPointerOver}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0"/>
            <Border x:Name="PressedVisual"
                    Background="{ThemeResource TelerikRibbonView_Button_BackgroundPressed}"
                    BorderBrush="{ThemeResource TelerikRibbonView_Button_BorderBrushPressed}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0"/>
            <Border x:Name="KeyboardNavigationVisual"
                    Background="{ThemeResource TelerikRibbonView_KeyboardNavigationVisual_Background}"
                    Opacity="0"/>
            <Border x:Name="DisabledVisual"
                    Background="{ThemeResource TelerikRibbonView_Button_BackgroundDisabled}"
                    BorderBrush="{ThemeResource TelerikRibbonView_Button_BorderBrushDisabled}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0"/>
            <ContentPresenter x:Name="ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              ContentTransitions="{TemplateBinding ContentTransitions}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Grid>
    </ControlTemplate>
    <Style x:Key="MinimizeButtonStyle" TargetType="telerik:RadRibbonToggleButton">
        <Setter Property="Template" Value="{StaticResource MinimizeButtonTemplate}" />
        <Setter Property="FontSize" Value="{ThemeResource TelerikRibbonView_IconFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TelerikRibbonView_IconForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{ThemeResource TelerikRibbonView_Button_Padding}" />
        <Setter Property="Margin" Value="{ThemeResource TelerikRibbonView_MinimizeButton_Margin}" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource TelerikRibbonView_FocusVisualPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="{ThemeResource TelerikRibbonView_Button_CornerRadius}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--#region RibbonView -->
    <Style TargetType="telerik:RadRibbonView">
        <Setter Property="Padding" Value="8 8 8 10"/>
        <Setter Property="CornerRadius" Value="{ThemeResource TelerikOverlayCornerRadius}"/>
        <Setter Property="LayoutModeButtonContent" Value="Simplified Ribbon" />
        <Setter Property="Background" Value="{ThemeResource TelerikRibbonView_Background}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TelerikRibbonView_BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="TitleBarBackground" Value="{ThemeResource TelerikRibbonView_HeaderBackground}"/>
        <Setter Property="ContentHeight" Value="{ThemeResource TelerikRibbonView_ContentHeight}"/>
        <Setter Property="SimplifiedContentHeight" Value="54" />
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="WindowTitleStyle" Value="{StaticResource WindowTitleStyle}"/>
        <Setter Property="MinimizeButtonStyle" Value="{StaticResource MinimizeButtonStyle}"/>
        <Setter Property="HelpButtonStyle" Value="{StaticResource HelpButtonStyle}" />
        <Setter Property="HelpButtonIcon">
            <Setter.Value>
                <FontIcon Foreground="{ThemeResource TelerikRibbonView_IconForeground}"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="{ThemeResource TelerikRibbonView_IconFontSize}"
                          Glyph="&#xE897;"/>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <telerikRibbonViewPrimitives:RibbonTabStripPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="telerik:RadRibbonView">
                    <Grid x:Name="RootPanel"
                          RowDefinitions="Auto,Auto,Auto">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="MinimizedPopupOpen">
                                    <VisualState.Setters>
                                        <Setter Target="MinimizeButtonIcon.Glyph" Value="&#xE718;"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="MinimizedPopupOpenTitleBarCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="MinimizeButtonIcon.Glyph" Value="&#xE718;"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="MinimizedTitleBarCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="MinimizeButtonIcon.Glyph" Value="&#xE718;"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Minimized">
                                    <VisualState.Setters>
                                        <Setter Target="MinimizeButtonIcon.Glyph" Value="&#xE718;"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="MaximizedTitleBarCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="MinimizeButtonIcon.Glyph" Value="&#xE0E4;"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Maximized">
                                    <VisualState.Setters>
                                        <Setter Target="MinimizeButtonIcon.Glyph" Value="&#xE0E4;"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid Grid.Row="1"
                              Background="{TemplateBinding Background}"
                              Padding="0 4 0 0">
                            <ContentPresenter x:Name="SelectedTabContent"
                                              Background="{ThemeResource TelerikRibbonView_ContentBackground}"
                                              Height="{TemplateBinding ContentHeight}"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Margin="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Padding,
                                              Converter={StaticResource ThicknessToOrientedThicknessConverter}, ConverterParameter=LeftRightBottom}"
                                              Translation="0,0,10">
                                <ContentPresenter.Shadow>
                                    <ThemeShadow/>
                                </ContentPresenter.Shadow>
                            </ContentPresenter>
                        </Grid>
                        <Grid x:Name="TopGrid"
                              ColumnDefinitions="Auto,*,Auto"
                              Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="{ThemeResource TelerikRibbonView_TabStripMinHeight}"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="titleBarBackground" Grid.ColumnSpan="3"
                                    Background="{TemplateBinding TitleBarBackground}"
                                    IsHitTestVisible="False"/>
                            <Border x:Name="belowTitleBarBorder" Grid.Row="1" Grid.ColumnSpan="3" Background="{TemplateBinding Background}"/>
                            <telerikRibbonViewPrimitives:RibbonTitleBarPanel x:Name="RibbonTitleBarPanel" Grid.ColumnSpan="3" Visibility="{TemplateBinding TitleBarVisibility}">
                                <ContentPresenter x:Name="AboveToolBarHost" VerticalAlignment="Center" telerikRibbonViewPrimitives:RibbonTitleBarPanel.Element="QuickAccessToolBar"/>
                                <telerikRibbonViewPrimitives:WindowTitle x:Name="WindowTitle"
                                                                         Title="{TemplateBinding Title}"
                                                                         telerikRibbonViewPrimitives:RibbonTitleBarPanel.Element="WindowTitle"
                                                                         ApplicationName="{TemplateBinding ApplicationName}"
                                                                         Style="{TemplateBinding WindowTitleStyle}"/>
                                <StackPanel x:Name="ContextualGroupsHeaders" Orientation="Horizontal" telerikRibbonViewPrimitives:RibbonTitleBarPanel.Element="ContextualGroupsPanel"/>
                            </telerikRibbonViewPrimitives:RibbonTitleBarPanel>
                            <telerik:RadRibbonApplicationDropDownButton x:Name="ApplicationButton" Grid.Row="1"
                                                                        IsEnabled="{TemplateBinding IsApplicationButtonEnabled}"
                                                                        SmallIcon="{TemplateBinding ApplicationButtonIcon}"
                                                                        Content="{TemplateBinding ApplicationButtonContent}"
                                                                        Visibility="{TemplateBinding ApplicationButtonVisibility}"
                                                                        Margin="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Padding,
                                                                        Converter={StaticResource ThicknessToOrientedThicknessConverter}, ConverterParameter=Left}"
                                                                        Style="{TemplateBinding ApplicationButtonStyle}"/>
                            <telerikRibbonViewPrimitives:RibbonScrollViewer x:Name="TabsScrollViewer" Grid.Column="1" Grid.Row="1">
                                <ItemsPresenter/>
                            </telerikRibbonViewPrimitives:RibbonScrollViewer>
                            <StackPanel Orientation="Horizontal" Grid.Column="2" Grid.Row="1">
                                <ToggleSwitch IsOn="False" x:Name="SimplifiedStateButton" Margin="7 0"/>
                                <telerik:RadRibbonToggleButton x:Name="MinimizeButton"
                                                               MinHeight="0"
                                                               Style="{TemplateBinding MinimizeButtonStyle}"
                                                               Visibility="{TemplateBinding MinimizeButtonVisibility}"
                                                               IsEnabled="{TemplateBinding IsMinimizable}"
                                                               IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMinimized, Mode=TwoWay}">
                                    <FontIcon x:Name="MinimizeButtonIcon"
                                              Foreground="{ThemeResource TelerikRibbonView_IconForeground}"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="{ThemeResource TelerikRibbonView_IconFontSize}"
                                              Glyph="&#xE0E4;"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </telerik:RadRibbonToggleButton>
                                <telerik:RadRibbonButton x:Name="HelpButton"
                                                         MinHeight="0"
                                                         Content="{TemplateBinding HelpButtonIcon}"
                                                         Command="{TemplateBinding HelpCommand}"
                                                         CommandParameter="{TemplateBinding HelpCommandParameter}"
                                                         Visibility="{TemplateBinding HelpButtonVisibility}"
                                                         Style="{TemplateBinding HelpButtonStyle}"
                                                         Margin="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Padding,
                                                         Converter={StaticResource ThicknessToOrientedThicknessConverter}, ConverterParameter=Right}"/>
                                <ContentPresenter Content="{TemplateBinding TabStripAdditionalContent}"/>
                            </StackPanel>
                        </Grid>
                        <ContentPresenter x:Name="BelowToolBarHost" Grid.Row="2"/>
                        <Popup x:Name="TabContentPopup" VerticalOffset="-1">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter x:Name="SelectedTabContentPopup"
                                                  Background="{ThemeResource TelerikRibbonView_ContentBackground}"
                                                  Height="{TemplateBinding ContentHeight}"
                                                  CornerRadius="{TemplateBinding CornerRadius}"
                                                  Margin="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Padding,
                                                  Converter={StaticResource ThicknessToOrientedThicknessConverter}, ConverterParameter=LeftRightBottom}"
                                                  Translation="0,0,10">
                                    <ContentPresenter.Shadow>
                                        <ThemeShadow/>
                                    </ContentPresenter.Shadow>
                                </ContentPresenter>
                                
                            </Grid>
                        </Popup>
                        <Popup x:Name="BackstagePopup">
                            <Canvas x:Name="BackstageArea"/>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#region RibbonTab-->
    <ControlTemplate x:Key="RadRibbonTabTemplate" TargetType="telerik:RadRibbonTab">
        <Grid x:Name="RootPanel">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="MouseOver">
                        <VisualState.Setters>
                            <Setter Target="HorizontalPill.Stroke" Value="{ThemeResource TelerikRibbonView_RibbonTab_BorderBrushPointerOver}"/>
                            <Setter Target="BorderVisual.Background" Value="{ThemeResource TelerikRibbonView_RibbonTab_BackgroundPointerOver}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Target="HorizontalPill.Stroke" Value="{ThemeResource TelerikRibbonView_RibbonTab_BorderBrushSelected}"/>
                            <Setter Target="HeaderElement.FontWeight" Value="SemiBold"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SelectedMouseOver">
                        <VisualState.Setters>
                            <Setter Target="HorizontalPill.Stroke" Value="{ThemeResource TelerikRibbonView_RibbonTab_BorderBrushSelected}"/>
                            <Setter Target="HorizontalPill.Margin" Value="0"/>
                            <Setter Target="HeaderElement.FontWeight" Value="SemiBold"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="EnabledStates">
                    <VisualState x:Name="Enabled"/>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="HeaderElement.Opacity" Value="{ThemeResource TelerikControlDisabledOpacity}"/>
                            <Setter Target="BorderVisual.Background" Value="{ThemeResource TelerikRibbonView_RibbonTab_BackgroundDisabled}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="ContextualTabStates">
                    <VisualState x:Name="NotContextualTab">
                        <VisualState.Setters>
                            <Setter Target="HeaderPanel.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="ActiveContextualTab">
                        <VisualState.Setters>
                            <Setter Target="HeaderPanel.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="InactiveContextualTab">
                        <VisualState.Setters>
                            <Setter Target="HeaderPanel.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="KeyboardNavigationStates">
                    <VisualState x:Name="KeyboardUnfocused"/>
                    <VisualState x:Name="KeyboardFocused">
                        <VisualState.Setters>
                            <Setter Target="KeyboardNavigationVisual.Opacity" Value="1"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid x:Name="ContentPanel" Width="0" Height="0">
                <Border x:Name="OuterBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CornerRadius}">
                    <telerikRibbonViewPrimitives:RibbonScrollViewer x:Name="TabItemsScrollViewer" CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <ItemsPresenter x:Name="DefaultItemsPresenter" HorizontalAlignment="Left" Margin="2" />
                            <ItemsControl x:Name="PART_SimplifiedItemsControl" Visibility="Collapsed" ItemsSource="{Binding SimplifiedItems, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <telerikRibbonViewPrimitives:RibbonGroupsPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </telerikRibbonViewPrimitives:RibbonScrollViewer>
                </Border>
            </Grid>
            <Grid x:Name="HeaderPanel"
                  Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HeaderVisibility, Mode=TwoWay}">
                <Border x:Name="BorderVisual" Background="{TemplateBinding Background}"/>
                <Border x:Name="KeyboardNavigationVisual" Background="{ThemeResource TelerikRibbonView_KeyboardNavigationVisual_Background}" Opacity="0" />
                <ContentControl x:Name="HeaderElement"
                                IsTabStop="False"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Margin="{TemplateBinding Padding}"/>
                <Rectangle x:Name="HorizontalPill"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Bottom"
                           RadiusX="2" RadiusY="2" Height="2"
                           Margin="{Binding ElementName=HeaderElement, Path=Margin}"/>
            </Grid>
        </Grid>
    </ControlTemplate>
    <Style x:Key="RadRibbonTabStyle" TargetType="telerik:RadRibbonTab">
        <Setter Property="CornerRadius" Value="{ThemeResource TelerikControlCornerRadius}"/>
        <Setter Property="FontSize" Value="{ThemeResource TelerikRibbonView_FontSize}"/>
        <Setter Property="Foreground" Value="{ThemeResource TelerikRibbonView_RibbonTab_Foreground}"/>
        <Setter Property="Background" Value="{ThemeResource TelerikRibbonView_RibbonTab_Background}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TelerikRibbonView_RibbonTab_BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="{ThemeResource TelerikRibbonView_RibbonTab_Padding}"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template" Value="{StaticResource RadRibbonTabTemplate}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <telerikRibbonViewPrimitives:RibbonGroupsPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="telerik:RadRibbonTab" BasedOn="{StaticResource RadRibbonTabStyle}"/>
