<UserControl x:Class="SamaHesab.WPF.Views.Accounting.VoucherListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             Background="{DynamicResource AppBackground}"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource RibbonBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ سند جدید" Style="{StaticResource PrimaryButton}"
                        Height="36" Margin="0,0,6,0" Command="{Binding NewVoucherCommand}"/>
                <Button Content="✏ ویرایش" Style="{StaticResource SecondaryButton}"
                        Height="36" Margin="0,0,6,0" Command="{Binding EditVoucherCommand}"/>
                <Button Content="✓ قطعی کردن" Style="{StaticResource SuccessButton}"
                        Height="36" Margin="0,0,6,0" Command="{Binding PostVoucherCommand}"/>
                <Button Content="🖨 چاپ" Style="{StaticResource SecondaryButton}"
                        Height="36" Margin="0,0,6,0" Command="{Binding PrintVoucherCommand}"/>
                <Separator Width="1" Background="{DynamicResource BorderColor}" Margin="6,4"/>
                <Button Content="↻ بروزرسانی" Style="{StaticResource SecondaryButton}"
                        Height="36" Command="{Binding SearchCommand}"/>
            </StackPanel>
        </Border>

        <!-- Filters -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" Padding="16,10"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="از تاریخ:" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryText}"
                           FontFamily="{StaticResource VazirFont}" Margin="0,0,8,0"/>
                <Border Background="{DynamicResource InputBackground}"
                        BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1" CornerRadius="4" Margin="0,0,12,0">
                    <TextBox Text="{Binding FromDate}" Background="Transparent"
                             BorderThickness="0" Padding="10,6" Width="120"
                             Foreground="{DynamicResource PrimaryText}"
                             FontFamily="{StaticResource VazirFont}"/>
                </Border>
                <TextBlock Text="تا تاریخ:" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryText}"
                           FontFamily="{StaticResource VazirFont}" Margin="0,0,8,0"/>
                <Border Background="{DynamicResource InputBackground}"
                        BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1" CornerRadius="4" Margin="0,0,12,0">
                    <TextBox Text="{Binding ToDate}" Background="Transparent"
                             BorderThickness="0" Padding="10,6" Width="120"
                             Foreground="{DynamicResource PrimaryText}"
                             FontFamily="{StaticResource VazirFont}"/>
                </Border>
                <TextBlock Text="وضعیت:" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryText}"
                           FontFamily="{StaticResource VazirFont}" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding StatusOptions}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedStatus}"
                          Width="120" Margin="0,0,12,0">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource BaseComboBox}">
                            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <Border Background="{DynamicResource InputBackground}"
                        BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
                    <TextBox Text="{Binding SearchText}" Background="Transparent"
                             BorderThickness="0" Padding="10,6" Width="200"
                             Foreground="{DynamicResource PrimaryText}"
                             FontFamily="{StaticResource VazirFont}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Border>
                <Button Content="جستجو" Style="{StaticResource PrimaryButton}"
                        Height="34" Command="{Binding SearchCommand}"/>
            </StackPanel>
        </Border>

        <!-- Summary -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBackground}" Padding="16,8"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource SecondaryText}"
                           FontFamily="{StaticResource VazirFont}">
                    <Run Text="تعداد اسناد: "/>
                    <Run Text="{Binding TotalCount}" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold"/>
                    <Run Text="  |  جمع بدهکار: "/>
                    <Run Text="{Binding TotalDebit, StringFormat='{}{0:N0}'}"
                         Foreground="{DynamicResource InfoColor}" FontWeight="Bold"/>
                    <Run Text="  |  جمع بستانکار: "/>
                    <Run Text="{Binding TotalCredit, StringFormat='{}{0:N0}'}"
                         Foreground="{DynamicResource SuccessColor}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Data Grid -->
        <telerik:RadGridView Grid.Row="3"
                  ItemsSource="{Binding Vouchers}"
                  SelectedItem="{Binding SelectedVoucher}"
                  AutoGenerateColumns="False" ShowSearchPanel="True" CanUserInsertRows="False" CanUserDeleteRows="False"
                  RowIndicatorVisibility="Collapsed" ShowGroupPanel="True"
                  FontFamily="{StaticResource VazirFont}">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="شماره سند" DataMemberBinding="{Binding VoucherNumber}" Width="110"/>
                <telerik:GridViewDataColumn Header="تاریخ" DataMemberBinding="{Binding VoucherDate}" Width="100"/>
                <telerik:GridViewDataColumn Header="نوع" DataMemberBinding="{Binding VoucherTypeName}" Width="100"/>
                <telerik:GridViewDataColumn Header="شرح" DataMemberBinding="{Binding Description}" Width="*"/>
                <telerik:GridViewDataColumn Header="بدهکار" DataMemberBinding="{Binding TotalDebit}" DataFormatString="{}{0:N0}" Width="130"/>
                <telerik:GridViewDataColumn Header="بستانکار" DataMemberBinding="{Binding TotalCredit}" DataFormatString="{}{0:N0}" Width="130"/>
                <telerik:GridViewDataColumn Header="وضعیت" Width="90" IsReadOnly="True">
                    <telerik:GridViewDataColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1A2A4B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusName}" Value="قطعی">
                                                <Setter Property="Background" Value="#1A3A2B"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusName}" Value="دائمی">
                                                <Setter Property="Background" Value="#2A1A3B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusName}" FontSize="12"
                                           FontFamily="{StaticResource VazirFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource StatusDraft}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusName}" Value="قطعی">
                                                    <Setter Property="Foreground" Value="{DynamicResource StatusPosted}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusName}" Value="دائمی">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </telerik:GridViewDataColumn.CellTemplate>
                </telerik:GridViewDataColumn>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
