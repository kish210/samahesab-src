        <Setter Property="Foreground" Value="{ThemeResource TelerikTabControl_IconForeground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Content" Value="&#xE70D;"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Width" Value="{ThemeResource TelerikTabControl_DropDownButtonWidth}"/>
    </Style>

    <ControlTemplate x:Key="TabControlTemplate" TargetType="local:RadTabControl">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="ContentBorder.BorderBrush" Value="{ThemeResource TelerikTabControl_BorderBrush_Disabled}"/>
                            <Setter Target="AdditionalContentElement.Opacity" Value="{ThemeResource TelerikControlDisabledOpacity}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="PlacementStates">
                    <VisualState x:Name="Left">
                        <VisualState.Setters>
                            <Setter Target="HeaderDockedElement.(telerikPrimitives:RadDockPanel.Dock)" Value="Left"/>
                            <Setter Target="AdditionalContentTransform.(telerikPrimitives:RadDockPanel.Dock)" Value="Left"/>
                            <Setter Target="DropDownButtonElement.(telerikPrimitives:RadDockPanel.Dock)" Value="Left"/>
                            <Setter Target="HeaderDockedElement.LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Right">
                        <VisualState.Setters>
                            <Setter Target="HeaderDockedElement.LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Top" />
                    <VisualState x:Name="Bottom">
                        <VisualState.Setters>
                            <Setter Target="AdditionalContentTransform.(telerikPrimitives:RadDockPanel.Dock)" Value="Left"/>
                            <Setter Target="DropDownButtonElement.(telerikPrimitives:RadDockPanel.Dock)" Value="Left"/>
                            <Setter Target="HeaderDockedElement.LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                            <Setter Target="AdditionalContentTransform.LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="DropDownStates">
                    <VisualState x:Name="DropDownButtonVisible">
                        <VisualState.Setters>
                            <Setter Target="DropDownButtonElement.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="DropDownButtonCollapsed">
                        <VisualState.Setters>
                            <Setter Target="DropDownButtonElement.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <telerikPrimitives:RadDockPanel LastChildFill="True">
                <telerikPrimitives:RadLayoutTransformControl x:Name="HeaderDockedElement" telerikPrimitives:RadDockPanel.Dock="Top">
                    <Grid>
                        <!--Header Background-->
                        <Border x:Name="HeaderBackground"
                                Background="{TemplateBinding HeaderBackground}"
                                BorderBrush="{ThemeResource TelerikTabControl_HeaderBorderBrush}"
                                BorderThickness="0 0 0 1"
                                Visibility="{TemplateBinding BackgroundVisibility}" />
                        <!--TabStrip-->
                        <telerikPrimitives:RadDockPanel Margin="{Binding ElementName=HeaderBackground, Path=BorderThickness}">
                            <telerikPrimitives:RadLayoutTransformControl x:Name="AdditionalContentTransform" Margin="0" telerikPrimitives:RadDockPanel.Dock="Right">
                                <ContentPresenter x:Name="AdditionalContentElement" Content="{TemplateBinding AdditionalContent}" />
                            </telerikPrimitives:RadLayoutTransformControl>

                            <local:RadDropDownButton x:Name="DropDownButtonElement"
                                                     Visibility="Collapsed"
                                                     Style="{TemplateBinding DropDownButtonStyle}"
                                                     AutomationProperties.Name="drop down menu"
                                                     telerikPrimitives:RadDockPanel.Dock="Right"
                                                     IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                     ClickMode="Press"
                                                     DropDownButtonPosition="Bottom">
                                <local:RadDropDownButton.DropDownContent>
                                    <tabcontrol:DropDownMenu x:Name="DropDownMenuElement"
                                                             Style="{TemplateBinding DropDownMenuStyle}"
                                                             ItemTemplate="{TemplateBinding ItemDropDownContentTemplate}"
                                                             ItemTemplateSelector="{TemplateBinding ItemDropDownContentTemplateSelector}"
                                                             DisplayMemberPath="{TemplateBinding DropDownDisplayMemberPath}"/>
                                </local:RadDropDownButton.DropDownContent>
                            </local:RadDropDownButton>

                            <RepeatButton x:Name="LeftScrollButtonElement"
                                          AutomationProperties.Name="scroll left"
                                          Style="{StaticResource TabControl_LeftScrollButtonStyle}"/>

                            <RepeatButton x:Name="RightScrollButtonElement"
                                          AutomationProperties.Name="scroll right"
                                          telerikPrimitives:RadDockPanel.Dock="Right"
                                          Style="{StaticResource TabControl_RightScrollButtonStyle}"/>

                            <!-- Items: -->
                            <ScrollViewer x:Name="ScrollViewerElement"
                                          Style="{StaticResource EmptyScrollViewerStyle}"
                                          IsTabStop="False"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="{Binding (ScrollViewer.HorizontalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </telerikPrimitives:RadDockPanel>
                    </Grid>
                </telerikPrimitives:RadLayoutTransformControl>

                <!--Content-->
                <Border x:Name="ContentBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid Margin="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="ContentElement"
                                          Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsContentPreserved,Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=True}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}" />
                        <Grid x:Name="ContentElementsPanel"
                              Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsContentPreserved, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </telerikPrimitives:RadDockPanel>
        </Grid>
    </ControlTemplate>

    <!-- RadTabControl -->
    <Style TargetType="local:RadTabControl">
        <Setter Property="Template" Value="{StaticResource TabControlTemplate}" />
        <Setter Property="Foreground" Value="{ThemeResource TelerikTabControl_Foreground}" />
        <Setter Property="FontSize" Value="{ThemeResource TelerikTabControl_FontSize}" />
        <Setter Property="Background" Value="{ThemeResource TelerikTabControl_Background}" />
        <Setter Property="HeaderBackground" Value="{ThemeResource TelerikTabControl_HeaderBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TelerikTabControl_BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <telerikPrimitives:TabWrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="DropDownButtonStyle" Value="{StaticResource TabControl_DropDownButtonStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <!--Magic numbers, do not change-->
        <Setter Property="MinWidth" Value="5" />
        <Setter Property="MinHeight" Value="20" />
    </Style>

    <!--#endregion-->
</ResourceDictionary>
