<UserControl x:Class="SamaHesab.WPF.Views.Treasury.ReceivePaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── فرمِ دریافت/پرداخت ── -->
        <Border Grid.Column="0" Margin="0,0,10,0" Padding="16" CornerRadius="12"
                Background="White" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="دریافت و پرداختِ وجه" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,12"/>

                <!-- کلیدِ حالت: دریافت / پرداخت -->
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <Button Content="دریافت" Command="{Binding SetReceiveCommand}" Height="36" Margin="0,0,4,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#EAEFFA"/><Setter Property="Foreground" Value="#324A7A"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReceive}" Value="True">
                                        <Setter Property="Background" Value="#2E7D32"/><Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="پرداخت" Command="{Binding SetPayCommand}" Height="36" Margin="4,0,0,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#EAEFFA"/><Setter Property="Foreground" Value="#324A7A"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReceive}" Value="False">
                                        <Setter Property="Background" Value="#C0392B"/><Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </UniformGrid>

                <TextBlock Text="{Binding ActionTitle}" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,10"/>

                <TextBlock Text="جست‌وجوی طرف‌حساب" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="6,4"/>

                <TextBlock Text="طرف‌حساب" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                <ComboBox ItemsSource="{Binding Parties}" DisplayMemberPath="Name"
                          SelectedValuePath="Id" SelectedValue="{Binding SelectedPartyId}" Margin="0,2,0,8" Height="32"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="مبلغ (ریال)" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="روش" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                        <ComboBox ItemsSource="{Binding Methods}" SelectedValue="{Binding PaymentMethod}" Height="30"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="شرح (اختیاری)" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                <TextBox Text="{Binding Description}" Margin="0,2,0,12" Padding="6,4"/>

                <Button Content="ثبتِ سند" Command="{Binding SubmitCommand}" Height="42" Cursor="Hand"
                        Background="#4B5F97" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="15"/>
            </StackPanel>
        </Border>

        <!-- ── فهرستِ اخیرِ دریافت/پرداخت ── -->
        <Border Grid.Column="1" Padding="0" CornerRadius="12"
                Background="White" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="دریافت‌ها و پرداخت‌های اخیر" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource PrimaryText}" Margin="12,12,12,6"/>
                <DataGrid ItemsSource="{Binding Recent}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                          CanUserAddRows="False" Margin="6,0,6,6" RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نوع" Binding="{Binding Kind}" Width="70"/>
                        <DataGridTextColumn Header="شماره" Binding="{Binding VoucherNumber}" Width="90"/>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="100"/>
                        <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, StringFormat={}{0:#,0}}" Width="130"/>
                        <DataGridTextColumn Header="شرح" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
