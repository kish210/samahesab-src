<Window x:Class="SamaHesab.WPF.Views.POS.QuickProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ثبتِ فوریِ کالا/خدمات" Height="Auto" Width="420"
        SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        FontFamily="{DynamicResource VazirFont}" Background="White">
    <Border Padding="18">
        <StackPanel>
            <TextBlock Text="ثبتِ فوریِ کالا/خدمات" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource ErpBlue700}" Margin="0,0,0,12"/>

            <!-- نوعِ آیتم: کالا / خدمت -->
            <TextBlock Text="نوع" FontSize="11.5" Foreground="{StaticResource ErpTextMuted}" Margin="0,0,0,3"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="RbGoods" Content="کالا" IsChecked="True" Margin="0,0,18,0" GroupName="Ptype"/>
                <RadioButton x:Name="RbService" Content="خدمت" GroupName="Ptype"/>
            </StackPanel>

            <TextBlock Text="نام (الزامی)" FontSize="11.5" Foreground="{StaticResource ErpTextMuted}" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtName" Height="34" FontSize="13" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="کد (خالی=خودکار)" FontSize="11.5" Foreground="{StaticResource ErpTextMuted}" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtCode" Height="32" FlowDirection="LeftToRight"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="بارکد (اختیاری)" FontSize="11.5" Foreground="{StaticResource ErpTextMuted}" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtBarcode" Height="32" FlowDirection="LeftToRight"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="قیمت فروش" FontSize="11.5" Foreground="{StaticResource ErpTextMuted}" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtSale" Height="32" FlowDirection="LeftToRight" Text="0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="قیمت خرید" FontSize="11.5" Foreground="{StaticResource ErpTextMuted}" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtPurchase" Height="32" FlowDirection="LeftToRight" Text="0"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="مالیات ٪" FontSize="11.5" Foreground="{StaticResource ErpTextMuted}" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtTax" Height="32" FlowDirection="LeftToRight" Text="0"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="TxtError" Foreground="#B91C1C" FontSize="11.5" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,0">
                <Button x:Name="BtnSave" Content="ثبت و افزودن به سبد (Enter)" Height="38" MinWidth="190"
                        Background="{StaticResource ErpBlue600}" Foreground="White" BorderThickness="0"
                        FontWeight="Bold" Cursor="Hand" Click="BtnSave_Click"/>
                <Button Content="انصراف (Esc)" Height="38" MinWidth="100" Margin="8,0,0,0"
                        Background="White" BorderBrush="{StaticResource ErpBorder}" Cursor="Hand" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
