<UserControl x:Class="SamaHesab.WPF.Views.Support.ReleaseNotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource VazirFont}" FlowDirection="RightToLeft"
             Background="{StaticResource ErpAppBg}">
    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,8">
            <StackPanel>
                <TextBlock Text="یادداشت‌های نسخه" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}"/>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource ErpTextMuted}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button HorizontalAlignment="Left" Style="{StaticResource ErpBtnGhost}" Height="30" Padding="12,0"
                    Content="🔄 به‌روزرسانی" Command="{Binding RefreshCommand}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="4">
                <ListBox ItemsSource="{Binding Releases}" SelectedItem="{Binding Selected}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,5">
                                <TextBlock Text="{Binding Version}" FontWeight="SemiBold"/>
                                <Border Background="#E8F5E9" CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="نسخهٔ فعلی" FontSize="10"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Selected.Version, StringFormat=نسخهٔ {0}}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}"/>
                        <TextBlock Text="✨ قابلیت‌های نو" FontWeight="Bold" Margin="0,14,0,4"/>
                        <TextBlock Text="{Binding Selected.Highlights}" TextWrapping="Wrap" FontSize="12.5"/>
                        <TextBlock Text="🐞 رفعِ باگ‌ها" FontWeight="Bold" Margin="0,14,0,4"/>
                        <TextBlock Text="{Binding Selected.BugFixes}" TextWrapping="Wrap" FontSize="12.5"/>
                        <TextBlock Text="⚠️ مشکلاتِ شناخته‌شده" FontWeight="Bold" Margin="0,14,0,4"/>
                        <TextBlock Text="{Binding Selected.KnownIssues}" TextWrapping="Wrap" FontSize="12.5"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
