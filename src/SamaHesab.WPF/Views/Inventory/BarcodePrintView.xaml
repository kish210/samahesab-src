<UserControl x:Class="SamaHesab.WPF.Views.Inventory.BarcodePrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- تنظیمات -->
        <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="14">
            <StackPanel>
                <TextBlock Text="چاپِ بارکدِ کالا" FontSize="16" FontWeight="Bold" Foreground="#2E7D52" Margin="0,0,0,12"/>

                <TextBlock Text="جستجوی کالا" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,2,0,8"/>

                <TextBlock Text="کالا" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                          DisplayMemberPath="Name" Height="32" Margin="0,2,0,8"/>

                <TextBlock Text="مقدارِ بارکد" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                <DockPanel Margin="0,2,0,8">
                    <Button DockPanel.Dock="Left" Content="🔧 تولیدِ بارکد" Height="32" Padding="8,0" Margin="6,0,0,0"
                            Command="{Binding GenerateBarcodeCommand}"/>
                    <TextBox Text="{Binding BarcodeValue, UpdateSourceTrigger=PropertyChanged}" Height="32" FlowDirection="LeftToRight" TextAlignment="Right"/>
                </DockPanel>

                <TextBlock Text="نامِ روی برچسب" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,2,0,8"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="قیمت (ریال)" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,2,4,0" FlowDirection="LeftToRight" TextAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="4,0,0,2">
                        <CheckBox Content="نمایشِ نام" IsChecked="{Binding ShowName}" Margin="0,0,0,4"/>
                        <CheckBox Content="نمایشِ قیمت" IsChecked="{Binding ShowPrice}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="تعداد (چاپِ تعدادی)" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                        <DockPanel Margin="0,2,4,0">
                            <Button DockPanel.Dock="Right" Content="−" Width="30" Height="32" Command="{Binding DecCountCommand}"/>
                            <Button DockPanel.Dock="Left" Content="+" Width="30" Height="32" Command="{Binding IncCountCommand}"/>
                            <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Height="32" TextAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="ستون در صفحه" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox Text="{Binding Columns, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="4,2,0,0" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Button x:Name="BtnPrint" Content="🖨 چاپِ بارکد" Height="40" Margin="0,16,0,0"
                        Background="#2E7D52" Foreground="White" FontWeight="Bold" Click="Print_Click"/>
                <TextBlock Text="برچسب‌ها روی چاپگرِ انتخابی چاپ می‌شوند؛ برای لیبل‌پرینتر اندازهٔ صفحه را در دیالوگِ چاپ تنظیم کنید."
                           FontSize="10.5" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- پیش‌نمایش -->
        <Border Grid.Column="2" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="14">
            <StackPanel>
                <TextBlock Text="پیش‌نمایشِ برچسب" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="20"
                        HorizontalAlignment="Center" Background="White">
                    <ContentControl x:Name="PreviewHost"/>
                </Border>
                <TextBlock Text="{Binding Count, StringFormat='تعدادِ برچسب برای چاپ: {0}'}" Margin="0,12,0,0"
                           Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
