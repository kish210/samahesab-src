<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!--DatePicker and TimePicker does not have compact mode-->
    <Thickness x:Key="TimePickerFlyoutPresenterItemPadding">0 0 0 1</Thickness>
    <Thickness x:Key="DatePickerFlyoutPresenterItemPadding">0 0 0 1</Thickness>
    <Thickness x:Key="DatePickerFlyoutPresenterMonthPadding">10 0 0 1</Thickness>

    <!--#region Grid-->
    <x:Double x:Key="TelerikGrid_RowHeight">32</x:Double>
    <x:Double x:Key="TelerikGrid_ColumnsFlyoutHeaderHeight">32</x:Double>
    <x:Double x:Key="TelerikGrid_ColumnHeaderMinHeight">32</x:Double>
    <x:Double x:Key="TelerikGrid_FilteringFlyoutButtonMinHeight">24</x:Double>
    <x:Double x:Key="TelerikGrid_TextFilterCaseButtonWidth">24</x:Double>
    <x:Double x:Key="TelerikGrid_TextFilterCaseButtonHeight">24</x:Double>
    <x:Double x:Key="TelerikGrid_EditRowButtonMinHeight">32</x:Double>

    <x:Double x:Key="TelerikGrid_OpenButtonWidth">24</x:Double>
    <x:Double x:Key="TelerikGrid_OpenButtonHeight">24</x:Double>

    <x:Double x:Key="TelerikGrid_ColumnReorderServicePanelMinHeight">30</x:Double>
    <!--#endregion-->

    <!--#region RibbonView-->
    <x:Double x:Key="TelerikRibbonView_ContentHeight">116</x:Double>
    <Thickness x:Key="TelerikRibbonView_WindowTitleMargin">0 5</Thickness>
    <GridLength x:Key="TelerikRibbonView_TabStripMinHeight">30</GridLength>
    <x:Double x:Key="TelerikRibbonView_Button_MinSize">24</x:Double>
    <Thickness x:Key="TelerikRibbonView_Button_Padding">3</Thickness>
    <Thickness x:Key="TelerikRibbonView_Backstage_ItemPadding">12 8</Thickness>
    <x:Double x:Key="TelerikRibbonView_Gallery_ButtonMinSize">24</x:Double>
    <x:Double x:Key="TelerikRibbonView_QuickAccessToolbar_BelowRibbonMinHeight">30</x:Double>
    <!--#endregion-->

    <!--#region ListView-->
    <x:Double x:Key="TelerikListView_ItemMinSize">30</x:Double>
    <Thickness x:Key="TelerikListView_ItemPadding">10 5</Thickness>
    <x:Double x:Key="TelerikListView_HeaderFooterMinSize">30</x:Double>
    <Thickness x:Key="TelerikListView_HeaderFooterPadding">10 5</Thickness>
    <x:Double x:Key="TelerikListView_GroupHeaderMinSize">30</x:Double>
    <Thickness x:Key="TelerikListView_GroupHeaderPadding">10 5</Thickness>
    <!--#endregion-->
</ResourceDictionary>
