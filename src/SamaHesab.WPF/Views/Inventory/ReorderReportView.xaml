<UserControl x:Class="SamaHesab.WPF.Views.Inventory.ReorderReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="گزارش کالاهای زیرِ حداقل / نقطهٔ سفارش" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
            <TextBlock Text="کالاهایی که موجودیِ کل‌شان به آستانه (نقطهٔ سفارش یا حداقل) رسیده — همراه با کسری و پیشنهادِ مقدارِ سفارش."
                       Foreground="{DynamicResource SecondaryText}" FontSize="12.5" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- نوار ابزار -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Width="220" Height="30" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="7,0"
                     Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}"
                     BorderBrush="{DynamicResource BorderColor}"/>
            <Button Content="نمایش" Command="{Binding RunCommand}" Margin="10,0,0,0" Style="{StaticResource ErpBtnPrimary}"/>
            <Button Content="اکسل" Command="{Binding ExportCsvCommand}" Margin="6,0,0,0" Style="{StaticResource ErpBtnSecondary}"/>
            <Button Content="چاپ / PDF" Command="{Binding PrintCommand}" Margin="6,0,0,0" Style="{StaticResource ErpBtnSecondary}"/>
        </StackPanel>

        <!-- گرید (ظاهر از استایلِ ضمنیِ ErpDataGrid: زبرا/هدر/خط‌کشی/۳۰px) -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="110"/>
                <DataGridTextColumn Header="نام کالا" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="موجودی" Binding="{Binding OnHand, Converter={StaticResource Num}}" Width="100"/>
                <DataGridTextColumn Header="حداقل" Binding="{Binding MinStock, Converter={StaticResource Num}}" Width="100"/>
                <DataGridTextColumn Header="نقطهٔ سفارش" Binding="{Binding ReorderPoint, Converter={StaticResource Num}}" Width="110"/>
                <DataGridTextColumn Header="کسری" Binding="{Binding Shortage, Converter={StaticResource Num}}" Width="100"/>
                <DataGridTextColumn Header="پیشنهادِ سفارش" Binding="{Binding SuggestedQty, Converter={StaticResource Num}}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- جمع -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="تعداد کالاهای نیازمندِ سفارش:" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ItemCount, Converter={StaticResource Num}}" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" Margin="6,0,24,0"/>
                <TextBlock Text="جمعِ مقدارِ پیشنهادی:" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalSuggestedQty, Converter={StaticResource Num}}"
                           FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
