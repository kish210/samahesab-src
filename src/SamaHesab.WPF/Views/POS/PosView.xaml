<UserControl x:Class="SamaHesab.WPF.Views.POS.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft"
             Background="#F4F5F7">

    <UserControl.InputBindings>
        <KeyBinding Key="Return" Command="{Binding CheckoutCommand}"/>
        <KeyBinding Key="F1" Command="{Binding NewSaleCommand}"/>
        <KeyBinding Key="F12" Command="{Binding CheckoutCommand}"/>
        <KeyBinding Key="F8" Command="{Binding PrintReceiptCommand}"/>
        <KeyBinding Key="F9" Command="{Binding PreviewReceiptCommand}"/>
        <KeyBinding Key="F7" Command="{Binding QuickAddProductCommand}"/>
        <KeyBinding Key="F4" Command="{Binding HoldSaleCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding ExitReturnModeCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>

        <!-- تایل کالا -->
        <Style x:Key="PItem" TargetType="Button">
            <Setter Property="Height" Value="78"/><Setter Property="Width" Value="156"/>
            <Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" Padding="11,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#9DB0DA"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#EEF2FB"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- چیپ دسته -->
        <Style x:Key="Cat" TargetType="Button">
            <Setter Property="Height" Value="42"/><Setter Property="Padding" Value="16,0"/><Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>   <!-- سبد (چپ در RTL) -->
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>      <!-- کالاها -->
        </Grid.ColumnDefinitions>

        <!-- ═══ سبد + پرداخت ═══ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- سبد -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F6F7F9" CornerRadius="9,9,0,0" Padding="12,9" BorderBrush="{StaticResource ErpBorder}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Text="{Binding ReceiptNumber, StringFormat='فاکتور صندوق {0}'}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource ErpBlue700}"/>
                            <!-- POS-CUSTOMER — انتخاب‌گرِ مشتری (سرچ‌پذیر، F6). پیش‌فرض «متفرقه». -->
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="مشتری:" FontSize="11.5" Foreground="{StaticResource ErpTextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="CustomerPicker" Width="170" Height="26" IsEditable="True" IsTextSearchEnabled="False"
                                          ItemsSource="{Binding Customers}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedCustomerId}"
                                          Text="{Binding CustomerDisplay, Mode=OneWay}" ToolTip="انتخابِ مشتری — F6 (جست‌وجوی نام)"/>
                                <Button Content="✕" Width="22" Height="22" Margin="3,0,0,0" Padding="0" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0" ToolTip="حذفِ مشتری (متفرقه)"
                                        Command="{Binding ClearCustomerCommand}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CartItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0F1F3" BorderThickness="0,0,0,1" Padding="12,7">
                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <Button Content="−" Width="30" Height="30" Cursor="Hand" Background="White" BorderBrush="{StaticResource ErpBorder}"
                                                        Command="{Binding DataContext.DecItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding Quantity}" Width="32" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button Content="+" Width="30" Height="30" Cursor="Hand" Background="White" BorderBrush="{StaticResource ErpBorder}"
                                                        Command="{Binding DataContext.IncItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding NetAmount, Converter={StaticResource Num}}" Width="92" TextAlignment="Left" FlowDirection="LeftToRight"
                                                           FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Quantity}" FontSize="10.5" Foreground="{StaticResource ErpTextMuted}"/>
                                                    <TextBlock Text=" × " FontSize="10.5" Foreground="{StaticResource ErpTextMuted}"/>
                                                    <TextBlock Text="{Binding UnitPrice, Converter={StaticResource Num}}" FontSize="10.5" Foreground="{StaticResource ErpTextMuted}" FlowDirection="LeftToRight"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- جمع‌ها -->
                    <StackPanel Grid.Row="2">
                        <DockPanel Margin="14,5"><TextBlock Text="جمع اقلام" FontSize="12" Foreground="{StaticResource ErpTextMuted}"/><TextBlock DockPanel.Dock="Left" Text="{Binding SubTotal, Converter={StaticResource Num}}" FontWeight="SemiBold" FlowDirection="LeftToRight"/></DockPanel>
                        <!-- U-POS-4: قبلاً «تخفیف» یک TextBoxِ ساده بینِ ردیف‌هایِ فقط‌خواندنی بود (بدونِ حاشیه/واحد)
                             و کاربر متوجه نمی‌شد که فیلدِ قابلِ‌ویرایش است — کلیکِ اشتباه، کلِ مبلغ را عوض می‌کرد. -->
                        <DockPanel Margin="14,3">
                            <TextBlock Text="تخفیف (ریال)" FontSize="12" Foreground="{StaticResource ErpTextMuted}"/>
                            <Border DockPanel.Dock="Left" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="5">
                                <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" Width="110" Height="26"
                                         Background="Transparent" BorderThickness="0" FlowDirection="LeftToRight" TextAlignment="Left"/>
                            </Border>
                        </DockPanel>
                        <DockPanel Margin="14,5"><TextBlock Text="مالیات" FontSize="12" Foreground="{StaticResource ErpTextMuted}"/><TextBlock DockPanel.Dock="Left" Text="{Binding Tax, Converter={StaticResource Num}}" FontWeight="SemiBold" FlowDirection="LeftToRight"/></DockPanel>
                        <Border Background="{StaticResource ErpBlue700}" Padding="14,12">
                            <DockPanel>
                                <TextBlock Text="مبلغ قابل پرداخت" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding GrandTotal, Converter={StaticResource Num}}" Foreground="White" FontSize="24" FontWeight="Bold" FlowDirection="LeftToRight"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- دکمه‌های پرداخت -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <!-- T13: تاگلِ حالتِ مرجوعی/برگشت -->
                <!-- U-POS-3: IsChecked حالا OneWay + Command (نه TwoWay مستقیم) تا با سبدِ غیرخالی
                     پیش از تعویض به حالتِ مرجوعی (بازپرداختِ کامل) از کاربر تأیید گرفته شود. -->
                <ToggleButton Grid.Row="0" Height="34" Margin="0,0,0,7" Cursor="Hand" FontWeight="SemiBold" FontSize="12.5"
                              IsChecked="{Binding IsReturnMode, Mode=OneWay}" Content="{Binding ReturnToggleLabel}"
                              Command="{Binding ToggleReturnModeCommand}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#B45309"/>
                            <Setter Property="BorderBrush" Value="#FBBF24"/>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#B45309"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <!-- U-POS-6: فیلدِ دریافتیِ نقدی — پیش‌تر اصلاً در UI وجود نداشت، یعنی «پرداخت نقدی»
                     همیشه با خطای «مبلغ دریافتی کافی نیست» رد می‌شد و کارت‌خوان بدونِ این فیلد فروش
                     را با paid=۰ (نسیهٔ ناخواسته) ثبت می‌کرد. -->
                <Grid Grid.Row="1" Margin="0,0,0,7" Visibility="{Binding NeedsCashInput, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock Text="دریافتیِ نقدی" FontSize="11" Foreground="{StaticResource ErpTextMuted}" DockPanel.Dock="Top"/>
                        <Border Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="8" Margin="0,3,0,0">
                            <TextBox Text="{Binding CashReceived, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,6"
                                     Background="Transparent" BorderThickness="0" FlowDirection="LeftToRight" TextAlignment="Left"/>
                        </Border>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock Text="باقیمانده/تغییر" FontSize="11" Foreground="{StaticResource ErpTextMuted}" DockPanel.Dock="Top"/>
                        <Border Background="#F6F7F9" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="8" Margin="0,3,0,0">
                            <TextBlock Text="{Binding Change, Converter={StaticResource Num}}" Height="34" Padding="8,6" FontWeight="SemiBold"
                                       FlowDirection="LeftToRight" TextAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </DockPanel>
                </Grid>
                <Button Grid.Row="2" Height="62" Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="16" FontWeight="Bold" Content="{Binding CheckoutLabel}" Command="{Binding CheckoutCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#16A34A"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReturnMode}" Value="True">
                                    <Setter Property="Background" Value="#DC2626"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Grid Grid.Row="3" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <!-- U-POS-1: پیش‌تر این سه دکمه Commandای نداشتند (کلیکِ بی‌اثر و گیج‌کننده)؛
                         حالا واقعاً PaymentMode را عوض می‌کنند و حالتِ فعال با رنگ مشخص است. -->
                    <Button Grid.Column="0" Height="52" BorderBrush="{StaticResource ErpBorder}" Cursor="Hand" Content="کارت‌خوان" FontWeight="SemiBold"
                            Command="{Binding SetPaymentModeCommand}" CommandParameter="کارتخوان">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#111827"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PaymentMode}" Value="کارتخوان">
                                        <Setter Property="Background" Value="{StaticResource ErpBlue600}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="2" Height="52" BorderBrush="{StaticResource ErpBorder}" Cursor="Hand" Content="نسیه" FontWeight="SemiBold"
                            Command="{Binding SetPaymentModeCommand}" CommandParameter="نسیه">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#111827"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PaymentMode}" Value="نسیه">
                                        <Setter Property="Background" Value="{StaticResource ErpBlue600}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="4" Height="52" BorderBrush="{StaticResource ErpBorder}" Cursor="Hand" Content="ترکیبی" FontWeight="SemiBold"
                            Command="{Binding SetPaymentModeCommand}" CommandParameter="ترکیبی">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#111827"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PaymentMode}" Value="ترکیبی">
                                        <Setter Property="Background" Value="{StaticResource ErpBlue600}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>

            <!-- ردیف توابع -->
            <Grid Grid.Row="2" Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <!-- U11 — تعلیق فاکتور (Hold) -->
                <Button Grid.Column="0" Height="40" Background="White" BorderBrush="{StaticResource ErpBorder}" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5"
                        Content="تعلیق فاکتور F4" Command="{Binding HoldSaleCommand}"/>
                <!-- U11 — بازیابی/فراخوان (Recall) با پاپ‌آپِ فهرستِ معلق -->
                <ToggleButton Grid.Column="2" x:Name="RecallToggle" Height="40" Background="White" BorderBrush="{StaticResource ErpBorder}" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="بازیابی F5" VerticalAlignment="Center"/>
                        <Border Margin="6,0,0,0" CornerRadius="9" Background="{StaticResource ErpBlue600}" Padding="6,1" MinWidth="18"
                                Visibility="{Binding HasHeldSales, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding HeldSales.Count}" Foreground="White" FontSize="10.5" FontWeight="Bold" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </ToggleButton>
                <Popup PlacementTarget="{Binding ElementName=RecallToggle}" Placement="Top" StaysOpen="False" AllowsTransparency="True"
                       IsOpen="{Binding IsChecked, ElementName=RecallToggle}">
                    <Border Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="9" Width="360" Margin="6"
                            SnapsToDevicePixels="True">
                        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22" Color="#334155"/></Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="فاکتورهای معلق" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource ErpBlue700}" Margin="12,10,12,6"/>
                            <TextBlock Grid.Row="0" Text="موردی نیست" FontSize="11.5" Foreground="{StaticResource ErpTextMuted}" Margin="12,34,0,0"
                                       Visibility="{Binding HasHeldSales, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                            <ScrollViewer Grid.Row="1" MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding HeldSales}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F0F1F3" BorderThickness="0,0,0,1" Padding="12,8">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Left" Content="✕" Width="28" Height="28" Background="White" BorderBrush="#E6BCBC" Foreground="#B91C1C" Cursor="Hand"
                                                            Command="{Binding DataContext.DeleteHeldCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                    <Button DockPanel.Dock="Left" Content="فراخوان" Width="72" Height="28" Margin="0,0,6,0" Background="{StaticResource ErpBlue600}" Foreground="White" BorderThickness="0" Cursor="Hand"
                                                            Command="{Binding DataContext.RecallSaleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Total, Converter={StaticResource Num}}" FontSize="10.5" Foreground="{StaticResource ErpBlue700}" FlowDirection="LeftToRight"/>
                                                            <TextBlock Text="{Binding CreatedAt, StringFormat=' · {0:HH:mm}'}" FontSize="10.5" Foreground="{StaticResource ErpTextMuted}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Popup>
                <!-- پیش‌نمایشِ رسید (F9) -->
                <Button Grid.Column="4" Height="40" Background="White" BorderBrush="{StaticResource ErpBorder}" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5"
                        Content="👁 پیش‌نمایش" Command="{Binding PreviewReceiptCommand}"/>
                <!-- چاپِ فاکتور/رسید (دستورِ موجود روی F8 — حالا دکمهٔ دیداری هم دارد) -->
                <Button Grid.Column="6" Height="40" Background="White" BorderBrush="{StaticResource ErpBorder}" Foreground="{StaticResource ErpBlue700}" FontSize="11.5"
                        Content="🖨 چاپ F8" Command="{Binding PrintReceiptCommand}"/>
                <!-- U-POS-2: برچسبِ «ابطال Esc» نادرست بود — کلیدِ Esc در واقع فقط از حالتِ برگشت خارج می‌کند
                     (ExitReturnModeCommand)، نه شروعِ فروشِ تازه؛ این کلیدِ F1 است. برچسب اصلاح شد. -->
                <!-- U-POS-2b: «فروش جدید F1» در ستونِ باریکِ ۱/۵ عرض، مثلِ برچسبِ قبلی، کلیپ می‌شد؛
                     بدونِ پسوندِ کلید کوتاه‌تر و در عرضِ ستون جا می‌شود. -->
                <Button Grid.Column="8" Height="40" Background="White" BorderBrush="#E6BCBC" Foreground="#B91C1C" FontSize="11.5" Content="فروش جدید" ToolTip="فروش جدید (F1)" Command="{Binding NewSaleCommand}"/>
            </Grid>
        </Grid>

        <!-- ═══ کالاها ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <!-- جستجو/بارکد + ثبتِ فوریِ کالا -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Grid.Column="2" Height="42" MinWidth="132" Background="{StaticResource ErpBlue600}" Foreground="White" BorderThickness="0"
                        Cursor="Hand" FontSize="13" FontWeight="SemiBold" Content="➕ ثبتِ فوری F7" Command="{Binding QuickAddProductCommand}"/>
            <!-- جستجو/بارکد (R15: placeholder واقعی) -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <TextBox x:Name="BarcodeBox" Height="42" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="12,0" FontSize="14"
                             Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding ProcessBarcodeCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="🔍  اسکن بارکد یا جستجوی کالا…  (F1)" Foreground="{StaticResource ErpTextMuted}" FontSize="14"
                               VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=BarcodeBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            </Grid>

            <!-- 🇮🇷 تفکیکِ کالا/خدمات -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource Cat}" Content="همه" Command="{Binding SetTypeFilterCommand}" CommandParameter="all"/>
                <Button Style="{StaticResource Cat}" Content="کالا" Command="{Binding SetTypeFilterCommand}" CommandParameter="goods"/>
                <Button Style="{StaticResource Cat}" Content="خدمات" Command="{Binding SetTypeFilterCommand}" CommandParameter="service"/>
            </StackPanel>

            <!-- دسته‌ها -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Cat}" Content="{Binding Name}"
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- شبکه‌ی کالا -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Products}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PItem}"
                                    Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#1F2937"/>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Price, Converter={StaticResource Num}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}" FlowDirection="LeftToRight"/>
                                            <TextBlock Text=" ریال" FontSize="11" Foreground="{StaticResource ErpTextMuted}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Code}" FontSize="10" Foreground="{StaticResource ErpTextMuted}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
