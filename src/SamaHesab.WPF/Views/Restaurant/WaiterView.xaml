<UserControl x:Class="SamaHesab.WPF.Views.Restaurant.WaiterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft"
             Background="#F4F5F7">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:NullToVisibilityConverter x:Key="NullVis"/>
        <conv:NumberFormatConverter x:Key="Num"/>
        <SolidColorBrush x:Key="Blue50" Color="#EEF2FB"/>
        <SolidColorBrush x:Key="Blue600" Color="#4B5F97"/>
        <SolidColorBrush x:Key="Blue700" Color="#324A7A"/>
        <SolidColorBrush x:Key="Gold500" Color="#B18A5A"/>
        <SolidColorBrush x:Key="Gold50" Color="#FBF4E9"/>
        <SolidColorBrush x:Key="Gold700" Color="#8A6A3E"/>
        <SolidColorBrush x:Key="Line" Color="#E3E6EC"/>
        <SolidColorBrush x:Key="Line2" Color="#F0F1F3"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
        <SolidColorBrush x:Key="Strong" Color="#1F2937"/>
        <SolidColorBrush x:Key="Success" Color="#2E7D52"/>

        <!-- چیپ سالن / دسته -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Strong}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- کارت میز -->
        <Style x:Key="TableCard" TargetType="Button">
            <Setter Property="Width" Value="128"/><Setter Property="Height" Value="112"/>
            <Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="11" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1.5" Padding="11">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.9"/></Trigger>
                            <!-- 0=آزاد (نقطه‌چین خاکستری) -->
                            <DataTrigger Binding="{Binding StatusCode}" Value="0">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#C9CDD4"/>
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                            </DataTrigger>
                            <!-- 1=فعال (آبی) -->
                            <DataTrigger Binding="{Binding StatusCode}" Value="1">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Blue600}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Blue50}"/>
                            </DataTrigger>
                            <!-- 2=رزرو (طلایی) -->
                            <DataTrigger Binding="{Binding StatusCode}" Value="2">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Gold500}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Gold50}"/>
                            </DataTrigger>
                            <!-- 3=صورتحساب (طلایی) -->
                            <DataTrigger Binding="{Binding StatusCode}" Value="3">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Gold500}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Gold50}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- تایل منو -->
        <Style x:Key="MenuTile" TargetType="Button">
            <Setter Property="Width" Value="146"/><Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="11,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#9DB0DA"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Blue50}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- استپر تعداد -->
        <Style x:Key="Stepper" TargetType="Button">
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>      <!-- نقشه میز + منو (راست) -->
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="400"/>    <!-- سفارش (چپ) -->
        </Grid.ColumnDefinitions>

        <!-- ═══ نقشه میز + منو ═══ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- floor tabs -->
                <RowDefinition Height="*"/>       <!-- tables -->
                <RowDefinition Height="Auto"/>   <!-- menu cats -->
                <RowDefinition Height="Auto"/>   <!-- menu grid -->
            </Grid.RowDefinitions>

            <!-- تب سالن‌ها -->
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                <ItemsControl ItemsSource="{Binding Halls}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Chip}" Content="{Binding Name}"
                                    Command="{Binding DataContext.SelectHallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- شبکه‌ی میزها -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Tables}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TableCard}"
                                    Command="{Binding DataContext.OpenTableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <!-- بج وضعیت -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="99" Padding="7,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E5E7EB"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusCode}" Value="1"><Setter Property="Background" Value="{StaticResource Blue600}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusCode}" Value="2"><Setter Property="Background" Value="{StaticResource Gold500}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusCode}" Value="3"><Setter Property="Background" Value="{StaticResource Gold500}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Top" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Name, StringFormat='میز {0}'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Strong}"/>
                                        <TextBlock Text="{Binding Capacity, StringFormat='{}{0} نفره'}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status}" VerticalAlignment="Bottom" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- دسته‌های منو -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,8">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Chip}" Height="34" Content="{Binding Name}"
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- شبکه‌ی منو -->
            <ScrollViewer Grid.Row="3" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding MenuItems}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource MenuTile}"
                                    Command="{Binding DataContext.AddMenuItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Strong}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding Price, Converter={StaticResource Num}}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Blue700}" FlowDirection="LeftToRight"/>
                                        <TextBlock Text=" ریال" FontSize="11" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ═══ سفارش میز ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- کارت سفارش -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- هدر آبی -->
                    <Border Grid.Row="0" Background="{StaticResource Blue700}" CornerRadius="10,10,0,0" Padding="14,11">
                        <DockPanel>
                            <TextBlock Text="{Binding CurrentTableName, StringFormat='میز {0}'}" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                                       Visibility="{Binding ShowOrder, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="میزی انتخاب نشده" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                       Visibility="{Binding ShowOrder, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                            <Border Background="#33FFFFFF" CornerRadius="99" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding ShowOrder, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding CurrentSeats, StringFormat='{}{0} نفر'}" Foreground="White" FontSize="11"/>
                            </Border>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding OrderNumber, StringFormat='سفارش {0}'}" Foreground="#BAC5DD" FontSize="11"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- ردیف‌های سفارش -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding OrderLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line2}" BorderThickness="0,0,0,1" Padding="13,8">
                                        <DockPanel>
                                            <!-- مبلغ -->
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding LineTotal, Converter={StaticResource Num}}" Width="80"
                                                       TextAlignment="Left" FlowDirection="LeftToRight" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <!-- استپر -->
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                <Button Style="{StaticResource Stepper}" Content="−"
                                                        Command="{Binding DataContext.DecLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding Qty, Converter={StaticResource Num}}" Width="26" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource Stepper}" Content="+"
                                                        Command="{Binding DataContext.IncLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <!-- نام + یادداشت -->
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Strong}"/>
                                                <TextBlock Text="{Binding Notes}" FontSize="10.5" Foreground="{StaticResource Muted}"
                                                           Visibility="{Binding Notes, Converter={StaticResource NullVis}}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- جمع‌ها -->
                    <StackPanel Grid.Row="2">
                        <DockPanel Margin="14,5"><TextBlock Text="جمع اقلام" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock DockPanel.Dock="Left" Text="{Binding SubTotal, Converter={StaticResource Num}}" FontWeight="SemiBold" FlowDirection="LeftToRight"/></DockPanel>
                        <DockPanel Margin="14,3"><TextBlock Text="مالیات و خدمات" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock DockPanel.Dock="Left" Text="{Binding ServiceTax, Converter={StaticResource Num}}" FontWeight="SemiBold" FlowDirection="LeftToRight"/></DockPanel>
                        <Border Background="#F1F2F4" Padding="14,11" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                            <DockPanel>
                                <TextBlock Text="جمع کل" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Strong}" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding GrandTotal, Converter={StaticResource Num}}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Blue700}" FlowDirection="LeftToRight"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- دکمه‌ها -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Button Grid.Row="0" Height="52" Background="{StaticResource Success}" Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="15" FontWeight="Bold" Content="🍳  ارسال به آشپزخانه (KOT)" Command="{Binding SendToKitchenCommand}"/>
                <Grid Grid.Row="1" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Height="46" Background="White" BorderBrush="{StaticResource Line}" Cursor="Hand" FontWeight="SemiBold" Content="🖨  صورتحساب" Command="{Binding BillCommand}"/>
                    <Button Grid.Column="2" Height="46" Background="White" BorderBrush="{StaticResource Line}" Cursor="Hand" FontWeight="SemiBold" Content="⇄  انتقال میز" Command="{Binding TransferTableCommand}"/>
                </Grid>
                <Button Grid.Row="2" Height="50" Margin="0,7,0,0" Background="{StaticResource Blue700}" Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="15" FontWeight="Bold" Content="💳  تسویه و پرداخت" Command="{Binding SettleCommand}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
