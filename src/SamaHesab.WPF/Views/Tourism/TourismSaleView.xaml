<UserControl x:Class="SamaHesab.WPF.Views.Tourism.TourismSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding AddLineCommand}"/>
        <KeyBinding Key="F9" Command="{Binding SaveCommand}"/>
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ثبتِ فروشِ گردشگری" FontSize="18" FontWeight="Bold" Margin="2,0,0,8"/>

        <!-- سرِ فروش -->
        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}" Padding="10">
            <WrapPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="فروشنده" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    <ComboBox Width="180" Height="32" ItemsSource="{Binding Persons}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedSalespersonId}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="مشتری (اختیاری)" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    <ComboBox Width="180" Height="32" ItemsSource="{Binding Persons}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedCustomerId}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="روشِ پرداخت" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    <ComboBox Width="100" Height="32" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="سالِ مالی" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    <ComboBox Width="130" Height="32" ItemsSource="{Binding FiscalYears}" DisplayMemberPath="Title"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedFiscalYearId}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="تاریخ" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBox Width="110" Height="32" Text="{Binding Date}" FlowDirection="LeftToRight"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- نوارِ افزودنِ ردیف -->
        <Border Grid.Row="2" Style="{StaticResource FormSectionCard}" Padding="10" Margin="0,8,0,0">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="محصول:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" Margin="0,0,6,0"/>
                <ComboBox Width="240" Height="32" ItemsSource="{Binding Products}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedProduct}" Margin="0,0,12,0"/>
                <TextBlock Text="تعداد:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" Margin="0,0,6,0"/>
                <TextBox Width="70" Height="32" Text="{Binding AddQuantity}" FlowDirection="LeftToRight" Margin="0,0,12,0"/>
                <Button Content="➕ افزودن (F2)" Style="{StaticResource SecondaryButton}" Height="32" Command="{Binding AddLineCommand}"/>
            </WrapPanel>
        </Border>

        <!-- ردیف‌ها -->
        <Border Grid.Row="3" Style="{StaticResource FormSectionCard}" Padding="0" Margin="0,8,0,0">
            <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False"
                      ItemsSource="{Binding Lines}" RowHeight="{DynamicResource ErpDensRowHeight}" FontFamily="{StaticResource VazirFont}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="محصول" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="تعداد" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="فیِ فروش" Binding="{Binding UnitSalePrice, StringFormat={}{0:#,##0}}" Width="120"/>
                    <DataGridTextColumn Header="تخفیف" Binding="{Binding DiscountAmount, StringFormat={}{0:#,##0}}" Width="110"/>
                    <DataGridTextColumn Header="خالص" Binding="{Binding LineNet, StringFormat={}{0:#,##0}}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="سود" Binding="{Binding LineProfit, StringFormat={}{0:#,##0}}" Width="120" IsReadOnly="True"/>
                    <DataGridTemplateColumn Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑" FontSize="12" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource DangerColor}"
                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- نوارِ پایین -->
        <DockPanel Grid.Row="4" Margin="2,8,2,0">
            <Button DockPanel.Dock="Left" Content="💾 ثبتِ فروش (F9)" Style="{StaticResource PrimaryButton}" Height="38" Command="{Binding SaveCommand}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="جمعِ کل: " Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:#,##0}}" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" FlowDirection="LeftToRight" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="سود: " Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalProfit, StringFormat={}{0:#,##0} ریال}" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
