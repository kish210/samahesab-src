<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SamaHesab.API</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SamaHesab.Application\SamaHesab.Application.csproj" />
    <ProjectReference Include="..\SamaHesab.Infrastructure\SamaHesab.Infrastructure.csproj" />
    <ProjectReference Include="..\SamaHesab.Modules.Hotel\SamaHesab.Modules.Hotel.csproj" />
    <ProjectReference Include="..\SamaHesab.Modules.Contracting\SamaHesab.Modules.Contracting.csproj" />
    <ProjectReference Include="..\SamaHesab.Modules.CRM\SamaHesab.Modules.CRM.csproj" />
    <ProjectReference Include="..\SamaHesab.Modules.Restaurant\SamaHesab.Modules.Restaurant.csproj" />
    <ProjectReference Include="..\SamaHesab.Modules.HR\SamaHesab.Modules.HR.csproj" />
    <ProjectReference Include="..\SamaHesab.Modules.POS\SamaHesab.Modules.POS.csproj" />
    <ProjectReference Include="..\SamaHesab.Modules.Tourism\SamaHesab.Modules.Tourism.csproj" />
    <ProjectReference Include="..\SamaHesab.Modules.Attendance\SamaHesab.Modules.Attendance.csproj" />
    <ProjectReference Include="..\SamaHesab.Modules.TaxInvoicing\SamaHesab.Modules.TaxInvoicing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0" /><!-- P7 — نسخه‌بندیِ API -->
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" /><!-- فاز ۱۲ P-G8 -->
  </ItemGroup>

  <!-- U-WEB-TEMPLATES — پکِ قالب‌های پیش‌فرضِ چاپ (.shtpl) همراهِ API به خروجی کپی می‌شود تا
       «نصبِ قالب‌های پیش‌فرض» از کلاینتِ وب هم در دسترس باشد (هم‌الگو با SamaHesab.WPF.csproj). -->
  <ItemGroup>
    <Content Include="..\..\Templates\**\*.shtpl" Link="Templates\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
