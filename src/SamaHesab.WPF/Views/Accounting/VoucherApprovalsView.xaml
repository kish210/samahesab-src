<UserControl x:Class="SamaHesab.WPF.Views.Accounting.VoucherApprovalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <Style x:Key="ActBtn" TargetType="Button">
            <Setter Property="Margin" Value="2,0"/><Setter Property="Padding" Value="9,2"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="11.5"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- سربرگِ فشرده + شمارش (نوارِ پایینیِ جداگانه حذف شد → فضای خالیِ کمتر) -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right">
                <TextBlock Text="کارتابلِ تأییدِ اسناد" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                <TextBlock Text="اسنادِ «در انتظارِ تأیید» — میان‌بر: Enter تأیید · Del رد · F5 بروزرسانی"
                           Foreground="{DynamicResource SecondaryText}" FontSize="11.5" Margin="0,2,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Left" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="6" Padding="12,4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="در انتظار:" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock Text="{Binding Count}" FontWeight="Bold" FontSize="15"
                               Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- نوارِ عملیاتِ همیشه‌دیدنی (روی ردیفِ انتخابی) — کاهشِ کلیک -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="✓ تأیید (Enter)" Style="{StaticResource ActBtn}" Background="#2E7D52" Padding="14,6"
                    Command="{Binding ApproveSelectedCommand}"/>
            <Button Content="✗ رد (Del)" Style="{StaticResource ActBtn}" Background="#C2403A" Padding="14,6"
                    Command="{Binding RejectSelectedCommand}"/>
            <Button Content="↻ بروزرسانی (F5)" Command="{Binding RefreshCommand}" Margin="6,0,0,0" Padding="12,6"
                    Cursor="Hand" Style="{StaticResource ErpBtnSecondary}"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="Grid" ItemsSource="{Binding Pending}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" RowHeight="{DynamicResource ErpDensRowHeight}" FontSize="12.5"
                  PreviewKeyDown="Grid_PreviewKeyDown"
                  AlternatingRowBackground="{DynamicResource SurfaceBackground}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="شمارهٔ سند" Binding="{Binding VoucherNumber}" Width="110"/>
                <DataGridTextColumn Header="تاریخ" Binding="{Binding VoucherDate}" Width="100"/>
                <DataGridTextColumn Header="شرح" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="مبلغ (بدهکار)" Binding="{Binding TotalDebit, Converter={StaticResource Num}}" Width="140"/>
                <DataGridTemplateColumn Header="عملیات" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="تأیید" Style="{StaticResource ActBtn}" Background="#2E7D52"
                                        Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="رد" Style="{StaticResource ActBtn}" Background="#C2403A"
                                        Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
