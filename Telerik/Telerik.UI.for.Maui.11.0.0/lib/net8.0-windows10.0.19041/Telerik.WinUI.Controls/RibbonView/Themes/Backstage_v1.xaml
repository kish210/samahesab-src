<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:telerik="using:Telerik.UI.Xaml.Controls"
    xmlns:telerikRibbonViewPrimitives="using:Telerik.UI.Xaml.Controls.RibbonView.Primitives">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/RibbonView/Themes/Resources_v1.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="BackstageGroupSeparator" TargetType="telerik:RadRibbonBackstageItem">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="telerik:RadRibbonBackstageItem">
                    <StackPanel>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="ContentPanel" To="{ThemeResource TelerikRibbonView_DisabledOpacity}" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ContentPanel" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Margin="20 0 0 0" VerticalAlignment="Center"/>
                        <Rectangle Height="1" Margin="10 4" Fill="{ThemeResource TelerikRibbonView_Backstage_SeparatorBorderBrush}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="RadRibbonBackstageItemTemplate" TargetType="telerik:RadRibbonBackstageItem">
        <Grid x:Name="wrapper" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="PointerOverVisual" To="1" Duration="0:0:0.1"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Selected">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="PointerOverVisual" To="1" Duration="0:0:0.1"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="HeaderElement" To="{ThemeResource TelerikRibbonView_DisabledOpacity}" Duration="0:0:0.1"/>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="BackgroundVisual" To="0" Duration="0:0:0.1"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="ButtonStates">
                    <VisualState x:Name="ButtonNormal"/>
                    <VisualState x:Name="ButtonPointerOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="PointerOverVisual" To="1" Duration="0:0:0.1"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="TabItemStates">
                    <VisualState x:Name="TabItemUnSelected"/>
                    <VisualState x:Name="TabItemPointerOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="PointerOverVisual" To="1" Duration="0:0:0.1"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="TabItemSelected">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="SelectedVisual" To="1" Duration="0:0:0.1"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border Name="BackgroundVisual" Background="{TemplateBinding Background}"/>
            <Border Name="PointerOverVisual" Background="{ThemeResource TelerikRibbonView_Backstage_ItemBackgroundPointerOver}" Opacity="0"/>
            <Border Name="SelectedVisual" Background="{ThemeResource TelerikRibbonView_Backstage_ItemBackgroundSelected}" Opacity="0"/>
            <StackPanel Orientation="Horizontal" x:Name="ContentPanel" Margin="{TemplateBinding Padding}">
                <ContentPresenter x:Name="Icon"
                                  Content="{TemplateBinding Icon}"
                                  Foreground="{TemplateBinding HeaderForeground}"
                                  Margin="0 0 8 0"
                                  Visibility="Collapsed"/>
                <ContentControl x:Name="HeaderElement"
                                IsTabStop="False"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Foreground="{TemplateBinding HeaderForeground}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </StackPanel>
        </Grid>
    </ControlTemplate>

    <Style x:Key="RadRibbonBackstageItemStyle" TargetType="telerik:RadRibbonBackstageItem">
        <Setter Property="Template" Value="{StaticResource RadRibbonBackstageItemTemplate}"/>
        <Setter Property="Foreground" Value="{ThemeResource TelerikRibbonView_Backstage_ContentForeground}"/>
        <Setter Property="HeaderForeground" Value="{ThemeResource TelerikRibbonView_Backstage_ItemHeaderForeground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="MinWidth" Value="5"/>
        <Setter Property="MinHeight" Value="5"/>
        <Setter Property="Padding" Value="{ThemeResource TelerikRibbonView_Backstage_ItemPadding}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style TargetType="telerik:RadRibbonBackstageItem" BasedOn="{StaticResource RadRibbonBackstageItemStyle}"/>

    <ControlTemplate TargetType="telerik:RadRibbonButton" x:Key="BackstageCloseButtonTemplate">
        <Grid x:Name="Root" Background="{TemplateBinding Background}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="PointerOverVisual" To="1" Duration="0:0:0.1"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="PressedVisual" To="1" Duration="0:0:0.1"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="Root" To="{ThemeResource TelerikRibbonView_DisabledOpacity}" Duration="0:0:0.1"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border Name="PointerOverVisual"
                    Background="{ThemeResource TelerikRibbonView_Backstage_ItemBackgroundPointerOver}"
                    Opacity="0"/>
            <Border Name="PressedVisual"
                    Background="{ThemeResource TelerikRibbonView_Backstage_ItemBackgroundSelected}"
                    Opacity="0"/>
            <Viewbox Stretch="None" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                <ContentPresenter Content="{TemplateBinding LargeIcon}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="Left"
                                  Margin="{TemplateBinding Padding}"/>
            </Viewbox>
        </Grid>
    </ControlTemplate>

    <Style x:Key="BackstageCloseButtonStyle" TargetType="telerik:RadRibbonButton">
        <Setter Property="Template" Value="{StaticResource BackstageCloseButtonTemplate}"/>
        <Setter Property="Foreground" Value="{ThemeResource TelerikRibbonView_Backstage_ItemHeaderForeground}" />
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12 8"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="IsTabStop" Value="True"/>
		<Setter Property="UseSystemFocusVisuals" Value="True"/>
		<Setter Property="LargeIcon">
            <Setter.Value>
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="24"
                          Glyph="&#xE72B;"
                          VerticalAlignment="Center"/>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="BackstageTemplate" TargetType="telerik:RadRibbonBackstage">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="HeaderBackground"
                    Grid.RowSpan="2"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Background="{TemplateBinding HeaderBackground}"
                    MinWidth="{Binding ElementName=ItemsPresenter, Path=ActualWidth}"/>
            <telerik:RadRibbonButton x:Name="CloseButton"
                                     Width="{Binding ElementName=ItemsPresenter, Path=ActualWidth}"
                                     Style="{StaticResource BackstageCloseButtonStyle}"/>
            <Border x:Name="ContentBackground" Grid.Column="1" Grid.RowSpan="2"
                    Background="{ThemeResource TelerikRibbonView_Backstage_ContentBackground}"/>
            <Border x:Name="TitleBackground" Grid.Column="1" Background="{ThemeResource TelerikRibbonView_Backstage_TitleBarBackground}">
                <telerikRibbonViewPrimitives:WindowTitle x:Name="WindowTitle"
                                                         Foreground="{ThemeResource TelerikRibbonView_Backstage_HeaderForeground}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
            </Border>
            <ScrollViewer Grid.ColumnSpan="2"
                          Grid.Row="1"
                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                          BorderThickness="0"
                          Padding="0"
                          Background="{x:Null}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ItemsPresenter x:Name="ItemsPresenter"/>
                    <Grid x:Name="ContentBorder" Grid.Column="1" Background="{TemplateBinding Background}">
                        <ContentPresenter x:Name="ContentElement"
                                          Foreground="{TemplateBinding Foreground}"
                                          Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsContentPreserved, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" 
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                        <Grid x:Name="ContentElementsPanel" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsContentPreserved, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </ControlTemplate>

    <Style x:Key="RadRibbonBackstageStyle" TargetType="telerik:RadRibbonBackstage">
        <Setter Property="Template" Value="{StaticResource BackstageTemplate}"/>
        <Setter Property="Foreground" Value="{ThemeResource TelerikRibbonView_Backstage_ContentForeground}"/>
        <Setter Property="Background" Value="{ThemeResource TelerikRibbonView_Backstage_ContentBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TelerikRibbonView_Backstage_BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0 0 1 0"/>
        <Setter Property="HeaderBackground" Value="{ThemeResource TelerikRibbonView_Backstage_HeaderBackground}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="ItemContainerStyleSelector">
            <Setter.Value>
                <telerik:BackstageContainerStyleSelector SeparatorStyle="{StaticResource BackstageGroupSeparator}" />
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel MinWidth="170"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style TargetType="telerik:RadRibbonBackstage" BasedOn="{StaticResource RadRibbonBackstageStyle}"/>
</ResourceDictionary>

