<UserControl x:Class="SamaHesab.WPF.Views.POS.RestaurantPosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <Style x:Key="CatTile" TargetType="Button">
            <Setter Property="Height" Value="62"/><Setter Property="Width" Value="92"/>
            <Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="FoodTile" TargetType="Button">
            <Setter Property="Height" Value="84"/><Setter Property="Width" Value="150"/>
            <Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#EEF1F7"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccent}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- top bar -->
            <RowDefinition Height="*"/>      <!-- body -->
        </Grid.RowDefinitions>

        <!-- ═══ Top bar: order type + table + people + quick search ═══ -->
        <Border Grid.Row="0" Style="{StaticResource ErpToolbar}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="صورتحساب:" Style="{StaticResource ErpInlineLabel}"/>
                    <Button Content="سالن" Width="64" Height="34" Margin="2,0" Command="{Binding SetOrderTypeCommand}" CommandParameter="سالن"
                            Background="{DynamicResource PrimaryAccent}" Foreground="White" BorderThickness="0"/>
                    <Button Content="بیرون" Width="64" Height="34" Margin="2,0" Command="{Binding SetOrderTypeCommand}" CommandParameter="بیرون" Style="{StaticResource SecondaryButton}"/>
                    <Button Content="پیک" Width="64" Height="34" Margin="2,0" Command="{Binding SetOrderTypeCommand}" CommandParameter="پیک" Style="{StaticResource SecondaryButton}"/>
                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="8,4"/>
                    <TextBlock Text="میز:" Style="{StaticResource ErpInlineLabel}"/>
                    <TextBox Text="{Binding TableNumber}" Width="70" Height="32"/>
                    <TextBlock Text="نفرات:" Style="{StaticResource ErpInlineLabel}" Margin="10,0,6,0"/>
                    <TextBox Text="{Binding People}" Width="60" Height="32"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBox Text="{Binding QuickSearch, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentTime}" Style="{StaticResource ErpInlineLabel}" Margin="14,0,0,0"/>
                    <Button Content="⚙ سرور" Height="32" Margin="14,0,0,0" Style="{StaticResource SecondaryButton}"
                            ToolTip="تنظیمات اتصال به سرور (IP)" Click="ServerSettings_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Body: menu (right) + order (left) ═══ -->
        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>     <!-- menu (renders on the right in RTL) -->
                <ColumnDefinition Width="560"/>   <!-- order (left) -->
            </Grid.ColumnDefinitions>

            <!-- MENU -->
            <Border Grid.Column="0" Style="{StaticResource ErpCardPanel}" Padding="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,0,0,4" Margin="0,0,0,4">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CatTile}" Content="{Binding Name}"
                                            Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding MenuItems}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FoodTile}"
                                            Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Price, StringFormat={}{0:#,##0}}" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource PrimaryAccent}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ORDER -->
            <Grid Grid.Column="1" Margin="4,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ErpCardPanel}" Padding="0">
                    <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding OrderLines}"
                                         RowHeight="34"
                                        
                                         FontFamily="{StaticResource VazirFont}" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Row}" Width="40"/>
                            <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*"/>
                            <DataGridTemplateColumn Header="تعداد" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="−" Width="28" Height="26" Command="{Binding DataContext.DecCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Qty, StringFormat={}{0:#,##0.##}}" Width="36" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Content="+" Width="28" Height="26" Command="{Binding DataContext.IncCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="فی" Binding="{Binding UnitPrice, StringFormat={}{0:#,##0}}" Width="110"/>
                            <DataGridTextColumn Header="جمع" Binding="{Binding LineTotal, StringFormat={}{0:#,##0}}" Width="120"/>
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="30" Height="26" Background="Transparent" BorderThickness="0"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Foreground="{DynamicResource DangerColor}" Width="18" Height="18"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- totals + actions -->
                <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}" Margin="3,4,3,0" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                        <!-- totals -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="جمع فاکتور" Foreground="{DynamicResource SecondaryText}"/><TextBlock DockPanel.Dock="Left" Text="{Binding SubTotal, StringFormat={}{0:#,##0}}"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="تخفیف" Foreground="{DynamicResource SecondaryText}"/><TextBox DockPanel.Dock="Left" Width="120" Height="26" Text="{Binding Discount}"/></DockPanel>
                            <DockPanel Margin="0,2"><CheckBox DockPanel.Dock="Right" Content="سرویس ٪" IsChecked="{Binding ServiceEnabled}"/><TextBlock DockPanel.Dock="Left" Text="{Binding ServiceAmount, StringFormat={}{0:#,##0}}"/></DockPanel>
                            <DockPanel Margin="0,2"><CheckBox DockPanel.Dock="Right" Content="مالیات" IsChecked="{Binding TaxEnabled}"/><TextBlock DockPanel.Dock="Left" Text="{Binding TaxAmount, StringFormat={}{0:#,##0}}"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="انعام" Foreground="{DynamicResource SecondaryText}"/><TextBox DockPanel.Dock="Left" Width="120" Height="26" Text="{Binding Tip}"/></DockPanel>
                            <Separator Margin="0,4"/>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="قابل پرداخت" FontWeight="Bold" FontSize="15"/><TextBlock DockPanel.Dock="Left" Text="{Binding GrandTotal, StringFormat={}{0:#,##0}}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryAccent}"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="نقد" Foreground="{DynamicResource SecondaryText}"/><TextBox DockPanel.Dock="Left" Width="120" Height="26" Text="{Binding CashPaid}"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="POS" Foreground="{DynamicResource SecondaryText}"/><TextBox DockPanel.Dock="Left" Width="120" Height="26" Text="{Binding PosPaid}"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="مانده" Foreground="{DynamicResource SecondaryText}"/><TextBlock DockPanel.Dock="Left" Text="{Binding Remain, StringFormat={}{0:#,##0}}" FontWeight="Bold" Foreground="{DynamicResource DangerColor}"/></DockPanel>
                        </StackPanel>

                        <!-- actions -->
                        <StackPanel Grid.Column="1" Width="150">
                            <Button Height="64" Background="{DynamicResource DangerColor}" Foreground="White" BorderThickness="0" Command="{Binding CheckoutCommand}">
                                <StackPanel><materialDesign:PackIcon Kind="CheckBold" Width="24" Height="24" HorizontalAlignment="Center"/><TextBlock Text="پرداخت (F12)" TextAlignment="Center" FontWeight="Bold"/></StackPanel>
                            </Button>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Height="40" Margin="0,0,3,0" Background="{DynamicResource WarningColor}" Foreground="White" BorderThickness="0" Content="تیکت" Command="{Binding PrintTicketCommand}"/>
                                <Button Grid.Column="1" Height="40" Margin="3,0,0,0" Style="{StaticResource SuccessButton}" Content="چاپ" Command="{Binding PrintBillCommand}"/>
                            </Grid>
                            <Button Height="38" Margin="0,6,0,0" Style="{StaticResource SecondaryButton}" Content="سفارش جدید" Command="{Binding NewOrderCommand}"/>
                            <Button Height="34" Margin="0,6,0,0" Style="{StaticResource SecondaryButton}" Content="پاک کردن" Command="{Binding ClearCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
