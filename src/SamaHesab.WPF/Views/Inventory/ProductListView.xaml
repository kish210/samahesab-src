<UserControl x:Class="SamaHesab.WPF.Views.Inventory.ProductListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <!-- CC-4 — میان‌برِ استانداردِ لیست: F5 بازخوانی · F2 جدید -->
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="F2" Command="{Binding NewProductCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- compact toolbar + filters (one strip) -->
            <RowDefinition Height="*"/>      <!-- grid (expanded, 25+ rows) -->
            <RowDefinition Height="Auto"/>   <!-- slim footer -->
        </Grid.RowDefinitions>

        <!-- ═══ Compact toolbar: actions (left) + filters (right) in one strip ═══ -->
        <Border Grid.Row="0" Style="{StaticResource ErpToolbar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- actions -->
                    <ColumnDefinition Width="*"/>      <!-- filters -->
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ErpToolButton}" Command="{Binding NewProductCommand}">
                        <StackPanel><Path Data="{StaticResource IcPlusBox}" Style="{StaticResource ErpToolSvg}" Width="18" Height="18" HorizontalAlignment="Center" Stroke="{DynamicResource PrimaryAccent}"/><TextBlock Text="کالای جدید" TextAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ErpToolButton}" Command="{Binding EditProductCommand}">
                        <StackPanel><Path Data="{StaticResource IcPencil}" Style="{StaticResource ErpToolSvg}" Width="18" Height="18" HorizontalAlignment="Center" Stroke="{DynamicResource WarningColor}"/><TextBlock Text="ویرایش" TextAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ErpToolButton}" Command="{Binding DeleteProductCommand}">
                        <StackPanel><Path Data="{StaticResource IcTrash}" Style="{StaticResource ErpToolSvg}" Width="18" Height="18" HorizontalAlignment="Center" Stroke="{DynamicResource DangerColor}"/><TextBlock Text="حذف" TextAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ErpToolButton}" Command="{Binding ExportExcelCommand}">
                        <StackPanel><Path Data="{StaticResource IcExcel}" Style="{StaticResource ErpToolSvg}" Width="18" Height="18" HorizontalAlignment="Center" Stroke="{DynamicResource SuccessColor}"/><TextBlock Text="اکسل" TextAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ErpToolButton}" Command="{Binding RefreshCommand}">
                        <StackPanel><Path Data="{StaticResource IcRefresh}" Style="{StaticResource ErpToolSvg}" Width="18" Height="18" HorizontalAlignment="Center" Stroke="{DynamicResource SecondaryText}"/><TextBlock Text="بروزرسانی" TextAlignment="Center"/></StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="6,6"/>
                </StackPanel>

                <!-- filters inline -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Path Data="{StaticResource IcSearch}" Style="{StaticResource ErpToolSvg}" Width="18" Height="18" VerticalAlignment="Center" Stroke="{DynamicResource SecondaryText}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="6,0" VerticalAlignment="Center">
                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="گروه" Style="{StaticResource ErpInlineLabel}" Margin="10,0,6,0"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" Width="180" Height="30"
                              ItemsSource="{Binding Groups}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedGroupId}"/>
                    <CheckBox Content="نمایش غیرفعال‌ها" IsChecked="{Binding ShowInactive}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Expanded dense grid (25+ rows visible) ═══ -->
        <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}" Margin="3" Padding="0">
            <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" x:Name="grid"
                                 ItemsSource="{Binding Products}"
                                 SelectedItem="{Binding SelectedProduct}"
                                 RowHeight="28">
                <!-- CC-5 — دابل‌کلیک/راست‌کلیک → کارتِ ۳۶۰°ِ کالا -->
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenCardCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📦 کارتِ کالا (۳۶۰°)"
                                  Command="{Binding PlacementTarget.DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="90"/>
                    <DataGridTextColumn Header="بارکد" Binding="{Binding Barcode}" Width="130"/>
                    <DataGridTextColumn Header="نام کالا" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="قیمت خرید" Binding="{Binding PurchasePrice, StringFormat={}{0:#,##0}}" Width="120"/>
                    <DataGridTextColumn Header="قیمت فروش" Binding="{Binding SalePrice, StringFormat={}{0:#,##0}}" Width="120"/>
                    <DataGridTextColumn Header="قیمت عمده" Binding="{Binding WholesalePrice, StringFormat={}{0:#,##0}}" Width="120"/>
                    <DataGridTextColumn Header="حداقل موجودی" Binding="{Binding MinStock, StringFormat={}{0:#,##0}}" Width="110"/>
                    <DataGridTemplateColumn Header="وضعیت" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FDE8E8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#E3F6EC"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="غیرفعال"/>
                                                <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Text" Value="فعال"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- T16: هشدارِ کسریِ موجودی (زیرِ حداقل) -->
                    <DataGridTemplateColumn Header="هشدار" Width="80" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Background="#FDE8E8" Padding="7,2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsLowStock, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="⚠ کسری" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DangerColor}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══ Slim footer ═══ -->
        <Border Grid.Row="2" Style="{StaticResource ErpToolbar}" BorderThickness="0,1,0,0">
            <DockPanel Margin="4,2">
                <TextBlock DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center">
                    <Run Text="تعداد کل کالاها:"/>
                    <Run Text="{Binding TotalCount}" FontWeight="Bold"/>
                    <Run Text="   |   فعال:"/>
                    <Run Text="{Binding ActiveCount}" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}"/>
                    <Run Text="   |   زیرِ حداقل:"/>
                    <Run Text="{Binding LowStockCount}" FontWeight="Bold" Foreground="{DynamicResource DangerColor}"/>
                </TextBlock>
                <TextBlock DockPanel.Dock="Left" Text="Enter=جستجو · دابل‌کلیک=ویرایش"
                           FontSize="11" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
