<UserControl x:Class="SamaHesab.WPF.Views.Inventory.InventoryReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <!-- F5 = اجرای/تازه‌سازیِ گزارش (کیبوردمحور، هم‌راستا با بقیهٔ صفحات) -->
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="گزارش موجودی و ارزش انبار" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
            <TextBlock Text="موجودی و ارزشِ کالاها به بهای میانگین موزون — همهٔ انبارها یا یک انبار."
                       Foreground="{DynamicResource SecondaryText}" FontSize="12.5" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- نوار ابزار -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="انبار:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" Margin="0,0,8,0"/>
            <ComboBox Width="200" Height="30" ItemsSource="{Binding Warehouses}" DisplayMemberPath="Display"
                      SelectedValuePath="Id" SelectedValue="{Binding SelectedWarehouseId}"/>
            <TextBox Width="200" Height="30" Margin="10,0,0,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="7,0"
                     Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}"
                     BorderBrush="{DynamicResource BorderColor}"/>
            <Button Content="نمایش" Command="{Binding RunCommand}" Margin="10,0,0,0" Padding="16,6" Cursor="Hand"
                    Background="{DynamicResource PrimaryAccent}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
            <Button Content="اکسل" Command="{Binding ExportCsvCommand}" Margin="6,0,0,0" Padding="12,6" Cursor="Hand"
                    Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"/>
            <Button Content="PDF" Command="{Binding ExportPdfCommand}" Margin="6,0,0,0" Padding="12,6" Cursor="Hand"
                    Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"/>
            <Button Content="چاپ" Command="{Binding PrintCommand}" Margin="6,0,0,0" Padding="12,6" Cursor="Hand"
                    Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"/>
        </StackPanel>

        <!-- گرید -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="All" RowHeight="{DynamicResource ErpDensRowHeight}" FontSize="12.5"
                  Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}"
                  CanUserAddRows="False" Foreground="{DynamicResource PrimaryText}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="120"/>
                <DataGridTextColumn Header="نام کالا" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="موجودی" Binding="{Binding Quantity, Converter={StaticResource Num}}" Width="120"/>
                <DataGridTextColumn Header="بهای میانگین" Binding="{Binding AverageCost, Converter={StaticResource Num}}" Width="140"/>
                <DataGridTextColumn Header="ارزش (ریال)" Binding="{Binding Value, Converter={StaticResource Num}}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- جمع -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="تعداد اقلام:" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ItemCount, Converter={StaticResource Num}}" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" Margin="6,0,24,0"/>
                <TextBlock Text="ارزش کل موجودی:" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalValue, Converter={StaticResource Num}, ConverterParameter=ریال}"
                           FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
