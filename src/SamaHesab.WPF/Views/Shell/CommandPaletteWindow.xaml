<Window x:Class="SamaHesab.WPF.Views.Shell.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        SizeToContent="Manual" Width="600" Height="460"
        FlowDirection="RightToLeft" FontFamily="{StaticResource VazirFont}">
    <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1" CornerRadius="10" Padding="2">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.45" Color="Black"/></Border.Effect>
        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- جعبهٔ ورودی -->
            <Border Grid.Row="0" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"
                    BorderThickness="1" CornerRadius="6" Margin="4,4,4,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⌘" FontSize="16" Foreground="{DynamicResource SecondaryText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="PaletteBox" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource PrimaryText}" CaretBrush="{DynamicResource PrimaryText}"
                             FontSize="15" Padding="10,12" VerticalContentAlignment="Center"
                             TextChanged="PaletteBox_TextChanged" PreviewKeyDown="PaletteBox_PreviewKeyDown"/>
                </Grid>
            </Border>

            <!-- نتایج -->
            <ListBox Grid.Row="1" x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="Results_Activate" KeyDown="ResultsList_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryText}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SecondaryText}" FontSize="10.5"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource InputBackground}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Group}" Foreground="{DynamicResource SecondaryText}" FontSize="10"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- راهنمای میان‌بر -->
            <TextBlock Grid.Row="2" Foreground="{DynamicResource SecondaryText}" FontSize="10.5" Margin="6,8,6,2"
                       Text="↑/↓ حرکت · Enter بازکردن · Esc بستن"/>
        </Grid>
    </Border>
</Window>
