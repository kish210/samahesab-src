<UserControl x:Class="SamaHesab.WPF.Views.TaxInvoicing.TaxInvoicingSubmissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusColor"/>
        <Style x:Key="ActBtn" TargetType="Button">
            <Setter Property="Margin" Value="2,0"/><Setter Property="Padding" Value="9,2"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="11.5"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,8">
            <TextBlock Text="صورتحساب‌هایِ الکترونیکیِ مودیان" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="فاکتورهایِ فروشِ صف‌شده برایِ ارسال به سامانهٔ مودیان و وضعیتِ هر ارسال."
                       Foreground="{DynamicResource SecondaryText}" FontSize="11.5" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="وضعیت:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="150" Height="30" ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Display"
                      SelectedItem="{Binding SelectedStatusOption}"/>
            <Button Content="↻ بروزرسانی" Command="{Binding RunCommand}" Margin="8,0,0,0" Padding="12,6"
                    Cursor="Hand" Style="{StaticResource ErpBtnSecondary}"/>
            <Button Content="↻ تلاشِ مجددِ همهٔ موارد" Command="{Binding RetryAllPendingCommand}"
                    Style="{StaticResource ActBtn}" Background="#3498DB" Padding="12,6" Margin="6,0,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" RowHeight="{DynamicResource ErpDensRowHeight}" FontSize="12.5"
                  AlternatingRowBackground="{DynamicResource SurfaceBackground}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="شمارهٔ فاکتور" Binding="{Binding SalesInvoiceId}" Width="90"/>
                <DataGridTemplateColumn Header="وضعیت" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{Binding Status, Converter={StaticResource StatusColor}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="شناسهٔ یکتایِ مالیاتی" Binding="{Binding UniqueTaxId}" Width="180"/>
                <DataGridTextColumn Header="شمارهٔ مرجع" Binding="{Binding ReferenceNumber}" Width="140"/>
                <DataGridTextColumn Header="خطا" Binding="{Binding ErrorMessage}" Width="*"/>
                <DataGridTextColumn Header="تعدادِ تلاش" Binding="{Binding RetryCount}" Width="80"/>
                <DataGridTextColumn Header="تاریخِ ثبت" Binding="{Binding CreatedAt}" Width="140"/>
                <DataGridTemplateColumn Header="عملیات" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="تلاشِ مجدد" Style="{StaticResource ActBtn}" Background="#2E7D52"
                                    Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
