<UserControl x:Class="SamaHesab.WPF.Views.POS.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             Background="{DynamicResource AppBackground}"
             FlowDirection="RightToLeft">

    <UserControl.InputBindings>
        <KeyBinding Key="F1" Command="{Binding NewSaleCommand}"/>
        <KeyBinding Key="F12" Command="{Binding CheckoutCommand}"/>
        <KeyBinding Key="F8" Command="{Binding PrintReceiptCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Cart -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search / Barcode Bar -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource PrimaryAccent}"
                            BorderThickness="2" CornerRadius="8" Margin="0,0,12,0">
                        <TextBox x:Name="BarcodeBox" Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}"
                                 Padding="12,10" FontFamily="{StaticResource VazirFont}" FontSize="16">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ProcessBarcodeCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Border>
                    <Button Grid.Column="1" Content="🔍 جستجو" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,0,8,0" Command="{Binding ProcessBarcodeCommand}"/>
                    <Button Grid.Column="2" Content="🗑 پاک کردن (F1)" Style="{StaticResource SecondaryButton}" Height="42" Command="{Binding NewSaleCommand}"/>
                    <Button Grid.Column="3" Content="⚙ سرور" Style="{StaticResource SecondaryButton}" Height="42" Margin="8,0,0,0"
                            ToolTip="تنظیمات اتصال به سرور (IP)" Click="ServerSettings_Click"/>
                </Grid>
            </Border>

            <!-- Cart Items -->
            <telerik:RadGridView Grid.Row="1" ItemsSource="{Binding CartItems}" AutoGenerateColumns="False"
                      CanUserInsertRows="False" CanUserDeleteRows="False" RowIndicatorVisibility="Collapsed"
                      ShowGroupPanel="False" FontFamily="{StaticResource VazirFont}">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="کد" DataMemberBinding="{Binding ProductCode}" Width="80" IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="نام کالا" DataMemberBinding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="تعداد" DataMemberBinding="{Binding Quantity}" Width="70"/>
                    <telerik:GridViewDataColumn Header="قیمت (ریال)" DataMemberBinding="{Binding UnitPrice}" DataFormatString="{}{0:N0}" Width="120"/>
                    <telerik:GridViewDataColumn Header="مالیات" DataMemberBinding="{Binding TaxAmount}" DataFormatString="{}{0:N0}" Width="90" IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="جمع (ریال)" DataMemberBinding="{Binding NetAmount}" DataFormatString="{}{0:N0}" Width="130" IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Width="50" IsReadOnly="True">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" Style="{StaticResource IconButton}" Foreground="{DynamicResource DangerColor}"
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>

            <!-- Quick Products (frequent items) -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="12,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏱ کالاهای پرفروش:" Foreground="{DynamicResource SecondaryText}"
                               FontFamily="{StaticResource VazirFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding CurrentTime}" Foreground="{DynamicResource WarningColor}"
                               FontFamily="{StaticResource VazirFont}" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- RIGHT: Payment Panel -->
        <Border Grid.Column="1" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Receipt Info -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <Grid>
                        <TextBlock Text="رسید فروش" FontWeight="Bold" FontSize="16"
                                   FontFamily="{StaticResource VazirFont}" Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock Text="{Binding ReceiptNumber}" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource PrimaryAccent}"
                                   FontFamily="{StaticResource VazirFont}" FontSize="12"/>
                    </Grid>
                    <!-- Customer -->
                    <TextBlock Text="مشتری (اختیاری):" Foreground="{DynamicResource SecondaryText}"
                               FontFamily="{StaticResource VazirFont}" FontSize="12" Margin="0,12,0,4"/>
                    <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="6">
                        <TextBox Text="{Binding SelectedCustomerName}" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryText}" Padding="10,8"
                                 FontFamily="{StaticResource VazirFont}"/>
                    </Border>
                </StackPanel>

                <!-- Totals -->
                <StackPanel Grid.Row="1">
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8"><TextBlock Text="جمع کل:" FontFamily="{StaticResource VazirFont}" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="{Binding SubTotal, StringFormat='{}{0:N0}'}" HorizontalAlignment="Left" FontFamily="{StaticResource VazirFont}" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold"/></Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="تخفیف:" FontFamily="{StaticResource VazirFont}" Foreground="{DynamicResource SecondaryText}"/>
                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Left" Width="100">
                                    <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource DangerColor}" Padding="8,4" FontFamily="{StaticResource VazirFont}"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,8"><TextBlock Text="مالیات:" FontFamily="{StaticResource VazirFont}" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="{Binding Tax, StringFormat='{}{0:N0}'}" HorizontalAlignment="Left" FontFamily="{StaticResource VazirFont}" Foreground="{DynamicResource WarningColor}"/></Grid>
                            <Border Height="1" Background="{DynamicResource SeparatorColor}" Margin="0,4"/>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="مبلغ قابل پرداخت:" FontWeight="Bold" FontSize="14" FontFamily="{StaticResource VazirFont}" Foreground="{DynamicResource PrimaryText}"/>
                                <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N0}'}" HorizontalAlignment="Left" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource WarningColor}" FontFamily="{StaticResource VazirFont}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Payment Mode -->
                    <TextBlock Text="روش پرداخت:" Foreground="{DynamicResource SecondaryText}"
                               FontFamily="{StaticResource VazirFont}" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding PaymentMode}"
                              Height="38" Margin="0,0,0,12">
                        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource BaseComboBox}"/></ComboBox.Style>
                    </ComboBox>

                    <TextBlock Text="مبلغ دریافتی:" Foreground="{DynamicResource SecondaryText}"
                               FontFamily="{StaticResource VazirFont}" FontSize="12" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="2" CornerRadius="8" Margin="0,0,0,12">
                        <TextBox Text="{Binding CashReceived, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SuccessColor}"
                                 Padding="12,10" FontFamily="{StaticResource VazirFont}" FontSize="18" FontWeight="Bold"/>
                    </Border>

                    <Border Background="#05966920" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="باقیمانده:" FontFamily="{StaticResource VazirFont}" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding Change, StringFormat='{}{0:N0} ریال'}" HorizontalAlignment="Left"
                                       Foreground="#059669" FontFamily="{StaticResource VazirFont}"
                                       FontWeight="Bold" FontSize="18"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Checkout Button -->
                <StackPanel Grid.Row="2">
                    <Button Content="✓ پرداخت و صدور رسید (F12)"
                            Style="{StaticResource SuccessButton}" Height="52" FontSize="15"
                            FontFamily="{StaticResource VazirFont}" Margin="0,0,0,8"
                            Command="{Binding CheckoutCommand}"/>
                    <Button Content="🖨 چاپ آخرین رسید (F8)"
                            Style="{StaticResource SecondaryButton}" Height="38" FontSize="13"
                            FontFamily="{StaticResource VazirFont}"
                            Command="{Binding PrintReceiptCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
