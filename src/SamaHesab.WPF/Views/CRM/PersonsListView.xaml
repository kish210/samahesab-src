<UserControl x:Class="SamaHesab.WPF.Views.CRM.PersonsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{StaticResource ErpAppBg}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource ErpBtnGhost}">
            <Setter Property="Height" Value="30"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- نوار بالا -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="اشخاص (طرف‌حساب)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource Chip}" Content="همه" Command="{Binding SetRoleCommand}" CommandParameter="all"/>
                    <Button Style="{StaticResource Chip}" Content="مشتری" Command="{Binding SetRoleCommand}" CommandParameter="customer"/>
                    <Button Style="{StaticResource Chip}" Content="تأمین‌کننده" Command="{Binding SetRoleCommand}" CommandParameter="supplier"/>
                    <Button Style="{StaticResource Chip}" Content="کارمند" Command="{Binding SetRoleCommand}" CommandParameter="employee"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBox Style="{StaticResource ErpInput}" Width="220" Height="30" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <Button Style="{StaticResource ErpBtnGhost}" Height="30" Padding="12,0" Margin="5,0,0,0" Command="{Binding SearchCommand}" Content="🔍 جستجو"/>
                    <Button Style="{StaticResource ErpBtnPrimary}" Height="30" Padding="12,0" Margin="5,0,0,0" Command="{Binding NewCustomerCommand}" Content="＋ مشتری"/>
                    <Button Style="{StaticResource ErpBtnSecondary}" Height="30" Padding="12,0" Margin="5,0,0,0" Command="{Binding NewSupplierCommand}" Content="＋ تأمین‌کننده"/>
                    <Button Style="{StaticResource ErpBtnGhost}" Height="30" Padding="12,0" Margin="5,0,0,0" Command="{Binding ExportCommand}" Content="اکسل"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- گرید -->
        <Border Grid.Row="1" Style="{StaticResource ErpGbox}" Padding="0">
            <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      ItemsSource="{Binding Persons}" RowHeight="{DynamicResource ErpDensRowHeight}" GridLinesVisibility="All" BorderThickness="0" FontFamily="{StaticResource VazirFont}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="100"/>
                    <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*"/>
                    <DataGridTemplateColumn Header="نوع" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource ErpBlue50}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSupplier}" Value="True">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ErpTextBody}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile}" Width="130">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="مانده" Binding="{Binding Balance, StringFormat={}{0:#,##0}}" Width="140">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="وضعیت" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" Text="فعال" Foreground="{StaticResource ErpSuccess700}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Text" Value="غیرفعال"/>
                                                    <Setter Property="Foreground" Value="{StaticResource ErpTextMuted}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- نوار جمع -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="تعداد:" Foreground="{StaticResource ErpTextMuted}" FontSize="12"/>
                <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" FontSize="12" Margin="4,0,0,0"/>
                <TextBlock Text="جمعِ مانده:" Foreground="{StaticResource ErpTextMuted}" FontSize="12" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding TotalBalance, Converter={StaticResource Num}}" FontWeight="Bold" FontSize="12" FlowDirection="LeftToRight" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
