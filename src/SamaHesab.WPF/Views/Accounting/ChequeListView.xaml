<UserControl x:Class="SamaHesab.WPF.Views.Accounting.ChequeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ErpToolbar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ErpToolButton}" Command="{Binding ClearChequeCommand}">
                    <StackPanel><materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{DynamicResource SuccessColor}"/><TextBlock Text="وصول" TextAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ErpToolButton}" Command="{Binding ReturnChequeCommand}">
                    <StackPanel><materialDesign:PackIcon Kind="UndoVariant" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{DynamicResource DangerColor}"/><TextBlock Text="برگشت" TextAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ErpToolButton}" Command="{Binding SearchCommand}">
                    <StackPanel><materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="بروزرسانی" TextAlignment="Center"/></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}" Margin="3" Padding="0">
            <telerik:RadGridView ItemsSource="{Binding Cheques}" Style="{StaticResource ErpGrid}"
                                 IsReadOnly="True" ShowSearchPanel="True" ShowGroupPanel="True" ShowColumnFooters="True">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="نوع" DataMemberBinding="{Binding Type}" Width="80"/>
                    <telerik:GridViewDataColumn Header="شماره چک" DataMemberBinding="{Binding Number}" Width="120"/>
                    <telerik:GridViewDataColumn Header="بانک" DataMemberBinding="{Binding Bank}" Width="*"/>
                    <telerik:GridViewDataColumn Header="مبلغ" DataMemberBinding="{Binding Amount}" DataFormatString="{}{0:#,##0}" Width="140">
                        <telerik:GridViewDataColumn.AggregateFunctions>
                            <telerik:SumFunction ResultFormatString="{}{0:#,##0}"/>
                        </telerik:GridViewDataColumn.AggregateFunctions>
                    </telerik:GridViewDataColumn>
                    <telerik:GridViewDataColumn Header="سررسید" DataMemberBinding="{Binding DueDate}" Width="110"/>
                    <telerik:GridViewDataColumn Header="وضعیت" DataMemberBinding="{Binding Status}" Width="110"/>
                    <telerik:GridViewDataColumn Header="صادرکننده" DataMemberBinding="{Binding IssuedBy}" Width="150"/>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ErpToolbar}" BorderThickness="0,1,0,0">
            <TextBlock FontSize="12" HorizontalAlignment="Right" Margin="4,2" VerticalAlignment="Center">
                <Run Text="تعداد چک:"/><Run Text="{Binding TotalCount}" FontWeight="Bold"/>
                <Run Text="   |   جمع مبلغ:"/><Run Text="{Binding TotalAmount, StringFormat={}{0:#,##0}}" FontWeight="Bold"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
