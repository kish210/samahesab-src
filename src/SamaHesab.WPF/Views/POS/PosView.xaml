<UserControl x:Class="SamaHesab.WPF.Views.POS.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft"
             Background="#F4F5F7">

    <UserControl.InputBindings>
        <KeyBinding Key="Return" Command="{Binding CheckoutCommand}"/>
        <KeyBinding Key="F1" Command="{Binding NewSaleCommand}"/>
        <KeyBinding Key="F12" Command="{Binding CheckoutCommand}"/>
        <KeyBinding Key="F8" Command="{Binding PrintReceiptCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>

        <!-- تایل کالا -->
        <Style x:Key="PItem" TargetType="Button">
            <Setter Property="Height" Value="78"/><Setter Property="Width" Value="156"/>
            <Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" Padding="11,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#9DB0DA"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#EEF2FB"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- چیپ دسته -->
        <Style x:Key="Cat" TargetType="Button">
            <Setter Property="Height" Value="42"/><Setter Property="Padding" Value="16,0"/><Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>   <!-- سبد (چپ در RTL) -->
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>      <!-- کالاها -->
        </Grid.ColumnDefinitions>

        <!-- ═══ سبد + پرداخت ═══ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- سبد -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F6F7F9" CornerRadius="9,9,0,0" Padding="12,9" BorderBrush="{StaticResource ErpBorder}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Text="{Binding ReceiptNumber, StringFormat='فاکتور صندوق {0}'}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource ErpBlue700}"/>
                            <TextBlock DockPanel.Dock="Left" Text="مشتری: متفرقه" FontSize="11.5" Foreground="{StaticResource ErpTextMuted}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CartItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0F1F3" BorderThickness="0,0,0,1" Padding="12,7">
                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <Button Content="−" Width="30" Height="30" Cursor="Hand" Background="White" BorderBrush="{StaticResource ErpBorder}"
                                                        Command="{Binding DataContext.DecItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding Quantity}" Width="32" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button Content="+" Width="30" Height="30" Cursor="Hand" Background="White" BorderBrush="{StaticResource ErpBorder}"
                                                        Command="{Binding DataContext.IncItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding NetAmount, Converter={StaticResource Num}}" Width="92" TextAlignment="Left" FlowDirection="LeftToRight"
                                                           FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Quantity}" FontSize="10.5" Foreground="{StaticResource ErpTextMuted}"/>
                                                    <TextBlock Text=" × " FontSize="10.5" Foreground="{StaticResource ErpTextMuted}"/>
                                                    <TextBlock Text="{Binding UnitPrice, Converter={StaticResource Num}}" FontSize="10.5" Foreground="{StaticResource ErpTextMuted}" FlowDirection="LeftToRight"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- جمع‌ها -->
                    <StackPanel Grid.Row="2">
                        <DockPanel Margin="14,5"><TextBlock Text="جمع اقلام" FontSize="12" Foreground="{StaticResource ErpTextMuted}"/><TextBlock DockPanel.Dock="Left" Text="{Binding SubTotal, Converter={StaticResource Num}}" FontWeight="SemiBold" FlowDirection="LeftToRight"/></DockPanel>
                        <DockPanel Margin="14,3"><TextBlock Text="تخفیف" FontSize="12" Foreground="{StaticResource ErpTextMuted}"/><TextBox DockPanel.Dock="Left" Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" Width="110" Height="26" FlowDirection="LeftToRight" TextAlignment="Left"/></DockPanel>
                        <DockPanel Margin="14,5"><TextBlock Text="مالیات ۹٪" FontSize="12" Foreground="{StaticResource ErpTextMuted}"/><TextBlock DockPanel.Dock="Left" Text="{Binding Tax, Converter={StaticResource Num}}" FontWeight="SemiBold" FlowDirection="LeftToRight"/></DockPanel>
                        <Border Background="{StaticResource ErpBlue700}" Padding="14,12">
                            <DockPanel>
                                <TextBlock Text="مبلغ قابل پرداخت" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding GrandTotal, Converter={StaticResource Num}}" Foreground="White" FontSize="24" FontWeight="Bold" FlowDirection="LeftToRight"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- دکمه‌های پرداخت -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Button Grid.Row="0" Height="62" Background="#16A34A" Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="16" FontWeight="Bold" Content="پرداخت نقدی — Enter" Command="{Binding CheckoutCommand}"/>
                <Grid Grid.Row="1" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Height="52" Background="White" BorderBrush="{StaticResource ErpBorder}" Cursor="Hand" Content="کارت‌خوان" FontWeight="SemiBold"/>
                    <Button Grid.Column="2" Height="52" Background="White" BorderBrush="{StaticResource ErpBorder}" Cursor="Hand" Content="نسیه" FontWeight="SemiBold"/>
                    <Button Grid.Column="4" Height="52" Background="White" BorderBrush="{StaticResource ErpBorder}" Cursor="Hand" Content="ترکیبی" FontWeight="SemiBold"/>
                </Grid>
            </Grid>

            <!-- ردیف توابع -->
            <Grid Grid.Row="2" Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Height="40" Background="White" BorderBrush="{StaticResource ErpBorder}" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5" Content="تعلیق فاکتور F4"/>
                <Button Grid.Column="2" Height="40" Background="White" BorderBrush="{StaticResource ErpBorder}" Foreground="{StaticResource ErpTextMuted}" FontSize="11.5" Content="بازیابی F5"/>
                <Button Grid.Column="4" Height="40" Background="White" BorderBrush="#E6BCBC" Foreground="#B91C1C" FontSize="11.5" Content="ابطال Esc" Command="{Binding NewSaleCommand}"/>
            </Grid>
        </Grid>

        <!-- ═══ کالاها ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <!-- جستجو/بارکد (R15: placeholder واقعی) -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                <Grid>
                    <TextBox x:Name="BarcodeBox" Height="42" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="12,0" FontSize="14"
                             Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding ProcessBarcodeCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="🔍  اسکن بارکد یا جستجوی کالا…  (F1)" Foreground="{StaticResource ErpTextMuted}" FontSize="14"
                               VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=BarcodeBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- دسته‌ها -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Cat}" Content="{Binding Name}"
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- شبکه‌ی کالا -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Products}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PItem}"
                                    Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#1F2937"/>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Price, Converter={StaticResource Num}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}" FlowDirection="LeftToRight"/>
                                            <TextBlock Text=" ریال" FontSize="11" Foreground="{StaticResource ErpTextMuted}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Code}" FontSize="10" Foreground="{StaticResource ErpTextMuted}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
