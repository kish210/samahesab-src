<UserControl x:Class="SamaHesab.WPF.Views.Accounting.VoucherEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft"
             Background="#F4F5F7">

    <!-- میان‌برهای کیبورد (طبق سند طراحی: F2/F7/F8/F9 + «=» توازن خودکار) -->
    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NewCommand}"/>
        <KeyBinding Key="F7" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="F8" Command="{Binding PrintCommand}"/>
        <KeyBinding Key="F9" Command="{Binding PostCommand}"/>
        <KeyBinding Key="OemPlus" Command="{Binding FillBalanceCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>

        <!-- توکن‌های برند -->
        <SolidColorBrush x:Key="Blue600" Color="#4B5F97"/>
        <SolidColorBrush x:Key="Blue700" Color="#324A7A"/>
        <SolidColorBrush x:Key="Gold500" Color="#B18A5A"/>
        <SolidColorBrush x:Key="EntryBg" Color="#EEF2FB"/>
        <SolidColorBrush x:Key="EntryBorder" Color="#CFDAEF"/>
        <SolidColorBrush x:Key="Line" Color="#E3E6EC"/>
        <SolidColorBrush x:Key="HeadBg" Color="#EFF2F7"/>
        <SolidColorBrush x:Key="Zebra" Color="#FAFBFC"/>
        <SolidColorBrush x:Key="TextStrong" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>

        <!-- لیبل کوچک بالای فیلد -->
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="2,0,2,3"/>
        </Style>
        <!-- کنترل فرم (TextBox) ارتفاع ۳۲ -->
        <Style x:Key="InputC" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#CBD0D8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="NumC" TargetType="TextBox" BasedOn="{StaticResource InputC}">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="SelectC" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- دکمه‌ی تولبار: متن + بَج F-key -->
        <Style x:Key="TBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D5D9E0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F0F3F9"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Fk" TargetType="Border">
            <Setter Property="Background" Value="#EEF1F6"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ تولبار ═══ -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource TBtn}" Command="{Binding NewCommand}" Background="{StaticResource Blue600}" Foreground="White" BorderBrush="{StaticResource Blue600}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="جدید"/><Border Style="{StaticResource Fk}" Background="#5E6FA8"><TextBlock Text="F2" FontSize="10.5" Foreground="White"/></Border></StackPanel>
                </Button>
                <Button Style="{StaticResource TBtn}" Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="ذخیره"/><Border Style="{StaticResource Fk}"><TextBlock Text="F7" FontSize="10.5" Foreground="{StaticResource TextMuted}"/></Border></StackPanel>
                </Button>
                <Button Style="{StaticResource TBtn}" Command="{Binding PostCommand}" Background="#E8F5EC" BorderBrush="#A7D7B6">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="قطعی‌سازی" Foreground="#15803D"/><Border Style="{StaticResource Fk}" Background="#C9E9D2"><TextBlock Text="F9" FontSize="10.5" Foreground="#15803D"/></Border></StackPanel>
                </Button>
                <Border Width="1" Background="{StaticResource Line}" Margin="4,2"/>
                <Button Style="{StaticResource TBtn}" Command="{Binding CopyCommand}"><TextBlock Text="کپی سند"/></Button>
                <Button Style="{StaticResource TBtn}" Command="{Binding ReverseCommand}"><TextBlock Text="سند معکوس"/></Button>
                <Button Style="{StaticResource TBtn}" Command="{Binding PrintCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="چاپ"/><Border Style="{StaticResource Fk}"><TextBlock Text="F8" FontSize="10.5" Foreground="{StaticResource TextMuted}"/></Border></StackPanel>
                </Button>
                <Button Style="{StaticResource TBtn}" Command="{Binding CancelCommand}" Foreground="#B91C1C" BorderBrush="#E6BcBc"><TextBlock Text="انصراف"/></Button>
            </StackPanel>
        </Border>

        <!-- ═══ محتوا ═══ -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- هدر سند -->
                <RowDefinition Height="Auto"/>   <!-- ردیف ورود -->
                <RowDefinition Height="*"/>      <!-- گرید -->
                <RowDefinition Height="Auto"/>   <!-- نوار تراز -->
            </Grid.RowDefinitions>

            <!-- هدر سند (gbox) -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                <StackPanel>
                    <Border Background="{StaticResource HeadBg}" CornerRadius="8,8,0,0" Padding="12,7" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Text="مشخصات سند" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextStrong}"/>
                            <Border Background="#FDF3E3" CornerRadius="9" Padding="8,2" Margin="8,0,0,0">
                                <TextBlock Text="پیش‌نویس" FontSize="11" Foreground="#B7791F"/>
                            </Border>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding VoucherNumber, StringFormat='شماره: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/><ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="130"/><ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="150"/><ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="160"/><ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Style="{StaticResource Lbl}" Text="شماره سند"/><TextBox Style="{StaticResource InputC}" Text="{Binding VoucherNumber}" IsReadOnly="True" Background="#F3F4F6"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Lbl}" Text="تاریخ *"/><TextBox Style="{StaticResource InputC}" Text="{Binding VoucherDate}"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource Lbl}" Text="نوع سند"/>
                            <ComboBox Style="{StaticResource SelectC}" ItemsSource="{Binding VoucherTypes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedVoucherTypeId}"/></StackPanel>
                        <StackPanel Grid.Column="6"><TextBlock Style="{StaticResource Lbl}" Text="مرکز هزینه"/>
                            <ComboBox Style="{StaticResource SelectC}" ItemsSource="{Binding CostCenters}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedCostCenterId}"/></StackPanel>
                        <StackPanel Grid.Column="8"><TextBlock Style="{StaticResource Lbl}" Text="شرح سند"/><TextBox Style="{StaticResource InputC}" Text="{Binding Description}"/></StackPanel>
                        <StackPanel Grid.Column="10"><TextBlock Style="{StaticResource Lbl}" Text="ارجاع"/><TextBox Style="{StaticResource InputC}" Text="{Binding Reference}"/></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ردیف ورود سریع (entry-strip) -->
            <Border Grid.Row="1" Background="{StaticResource EntryBg}" BorderBrush="{StaticResource EntryBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.7*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="کد حساب" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Blue700}" Margin="2,0,2,3"/>
                        <TextBox Style="{StaticResource NumC}" IsReadOnly="True" Background="White"
                                 Text="{Binding SelectedItem.Code, ElementName=AccCombo, Mode=OneWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="نام حساب" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Blue700}" Margin="2,0,2,3"/>
                        <!-- جستجوی هوشمند حساب: تایپِ کد یا نام (contains) فیلتر می‌کند — کیبوردمحور (PD-2) -->
                        <telerik:RadComboBox x:Name="AccCombo" Height="32"
                                  ItemsSource="{Binding LeafAccounts}" DisplayMemberPath="Display"
                                  SelectedValuePath="Id" SelectedValue="{Binding NewAccountId}"
                                  IsEditable="True" IsFilteringEnabled="True" TextSearchMode="Contains"
                                  CanAutocompleteSelectItems="True" OpenDropDownOnFocus="True"
                                  EmptyText="کد یا نام حساب…">
                            <telerik:RadComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Code}" FontSize="11" Foreground="{StaticResource TextMuted}" Width="52" FlowDirection="LeftToRight"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </telerik:RadComboBox.ItemTemplate>
                        </telerik:RadComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="شرح ردیف" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Blue700}" Margin="2,0,2,3"/>
                        <TextBox Style="{StaticResource InputC}" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="بدهکار" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Blue700}" Margin="2,0,2,3"/>
                        <TextBox Style="{StaticResource NumC}" Text="{Binding NewDebit, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="8">
                        <TextBlock Text="بستانکار" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Blue700}" Margin="2,0,2,3"/>
                        <TextBox Style="{StaticResource NumC}" Text="{Binding NewCredit, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddRowCommand}"/></TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <Button Grid.Column="10" VerticalAlignment="Bottom" Height="32" Padding="14,0" Cursor="Hand"
                            Background="{StaticResource Blue600}" Foreground="White" BorderThickness="0"
                            Content="افزودن ⏎" Command="{Binding AddRowCommand}"/>
                </Grid>
            </Border>

            <!-- گرید ردیف‌ها -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Background="White">
                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False" Background="White"
                          GridLinesVisibility="All" HorizontalGridLinesBrush="#EDEFF3" VerticalGridLinesBrush="#EDEFF3"
                          RowBackground="White" AlternatingRowBackground="{StaticResource Zebra}" RowHeight="30" FontSize="12.5"
                          BorderThickness="0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource HeadBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="BorderBrush" Value="#E1E4EA"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="40"/>
                        <DataGridTextColumn Header="کد" Binding="{Binding AccountCode}" Width="80"/>
                        <DataGridTextColumn Header="نام حساب" Binding="{Binding AccountName}" Width="*"/>
                        <DataGridTextColumn Header="شرح ردیف" Binding="{Binding Description}" Width="1.4*"/>
                        <DataGridTextColumn Header="بدهکار" Binding="{Binding Debit, Converter={StaticResource Num}}" Width="120">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="6,0"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="بستانکار" Binding="{Binding Credit, Converter={StaticResource Num}}" Width="120">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Margin" Value="6,0"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Foreground="#9CA3AF" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- نوار تراز -->
            <Border Grid.Row="3" CornerRadius="8" Padding="12,8" Margin="0,10,0,0" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FBEAEA"/>
                        <Setter Property="BorderBrush" Value="#E6B3B3"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBalanced}" Value="True">
                                <Setter Property="Background" Value="#E8F5EC"/>
                                <Setter Property="BorderBrush" Value="#A7D7B6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="✕ سند تراز نیست"/>
                                <Setter Property="Foreground" Value="#B91C1C"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBalanced}" Value="True">
                                        <Setter Property="Text" Value="✓ سند تراز است"/>
                                        <Setter Property="Foreground" Value="#15803D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <StackPanel Margin="18,0,0,0">
                            <TextBlock Text="جمع بدهکار" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding TotalDebit, Converter={StaticResource Num}}" FontWeight="Bold" FontSize="14" FlowDirection="LeftToRight"/>
                        </StackPanel>
                        <StackPanel Margin="18,0,0,0">
                            <TextBlock Text="جمع بستانکار" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding TotalCredit, Converter={StaticResource Num}}" FontWeight="Bold" FontSize="14" FlowDirection="LeftToRight"/>
                        </StackPanel>
                        <StackPanel Margin="18,0,0,0">
                            <TextBlock Text="اختلاف" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding Difference, Converter={StaticResource Num}}" FontWeight="Bold" FontSize="14" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
