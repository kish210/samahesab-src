<Window x:Class="SamaHesab.SupportTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ابزارِ پشتیبانیِ سما حساب — صدورِ کدِ ریست"
        Height="560" Width="480"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#161C2A"
        FontFamily="Segoe UI">

    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="🔧 صدورِ کدِ ریستِ پشتیبانی" FontSize="18" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="کدِ دستگاهِ مشتری را بگیرید، کلیدِ خصوصیِ RSA (همان کلیدِ لایسنس) را انتخاب کنید، و کدِ ریست را برایِ مشتری بفرستید."
                       Foreground="#94A3B8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <Border x:Name="ErrorPanel" Background="#3F1D1D" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8"
                    Padding="10,8" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="کدِ دستگاهِ مشتری (Fingerprint)" Foreground="#94A3B8" FontSize="12" Margin="2,16,0,6"/>
            <Border Background="#1B2843" BorderBrush="#283A60" BorderThickness="1" CornerRadius="10">
                <TextBox x:Name="TxtFingerprint" Padding="10,11" Background="Transparent" BorderThickness="0"
                         Foreground="White" CaretBrush="White" FlowDirection="LeftToRight" FontFamily="Consolas"/>
            </Border>

            <TextBlock Text="فایلِ کلیدِ خصوصیِ RSA (PEM)" Foreground="#94A3B8" FontSize="12" Margin="2,14,0,6"/>
            <Border Background="#1B2843" BorderBrush="#283A60" BorderThickness="1" CornerRadius="10">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="انتخاب…" Width="80" Margin="4" Height="34"
                            Background="#283A60" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="BrowseKey_Click"/>
                    <TextBox x:Name="TxtKeyPath" Padding="10,11" Background="Transparent" BorderThickness="0"
                             Foreground="White" IsReadOnly="True" FlowDirection="LeftToRight" FontSize="11"/>
                </DockPanel>
            </Border>

            <TextBlock Text="مدتِ اعتبارِ کد (روز)" Foreground="#94A3B8" FontSize="12" Margin="2,14,0,6"/>
            <Border Background="#1B2843" BorderBrush="#283A60" BorderThickness="1" CornerRadius="10" Width="100" HorizontalAlignment="Right">
                <TextBox x:Name="TxtDays" Text="2" Padding="10,11" Background="Transparent" BorderThickness="0"
                         Foreground="White" CaretBrush="White" FlowDirection="LeftToRight" TextAlignment="Center"/>
            </Border>

            <Button x:Name="BtnGenerate" Content="ساختِ کدِ ریست" Height="42" FontSize="13" FontWeight="SemiBold"
                    Foreground="White" Cursor="Hand" Margin="0,18,0,0" Click="Generate_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="#324A7A">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4B5F97"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Margin="0,18,0,0">
                <TextBlock x:Name="ResultInfo" Foreground="#86EFAC" FontSize="12" TextWrapping="Wrap"/>
                <Border Background="#1B2843" BorderBrush="#283A60" BorderThickness="1" CornerRadius="10" Margin="0,8,0,0">
                    <TextBox x:Name="TxtResultCode" Padding="10,11" Background="Transparent" BorderThickness="0"
                             Foreground="White" IsReadOnly="True" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto"/>
                </Border>
                <Button Content="📋 کپی در کلیپ‌بورد" Height="34" Margin="0,8,0,0" Background="#283A60"
                        Foreground="White" BorderThickness="0" Cursor="Hand" Click="CopyCode_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
