<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:telerik="using:Telerik.UI.Xaml.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/Primitives/Themes/ThemeColorsHighContrast.xaml"/>
        <ResourceDictionary>
            <telerik:UserThemeResources x:Key="ResourceLoaderInitializer"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="{CustomResource HighContrastResourcesPath}"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>

    <!--#region SegmentedControl Brushes-->
    <SolidColorBrush x:Key="TelerikSegmentedControl_Foreground" Color="{ThemeResource SystemColorButtonTextColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_ForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_ForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_Background" Color="{ThemeResource SystemColorWindowColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_BackgroundPointerOver" Color="{ThemeResource SystemListLowColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_BackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_BackgroundSelectedPointerOver" Color="{ThemeResource SystemListAccentHighColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_BackgroundPressed" Color="{ThemeResource SystemBaseMediumLowColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_BorderBrush" Color="{ThemeResource SystemChromeMediumColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_BorderBrushDisabled" Color="{ThemeResource SystemBaseLowColor}" />
    <SolidColorBrush x:Key="TelerikSegmentedControl_SeparatorBrush" Color="{ThemeResource SystemChromeMediumColor}" />
    <!--#endregion-->

    <!--#region NumericBox-->
    <SolidColorBrush x:Key="TelerikNumericBox_Foreground" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_ForegroundFocused" Color="{ThemeResource SystemChromeBlackHighColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_ForegroundDisabled" Color="{ThemeResource SystemChromeDisabledLowColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_Background" Color="{ThemeResource SystemColorWindowColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_BackgroundFocused" Color="{ThemeResource SystemChromeWhiteColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_BorderBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_BorderBrushPointerOver" Color="{ThemeResource SystemColorHotlightColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_BorderBrushFocused" Color="{ThemeResource SystemColorHighlightColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_BorderBrushDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <!--Buttons-->
    <SolidColorBrush x:Key="TelerikNumericBox_ButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_ButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_ButtonBackgroundPointerOver" Color="{ThemeResource SystemListLowColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_ButtonBackgroundDisabled" Color="{ThemeResource SystemListLowColor}"/>
    <SolidColorBrush x:Key="TelerikNumericBox_ButtonBorderBrushDisabled" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <!--Clear button-->
    <SolidColorBrush x:Key="TelerikNumericBox_ClearButtonForegroundPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.7"/>
    <SolidColorBrush x:Key="TelerikNumericBox_ClearButtonForegroundPressed" Color="{ThemeResource SystemAccentColor}"/>
    <!--#endregion-->

    <!--#region Rating-->
    <x:Double x:Key="TelerikRating_Item_ContentFontSize">15</x:Double>
    <SolidColorBrush x:Key="TelerikRating_IconForeground" Color="{ThemeResource SystemChromeHighColor}"/>
    <SolidColorBrush x:Key="TelerikRating_IconForeground_Filled" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="TelerikRating_IconForeground_Highlighted" Color="{ThemeResource SystemListAccentHighColor}"/>
    <!--#endregion-->

    <!--#region DateTimePicker-->
    <SolidColorBrush x:Key="TelerikDateTimePicker_Foreground" Color="{ThemeResource SystemColorButtonTextColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_Background" Color="{ThemeResource SystemColorWindowColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_BorderBrush" Color="{ThemeResource SystemBaseMediumLowColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_BackgroundPointerOver" Color="{ThemeResource SystemListLowColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_BorderBrushPointerOver" Color="{ThemeResource SystemBaseMediumColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_BackgroundPressed" Color="{ThemeResource SystemBaseMediumLowColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_BackgroundFocused" Color="{ThemeResource SystemListAccentLowColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_BorderBrushFocused" Color="{ThemeResource SystemBaseHighColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_BorderBrushDisabled" Color="{ThemeResource SystemBaseLowColor}" />
    <!--Selector-->
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorBackground" Color="{ThemeResource SystemColorWindowColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorBorderBrush" Color="{ThemeResource SystemChromeMediumColor}" />
    <!--SelectorItem-->
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorItem_Foreground" Color="{ThemeResource SystemColorButtonTextColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorItem_ForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorItem_Background" Color="Transparent" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorItem_BackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
    <!--SelectorButton-->
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorButton_Foreground" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="TelerikDateTimePicker_SelectorButton_Background" Color="Transparent" />
    <!--#endregion-->

    <SolidColorBrush x:Key="TelerikMaskedInput_Foreground" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_ForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_HeaderForeground" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_HeaderForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_DescriptionForeground" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_Background" Color="{ThemeResource SystemColorWindowColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_BorderBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_BorderBrushPointerOver" Color="{ThemeResource SystemColorHotlightColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_BorderBrushFocused" Color="{ThemeResource SystemColorHighlightColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_BorderBrushDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_ValidationBrush" Color="#A80000"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_ClearButtonForegroundPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.7"/>
    <SolidColorBrush x:Key="TelerikMaskedInput_ClearButtonForegroundPressed" Color="{ThemeResource SystemAccentColor}"/>
</ResourceDictionary>

