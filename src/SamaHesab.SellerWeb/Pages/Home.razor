@page "/"
@using SamaHesab.SellerWeb.Services
@inject SellerApi Api
@inject NavigationManager Nav

<PageTitle>پنلِ فروشِ گردشگری</PageTitle>

@if (!Api.IsLoggedIn)
{
    <div class="login-wrap">
        <div class="login-card">
            <div class="brand">
                <div class="brand-mark">س</div>
                <div class="brand-text">
                    <div class="brand-name">سما حساب</div>
                    <div class="brand-sub">پنلِ فروشِ گردشگری</div>
                </div>
            </div>

            <div class="field">
                <label>نام کاربری</label>
                <input class="erp-input" @bind="_user" autocomplete="username" />
            </div>
            <div class="field">
                <label>رمز عبور</label>
                <input class="erp-input" type="password" @bind="_pass" @bind:event="oninput" autocomplete="current-password"
                       @onkeydown="@(e => { if (e.Key == "Enter") _ = DoLogin(); })" />
            </div>
            @if (_error is not null) { <div class="erp-error">@_error</div> }
            <button class="erp-btn-primary" @onclick="DoLogin" disabled="@_busy">
                @(_busy ? "در حال ورود…" : "ورود به سیستم")
            </button>
            <div class="login-foot">سماع رایانه کیش</div>
        </div>
    </div>
}
else
{
    <div class="panel-top">
        <div>
            <strong>@Api.Context?.FullName</strong>
            <span class="sub"> · سالِ مالی @Api.Context?.FiscalYearTitle</span>
        </div>
        <button class="btn-logout" @onclick="Logout">خروج</button>
    </div>

    @if (Api.Context?.IsSeller != true)
    {
        <div class="warn">این کاربر به «فروشنده» نگاشته نشده — مدیر باید در «امنیت ← کاربران» فروشنده را تعیین کند.</div>
    }

    <div class="sell-grid">
        <div class="products">
            @if (_products is null) { <p class="muted">در حال بارگذاری…</p> }
            else if (_products.Count == 0) { <p class="muted">محصولی تعریف نشده.</p> }
            else
            {
                @foreach (var p in _products)
                {
                    <button class="product @(p.IsSoldOut ? "soldout" : "")" disabled="@p.IsSoldOut" @onclick="() => Add(p)">
                        <div class="pname">@p.Name</div>
                        <div class="pprice">@Money(p.SalePrice)</div>
                        <div class="pcap">@(p.Capacity is null ? "نامحدود" : $"مانده: {p.Remaining}")</div>
                    </button>
                }
            }
        </div>

        <div class="cart">
            <h6>سبدِ فروش</h6>
            @if (_cart.Count == 0) { <p class="muted">محصولی انتخاب نشده.</p> }
            else
            {
                <div class="cart-lines">
                    @foreach (var c in _cart)
                    {
                        <div class="cart-line">
                            <div class="cl-name">@c.Name</div>
                            <input class="cl-qty" type="number" min="1"
                                   value="@c.Qty" @onchange="e => SetQty(c, e.Value?.ToString())" />
                            <div class="cl-sum">@Money(c.Qty * c.Price)</div>
                            <button class="cl-del" @onclick="() => _cart.Remove(c)">✕</button>
                        </div>
                    }
                </div>
                <div class="cart-total"><span>جمع</span><strong>@Money(Total)</strong></div>
                <div class="cart-actions">
                    <select class="erp-select" @bind="_payment">
                        <option value="نقدی">نقدی</option>
                        <option value="کارت">کارت</option>
                        <option value="نسیه">نسیه</option>
                    </select>
                    @if (_saleMsg is not null) { <div class="@(_saleOk ? "sale-ok" : "sale-err")">@_saleMsg</div> }
                    <button class="erp-btn-success" @onclick="Submit" disabled="@_submitting">
                        @(_submitting ? "در حال ثبت…" : "ثبتِ فروش")
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    string _user = "", _pass = "";
    const int Company = 1;   // پیش‌فرض؛ فروشنده نیازی به دانستنِ کدِ شرکت ندارد
    bool _busy, _submitting, _saleOk;
    string? _error, _saleMsg, _payment = "نقدی";

    List<SellerApi.AvailabilityRow>? _products;
    readonly List<CartItem> _cart = new();
    decimal Total => _cart.Sum(c => c.Qty * c.Price);

    static string Money(decimal v) => v.ToString("#,0") + " ریال";

    protected override void OnInitialized()
        // آدرسِ سرور = همان originِ پنل (پنل از خودِ API روی /seller/ سرو می‌شود).
        => Api.BaseUrl = new System.Uri(Nav.BaseUri).GetLeftPart(System.UriPartial.Authority);

    async Task DoLogin()
    {
        if (string.IsNullOrWhiteSpace(_user)) { _error = "نام کاربری را وارد کنید."; return; }
        _busy = true; _error = null;
        _error = await Api.LoginAsync(_user.Trim(), _pass, Company);
        _busy = false;
        if (_error is null) await LoadProducts();
    }

    void Logout() { Api.Logout(); _cart.Clear(); _products = null; }

    async Task LoadProducts() => _products = await Api.GetAvailabilityAsync() ?? new();

    void Add(SellerApi.AvailabilityRow p)
    {
        var existing = _cart.FirstOrDefault(c => c.ProductId == p.ProductId);
        if (existing is not null) existing.Qty++;
        else _cart.Add(new CartItem { ProductId = p.ProductId, Name = p.Name, Price = p.SalePrice, Qty = 1 });
        _saleMsg = null;
    }

    void SetQty(CartItem c, string? v)
    {
        if (decimal.TryParse(v, out var q) && q > 0) c.Qty = q;
    }

    async Task Submit()
    {
        if (_cart.Count == 0) return;
        _submitting = true; _saleMsg = null;
        var lines = _cart.Select(c => new SellerApi.SaleLine(c.ProductId, c.Qty, c.Price)).ToList();
        var (ok, err, saleId) = await Api.CreateSaleAsync(_payment ?? "نقدی", lines, null, null);
        _saleOk = ok;
        _saleMsg = ok ? $"فروش ثبت شد (شناسه {saleId})." : err;
        _submitting = false;
        if (ok) { _cart.Clear(); await LoadProducts(); }
    }

    class CartItem { public int ProductId; public string Name = ""; public decimal Price; public decimal Qty; }
}
