<UserControl x:Class="SamaHesab.WPF.Views.Accounting.VoucherEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Toolbar ═══ -->
        <Border Grid.Row="0" Style="{StaticResource FormSectionCard}" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <Border Width="40" Height="40" CornerRadius="8" Background="#E0EDFF">
                        <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="22" Height="22"
                                                 Foreground="{DynamicResource PrimaryAccent}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="سند حسابداری" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding VoucherNumber, StringFormat=شماره سند: {0}}"
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding NewCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="FilePlusOutline" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="جدید (F2)" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding SaveCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="ContentSaveOutline" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource WarningColor}"/><TextBlock Text="ذخیره (F7)" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding PostCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="CheckCircleOutline" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource SuccessColor}"/><TextBlock Text="قطعی (F9)" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ReverseCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="UndoVariant" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource DangerColor}"/><TextBlock Text="برگشت" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding PrintCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="PrinterOutline" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="چاپ (F8)" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Header fields ═══ -->
        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="6">
                    <TextBlock Text="نوع سند" Style="{StaticResource FieldCaption}"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" ItemsSource="{Binding VoucherTypes}"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedVoucherTypeId}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6">
                    <TextBlock Text="مرکز هزینه" Style="{StaticResource FieldCaption}"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" ItemsSource="{Binding CostCenters}"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedCostCenterId}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="6">
                    <TextBlock Text="تاریخ سند" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding VoucherDate}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="6">
                    <TextBlock Text="شماره سند" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding VoucherNumber}" IsReadOnly="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Add row bar ═══ -->
        <Border Grid.Row="2" Style="{StaticResource FormSectionCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="4">
                    <TextBlock Text="حساب" Style="{StaticResource FieldCaption}"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" ItemsSource="{Binding LeafAccounts}"
                              SelectedValuePath="Id" SelectedValue="{Binding NewAccountId}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Code}" Foreground="{DynamicResource SecondaryText}"/>
                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4">
                    <TextBlock Text="شرح ردیف" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding NewDescription}">
                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddRowCommand}"/></TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="4">
                    <TextBlock Text="بدهکار" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding NewDebit}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="4">
                    <TextBlock Text="بستانکار" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding NewCredit}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="4" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource PrimaryButton}" Height="36" Padding="16,0" Command="{Binding AddRowCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="افزودن ردیف" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Items grid ═══ -->
        <Border Grid.Row="3" Style="{StaticResource FormSectionCard}" Padding="0">
            <telerik:RadGridView ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                      CanUserInsertRows="False" CanUserDeleteRows="False" RowIndicatorVisibility="Collapsed"
                      ShowGroupPanel="False" ShowColumnFooters="True" FontFamily="{StaticResource VazirFont}">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="ردیف" DataMemberBinding="{Binding RowNumber}" Width="48" IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="حساب کل" DataMemberBinding="{Binding Kol}" Width="70" IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="حساب معین" DataMemberBinding="{Binding Moein}" Width="90" IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="تفصیلی" DataMemberBinding="{Binding Tafsili}" Width="100" IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="نام حساب" DataMemberBinding="{Binding AccountName}" Width="*" IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="شرح" DataMemberBinding="{Binding Description}" Width="2*"/>
                    <telerik:GridViewDataColumn Header="بدهکار" DataMemberBinding="{Binding Debit}" DataFormatString="{}{0:#,##0}" Width="130">
                        <telerik:GridViewDataColumn.AggregateFunctions>
                            <telerik:SumFunction ResultFormatString="{}{0:#,##0}"/>
                        </telerik:GridViewDataColumn.AggregateFunctions>
                    </telerik:GridViewDataColumn>
                    <telerik:GridViewDataColumn Header="بستانکار" DataMemberBinding="{Binding Credit}" DataFormatString="{}{0:#,##0}" Width="130">
                        <telerik:GridViewDataColumn.AggregateFunctions>
                            <telerik:SumFunction ResultFormatString="{}{0:#,##0}"/>
                        </telerik:GridViewDataColumn.AggregateFunctions>
                    </telerik:GridViewDataColumn>
                    <telerik:GridViewDataColumn Header="حذف" Width="50" IsReadOnly="True">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ToolbarButton}" Width="34" Height="30"
                                        Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                        CommandParameter="{Binding}">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="{DynamicResource DangerColor}"/>
                                </Button>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Border>

        <!-- ═══ Totals footer ═══ -->
        <Border Grid.Row="4" Style="{StaticResource FormSectionCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Balance badge -->
                <Border Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        CornerRadius="6" Padding="14,8" Margin="4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FDE8E8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBalanced}" Value="True">
                                    <Setter Property="Background" Value="#E3F6EC"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon VerticalAlignment="Center" Width="20" Height="20">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="AlertCircleOutline"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBalanced}" Value="True">
                                            <Setter Property="Kind" Value="CheckCircleOutline"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{x:Null}">
                                    <Setter Property="Text" Value="سند تراز نیست"/>
                                    <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBalanced}" Value="True">
                                            <Setter Property="Text" Value="سند تراز است"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#E3F6EC" CornerRadius="6" Padding="14,8" Margin="4">
                    <StackPanel>
                        <TextBlock Text="جمع بدهکار" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBlock Text="{Binding TotalDebit, StringFormat={}{0:#,##0}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#FDE8E8" CornerRadius="6" Padding="14,8" Margin="4">
                    <StackPanel>
                        <TextBlock Text="جمع بستانکار" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBlock Text="{Binding TotalCredit, StringFormat={}{0:#,##0}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DangerColor}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="{DynamicResource AppBackground}" CornerRadius="6" Padding="14,8" Margin="4">
                    <StackPanel>
                        <TextBlock Text="اختلاف (تراز)" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBlock Text="{Binding Difference, StringFormat={}{0:#,##0}}" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
