<UserControl x:Class="SamaHesab.WPF.Views.Support.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft"
             Background="{StaticResource ErpAppBg}">
    <UserControl.Resources>
        <Style x:Key="DiagLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ErpTextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <Style x:Key="DiagValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <StackPanel Grid.Row="0" Margin="2,0,2,8">
            <TextBlock Text="عیب‌یابیِ سیستم" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}"/>
            <TextBlock Text="وضعیتِ فنیِ نصب — برای پشتیبانی. هیچ دادهٔ مالی/فاکتور/تراکنشی در این گزارش نیست."
                       FontSize="12" Foreground="{StaticResource ErpTextMuted}" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- نوار ابزار -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,2,8">
            <Button Style="{StaticResource ErpBtnPrimary}" Height="30" Padding="14,0" Content="🔄 به‌روزرسانی" Command="{Binding RefreshCommand}"/>
            <Button Style="{StaticResource ErpBtnGhost}" Height="30" Padding="12,0" Margin="6,0,0,0" Content="📋 کپیِ گزارش" Command="{Binding CopyCommand}"/>
            <Button Style="{StaticResource ErpBtnGhost}" Height="30" Padding="12,0" Margin="6,0,0,0" Content="💾 ذخیرهٔ گزارش" Command="{Binding SaveCommand}"/>
        </StackPanel>

        <!-- کارت اطلاعات -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DiagLabel}" Text="نسخهٔ ERP"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DiagValue}" Text="{Binding Info.ErpVersion}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource DiagLabel}" Text="شمارهٔ Build"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource DiagValue}" Text="{Binding Info.BuildNumber}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DiagLabel}" Text="ویندوز"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DiagValue}" Text="{Binding Info.WindowsVersion}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource DiagLabel}" Text="چارچوب"/>
                        <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource DiagValue}" Text="{Binding Info.Framework}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DiagLabel}" Text="پایگاه‌داده"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <Border CornerRadius="4" Padding="8,2" Margin="0,5,0,5" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FDECEA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DbHealthy}" Value="True">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Info.DatabaseStatus}" FontWeight="SemiBold" FontSize="12.5"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource DiagLabel}" Text="تأخیرِ اتصال"/>
                        <TextBlock Grid.Row="2" Grid.Column="4" Style="{StaticResource DiagValue}" Text="{Binding Info.ConnectionLatencyMs, StringFormat={}{0} ms}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DiagLabel}" Text="نسخهٔ پایگاه‌داده"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource DiagValue}" Text="{Binding Info.DatabaseVersion}" FontWeight="Normal" FontSize="11.5"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource DiagLabel}" Text="لایسنس"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DiagValue}">
                            <Run Text="{Binding Info.LicenseType}"/><Run Text=" — "/><Run Text="{Binding Info.LicenseState}"/>
                        </TextBlock>
                        <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource DiagLabel}" Text="اثرانگشتِ ماشین"/>
                        <TextBlock Grid.Row="4" Grid.Column="4" Style="{StaticResource DiagValue}" Text="{Binding Info.MachineFingerprint}" FontWeight="Normal" FontFamily="Consolas" FontSize="11"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource DiagLabel}" Text="کاربر"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DiagValue}" Text="{Binding Info.User}"/>
                        <TextBlock Grid.Row="5" Grid.Column="3" Style="{StaticResource DiagLabel}" Text="شعبه"/>
                        <TextBlock Grid.Row="5" Grid.Column="4" Style="{StaticResource DiagValue}" Text="{Binding Info.Branch}"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource DiagLabel}" Text="حافظه / دیسک"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource DiagValue}" FontWeight="Normal">
                            <Run Text="{Binding Info.MemoryUsageMb, StringFormat={}{0:N0} MB حافظه}"/>
                            <Run Text="  ·  "/>
                            <Run Text="{Binding Info.DiskFreeGb, StringFormat={}{0:N1} GB آزاد}"/>
                            <Run Text="{Binding Info.DiskTotalGb, StringFormat={} از {0:N1} GB}"/>
                        </TextBlock>
                    </Grid>

                    <Separator Margin="0,12"/>
                    <TextBlock Text="ماژول‌های فعال" Style="{StaticResource DiagLabel}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Info.InstalledModules}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource ErpAppBg}" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1"
                                        CornerRadius="12" Padding="10,3" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding}" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" Margin="2,8,2,0" FontSize="11" Foreground="{StaticResource ErpTextMuted}"
                   Text="🔒 امنیت: گزارشِ عیب‌یابی فقط دادهٔ فنی دارد و هیچ اطلاعاتِ مالی یا تجاریِ شما را شامل نمی‌شود."/>
    </Grid>
</UserControl>
