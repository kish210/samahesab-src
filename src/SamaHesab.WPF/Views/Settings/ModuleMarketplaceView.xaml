<UserControl x:Class="SamaHesab.WPF.Views.Settings.ModuleMarketplaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="مدیریت ماژول‌ها" FontSize="18" FontWeight="Bold" Margin="2,0,0,2"/>
        <TextBlock Grid.Row="1" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="2,0,0,10"
                   Text="ماژول‌های اختیاریِ پلتفرم — فعال/غیرفعال، نصب/به‌روزرسانی از بازارِ GitHub، یا حذف. هسته بدونِ ماژول کامل کار می‌کند و دادهٔ تاریخیِ ماژولِ حذف‌شده در پایگاه‌داده می‌ماند."/>

        <Border Grid.Row="2" Style="{StaticResource FormSectionCard}" Padding="0">
            <ListView ItemsSource="{Binding Modules}" BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="6" CornerRadius="8" Background="White" BorderBrush="{DynamicResource ErpBorder}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14"/>
                                        <Border Background="#EEF2FF" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                Visibility="{Binding InCatalog, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding Version}" FontSize="11" Foreground="#3B5BDB" FlowDirection="LeftToRight"/>
                                        </Border>
                                        <Border Background="#E8F5E9" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                Visibility="{Binding Enabled, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="● فعال" FontSize="11" Foreground="#2E7D32"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- اکشن‌ها: فعال/غیرفعال · دانلود/به‌روزرسانی · حذف -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button MinWidth="92" Height="32" Margin="0,0,6,0"
                                            Command="{Binding DataContext.ToggleEnableCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Setter Property="Content" Value="فعال‌سازی"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                        <Setter Property="Content" Value="غیرفعال‌سازی"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button MinWidth="110" Height="32" Margin="0,0,6,0"
                                            Visibility="{Binding InCatalog, Converter={StaticResource BoolVis}}"
                                            Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                <Setter Property="Content" Value="⬇ دانلود و نصب"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Installed}" Value="True">
                                                        <Setter Property="Content" Value="⟳ به‌روزرسانی"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="🗑 حذف" Height="32" MinWidth="72" Style="{StaticResource SecondaryButton}"
                                            Visibility="{Binding Installed, Converter={StaticResource BoolVis}}"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>

                                <!-- نشانگرِ دانلود (نوارِ پیشرفت + درصد + حجم) -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="160"
                                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}">
                                    <ProgressBar Height="10" Minimum="0" Maximum="100" Value="{Binding Progress}"/>
                                    <TextBlock HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource SecondaryText}">
                                        <Run Text="در حال دانلود… "/><Run Text="{Binding Progress}"/><Run Text="٪"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DownloadedText}" HorizontalAlignment="Center" FontSize="10"
                                               Foreground="{DynamicResource SecondaryText}" FlowDirection="LeftToRight"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2,8,0,0">
            <Button Content="🔄 تازه‌سازی" Style="{StaticResource SecondaryButton}" Height="32" Command="{Binding RefreshCommand}"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource SecondaryText}"/>
        </StackPanel>
    </Grid>
</UserControl>
