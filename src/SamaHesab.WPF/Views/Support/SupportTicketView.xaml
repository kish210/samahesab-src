<UserControl x:Class="SamaHesab.WPF.Views.Support.SupportTicketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource VazirFont}" FlowDirection="RightToLeft"
             Background="{StaticResource ErpAppBg}">
    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,8">
            <TextBlock Text="تیکتِ پشتیبانی" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}"/>
            <TextBlock Text="ثبت و پیگیریِ درخواستِ پشتیبانی. وضعیت: جدید/باز/در حالِ بررسی/منتظرِ مشتری/آزمایش/حل‌شده/بسته."
                       FontSize="12" Foreground="{StaticResource ErpTextMuted}" Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ستونِ راست: تیکتِ جدید + فهرست -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="تیکتِ جدید" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="6,3"
                                 Tag="موضوع" ToolTip="موضوع"/>
                        <ComboBox Margin="0,6,0,0" Height="30" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label"/>
                        <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" Height="64" Margin="0,6,0,0"
                                 TextWrapping="Wrap" AcceptsReturn="True" Padding="6,3"/>
                        <Button Style="{StaticResource ErpBtnPrimary}" Height="30" Margin="0,8,0,0" Content="➕ ثبتِ تیکت" Command="{Binding CreateCommand}"/>
                        <Border CornerRadius="4" Padding="8,5" Margin="0,8,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResultIsError}" Value="True"><Setter Property="Background" Value="#FDECEA"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" FontSize="11.5"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0" Padding="6">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4,2,4,6">
                            <Button DockPanel.Dock="Left" Content="🔄" Command="{Binding RefreshCommand}" Padding="6,2" ToolTip="به‌روزرسانی"/>
                            <TextBlock Text="تیکت‌های من" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Tickets}" SelectedItem="{Binding SelectedTicket}" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Background="{StaticResource ErpAppBg}" CornerRadius="8" Padding="6,1">
                                                <TextBlock Text="{Binding StatusText}" FontSize="10.5"/>
                                            </Border>
                                            <TextBlock Text="{Binding SyncText}" FontSize="10.5" Foreground="{StaticResource ErpTextMuted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ستونِ چپ: گفت‌وگو -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{Binding SelectedTicket.Subject}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedTicket.StatusText, StringFormat=وضعیت: {0}}" FontSize="11.5" Foreground="{StaticResource ErpTextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedTicket.Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="10,7" Margin="0,4" MaxWidth="520">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#EEF3FB"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FromSupport}" Value="True">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Author}" FontSize="10.5" Foreground="{StaticResource ErpTextMuted}"/>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}" Height="36"
                                 VerticalContentAlignment="Center" Padding="8,0" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Style="{StaticResource ErpBtnPrimary}" Height="36" Padding="16,0" Margin="6,0,0,0"
                                Content="ارسال" Command="{Binding SendReplyCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
