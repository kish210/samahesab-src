{
    "Format":  "shtpl-v1",
    "DocumentType":  "Voucher",
    "Name":  "سندِ حسابداری",
    "PaperSize":  "A4P",
    "HeaderHtml":  null,
    "BodyHtml":  "\u003cdiv class=\u0027doc\u0027\u003e\u003cstyle\u003e\n.doc{font-family:Tahoma,\u0027B Nazanin\u0027,sans-serif;direction:rtl;color:#1a1a1a;font-size:12px;padding:16px;max-width:780px;margin:auto}\n.top{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:2px solid #1f4e79;padding-bottom:8px}\n.logo{width:118px;height:62px;border:1px dashed #b0b0b0;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#9a9a9a;font-size:11px;text-align:center}\n.co{text-align:center;flex:1;padding:0 8px}\n.co h1{margin:0;font-size:18px;color:#1f4e79}\n.co .sub{font-size:10.5px;color:#555;margin-top:3px}\n.codes{text-align:center;font-size:10px;color:#777}\n.qr{width:66px;height:66px;border:1px solid #ccc;border-radius:4px;display:flex;align-items:center;justify-content:center;color:#aaa;font-size:10px}\n.bc{font-family:\u0027Libre Barcode 39 Text\u0027,\u0027Consolas\u0027,monospace;font-size:13px;letter-spacing:1px;margin-top:5px;color:#222}\n.title{background:#1f4e79;color:#fff;text-align:center;padding:6px;font-size:14px;font-weight:bold;border-radius:4px;margin:10px 0}\n.meta{display:flex;flex-wrap:wrap;font-size:11.5px;border:1px solid #e2e2e2;border-radius:6px;padding:6px;margin-bottom:10px}\n.meta div{width:50%;padding:3px 5px;box-sizing:border-box}\n.meta b{color:#1f4e79}\ntable.items{width:100%;border-collapse:collapse;font-size:11.5px}\ntable.items th{background:#1f4e79;color:#fff;padding:6px;border:1px solid #15395c}\ntable.items td{padding:5px 6px;border:1px solid #d9d9d9;text-align:center}\ntable.items tr:nth-child(even) td{background:#f5f8fc}\n.tot{margin-top:10px;width:48%;float:left;font-size:12px;border:1px solid #e2e2e2;border-radius:6px;overflow:hidden}\n.tot div{display:flex;justify-content:space-between;padding:5px 10px;border-bottom:1px solid #eee}\n.tot .grand{background:#1f4e79;color:#fff;font-weight:bold}\n.notes{clear:both;font-size:11px;color:#555;border-top:1px dashed #ccc;margin-top:12px;padding-top:8px}\n.sign{display:flex;justify-content:space-between;margin-top:22px;font-size:11px}\n.sign div{width:30%;text-align:center;border-top:1px solid #999;padding-top:6px;color:#555}\n.stamp{width:30%;text-align:center;border:1px dashed #c0392b;border-radius:6px;color:#c0392b;padding:14px 0;font-size:10px}\n/* thermal */\n.t{font-family:Tahoma,sans-serif;direction:rtl;width:100%;font-size:11px;color:#000;padding:4px}\n.t .c{text-align:center}\n.t h2{font-size:14px;margin:2px 0;text-align:center}\n.t table{width:100%;border-collapse:collapse;font-size:10.5px}\n.t td{padding:2px 0}\n.t .ln{border-top:1px dashed #000;margin:4px 0}\n.t .big{font-size:13px;font-weight:bold}\n\u003c/style\u003e\u003cdiv class=\u0027top\u0027\u003e\n  \u003cdiv class=\u0027logo\u0027\u003eلوگوی شرکت\u003cbr/\u003e{CompanyName}\u003c/div\u003e\n  \u003cdiv class=\u0027co\u0027\u003e\u003ch1\u003e{CompanyName}\u003c/h1\u003e\n    \u003cdiv class=\u0027sub\u0027\u003e{BranchName} — {CompanyAddress}\u003c/div\u003e\n    \u003cdiv class=\u0027sub\u0027\u003eتلفن: {CompanyPhone} · شناسهٔ اقتصادی: {EconomicCode} · کد/شناسهٔ ملی: {NationalId}\u003c/div\u003e\u003c/div\u003e\n  \u003cdiv class=\u0027codes\u0027\u003e\u003cdiv class=\u0027qr\u0027\u003eQR\u003cbr/\u003e{QrData}\u003c/div\u003e\u003cdiv class=\u0027bc\u0027\u003e*{DocNumber}*\u003c/div\u003e\u003c/div\u003e\n\u003c/div\u003e\u003cdiv class=\u0027title\u0027\u003eسندِ حسابداری\u003c/div\u003e\u003cdiv class=\u0027meta\u0027\u003e\u003cdiv\u003e\u003cb\u003eشمارهٔ سند:\u003c/b\u003e {VoucherNumber}\u003c/div\u003e\u003cdiv\u003e\u003cb\u003eتاریخ:\u003c/b\u003e {VoucherDate}\u003c/div\u003e\u003cdiv\u003e\u003cb\u003eنوعِ سند:\u003c/b\u003e {VoucherType}\u003c/div\u003e\u003cdiv\u003e\u003cb\u003eعطفِ سند:\u003c/b\u003e {Reference}\u003c/div\u003e\u003cdiv\u003e\u003cb\u003eشرحِ کلّی:\u003c/b\u003e {Description}\u003c/div\u003e\u003cdiv\u003e\u003cb\u003eشعبه:\u003c/b\u003e {BranchName}\u003c/div\u003e\u003c/div\u003e\u003ctable class=\u0027items\u0027\u003e\u003cthead\u003e\u003ctr\u003e\u003cth\u003eردیف\u003c/th\u003e\u003cth\u003eکدِ حساب\u003c/th\u003e\u003cth\u003eشرحِ حساب\u003c/th\u003e\u003cth\u003eتفصیلی\u003c/th\u003e\u003cth\u003eشرحِ آرتیکل\u003c/th\u003e\u003cth\u003eبدهکار\u003c/th\u003e\u003cth\u003eبستانکار\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e[[ROWS]]\u003ctr\u003e\u003ctd style=\u0027text-align:center\u0027\u003e{#}\u003c/td\u003e\u003ctd style=\u0027text-align:center\u0027\u003e{AccountCode}\u003c/td\u003e\u003ctd style=\u0027text-align:right\u0027\u003e{AccountName}\u003c/td\u003e\u003ctd style=\u0027text-align:right\u0027\u003e{DetailName}\u003c/td\u003e\u003ctd style=\u0027text-align:right\u0027\u003e{LineDescription}\u003c/td\u003e\u003ctd style=\u0027text-align:left\u0027\u003e{Debit}\u003c/td\u003e\u003ctd style=\u0027text-align:left\u0027\u003e{Credit}\u003c/td\u003e\u003c/tr\u003e[[/ROWS]]\u003ctr\u003e\u003ctd colspan=\u00276\u0027 style=\u0027text-align:left;font-weight:bold;background:#eef3fa\u0027\u003eجمعِ کل\u003c/td\u003e\u003ctd style=\u0027font-weight:bold;background:#eef3fa\u0027\u003e{Debit} / {Credit}\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003cdiv class=\u0027sign\u0027\u003e\u003cdiv\u003eتهیه‌کننده\u003c/div\u003e\u003cdiv class=\u0027stamp\u0027\u003eمحلِ مهر\u003c/div\u003e\u003cdiv\u003eتأییدکننده\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e",
    "FooterHtml":  "\u003cdiv style=\u0027text-align:center;font-family:Tahoma;direction:rtl;font-size:9.5px;color:#888;border-top:1px solid #ddd;padding-top:4px;margin-top:8px\u0027\u003eصفحه {PageNo} از {PageCount} · تاریخِ چاپ: {PrintDate} {PrintTime} · {BranchName} · چاپ‌شده با سما حساب\u003c/div\u003e"
}