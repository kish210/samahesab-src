<UserControl x:Class="SamaHesab.WPF.Views.Accounting.VoucherListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- نوار فیلتر -->
            <RowDefinition Height="*"/>      <!-- لیست + پیش‌نمایش -->
            <RowDefinition Height="Auto"/>   <!-- نوار جمع -->
        </Grid.RowDefinitions>

        <!-- ═══ نوار فیلتر ═══ -->
        <Border Grid.Row="0" Style="{StaticResource ErpGbox}">
            <DockPanel Margin="10,8">
                <Button DockPanel.Dock="Left" Content="＋ سند جدید" Style="{StaticResource ErpBtnPrimary}"
                        Height="32" Command="{Binding NewVoucherCommand}"/>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0"
                           Foreground="{DynamicResource MutedText}" FontSize="11.5"
                           Text="{Binding TotalCount, StringFormat='{}{0} نتیجه'}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="اسناد حسابداری" Style="{StaticResource ErpGboxTitle}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock Text="از" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                    <TextBox Text="{Binding FromDate}" Style="{StaticResource ErpInput}" Width="110" Margin="4,0"/>
                    <TextBlock Text="تا" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                    <TextBox Text="{Binding ToDate}" Style="{StaticResource ErpInput}" Width="110" Margin="4,0"/>
                    <ComboBox ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedStatus}" Width="120" Margin="4,0" Height="32"/>
                    <TextBox Text="{Binding SearchText}" Style="{StaticResource ErpInput}" Width="180" Margin="4,0"/>
                    <Button Content="🔍 جستجو" Style="{StaticResource ErpBtnSecondary}" Height="32" Margin="4,0"
                            Command="{Binding SearchCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ لیست (اصلی) + پیش‌نمایش (کنار) ═══ -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- لیست اسناد -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding Vouchers}" SelectedItem="{Binding SelectedVoucher}"
                      Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="All" CanUserAddRows="False" Margin="0,0,5,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="شماره" Binding="{Binding VoucherNumber}" Width="80"/>
                    <DataGridTextColumn Header="تاریخ" Binding="{Binding VoucherDate}" Width="95"/>
                    <DataGridTextColumn Header="نوع" Binding="{Binding VoucherTypeName}" Width="80"/>
                    <DataGridTextColumn Header="شرح سند" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="مبلغ (ریال)" Binding="{Binding TotalDebit, StringFormat='{}{0:#,##0}'}" Width="130"/>
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusName}" Width="85"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- پنل پیش‌نمایش سند انتخاب‌شده -->
            <Border Grid.Column="1" Style="{StaticResource ErpGbox}" Margin="5,0,0,0">
                <DockPanel Margin="14,12">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource ErpGboxTitle}"
                               Text="{Binding SelectedVoucher.VoucherNumber, StringFormat='پیش‌نمایش سند {0}', FallbackValue='پیش‌نمایش سند'}"/>

                    <Button DockPanel.Dock="Bottom" Content="باز کردن سند کامل ↗" Style="{StaticResource ErpBtnPrimary}"
                            Height="36" Margin="0,12,0,0" Command="{Binding EditVoucherCommand}"/>

                    <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
                        <Grid Margin="0,4">
                            <TextBlock Text="تاریخ" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedVoucher.VoucherDate}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="نوع" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedVoucher.VoucherTypeName}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="وضعیت" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedVoucher.StatusName}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource PrimaryAccent}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="جمع بدهکار" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedVoucher.TotalDebit, StringFormat='{}{0:#,##0}'}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="جمع بستانکار" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedVoucher.TotalCredit, StringFormat='{}{0:#,##0}'}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Left"/>
                        </Grid>
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                            <TextBlock Text="{Binding SelectedVoucher.Description}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource PrimaryText}" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ نوار جمع ═══ -->
        <Border Grid.Row="2" Style="{StaticResource ErpSumBarOk}" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Margin="12,8">
                <TextBlock Text="جمع اسناد فیلترشده:" Foreground="{DynamicResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} سند'}" FontWeight="Bold" Margin="4,0,16,0" VerticalAlignment="Center"/>
                <TextBlock Text="جمع بدهکار:" Foreground="{DynamicResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalDebit, StringFormat='{}{0:#,##0}'}" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
