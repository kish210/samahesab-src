    <Style TargetType="telerik:RadRibbonContextualGroup" BasedOn="{StaticResource ContextualGroupsStyle}"/>
    <!--#endregion-->

    <!--#region Ribbon Buttons-->
    <ControlTemplate x:Key="RadRibbonButtonTemplate" TargetType="telerik:RadRibbonButton">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PointerOverVisual"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PressedVisual"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="DisabledVisual"/>
                            <DoubleAnimation Duration="0" To="{ThemeResource TelerikControlDisabledOpacity}" Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity"/>
                            <DoubleAnimation Duration="0" To="{ThemeResource TelerikControlDisabledOpacity}" Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity"/>
                            <DoubleAnimation Duration="0" To="{ThemeResource TelerikControlDisabledOpacity}" Storyboard.TargetName="textRow1" Storyboard.TargetProperty="Opacity"/>
                            <DoubleAnimation Duration="0" To="{ThemeResource TelerikControlDisabledOpacity}" Storyboard.TargetName="textRow2" Storyboard.TargetProperty="Opacity"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused"/>
                    <VisualState x:Name="Unfocused"/>
                </VisualStateGroup>
                <VisualStateGroup x:Name="KeyboardNavigationStates">
                    <VisualState x:Name="KeyboardUnfocused"/>
                    <VisualState x:Name="KeyboardFocused">
                        <Storyboard>
                            <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="KeyboardNavigationVisual"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="NormalVisual"
                    Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"/>
            <Border x:Name="PointerOverVisual"
                    Background="{ThemeResource TelerikRibbonView_Button_BackgroundPointerOver}"
                    BorderBrush="{ThemeResource TelerikRibbonView_Button_BorderBrushPointerOver}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0"/>
            <Border x:Name="PressedVisual"
                    Background="{ThemeResource TelerikRibbonView_Button_BackgroundPressed}"
                    BorderBrush="{ThemeResource TelerikRibbonView_Button_BorderBrushPressed}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0"/>
            <Border x:Name="DisabledVisual"
                    Background="{ThemeResource TelerikRibbonView_Button_BackgroundDisabled}"
                    BorderBrush="{ThemeResource TelerikRibbonView_Button_BorderBrushDisabled}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0"/>
            <Border x:Name="KeyboardNavigationVisual"
                    Background="{ThemeResource TelerikRibbonView_KeyboardNavigationVisual_Background}"
                    Opacity="0"/>
            <Grid x:Name="ContentGrid"
                  Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Viewbox x:Name="IconHost">
                    <ContentPresenter x:Name="Icon"/>
                </Viewbox>
                <StackPanel x:Name="FirstRowContainer" Grid.Row="1">
                    <ContentControl x:Name="ContentPresenter"
                                    IsTabStop="False"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    Foreground="{TemplateBinding Foreground}"/>
                    <TextBlock Name="textRow1" Text="{TemplateBinding TextRow1}" TextAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                </StackPanel>
                <TextBlock Name="textRow2"
                           Grid.Row="2"
                           VerticalAlignment="Top"
                           Text="{TemplateBinding TextRow2}"
                           TextAlignment="Center"
                           Foreground="{TemplateBinding Foreground}"/>
            </Grid>
        </Grid>
    </ControlTemplate>
    <Style x:Key="RadRibbonButtonStyle" TargetType="telerik:RadRibbonButton">
        <Setter Property="Template" Value="{StaticResource RadRibbonButtonTemplate}"/>
        <Setter Property="Foreground" Value="{ThemeResource TelerikRibbonView_Button_Foreground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{ThemeResource TelerikRibbonView_Button_Padding}"/>
        <Setter Property="MinHeight" Value="{ThemeResource TelerikRibbonView_Button_MinSize}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="CornerRadius" Value="{ThemeResource TelerikRibbonView_Button_CornerRadius}"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource TelerikRibbonView_FocusVisualPrimaryBrush}"/>
    </Style>
    <Style TargetType="telerik:RadRibbonButton" BasedOn="{StaticResource RadRibbonButtonStyle}"/>

    <ControlTemplate x:Key="RadRibbonRadioButtonTemplate" TargetType="telerik:RadRibbonRadioButton">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PointerOverVisual"/>
                        </Storyboard>
                    </VisualState>
