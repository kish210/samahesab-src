<UserControl x:Class="SamaHesab.WPF.Views.Tourism.TourismSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding AddLineCommand}"/>
        <KeyBinding Key="F9" Command="{Binding SaveCommand}"/>
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ثبتِ فروشِ گردشگری" FontSize="18" FontWeight="Bold" Margin="2,0,0,8"/>

        <!-- سرِ فروش -->
        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}" Padding="10">
            <WrapPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="فروشنده" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    <ComboBox Width="180" Height="32" ItemsSource="{Binding Persons}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedSalespersonId}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="مشتری (اختیاری)" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    <ComboBox Width="180" Height="32" ItemsSource="{Binding Persons}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedCustomerId}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="روشِ پرداخت" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    <ComboBox Width="100" Height="32" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="سالِ مالی" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    <ComboBox Width="130" Height="32" ItemsSource="{Binding FiscalYears}" DisplayMemberPath="Title"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedFiscalYearId}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="تاریخ" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBox Width="110" Height="32" Text="{Binding Date}" FlowDirection="LeftToRight"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- نوارِ افزودنِ ردیف -->
        <Border Grid.Row="2" Style="{StaticResource FormSectionCard}" Padding="10" Margin="0,8,0,0">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="محصول:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" Margin="0,0,6,0"/>
                <ComboBox Width="240" Height="32" ItemsSource="{Binding Products}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedProduct}" Margin="0,0,12,0"/>
                <TextBlock Text="تعداد:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" Margin="0,0,6,0"/>
                <TextBox Width="70" Height="32" Text="{Binding AddQuantity}" FlowDirection="LeftToRight" Margin="0,0,12,0"/>
                <Button Content="➕ افزودن (F2)" Style="{StaticResource SecondaryButton}" Height="32" Command="{Binding AddLineCommand}"/>
            </WrapPanel>
        </Border>

        <!-- ردیف‌ها + ویرایشگرِ مسافرانِ ردیفِ انتخاب‌شده -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource FormSectionCard}" Padding="0">
            <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False"
                      ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                      RowHeight="{DynamicResource ErpDensRowHeight}" FontFamily="{StaticResource VazirFont}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="محصول" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="تعداد" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="فیِ فروش" Binding="{Binding UnitSalePrice, Converter={StaticResource Num}}" Width="120" ElementStyle="{StaticResource NumCell}"/>
                    <DataGridTextColumn Header="تخفیف" Binding="{Binding DiscountAmount, Converter={StaticResource Num}}" Width="110" ElementStyle="{StaticResource NumCell}"/>
                    <DataGridTextColumn Header="خالص" Binding="{Binding LineNet, Converter={StaticResource Num}}" Width="130" IsReadOnly="True" ElementStyle="{StaticResource NumCell}"/>
                    <DataGridTextColumn Header="سود" Binding="{Binding LineProfit, Converter={StaticResource Num}}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource NumCell}"/>
                    <!-- مسافران: خلاصه + دکمهٔ افزودن (ویرایش در پنلِ زیرِ ردیف) -->
                    <DataGridTemplateColumn Header="مسافران" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PassengerSummary}" VerticalAlignment="Center" FontSize="11.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PassengerSummary}" Value="⚠ مسافر لازم است">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="➕" FontSize="11" Margin="6,0,0,0" Padding="6,1" Cursor="Hand"
                                            ToolTip="افزودنِ مسافر" Command="{Binding AddPassengerCommand}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑" FontSize="12" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource DangerColor}"
                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            </Border>

            <!-- ویرایشگرِ مسافرانِ ردیفِ انتخاب‌شده (پایینِ گرید) -->
            <Border Grid.Row="1" Style="{StaticResource FormSectionCard}" Padding="10" Margin="0,8,0,0"
                    Visibility="{Binding DataContext.HasSelectedLine, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}"
                    DataContext="{Binding SelectedLine}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontSize="12.5">
                            <Run Text="مسافرانِ:"/><Run Text="{Binding ProductName, Mode=OneWay}"/>
                        </TextBlock>
                        <Button DockPanel.Dock="Left" HorizontalAlignment="Left" Content="➕ افزودنِ مسافر"
                                Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0"
                                Command="{Binding AddPassengerCommand}"/>
                    </DockPanel>
                    <Grid Margin="0,8,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="150"/><ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="نام و نام خانوادگی" FontSize="10.5" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBlock Grid.Column="1" Text="کدملی / گذرنامه" FontSize="10.5" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBlock Grid.Column="2" Text="تلفن" FontSize="10.5" Foreground="{DynamicResource SecondaryText}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Passengers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="150"/><ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Height="30" Margin="0,0,4,0" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="1" Height="30" Margin="0,0,4,0" FlowDirection="LeftToRight" Text="{Binding IdOrPassport, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" Height="30" Margin="0,0,4,0" FlowDirection="LeftToRight" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="3" Content="🗑" FontSize="12" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource DangerColor}"
                                            Command="{Binding DataContext.RemovePassengerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="محصولاتِ «اجباری‌مسافر» بدونِ حداقل یک مسافر (با نام) ثبت نمی‌شوند."
                               FontSize="10.5" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- نوارِ پایین -->
        <DockPanel Grid.Row="4" Margin="2,8,2,0">
            <Button DockPanel.Dock="Left" Content="💾 ثبتِ فروش (F9)" Style="{StaticResource PrimaryButton}" Height="38" Command="{Binding SaveCommand}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="جمعِ کل: " Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding GrandTotal, Converter={StaticResource Num}}" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" FlowDirection="LeftToRight" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="سود: " Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalProfit, Converter={StaticResource Num}}" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                <TextBlock Text=" ریال" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
