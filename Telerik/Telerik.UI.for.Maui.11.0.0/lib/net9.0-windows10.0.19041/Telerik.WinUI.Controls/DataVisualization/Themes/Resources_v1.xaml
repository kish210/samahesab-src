<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Telerik.UI.Xaml.Controls.DataVisualization"
    xmlns:bulletGraph="using:Telerik.UI.Xaml.Controls.DataVisualization.BulletGraph" 
    xmlns:telerikMap="using:Telerik.UI.Xaml.Controls.DataVisualization.Map" 
    xmlns:primitives="using:Telerik.UI.Xaml.Controls.Primitives" 
    xmlns:controls="using:Telerik.UI.Xaml.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Telerik.WinUI.Controls/Themes/CommonThemeResources_v1.xaml"/>

        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark" Source="ms-appx:///Telerik.WinUI.Controls/DataVisualization/Themes/ThemeResourcesDark_v1.xaml"/>
                <ResourceDictionary x:Key="Light" Source="ms-appx:///Telerik.WinUI.Controls/DataVisualization/Themes/ThemeResourcesLight_v1.xaml"/>
                <ResourceDictionary x:Key="HighContrast" Source="ms-appx:///Telerik.WinUI.Controls/DataVisualization/Themes/ThemeResourcesHighContrast.xaml"/>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>

        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark" Source="{CustomResource DarkResourcesPath}"/>
                <ResourceDictionary x:Key="Light" Source="{CustomResource LightResourcesPath}"/>
                <ResourceDictionary x:Key="HighContrast" Source="{CustomResource HighContrastResourcesPath}"/>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>

    <bulletGraph:ValueToVisibilityConverter x:Key="ZeroToCollapsedConverter" Visibility="Collapsed"/>
    <bulletGraph:ValueToVisibilityConverter x:Key="ZeroToVisibleConverter" Visibility="Visible"/>

    <DataTemplate x:Key="LabelTemplate">
        <TextBlock Text="{Binding}" FontSize="12" Foreground="{ThemeResource TelerikGauge_RangeForegroundBrush}"/>
    </DataTemplate>

    <Style TargetType="local:RadLinearGauge">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RadLinearGauge">
                    <local:LinearGaugePanel x:Name="PART_Panel" local:RadLinearGauge.Orientation="{TemplateBinding Orientation}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="LabelTemplate" Value="{StaticResource LabelTemplate}"/>
        <Setter Property="TickTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Rectangle Width="2" Height="4" Fill="{ThemeResource TelerikGauge_TickBackgroundBrush}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RadRadialGauge">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RadRadialGauge">
                    <local:RadialGaugePanel x:Name="PART_Panel"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="LabelTemplate" Value="{StaticResource LabelTemplate}"/>
        <Setter Property="TickTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Rectangle Width="4" Height="2" Fill="{ThemeResource TelerikGauge_TickBackgroundBrush}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:LinearBarGaugeIndicator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:LinearBarGaugeIndicator">
                    <Canvas>
                        <Rectangle x:Name="PART_Bar" Fill="{TemplateBinding Brush}" StrokeThickness="{TemplateBinding BorderThickness}" Stroke="{TemplateBinding BorderBrush}" RenderTransformOrigin="0.5, 0.5"/>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ArrowGaugeIndicator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ArrowGaugeIndicator">
                    <Grid x:Name="PART_Layout" RenderTransformOrigin="0.5, 0.5">
                        <Path x:Name="PART_Path" 
                              StrokeThickness="{TemplateBinding Thickness}"
                              Stroke="{TemplateBinding Brush}"
                              Fill="{TemplateBinding Brush}">
                            <Path.Data>
                                <GeometryGroup>
                                    <PathGeometry>
                                        <PathFigure x:Name="PART_ArrowHead" IsClosed="True">
                                            <LineSegment x:Name="PART_ArrowBottom"/>
                                            <LineSegment x:Name="PART_ArrowTop"/>
                                        </PathFigure>
                                    </PathGeometry>
                                    <LineGeometry x:Name="PART_ArrowShaft"/>
                                    <EllipseGeometry x:Name="PART_ArrowTail" RadiusX="2" RadiusY="2"/>
                                </GeometryGroup>
                            </Path.Data>
                        </Path>
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="PART_NeedleRotateTransform"/>
                        </Grid.RenderTransform>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RadialBarGaugeIndicator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RadialBarGaugeIndicator">
                    <Grid>
                        <Path x:Name="PART_Path" StrokeThickness="{TemplateBinding Thickness}" Stroke="{TemplateBinding Brush}">
                            <Path.Data>
                                <PathGeometry>
                                    <PathGeometry.Figures>
                                        <PathFigure x:Name="PART_Figure"/>
                                    </PathGeometry.Figures>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:MarkerGaugeIndicator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MarkerGaugeIndicator">
                    <Canvas x:Name="PART_Canvas">
                        <ContentPresenter x:Name="PART_VisualElement"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RenderTransformOrigin="0.5, 0.5">
                            <ContentPresenter.RenderTransform>
                                <RotateTransform x:Name="PART_VisualElementRotation"/>
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:SegmentedGaugeIndicator" x:Key="BaseSegmentedIndicatorStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SegmentedGaugeIndicator">
                    <Grid x:Name="PART_Layout"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:SegmentedLinearGaugeIndicator" BasedOn="{StaticResource BaseSegmentedIndicatorStyle}"/>

    <Style TargetType="local:SegmentedRadialGaugeIndicator" BasedOn="{StaticResource BaseSegmentedIndicatorStyle}"/>

    <Style TargetType="local:BarIndicatorSegment">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:BarIndicatorSegment">
                    <Canvas x:Name="PART_Layout"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RadBulletGraph">
        <Setter Property="FeaturedMeasureBrush" Value="{ThemeResource TelerikBulletGraph_FeaturedMeasureBackgroundBrush}"/>
        <Setter Property="FeaturedMeasureAlternativeTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Ellipse Width="10" Height="15" Fill="{ThemeResource TelerikBulletGraph_FeaturedMeasureBackgroundBrush}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ComparativeMeasureTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Rectangle Width="9" Height="15" Fill="{ThemeResource TelerikBulletGraph_ComparitiveMeasureBackgroundBrush}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="TickTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Rectangle Width="2" Height="7" Fill="{ThemeResource TelerikBulletGraph_TickBackgroundBrush}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RadBulletGraph">
                    <local:RadLinearGauge x:Name="PART_Scale"
                                            MinValue="{TemplateBinding StartValue}"
                                            MaxValue="{TemplateBinding EndValue}"
                                            TickStep="{TemplateBinding TickStep}"
                                            LabelStep="{TemplateBinding LabelStep}"
                                            LabelOffset="{TemplateBinding LabelOffset}"
                                            local:RadLinearGauge.Orientation="{TemplateBinding Orientation}"
                                            TickTemplate="{TemplateBinding TickTemplate}"
                                            LabelTemplate="{TemplateBinding LabelTemplate}">

                        <local:SegmentedLinearGaugeIndicator x:Name="PART_QualitativeBar"
                                                             StartValue="{TemplateBinding StartValue}"
                                                             Value="{TemplateBinding EndValue}"
                                                             local:RadLinearGauge.IndicatorOffset="-15"
                                                             Canvas.ZIndex="0"/>
                        <local:LinearBarGaugeIndicator x:Name="PART_FeaturedMeasure"
                                                       Value="{TemplateBinding FeaturedMeasure}"
                                                       Brush="{TemplateBinding FeaturedMeasureBrush}"
                                                       Thickness="{TemplateBinding FeaturedMeasureThickness}"
                                                       local:RadLinearGauge.IndicatorOffset="-15"
                                                       StartValue="{TemplateBinding FeaturedMeasureStartValue}"
                                                       Visibility="{Binding ElementName=PART_BulletGraphScale, Path=MinValue, Converter={StaticResource ZeroToVisibleConverter}}"
                                                       Canvas.ZIndex="9"
                                                       IsAnimated="{TemplateBinding IsAnimated}"/>
                        <local:LinearBarGaugeIndicator x:Name="PART_ProjectedMeasure"
                                                       Value="{TemplateBinding ProjectedMeasure}"
                                                       Brush="{TemplateBinding ProjectedMeasureBrush}"
                                                       StartValue="{TemplateBinding FeaturedMeasureStartValue}"
                                                       Thickness="{Binding Thickness, ElementName=PART_FeaturedMeasure}"
                                                       local:RadLinearGauge.IndicatorOffset="-15"
                                                       Canvas.ZIndex="1"/>
                        <local:MarkerGaugeIndicator x:Name="PART_AlternativeFeaturedMeasure"
                                                    Value="{TemplateBinding FeaturedMeasure}"
                                                    local:RadLinearGauge.IndicatorOffset="-20"
                                                    Visibility="{Binding ElementName=PART_BulletGraphScale, Path=MinValue, Converter={StaticResource ZeroToCollapsedConverter}}"
                                                    ContentTemplate="{TemplateBinding FeaturedMeasureAlternativeTemplate}"
                                                    IsRotated="True"
                                                    Canvas.ZIndex="9"/>
                        <local:MarkerGaugeIndicator x:Name="PART_ComparativeMeasure"
                                                    IsRotated="True"
                                                    local:RadLinearGauge.IndicatorOffset="-15"
                                                    Value="{TemplateBinding ComparativeMeasure}"
                                                    Canvas.ZIndex="2"
                                                    ContentTemplate="{TemplateBinding ComparativeMeasureTemplate}"/>
                    </local:RadLinearGauge>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--<Style TargetType="local:RadBarcode">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RadBarcode">
                    <Grid Background="{TemplateBinding Background}">
                        <Canvas x:Name="PART_MainContainer" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>-->

    <Style x:Key="FastItemsControlBaseStyle" TargetType="local:FastItemsControlBase">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:FastItemsControlBase">
                    <Border Name="PART_ControlRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#region Sparklines-->
    <Style x:Key="NegativeIndicatorStyle" TargetType="local:IndicatorItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:IndicatorItem">
                    <Ellipse Fill="{TemplateBinding Fill}" Height="9" Width="9"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NegativeScatterStyle" TargetType="local:ScatterItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScatterItem">
                    <Ellipse Fill="{TemplateBinding Fill}" Height="9" Width="9"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FirstLastIndicatorStyle" TargetType="local:IndicatorItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:IndicatorItem">
                    <Ellipse Fill="{TemplateBinding Fill}" Height="9" Width="9"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HighLowIndicatorStyle" TargetType="local:IndicatorItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:IndicatorItem">
                    <Ellipse Fill="{TemplateBinding Fill}" Height="9" Width="9"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FirstLastScatterStyle" TargetType="local:ScatterItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScatterItem">
                    <Ellipse Fill="{TemplateBinding Fill}" Height="9" Width="9"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HighLowScatterStyle" TargetType="local:ScatterItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScatterItem">
                    <Ellipse Fill="{TemplateBinding Fill}" Height="9" Width="9"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <local:PointCollectionCloneConverter x:Key="PointCollectionCloneConverter"/>
    <local:RectToRectangleGeometryConverter x:Key="RectToRectangleGeometryConverter"/>

    <Style x:Key="RadWinLossSparklineStyle" TargetType="local:RadWinLossSparkline">
        <Setter Property="AxisStroke" Value="{ThemeResource TelerikSparkline_AxisStroke}"/>
        <Setter Property="ItemFill" Value="{ThemeResource TelerikSparkline_Fill_Column}"/>
        <Setter Property="FirstPointBrush" Value="{ThemeResource TelerikSparkline_FirstLastPointBrush_Column}"/>
        <Setter Property="LastPointBrush" Value="{ThemeResource TelerikSparkline_FirstLastPointBrush_Column}"/>
        <Setter Property="HighPointBrush" Value="{ThemeResource TelerikSparkline_HighLowPointBrush_Column}"/>
        <Setter Property="LowPointBrush" Value="{ThemeResource TelerikSparkline_HighLowPointBrush_Column}"/>
        <Setter Property="NegativePointBrush" Value="{ThemeResource TelerikSparkline_NegativePointBrush_Column}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RadWinLossSparkline">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <local:ColumnsContainer x:Name="PART_IndicatorsContainer"
                                                    ItemStyle="{TemplateBinding ItemStyle}"
                                                    ItemsSource="{TemplateBinding Tag}"/>
                            <Line Stroke="{TemplateBinding AxisStroke}"
                                  StrokeThickness="1"
                                  X1="0"
                                  Y1="{TemplateBinding ZeroYPosition}"
                                  X2="{TemplateBinding AxisWidth}"
                                  Y2="{TemplateBinding ZeroYPosition}"
                                  Visibility="{TemplateBinding AxisVisibility}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RadColumnSparklineStyle" TargetType="local:RadColumnSparkline">
        <Setter Property="AxisStroke" Value="{ThemeResource TelerikSparkline_AxisStroke}"/>
        <Setter Property="ItemFill" Value="{ThemeResource TelerikSparkline_Fill_Column}"/>
        <Setter Property="FirstPointBrush" Value="{ThemeResource TelerikSparkline_FirstLastPointBrush_Column}"/>
        <Setter Property="LastPointBrush" Value="{ThemeResource TelerikSparkline_FirstLastPointBrush_Column}"/>
        <Setter Property="HighPointBrush" Value="{ThemeResource TelerikSparkline_HighLowPointBrush_Column}"/>
        <Setter Property="LowPointBrush" Value="{ThemeResource TelerikSparkline_HighLowPointBrush_Column}"/>
        <Setter Property="NegativePointBrush" Value="{ThemeResource TelerikSparkline_NegativePointBrush_Column}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RadColumnSparkline">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <local:ColumnsContainer x:Name="PART_IndicatorsContainer"
                                                    ColumnLayoutMode="{TemplateBinding ColumnLayoutMode}"
                                                    ItemStyle="{TemplateBinding ItemStyle}"
                                                    ItemsSource="{TemplateBinding Tag}"/>
                            <Line Stroke="{TemplateBinding AxisStroke}"
                                  StrokeThickness="1"
                                  X1="0"
                                  Y1="{TemplateBinding ZeroYPosition}"
                                  X2="{TemplateBinding AxisWidth}"
                                  Y2="{TemplateBinding ZeroYPosition}"
                                  Visibility="{TemplateBinding AxisVisibility}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RadAreaSparklineStyle" TargetType="local:RadAreaSparkline">
        <Setter Property="AxisStroke" Value="{ThemeResource TelerikSparkline_AxisStroke}"/>
        <Setter Property="MarkersBrush" Value="{ThemeResource TelerikSparkline_MarkersBrush}"/>
        <Setter Property="PositiveAreaFill" Value="{ThemeResource TelerikSparkline_PositiveAreaFill}"/>
        <Setter Property="PositiveAreaStroke" Value="{ThemeResource TelerikSparkline_Stroke}"/>
        <Setter Property="NegativeAreaFill" Value="{ThemeResource TelerikSparkline_NegativeAreaFill}"/>
        <Setter Property="NegativeAreaStroke" Value="{ThemeResource TelerikSparkline_NegativeAreaStroke}"/>
        <Setter Property="FirstPointBrush" Value="{ThemeResource TelerikSparkline_FirstLastPointBrush}"/>
        <Setter Property="FirstPointStyle" Value="{StaticResource FirstLastIndicatorStyle}"/>
        <Setter Property="LastPointBrush" Value="{ThemeResource TelerikSparkline_FirstLastPointBrush}"/>
        <Setter Property="LastPointStyle" Value="{StaticResource FirstLastIndicatorStyle}"/>
        <Setter Property="HighPointBrush" Value="{ThemeResource TelerikSparkline_HighLowPointBrush}"/>
        <Setter Property="HighPointStyle" Value="{StaticResource HighLowIndicatorStyle}"/>
        <Setter Property="LowPointBrush" Value="{ThemeResource TelerikSparkline_HighLowPointBrush}"/>
        <Setter Property="LowPointStyle" Value="{StaticResource HighLowIndicatorStyle}"/>
        <Setter Property="NegativePointBrush" Value="{ThemeResource TelerikSparkline_NegativePointBrush}"/>
        <Setter Property="NegativePointStyle" Value="{StaticResource NegativeIndicatorStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RadAreaSparkline">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Polyline Visibility="{TemplateBinding TopLineVisibility}"
                                      Clip="{Binding TopClipRect, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RectToRectangleGeometryConverter}}"
                                      Points="{Binding AreaPoints, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PointCollectionCloneConverter}}"
                                      Fill="{TemplateBinding PositiveAreaFill}"
                                      Style="{TemplateBinding PositiveAreaShapeStyle}"/>
                            <Polyline Visibility="{TemplateBinding TopLineVisibility}"
                                      Clip="{Binding TopClipRect, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RectToRectangleGeometryConverter}}"
                                      Points="{Binding LinePoints, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PointCollectionCloneConverter}}"
                                      StrokeLineJoin="Round"
                                      StrokeThickness="1"
                                      Stroke="{TemplateBinding PositiveAreaStroke}"
                                      Style="{TemplateBinding PositiveLineShapeStyle}"/>
                            <Polyline Visibility="{TemplateBinding BottomLineVisibility}"
                                      Clip="{Binding BottomClipRect, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RectToRectangleGeometryConverter}}"
                                      Points="{Binding AreaPoints, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PointCollectionCloneConverter}}"
                                      Fill="{TemplateBinding NegativeAreaFill}"
                                      Style="{TemplateBinding NegativeAreaShapeStyle}"/>
                            <Polyline Visibility="{TemplateBinding BottomLineVisibility}"
                                      Clip="{Binding BottomClipRect, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RectToRectangleGeometryConverter}}"
                                      Points="{Binding LinePoints, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PointCollectionCloneConverter}}"
                                      StrokeLineJoin="Round"
                                      StrokeThickness="1"
                                      Stroke="{TemplateBinding NegativeAreaStroke}"
                                      Style="{TemplateBinding NegativeLineShapeStyle}"/>
                            <Line Stroke="{TemplateBinding AxisStroke}"
                                  X1="0"
                                  Y1="{TemplateBinding ZeroYPosition}"
                                  X2="{TemplateBinding AxisWidth}"
                                  Y2="{TemplateBinding ZeroYPosition}"
                                  StrokeThickness="1"
                                  Visibility="{TemplateBinding AxisVisibility}"/>
                            <local:IndicatorsContainer x:Name="PART_IndicatorsContainer"
                                                       ItemStyle="{TemplateBinding IndicatorStyle}"
                                                       ItemsSource="{TemplateBinding IndicatorsPoints}"
                                                       Visibility="{TemplateBinding IndicatorsVisibility}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RadLinearSparklineStyle" TargetType="local:RadLinearSparkline">
        <Setter Property="AxisStroke" Value="{ThemeResource TelerikSparkline_AxisStroke}"/>
        <Setter Property="LineStroke" Value="{ThemeResource TelerikSparkline_Stroke}"/>
        <Setter Property="MarkersBrush" Value="{ThemeResource TelerikSparkline_MarkersBrush}"/>
        <Setter Property="NormalRangeFill" Value="{ThemeResource TelerikSparkline_NormalRangeFill}"/>
        <Setter Property="FirstPointBrush" Value="{ThemeResource TelerikSparkline_FirstLastPointBrush}"/>
        <Setter Property="FirstPointStyle" Value="{StaticResource FirstLastIndicatorStyle}"/>
        <Setter Property="LastPointBrush" Value="{ThemeResource TelerikSparkline_FirstLastPointBrush}"/>
        <Setter Property="LastPointStyle" Value="{StaticResource FirstLastIndicatorStyle}"/>
        <Setter Property="HighPointBrush" Value="{ThemeResource TelerikSparkline_HighLowPointBrush}"/>
        <Setter Property="HighPointStyle" Value="{StaticResource HighLowIndicatorStyle}"/>
        <Setter Property="LowPointBrush" Value="{ThemeResource TelerikSparkline_HighLowPointBrush}"/>
        <Setter Property="LowPointStyle" Value="{StaticResource HighLowIndicatorStyle}"/>
        <Setter Property="NegativePointBrush" Value="{ThemeResource TelerikSparkline_NegativePointBrush}"/>
        <Setter Property="NegativePointStyle" Value="{StaticResource NegativeIndicatorStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RadLinearSparkline">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Path Fill="{TemplateBinding NormalRangeFill}"
                                  Data="{Binding NormalRangeRect, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RectToRectangleGeometryConverter}}"
                                  Visibility="{TemplateBinding NormalRangeVisibility}"/>
                            <Polyline Visibility="{TemplateBinding LineShapeVisibility}"
                                      Style="{TemplateBinding LineShapeStyle}"
                                      Points="{Binding LinePoints, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PointCollectionCloneConverter}}"
                                      StrokeLineJoin="Round"
                                      Stroke="{TemplateBinding LineStroke}"/>
                            <Line Stroke="{TemplateBinding AxisStroke}"
                                  StrokeThickness="1"
                                  X1="0"
                                  Y1="{TemplateBinding ZeroYPosition}"
                                  X2="{TemplateBinding AxisWidth}"
                                  Y2="{TemplateBinding ZeroYPosition}"
                                  Visibility="{TemplateBinding AxisVisibility}"/>
                            <local:IndicatorsContainer x:Name="PART_IndicatorsContainer"
                                                       ItemStyle="{TemplateBinding IndicatorStyle}"
                                                       ItemsSource="{TemplateBinding IndicatorsPoints}"
                                                       Visibility="{TemplateBinding IndicatorsVisibility}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RadScatterSparklineStyle" TargetType="local:RadScatterSparkline">
        <Setter Property="AxisStroke" Value="{ThemeResource TelerikSparkline_AxisStroke}"/>
        <Setter Property="ItemFill" Value="{ThemeResource TelerikSparkline_MarkersBrush}"/>
        <Setter Property="NormalRangeFill" Value="{ThemeResource TelerikSparkline_NormalRangeFill}"/>
        <Setter Property="FirstPointBrush" Value="{ThemeResource TelerikSparkline_FirstLastPointBrush}"/>
        <Setter Property="FirstPointStyle" Value="{StaticResource FirstLastScatterStyle}"/>
        <Setter Property="LastPointBrush" Value="{ThemeResource TelerikSparkline_FirstLastPointBrush}"/>
        <Setter Property="LastPointStyle" Value="{StaticResource FirstLastScatterStyle}"/>
        <Setter Property="HighPointBrush" Value="{ThemeResource TelerikSparkline_HighLowPointBrush}"/>
        <Setter Property="HighPointStyle" Value="{StaticResource HighLowScatterStyle}"/>
        <Setter Property="LowPointBrush" Value="{ThemeResource TelerikSparkline_HighLowPointBrush}"/>
        <Setter Property="LowPointStyle" Value="{StaticResource HighLowScatterStyle}"/>
        <Setter Property="NegativePointBrush" Value="{ThemeResource TelerikSparkline_NegativePointBrush}"/>
        <Setter Property="NegativePointStyle" Value="{StaticResource NegativeScatterStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RadScatterSparkline">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Path Fill="{TemplateBinding NormalRangeFill}"
                                  Data="{Binding NormalRangeRect, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RectToRectangleGeometryConverter}}"
                                  Visibility="{TemplateBinding NormalRangeVisibility}"/>
                            <Line Stroke="{TemplateBinding AxisStroke}"
                                  StrokeThickness="1"
                                  X1="0"
                                  Y1="{TemplateBinding ZeroYPosition}"
                                  X2="{TemplateBinding AxisWidth}"
                                  Y2="{TemplateBinding ZeroYPosition}"
                                  Visibility="{TemplateBinding AxisVisibility}"/>
                            <local:ScatterContainer x:Name="PART_IndicatorsContainer" ItemStyle="{TemplateBinding ItemStyle}" ItemsSource="{TemplateBinding Tag}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ColumnStyle" TargetType="local:Column">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Column">
                    <Rectangle Fill="{TemplateBinding Fill}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScatterItemStyle" TargetType="local:ScatterItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScatterItem">
                    <Ellipse Fill="{TemplateBinding Fill}" Width="9" Height="9"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IndicatorItemStyle" TargetType="local:IndicatorItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:IndicatorItem">
                    <Ellipse Fill="{TemplateBinding Fill}" Width="9" Height="9"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ColumnsContainer" BasedOn="{StaticResource FastItemsControlBaseStyle}"/>
    <Style TargetType="local:ScatterContainer" BasedOn="{StaticResource FastItemsControlBaseStyle}"/>
    <Style TargetType="local:IndicatorsContainer" BasedOn="{StaticResource FastItemsControlBaseStyle}"/>
