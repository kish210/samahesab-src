<UserControl x:Class="SamaHesab.WPF.Views.Accounting.BankAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ErpToolbar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ErpToolButton}" Command="{Binding RefreshCommand}">
                    <StackPanel><materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="بروزرسانی" TextAlignment="Center"/></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}" Margin="3" Padding="0">
            <telerik:RadGridView ItemsSource="{Binding Accounts}" Style="{StaticResource ErpGrid}" ShowSearchPanel="True"
                                 IsReadOnly="True" ShowGroupPanel="True" ShowColumnFooters="True">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="بانک" DataMemberBinding="{Binding BankName}" Width="150"/>
                    <telerik:GridViewDataColumn Header="شماره حساب" DataMemberBinding="{Binding AccountNumber}" Width="160"/>
                    <telerik:GridViewDataColumn Header="شبا" DataMemberBinding="{Binding Sheba}" Width="*"/>
                    <telerik:GridViewDataColumn Header="شماره کارت" DataMemberBinding="{Binding CardNumber}" Width="160"/>
                    <telerik:GridViewDataColumn Header="شعبه" DataMemberBinding="{Binding BranchName}" Width="140"/>
                    <telerik:GridViewDataColumn Header="مانده اولیه" DataMemberBinding="{Binding OpeningBalance}" DataFormatString="{}{0:#,##0}" Width="140"/>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ErpToolbar}" BorderThickness="0,1,0,0">
            <TextBlock HorizontalAlignment="Right" FontSize="12" Margin="4,2" VerticalAlignment="Center">
                <Run Text="تعداد حساب‌ها:"/><Run Text="{Binding TotalCount}" FontWeight="Bold"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
