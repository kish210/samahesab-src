<mah:MetroWindow x:Class="SamaHesab.WPF.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="{Binding CompanyName}"
        WindowState="Maximized"
        MinWidth="1200" MinHeight="760"
        FlowDirection="RightToLeft"
        TitleCharacterCasing="Normal"
        FontFamily="{StaticResource VazirFont}"
        Background="{DynamicResource AppBackground}"
        GlowBrush="{DynamicResource PrimaryAccent}"
        BorderThickness="0">

    <mah:MetroWindow.Resources>

        <!-- ─── Ribbon big button ─────────────────────────────────────────── -->
        <Style x:Key="RibbonButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="78"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF4FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Ribbon small QAT icon button ──────────────────────────────── -->
        <Style x:Key="QatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Tree nav group expander ───────────────────────────────────── -->
        <Style x:Key="NavExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}"/>
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
        </Style>

        <!-- ─── Tree nav leaf item ────────────────────────────────────────── -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="6,1" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Quick Access Toolbar -->
            <RowDefinition Height="Auto"/>   <!-- Ribbon -->
            <RowDefinition Height="*"/>      <!-- Nav + Workspace -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══ Quick Access Toolbar ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource RibbonBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="14,8">

                <!-- Company (right side in RTL) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/Images/logo.png" Height="32"
                           Stretch="Uniform" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="10,4"/>
                    <TextBlock Text="{Binding CompanyName}" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,0,0"/>
                </StackPanel>

                <!-- Action cluster (left side in RTL) -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Date -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                        <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="18" Height="18"
                                                 Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TodayPersianDate}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="8,4"/>
                    <!-- Branch -->
                    <Button Style="{StaticResource QatButton}" Width="Auto" Padding="8,0"
                            Command="{Binding ChangeBranchCommand}" ToolTip="تغییر شعبه">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SourceBranch" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentBranch}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="8,4"/>
                    <!-- Calculator -->
                    <Button Style="{StaticResource QatButton}" Command="{Binding OpenCalculatorCommand}" ToolTip="ماشین حساب">
                        <materialDesign:PackIcon Kind="Calculator" Width="20" Height="20"/>
                    </Button>
                    <!-- Notifications -->
                    <Button Style="{StaticResource QatButton}" Command="{Binding ShowNotificationsCommand}" ToolTip="اعلان‌ها">
                        <materialDesign:Badged Badge="{Binding NotificationCount}" BadgeColorZoneMode="SecondaryMid">
                            <materialDesign:PackIcon Kind="BellOutline" Width="20" Height="20"/>
                        </materialDesign:Badged>
                    </Button>
                    <!-- Messages -->
                    <Button Style="{StaticResource QatButton}" Command="{Binding ShowMessagesCommand}" ToolTip="پیام‌ها">
                        <materialDesign:Badged Badge="{Binding MessageCount}" BadgeColorZoneMode="SecondaryMid">
                            <materialDesign:PackIcon Kind="EmailOutline" Width="20" Height="20"/>
                        </materialDesign:Badged>
                    </Button>
                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="8,4"/>
                    <!-- User -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                        <materialDesign:PackIcon Kind="AccountCircle" Width="26" Height="26"
                                                 Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center"/>
                        <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUserName}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CurrentUserRole}" FontSize="10"
                                       Foreground="{DynamicResource SecondaryText}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource QatButton}" Command="{Binding LogoutCommand}" ToolTip="خروج">
                        <materialDesign:PackIcon Kind="LogoutVariant" Width="20" Height="20" Foreground="{DynamicResource DangerColor}"/>
                    </Button>
                </StackPanel>

                <!-- Quick search (center, fills) -->
                <Border Background="{DynamicResource AppBackground}" CornerRadius="8"
                        Margin="20,0" MaxWidth="520" HorizontalAlignment="Stretch"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18"
                                                 Margin="10,0" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox Grid.Column="1" Text="{Binding QuickSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                 materialDesign:HintAssist.Hint="جستجوی سریع (Ctrl+F)"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- ═══ Standard top menu ═══ -->
        <Menu Grid.Row="1" FontFamily="{StaticResource VazirFont}" FontSize="13"
              Background="{DynamicResource RibbonBackground}" Padding="8,3"
              BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <MenuItem Header="حسابداری">
                <MenuItem Header="ثبت سند" Command="{Binding NavigateCommand}" CommandParameter="VoucherEdit"/>
                <MenuItem Header="اسناد حسابداری" Command="{Binding NavigateCommand}" CommandParameter="Vouchers"/>
                <MenuItem Header="نمودار حساب‌ها" Command="{Binding NavigateCommand}" CommandParameter="ChartOfAccounts"/>
                <Separator/>
                <MenuItem Header="گزارش‌ها" Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
            </MenuItem>
            <MenuItem Header="خزانه‌داری">
                <MenuItem Header="مدیریت چک" Command="{Binding NavigateCommand}" CommandParameter="Cheques"/>
                <MenuItem Header="حساب‌های بانکی" Command="{Binding NavigateCommand}" CommandParameter="BankAccounts"/>
            </MenuItem>
            <MenuItem Header="فروش">
                <MenuItem Header="فاکتور فروش" Command="{Binding NavigateCommand}" CommandParameter="SalesInvoice"/>
                <MenuItem Header="لیست فاکتورها" Command="{Binding NavigateCommand}" CommandParameter="SalesInvoiceList"/>
                <MenuItem Header="صندوق فروش" Command="{Binding NavigateCommand}" CommandParameter="POS"/>
            </MenuItem>
            <MenuItem Header="خرید">
                <MenuItem Header="فاکتور خرید" Command="{Binding NavigateCommand}" CommandParameter="PurchaseInvoice"/>
                <MenuItem Header="لیست خریدها" Command="{Binding NavigateCommand}" CommandParameter="PurchaseInvoiceList"/>
            </MenuItem>
            <MenuItem Header="انبار">
                <MenuItem Header="کالاها" Command="{Binding NavigateCommand}" CommandParameter="Products"/>
                <MenuItem Header="انبارها" Command="{Binding NavigateCommand}" CommandParameter="Warehouses"/>
                <MenuItem Header="تعدیل موجودی" Command="{Binding NavigateCommand}" CommandParameter="StockAdjust"/>
            </MenuItem>
            <MenuItem Header="اشخاص">
                <MenuItem Header="مشتریان" Command="{Binding NavigateCommand}" CommandParameter="Customers"/>
                <MenuItem Header="تأمین‌کنندگان" Command="{Binding NavigateCommand}" CommandParameter="Suppliers"/>
            </MenuItem>
            <MenuItem Header="منابع انسانی">
                <MenuItem Header="کارکنان" Command="{Binding NavigateCommand}" CommandParameter="Employees"/>
                <MenuItem Header="حقوق و دستمزد" Command="{Binding NavigateCommand}" CommandParameter="Salary"/>
                <MenuItem Header="حضور و غیاب" Command="{Binding NavigateCommand}" CommandParameter="Attendance"/>
            </MenuItem>
            <MenuItem Header="گزارشات">
                <MenuItem Header="گزارش‌ها" Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
            </MenuItem>
            <MenuItem Header="سیستم">
                <MenuItem Header="داشبورد" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                <MenuItem Header="تنظیمات" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                <MenuItem Header="پشتیبان‌گیری" Command="{Binding NavigateCommand}" CommandParameter="Backup"/>
                <Separator/>
                <MenuItem Header="خروج" Command="{Binding LogoutCommand}"/>
            </MenuItem>
            <MenuItem Header="نمایش (پوسته)">
                <MenuItem Header="Office 2019" Command="{Binding ChangeThemeCommand}" CommandParameter="Office2019"/>
                <MenuItem Header="Fluent" Command="{Binding ChangeThemeCommand}" CommandParameter="Fluent"/>
                <MenuItem Header="Crystal" Command="{Binding ChangeThemeCommand}" CommandParameter="Crystal"/>
                <MenuItem Header="Windows 11" Command="{Binding ChangeThemeCommand}" CommandParameter="Windows11"/>
            </MenuItem>
        </Menu>

        <!-- ═══ Workspace: Telerik RadDocking (full width MDI) ═══ -->
        <telerik:RadDocking Grid.Row="2" x:Name="docking" Margin="2"
                            Close="Docking_Close" BorderThickness="0" HasDocumentHost="True">
            <telerik:RadDocking.DocumentHost>
                <telerik:RadSplitContainer>
                    <telerik:RadPaneGroup x:Name="docGroup"/>
                </telerik:RadSplitContainer>
            </telerik:RadDocking.DocumentHost>
        </telerik:RadDocking>
        <!-- ═══ Status bar ═══ -->
        <Border Grid.Row="3" Background="{DynamicResource SidebarBackground}" Height="28">
            <DockPanel LastChildFill="False" Margin="14,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}"
                           Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="سماع رایانه کیش | سما حساب ۱.۰.۰ | kishwifi.com"
                           Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentBranch}" Margin="16,0,0,0"
                           Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding TodayPersianDate}" Margin="16,0,0,0"
                           Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
