<UserControl x:Class="SamaHesab.WPF.Views.Purchase.PurchaseInvoiceEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">

    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- toolbar + supplier (top) -->
            <RowDefinition Height="Auto"/>   <!-- add-item line -->
            <RowDefinition Height="*"/>      <!-- products grid + summary -->
            <RowDefinition Height="Auto"/>   <!-- payment bar -->
        </Grid.RowDefinitions>

        <!-- ═══ Top: actions + supplier header ═══ -->
        <Border Grid.Row="0" Style="{StaticResource ErpToolbar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ErpToolButton}" Command="{Binding NewInvoiceCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="FilePlusOutline" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="جدید" TextAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ErpToolButton}" Command="{Binding PrintCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="PrinterOutline" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="چاپ" TextAlignment="Center"/></StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="6,6"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <materialDesign:PackIcon Kind="TruckOutline" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource WarningColor}"/>
                    <TextBlock Text="تأمین‌کننده" Style="{StaticResource ErpInlineLabel}" Margin="6,0"/>
                    <telerik:RadComboBox ItemsSource="{Binding Suppliers}" Width="320"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedSupplierId}"
                              IsEditable="True" IsFilteringEnabled="True"
                              CanAutocompleteSelectItems="True" OpenDropDownOnFocus="True"
                              EmptyText="انتخاب / جستجوی تأمین‌کننده..." Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="انبار" Style="{StaticResource ErpInlineLabel}"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" Width="130" Height="30"
                              ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedWarehouseId}"/>
                    <TextBlock Text="تاریخ" Style="{StaticResource ErpInlineLabel}" Margin="10,0,6,0"/>
                    <TextBox Text="{Binding InvoiceDate}" Width="95"/>
                    <TextBlock Text="شماره" Style="{StaticResource ErpInlineLabel}" Margin="10,0,6,0"/>
                    <TextBox Text="{Binding InvoiceNumber}" Width="92" IsReadOnly="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Add-item line ═══ -->
        <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}" Margin="3,3,3,0" Padding="6,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="3,0">
                    <TextBlock Text="کالا (کد / بارکد / نام)" Style="{StaticResource FieldCaption}"/>
                    <telerik:RadComboBox ItemsSource="{Binding AllProducts}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedProductItem}" TextSearchMode="Contains"
                              IsEditable="True" IsFilteringEnabled="True" CanAutocompleteSelectItems="True"
                              OpenDropDownOnFocus="True" EmptyText="جستجوی کالا..." Height="32"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="3,0">
                    <TextBlock Text="مقدار" Style="{StaticResource FieldCaption}"/>
                    <telerik:RadMaskedNumericInput Value="{Binding AddQty}" Mask="n2" Height="32"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="3,0">
                    <TextBlock Text="قیمت خرید" Style="{StaticResource FieldCaption}"/>
                    <telerik:RadMaskedNumericInput Value="{Binding AddUnitPrice}" Mask="n0" Height="32"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="3,0">
                    <TextBlock Text="تخفیف ٪" Style="{StaticResource FieldCaption}"/>
                    <telerik:RadMaskedNumericInput Value="{Binding AddDiscountPct}" Mask="n0" Height="32"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="3,0">
                    <TextBlock Text="مالیات ٪" Style="{StaticResource FieldCaption}"/>
                    <telerik:RadMaskedNumericInput Value="{Binding AddTaxPct}" Mask="n0" Height="32"/>
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="3,0" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Command="{Binding AddSelectedProductCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="افزودن" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Center: products grid + financial summary ═══ -->
        <Grid Grid.Row="2" Margin="0,3,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ErpCardPanel}" Padding="0">
                <telerik:RadGridView ItemsSource="{Binding InvoiceItems}" SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False" RowIndicatorVisibility="Collapsed" RowHeight="28" CanUserInsertRows="False" CanUserDeleteRows="False"
                          ShowColumnFooters="True" IsReadOnly="False" GridLinesVisibility="Both">
                    <telerik:RadGridView.Columns>
                        <telerik:GridViewDataColumn Header="ردیف" DataMemberBinding="{Binding RowNumber}" Width="48" IsReadOnly="True"/>
                        <telerik:GridViewDataColumn Header="کد" DataMemberBinding="{Binding ProductCode}" Width="90" IsReadOnly="True"/>
                        <telerik:GridViewDataColumn Header="نام کالا" DataMemberBinding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                        <telerik:GridViewDataColumn Header="مقدار" DataMemberBinding="{Binding Quantity}" Width="90"/>
                        <telerik:GridViewDataColumn Header="قیمت خرید" DataMemberBinding="{Binding UnitPrice}" DataFormatString="{}{0:#,##0}" Width="120"/>
                        <telerik:GridViewDataColumn Header="تخفیف ٪" DataMemberBinding="{Binding DiscountPct}" Width="80"/>
                        <telerik:GridViewDataColumn Header="مالیات ٪" DataMemberBinding="{Binding TaxPct}" Width="80"/>
                        <telerik:GridViewDataColumn Header="مبلغ خالص" DataMemberBinding="{Binding NetAmount}" DataFormatString="{}{0:#,##0}" Width="140" IsReadOnly="True">
                            <telerik:GridViewDataColumn.AggregateFunctions>
                                <telerik:SumFunction ResultFormatString="{}{0:#,##0}"/>
                            </telerik:GridViewDataColumn.AggregateFunctions>
                        </telerik:GridViewDataColumn>
                        <telerik:GridViewDataColumn Header="حذف" Width="50" IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ErpToolButton}" Width="34" Height="26"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="{DynamicResource DangerColor}"/>
                                    </Button>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource ErpCardPanel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource ErpPanelHeader}">
                        <TextBlock Text="خلاصه مالی خرید" FontWeight="Bold" FontSize="12"/></Border>
                    <StackPanel Margin="10,8">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="نوع" Style="{StaticResource ErpInlineLabel}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource BaseComboBox}" Height="28" ItemsSource="{Binding InvoiceTypes}" SelectedItem="{Binding InvoiceType}"/>
                        </Grid>
                        <Separator Margin="0,6"/>
                        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="جمع کل" Foreground="{DynamicResource SecondaryText}"/><TextBlock DockPanel.Dock="Left" Text="{Binding SubTotal, StringFormat={}{0:#,##0}}"/></DockPanel>
                        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="تخفیف" Foreground="{DynamicResource SecondaryText}"/><TextBlock DockPanel.Dock="Left" Text="{Binding TotalDiscount, StringFormat={}{0:#,##0}}" Foreground="{DynamicResource DangerColor}"/></DockPanel>
                        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="مالیات" Foreground="{DynamicResource SecondaryText}"/><TextBlock DockPanel.Dock="Left" Text="{Binding TotalTax, StringFormat={}{0:#,##0}}"/></DockPanel>
                        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="هزینه حمل" Foreground="{DynamicResource SecondaryText}"/><telerik:RadMaskedNumericInput DockPanel.Dock="Left" Width="120" Value="{Binding Shipping}" Mask="n0" Height="28"/></DockPanel>
                        <Separator Margin="0,8"/>
                        <DockPanel Margin="0,3">
                            <TextBlock DockPanel.Dock="Right" Text="قابل پرداخت" FontWeight="Bold" FontSize="14"/>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding GrandTotal, StringFormat={}{0:#,##0}}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryAccent}"/>
                        </DockPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ Bottom: payment bar ═══ -->
        <Border Grid.Row="3" Style="{StaticResource ErpToolbar}" BorderThickness="0,1,0,0">
            <Grid Margin="4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CashMultiple" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource WarningColor}"/>
                    <TextBlock Text="نحوه پرداخت" Style="{StaticResource ErpInlineLabel}" Margin="6,0"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" Width="120" Height="30" ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding PaymentType}"/>
                    <TextBlock Text="پرداختی" Style="{StaticResource ErpInlineLabel}" Margin="12,0,6,0"/>
                    <telerik:RadMaskedNumericInput Value="{Binding PaidAmount}" Mask="n0" Width="140" Height="30"/>
                    <TextBlock Text="سررسید" Style="{StaticResource ErpInlineLabel}" Margin="12,0,6,0"/>
                    <TextBox Text="{Binding DueDate}" Width="95"/>
                    <TextBlock Text="مانده" Style="{StaticResource ErpInlineLabel}" Margin="12,0,6,0"/>
                    <TextBlock Text="{Binding RemainAmount, StringFormat={}{0:#,##0}}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource DangerColor}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource SuccessButton}" Height="40" Padding="24,0" Command="{Binding PostInvoiceCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckCircle" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="ثبت قطعی فاکتور خرید" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
