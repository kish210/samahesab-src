    <!--#region TabControl-->

    <ControlTemplate x:Key="TabItemTemplate" TargetType="local:RadTabItem">
        <!-- PUBLIC: x:Name is used in code -->
        <Grid x:Name="wrapper">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="PointerOverVisual.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="DisabledVisual.Visibility" Value="Visible"/>
                            <Setter Target="HeaderElement.Opacity" Value="{ThemeResource TelerikControlDisabledOpacity}"/>
                            <Setter Target="SelectedVisual.Opacity" Value="{ThemeResource TelerikControlDisabledOpacity}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="SelectionStates">
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Target="SelectedVisual.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="NotSelected">
                        <VisualState.Setters>
                            <Setter Target="SelectedVisual.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="PinStates">
                    <VisualState x:Name="Pinned">
                        <VisualState.Setters>
                            <Setter Target="PinIcon.Glyph" Value="&#xE840;"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unpinned">
                        <VisualState.Setters>
                            <Setter Target="PinIcon.Glyph" Value="&#xE718;"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="PlacementOrientationStates">
                    <VisualState x:Name="HorizontalTop" />
                    <VisualState x:Name="HorizontalLeft" />
                    <VisualState x:Name="HorizontalRight" />
                    <VisualState x:Name="HorizontalBottom">
                        <VisualState.Setters>
                            <Setter Target="OrientationTransform.LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="VerticalTop">
                        <VisualState.Setters>
                            <Setter Target="OrientationTransform.LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="VerticalLeft">
                        <VisualState.Setters>
                            <Setter Target="OrientationTransform.LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="VerticalRight">
                        <VisualState.Setters>
                            <Setter Target="OrientationTransform.LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="VerticalBottom">
                        <VisualState.Setters>
                            <Setter Target="OrientationTransform.LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="BorderVisual"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" />
            <Border x:Name="PointerOverVisual"
                    Background="{ThemeResource TelerikTabControl_ItemBackground_PointerOver}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Visibility="Collapsed"/>
            <Border x:Name="DisabledVisual"
                    Background="{ThemeResource TelerikTabControl_ItemBackground_Disabled}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Visibility="Collapsed"/>
            <Border x:Name="SelectedVisual"
                    BorderBrush="{ThemeResource TelerikTabControl_ItemBorderBrush_Selected}"
                    BorderThickness="0 0 0 3"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed"/>
            <!--Content-->
            <telerikPrimitives:RadLayoutTransformControl x:Name="OrientationTransform">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="HeaderElement"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Foreground="{TemplateBinding HeaderForeground}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}" />
                    <local:RadButton x:Name="PinButton" Grid.Column="1"
                                     Visibility="{TemplateBinding PinButtonVisibility}"
                                     Background="Transparent" MinHeight="0"
                                     Width="{ThemeResource TelerikTabControl_PinCloseButtonWidthHeight}"
                                     Height="{ThemeResource TelerikTabControl_PinCloseButtonWidthHeight}"
                                     Margin="0 0 5 0" Padding="0"
                                     Command="{core:Static Member=tabcontrol:TabItemCommands.TogglePin}"
                                     IsTabStop="False">
                        <FontIcon x:Name="PinIcon"
                                  Foreground="{ThemeResource TelerikTabControl_IconForeground}"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="{ThemeResource TelerikIconFontSize}"
                                  Glyph="&#xE718;"/>
                    </local:RadButton>
                    <local:RadButton x:Name="CloseButton" Grid.Column="2"
                                     Visibility="{TemplateBinding CloseButtonVisibility}"
                                     Background="Transparent" MinHeight="0"
                                     Width="{ThemeResource TelerikTabControl_PinCloseButtonWidthHeight}"
                                     Height="{ThemeResource TelerikTabControl_PinCloseButtonWidthHeight}"
                                     Margin="0 0 5 0" Padding="0"
                                     Command="{core:Static Member=tabcontrol:TabItemCommands.Close}"
                                     IsTabStop="False">
                        <FontIcon Foreground="{ThemeResource TelerikTabControl_IconForeground}"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="10"
                                  Glyph="&#xE894;"/>
                    </local:RadButton>
                </Grid>
            </telerikPrimitives:RadLayoutTransformControl>
        </Grid>
    </ControlTemplate>

    <Style TargetType="local:RadTabItem">
        <Setter Property="FontSize" Value="{ThemeResource TelerikTabControl_FontSize}" />
        <Setter Property="Background" Value="{ThemeResource TelerikTabControl_ItemBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TelerikTabControl_ItemBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10 0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HeaderForeground" Value="{ThemeResource TelerikTabControl_ItemForeground}" />
