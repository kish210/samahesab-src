<UserControl x:Class="SamaHesab.WPF.Views.Accounting.BankAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource FormSectionCard}" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <Border Width="40" Height="40" CornerRadius="8" Background="#E0EDFF">
                        <materialDesign:PackIcon Kind="BankOutline" Width="22" Height="22"
                                                 Foreground="{DynamicResource PrimaryAccent}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="حساب‌های بانکی" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Command="{Binding RefreshCommand}">
                    <StackPanel><materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="بروزرسانی" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}" Padding="0">
            <telerik:RadGridView ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" ShowSearchPanel="True"
                                 IsReadOnly="True" RowIndicatorVisibility="Collapsed" ShowGroupPanel="True"
                                 FontFamily="{StaticResource VazirFont}">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="بانک" DataMemberBinding="{Binding BankName}" Width="150"/>
                    <telerik:GridViewDataColumn Header="شماره حساب" DataMemberBinding="{Binding AccountNumber}" Width="160"/>
                    <telerik:GridViewDataColumn Header="شبا" DataMemberBinding="{Binding Sheba}" Width="*"/>
                    <telerik:GridViewDataColumn Header="شماره کارت" DataMemberBinding="{Binding CardNumber}" Width="160"/>
                    <telerik:GridViewDataColumn Header="شعبه" DataMemberBinding="{Binding BranchName}" Width="140"/>
                    <telerik:GridViewDataColumn Header="مانده اولیه" DataMemberBinding="{Binding OpeningBalance}" DataFormatString="{}{0:#,##0}" Width="140"/>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FormSectionCard}" Padding="12,8">
            <TextBlock HorizontalAlignment="Right" FontSize="12">
                <Run Text="تعداد حساب‌ها:"/><Run Text="{Binding TotalCount}" FontWeight="Bold"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
