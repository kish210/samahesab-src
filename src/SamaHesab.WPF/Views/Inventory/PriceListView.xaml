<UserControl x:Class="SamaHesab.WPF.Views.Inventory.PriceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="Auto"/>   <!-- bulk strip -->
            <RowDefinition Height="*"/>      <!-- grid -->
            <RowDefinition Height="Auto"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- toolbar: actions + search -->
        <Border Grid.Row="0" Style="{StaticResource ErpToolbar}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ErpToolButton}" Command="{Binding SaveCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="ذخیرهٔ قیمت‌ها" TextAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ErpToolButton}" Command="{Binding RunSearchCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="بازخوانی" TextAlignment="Center"/></StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{DynamicResource BorderColor}" Margin="6,6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="6,0" VerticalAlignment="Center">
                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding RunSearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- bulk apply strip -->
        <Border Grid.Row="1" Style="{StaticResource ErpCardPanel}" Margin="3,3,3,0" Padding="8,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Percent" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource WarningColor}"/>
                <TextBlock Text="اعمالِ گروهی روی سطح:" Style="{StaticResource ErpInlineLabel}" Margin="6,0"/>
                <ComboBox Style="{StaticResource BaseComboBox}" Width="150" Height="30" ItemsSource="{Binding PriceLevels}" SelectedItem="{Binding SelectedPriceLevel}"/>
                <TextBlock Text="درصدِ تغییر (٪):" Style="{StaticResource ErpInlineLabel}" Margin="14,0,6,0"/>
                <TextBox Text="{Binding BulkPercent}" Width="90" Height="30" FlowDirection="LeftToRight" TextAlignment="Center"/>
                <Button Content="اعمال" Command="{Binding ApplyBulkCommand}" Margin="10,0,0,0" Padding="16,5" Cursor="Hand"
                        Background="{DynamicResource PrimaryAccent}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                <TextBlock Text="مثبت=افزایش، منفی=کاهش — روی همهٔ ردیف‌های فهرستِ فعلی." Style="{StaticResource ErpInlineLabel}"
                           Foreground="{DynamicResource SecondaryText}" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- editable price grid -->
        <Border Grid.Row="2" Style="{StaticResource ErpCardPanel}" Margin="3" Padding="0">
            <DataGrid Style="{StaticResource ErpDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False"
                      ItemsSource="{Binding Rows}" RowHeight="28" IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="نام کالا" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="قیمت خرید" Binding="{Binding PurchasePrice, StringFormat={}{0:#,##0}, UpdateSourceTrigger=LostFocus}" Width="130"/>
                    <DataGridTextColumn Header="خرده‌فروشی" Binding="{Binding SalePrice, StringFormat={}{0:#,##0}, UpdateSourceTrigger=LostFocus}" Width="130"/>
                    <DataGridTextColumn Header="عمده" Binding="{Binding WholesalePrice, StringFormat={}{0:#,##0}, UpdateSourceTrigger=LostFocus}" Width="130"/>
                    <DataGridTextColumn Header="مصرف‌کننده" Binding="{Binding ConsumerPrice, StringFormat={}{0:#,##0}, UpdateSourceTrigger=LostFocus}" Width="130"/>
                    <DataGridTemplateColumn Header="" Width="36">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="{DynamicResource WarningColor}"
                                         Visibility="{Binding IsDirty, Converter={StaticResource BoolVis}}" ToolTip="تغییرِ ذخیره‌نشده"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- footer -->
        <Border Grid.Row="3" Style="{StaticResource ErpToolbar}" BorderThickness="0,1,0,0">
            <DockPanel Margin="4,2">
                <TextBlock DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center">
                    <Run Text="تعداد کالا:"/><Run Text="{Binding Rows.Count, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text="   |   تغییرِ ذخیره‌نشده:"/><Run Text="{Binding DirtyCount}" FontWeight="Bold" Foreground="{DynamicResource WarningColor}"/>
                </TextBlock>
                <TextBlock DockPanel.Dock="Left" Text="قیمت‌ها را مستقیم در جدول ویرایش کنید، سپس «ذخیرهٔ قیمت‌ها»."
                           FontSize="11" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
