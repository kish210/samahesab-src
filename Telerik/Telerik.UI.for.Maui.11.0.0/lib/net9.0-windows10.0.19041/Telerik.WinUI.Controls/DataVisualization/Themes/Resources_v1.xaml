                    <Grid x:Name="PART_LayoutRoot">
                        <telerikMap:MultiScaleImage x:Name="PART_MasterImage"/>
                        <telerikMap:TilesVisualizationLayer x:Name="PART_TilesVisualizationLayer"
                                                            Background="{TemplateBinding Background}"
                                                            Grid.RowSpan="2" />
                        <ItemsPresenter Grid.RowSpan="2" />
                        <telerikMap:MouseControl x:Name="PART_MouseControl"/>

                        <Grid VerticalAlignment="Bottom">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="PART_MapBarControlsPanel"
                                  Background="{ThemeResource TelerikMap_NavigationBarBackground}"
                                  Margin="0 0 10 10"
                                  CornerRadius="4"
                                  MinWidth="48"
                                  MinHeight="170"
                                  HorizontalAlignment="Right">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <telerikMap:MapCommandBar x:Name="PART_MapCommandBar"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Right"
                                                          Margin="15 0"/>
                                <telerikMap:MapNavigation x:Name="PART_MapNavigation"
                                                          Grid.Row="1"
                                                          VerticalAlignment="Center"
                                                          Visibility="Visible"/>
                                <telerikMap:MapZoomBar x:Name="PART_MapZoomBar"
                                                       Grid.Row="2"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"
                                                       Visibility="Visible"
                                                       Margin="15 0" />
                            </Grid>
                            <Grid Grid.Row="1"
                                  HorizontalAlignment="Right"
                                  Background="{ThemeResource TelerikMap_NavigationBarBackground}"
                                  CornerRadius="4"
                                  Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition MinWidth="210"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <telerikMap:MapMouseLocationIndicator x:Name="PART_MapMouseLocationIndicator"
                                                                      Visibility="Visible" />
                                <telerikMap:MapScale x:Name="PART_MapScale"
                                                     Grid.Column="1"
                                                     DistanceUnit="{TemplateBinding DistanceUnit}"
                                                     Margin="20 0 0 0"
                                                     Visibility="Visible" />
                            </Grid>
                        </Grid>

                        <primitives:RadExpander
                            x:Name="PART_MiniMapExpander"
                            Visibility="Collapsed"
                            IsExpanded="{TemplateBinding IsMiniMapExpanded}"
                            Style="{StaticResource MapExpanderStyle}">
                            <Grid Width="{TemplateBinding MiniMapWidth}"
                                  Height="{TemplateBinding MiniMapHeight}">
                                <telerikMap:MiniMap x:Name="PART_MiniMap"
                                                    AutomationProperties.Name="Mini Map"/>
                            </Grid>
                        </primitives:RadExpander>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

