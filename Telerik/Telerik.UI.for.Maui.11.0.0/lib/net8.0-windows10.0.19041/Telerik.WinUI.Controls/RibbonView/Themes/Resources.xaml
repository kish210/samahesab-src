    <Style x:Key="ContextualGroupsStyle" TargetType="telerik:RadRibbonContextualGroup">
        <Setter Property="Template" Value="{StaticResource ContextualGroupsTemplate}"/>
        <Setter Property="Foreground" Value="{ThemeResource TelerikRibbonView_RibbonTab_Foreground}"/>
