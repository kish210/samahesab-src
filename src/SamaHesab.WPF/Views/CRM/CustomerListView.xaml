<UserControl x:Class="SamaHesab.WPF.Views.CRM.CustomerListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource FormSectionCard}" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <Border Width="40" Height="40" CornerRadius="8" Background="#E0EDFF">
                        <materialDesign:PackIcon Kind="AccountGroupOutline" Width="22" Height="22"
                                                 Foreground="{DynamicResource PrimaryAccent}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="مشتریان" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding NewCustomerCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="AccountPlusOutline" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/><TextBlock Text="مشتری جدید" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ExportCommand}">
                        <StackPanel><materialDesign:PackIcon Kind="MicrosoftExcel" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource SuccessColor}"/><TextBlock Text="خروجی اکسل" FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Height="36" Width="44"
                        Margin="6,0,0,0" Command="{Binding SearchCommand}">
                    <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18"/>
                </Button>
                <StackPanel>
                    <TextBlock Text="جستجو (کد / نام / موبایل)" Style="{StaticResource FieldCaption}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FormSectionCard}" Padding="0">
            <telerik:RadGridView ItemsSource="{Binding Customers}" AutoGenerateColumns="False"
                                 ShowSearchPanel="True" IsReadOnly="True" CanUserFreezeColumns="True"
                                 ShowGroupPanel="True" ShowColumnFooters="True" RowIndicatorVisibility="Collapsed"
                                 FontFamily="{StaticResource VazirFont}">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="کد" DataMemberBinding="{Binding Code}" Width="90"/>
                    <telerik:GridViewDataColumn Header="نام / شرکت" DataMemberBinding="{Binding Name}" Width="2*"/>
                    <telerik:GridViewDataColumn Header="موبایل" DataMemberBinding="{Binding Mobile}" Width="130"/>
                    <telerik:GridViewDataColumn Header="سطح قیمت" DataMemberBinding="{Binding PriceLevel}" Width="100"/>
                    <telerik:GridViewDataColumn Header="مانده حساب" DataMemberBinding="{Binding Balance}" DataFormatString="{}{0:#,##0}" Width="150">
                        <telerik:GridViewDataColumn.AggregateFunctions>
                            <telerik:SumFunction ResultFormatString="{}{0:#,##0}"/>
                        </telerik:GridViewDataColumn.AggregateFunctions>
                    </telerik:GridViewDataColumn>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource FormSectionCard}" Padding="12,8">
            <TextBlock FontSize="12" HorizontalAlignment="Right">
                <Run Text="تعداد مشتریان:"/><Run Text="{Binding TotalCount}" FontWeight="Bold"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
