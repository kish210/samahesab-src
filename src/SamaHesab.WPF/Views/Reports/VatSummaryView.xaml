<UserControl x:Class="SamaHesab.WPF.Views.Reports.VatSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SamaHesab.WPF.Converters"
             Background="{DynamicResource AppBackground}"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft">
    <!-- F5 = اجرای/تازه‌سازیِ گزارش (کیبوردمحور) -->
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="Num"/>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="خلاصهٔ مالیاتِ ارزش‌افزوده" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
            <TextBlock Text="مالیاتِ فروش (خروجی) منهای مالیاتِ خرید (ورودی) = مالیاتِ قابلِ پرداخت — برای تهیهٔ اظهارنامه."
                       Foreground="{DynamicResource SecondaryText}" FontSize="12.5" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- نوار ابزار -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="از تاریخ:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" Margin="0,0,6,0"/>
            <TextBox Width="120" Height="30" Text="{Binding FromDate}" VerticalContentAlignment="Center" Padding="7,0"
                     Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
            <TextBlock Text="تا تاریخ:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" Margin="12,0,6,0"/>
            <TextBox Width="120" Height="30" Text="{Binding ToDate}" VerticalContentAlignment="Center" Padding="7,0"
                     Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}"/>
            <Button Content="نمایش" Command="{Binding RunCommand}" Margin="10,0,0,0" Style="{StaticResource ErpBtnPrimary}"/>
            <Button Content="اکسل" Command="{Binding ExportCsvCommand}" Margin="6,0,0,0" Style="{StaticResource ErpBtnSecondary}"/>
            <Button Content="PDF" Command="{Binding ExportPdfCommand}" Margin="6,0,0,0" Style="{StaticResource ErpBtnSecondary}"/>
            <Button Content="چاپ" Command="{Binding PrintCommand}" Margin="6,0,0,0" Style="{StaticResource ErpBtnSecondary}"/>
        </StackPanel>

        <!-- کارت‌های خلاصه -->
        <StackPanel Grid.Row="2" Orientation="Vertical">
            <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="فروش (مشمول)" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBlock Text="{Binding SalesBase, Converter={StaticResource Num}, ConverterParameter=ریال}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock Text="مالیاتِ فروش (خروجی)" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding OutputVat, Converter={StaticResource Num}, ConverterParameter=ریال}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryAccent}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="خرید (مشمول)" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBlock Text="{Binding PurchaseBase, Converter={StaticResource Num}, ConverterParameter=ریال}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock Text="مالیاتِ خرید (ورودی)" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding InputVat, Converter={StaticResource Num}, ConverterParameter=ریال}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryAccent}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="مالیاتِ قابلِ پرداخت (خالص):" FontSize="15" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding NetPayable, Converter={StaticResource Num}, ConverterParameter=ریال}" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
