<UserControl x:Class="SamaHesab.WPF.Views.Settings.DocumentTemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource VazirFont}"
             FlowDirection="RightToLeft"
             Background="{StaticResource ErpAppBg}">
    <UserControl.Resources>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource ErpTextMuted}"/>
            <Setter Property="Margin" Value="2,6,0,2"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- ═══ تولبار ═══ -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IcTemplate}" Style="{StaticResource ErpToolSvg}" Width="18" Height="18" Stroke="{StaticResource ErpBlue700}"/>
                    <TextBlock Text="طراحِ قالبِ اسناد" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ErpBlue700}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="نوعِ سند" Style="{StaticResource Cap}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox Width="180" Height="28" ItemsSource="{Binding DocumentTypes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedType}"/>
                    <Button Style="{StaticResource ErpBtnPrimary}" Height="28" Padding="14,0" Margin="8,0,0,0" Content="＋ قالبِ جدید" Command="{Binding NewTemplateCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- ═══ فهرستِ قالب‌ها ═══ -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="0">
                <ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,4">
                                <Border DockPanel.Dock="Left" CornerRadius="4" Background="{StaticResource ErpGray150}" Padding="5,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding PaperSize}" FontSize="9.5" Foreground="{StaticResource ErpTextMuted}"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- ═══ ویرایشگرِ قالب ═══ -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource ErpBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="نامِ قالب" Style="{StaticResource Cap}"/>
                            <TextBox Style="{StaticResource ErpInput}" Height="30" Text="{Binding EditName}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="اندازهٔ کاغذ" Style="{StaticResource Cap}"/>
                            <ComboBox Height="30" ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding EditPaperSize}"/></StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="سربرگ (HTML — اختیاری)" Style="{StaticResource Cap}"/>
                            <TextBox Text="{Binding EditHeader}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="64" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight"/>
                            <TextBlock Text="بدنه (HTML — توکن: {InvoiceNumber}،{CustomerName}،… · ردیف‌ها: [[ROWS]]…[[/ROWS]] با {ProductName}/{Quantity}/{LineTotal}/{#})" Style="{StaticResource Cap}"/>
                            <TextBox Text="{Binding EditBody}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="220" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight"/>
                            <TextBlock Text="پاورقی (HTML — اختیاری)" Style="{StaticResource Cap}"/>
                            <TextBox Text="{Binding EditFooter}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="64" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button Style="{StaticResource ErpBtnPrimary}" Height="32" Padding="18,0" Content="💾 ذخیره" Command="{Binding SaveCommand}"/>
                        <Button Style="{StaticResource ErpBtnGhost}" Height="32" Padding="14,0" Margin="6,0,0,0" Content="👁 پیش‌نمایش" Command="{Binding PreviewCommand}"/>
                        <Button Style="{StaticResource ErpBtnGhost}" Height="32" Padding="14,0" Margin="6,0,0,0" Content="📤 خروجی قالب" Command="{Binding ExportCommand}"/>
                        <Button Style="{StaticResource ErpBtnGhost}" Height="32" Padding="14,0" Margin="6,0,0,0" Content="📥 ورود قالب" Click="Import_Click"/>
                        <Button Style="{StaticResource ErpBtnSecondary}" Height="32" Padding="14,0" Margin="6,0,0,0" Content="🗑 حذف" Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
